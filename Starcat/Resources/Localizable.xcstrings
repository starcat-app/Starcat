    "settings.pro.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions are processed by Apple. You can restore purchases or manage the subscription from your Apple Account at any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅由 Apple 处理。你可以随时恢复购买，或前往 Apple 账户管理订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱由 Apple 處理。您可以隨時從 Apple 帳戶還原購買或管理訂閱。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは Apple によって処理されます。いつでも Apple アカウントから購入を復元したり、サブスクリプションを管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 Apple에서 처리합니다. 언제든지 Apple 계정에서 구입 항목을 복원하거나 구독을 관리할 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements werden von Apple abgewickelt. Du kannst jederzeit Käufe wiederherstellen oder das Abonnement in deinem Apple-Konto verwalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements sont traités par Apple. Vous pouvez restaurer les achats ou gérer l’abonnement depuis votre compte Apple à tout moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones son procesadas por Apple. Puedes restaurar compras o gestionar la suscripción desde tu cuenta de Apple en cualquier momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são processadas pela Apple. Você pode restaurar compras ou gerenciar a assinatura na sua Conta Apple a qualquer momento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti sono gestiti da Apple. Puoi ripristinare acquisti o gestire l'abbonamento dal tuo account Apple in qualsiasi momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписки обрабатываются Apple. Вы можете восстановить покупки или управлять подпиской в своей учетной записи Apple в любое время."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen worden verwerkt door Apple. U kunt aankopen herstellen of het abonnement op elk moment beheren via uw Apple-account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje są przetwarzane przez Apple. Możesz w każdej chwili przywrócić zakupy lub zarządzać subskrypcją ze swojego konta Apple."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписки обробляються Apple. Ви можете відновити покупки або керувати підпискою зі свого облікового запису Apple у будь-який час."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelikler Apple tarafından işlenir. Satın alımları geri yükleyebilir veya aboneliği istediğiniz zaman Apple Hesabınızdan yönetebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các đăng ký được xử lý bởi Apple. Bạn có thể khôi phục giao dịch mua hoặc quản lý đăng ký từ Tài khoản Apple của mình bất kỳ lúc nào."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diproses oleh Apple. Anda dapat memulihkan pembelian atau mengelola langganan dari Akun Apple Anda kapan saja."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم معالجة الاشتراكات بواسطة Apple. يمكنك استعادة المشتريات أو إدارة الاشتراك من حساب Apple الخاص بك في أي وقت."
          }
        }
      }
    },
    "settings.pro.offerCode.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offer codes are created in App Store Connect. Starcat opens Apple's redemption sheet — codes are not validated on Starcat servers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优惠码在 App Store Connect 创建。Starcat 会打开 Apple 官方兑换窗口，不在自建服务器校验。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優惠碼在 App Store Connect 中建立。Starcat 會開啟 Apple 的兌換頁面，不會在 Starcat 伺服器上驗證。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オファーコードは App Store Connect で作成されます。Starcat は Apple の引き換えシートを開きます。コードは Starcat サーバーでは検証されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안 코드는 App Store Connect에서 생성됩니다. Starcat이 Apple의 교환 시트를 엽니다. 코드는 Starcat 서버에서 검증되지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angebotscodes werden in App Store Connect erstellt. Starcat öffnet das Apple-Einlösungsblatt – Codes werden nicht auf Starcat-Servern validiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes d’offre sont créés dans App Store Connect. Starcat ouvre la feuille de remboursement d’Apple — les codes ne sont pas validés sur les serveurs Starcat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códigos de oferta se crean en App Store Connect. Starcat abre la hoja de canje de Apple; los códigos no se validan en los servidores de Starcat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os códigos de oferta são criados no App Store Connect. O Starcat abre a folha de resgate da Apple — os códigos não são validados nos servidores Starcat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici offerta vengono creati in App Store Connect. Starcat apre il foglio di riscatto di Apple — i codici non vengono convalidati sui server Starcat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коды предложений создаются в App Store Connect. Starcat открывает форму погашения Apple — коды не проверяются на серверах Starcat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanbiedingscodes worden aangemaakt in App Store Connect. Starcat opent het inwisselingsblad van Apple — codes worden niet gevalideerd op Starcat-servers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kody ofertowe są tworzone w App Store Connect. Starcat otwiera arkusz realizacji Apple — kody nie są weryfikowane na serwerach Starcat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промокоди створюються в App Store Connect. Starcat відкриває аркуш погашення Apple — коди не перевіряються на серверах Starcat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teklif kodları App Store Connect'te oluşturulur. Starcat, Apple'ın kullanım sayfasını açar — kodlar Starcat sunucularında doğrulanmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã ưu đãi được tạo trong App Store Connect. Starcat mở trang nhập mã của Apple — mã không được xác thực trên máy chủ Starcat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode penawaran dibuat di App Store Connect. Starcat membuka lembar penebusan Apple — kode tidak divalidasi di server Starcat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إنشاء رموز العرض في App Store Connect. يفتح Starcat ورقة استرداد Apple - لا يتم التحقق من الرموز على خوادم Starcat."
          }
        }
      }
    },
