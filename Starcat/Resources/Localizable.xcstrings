    "rag.workspace.context.budget.help.compare.segments.usage" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر مقاطع الإدخال فقط؛ الإخراج المحجوز مخفي لكنه يُخصم داخليًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur Eingabesegmente an; reservierte Ausgabe ist versteckt, wird aber intern abgezogen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows input segments only; reserved output is hidden but still deducted internally"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra solo segmentos de entrada; la salida reservada está oculta pero se deduce internamente"
