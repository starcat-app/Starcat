        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То же, что очистка каждого кэша выше (README, изображения, загруженные ZIP, переводы, поиск, контекст кода, CodeFlow)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetzelfde als het wissen van alle bovenstaande caches (README, afbeeldingen, gedownloade ZIP's, vertaling, zoekopdracht, codecontext, CodeFlow)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To samo, co wyczyszczenie każdej pamięci podręcznej powyżej (README, obrazy, pobrane ZIP, tłumaczenia, wyszukiwanie, kontekst kodu, CodeFlow)."
          }
