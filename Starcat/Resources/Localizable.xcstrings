    "authV2.pat.help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ رمزًا في GitHub ← الإعدادات ← إعدادات المطور ← رموز الوصول الشخصية ← الرموز (كلاسيكية)، مع نطاقات public_repo و read:user."
