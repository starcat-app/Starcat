    "agent.workspace.inspector.auditHint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجزء الأيمن يتعامل فقط مع عرض وتصدير المخرجات؛ يتم تدقيق الخطوات واستدعاءات الأدوات وإدخال/إخراج الذكاء الاصطناعي والسجلات في التتبع الأوسط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das rechte Fenster dient nur der Artefaktansicht und dem Export; Schritte, Tool-Aufrufe, KI-Ein-/Ausgabe und Protokolle werden in der mittleren Spur geprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The right pane only handles artifact viewing and export; steps, tool calls, AI input/output, and logs are audited in the middle trace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel derecho solo maneja la visualización y exportación de artefactos; los pasos, llamadas a herramientas, entrada/salida de IA y registros se auditan en la traza central."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volet droit gère uniquement la visualisation et l'exportation des artefacts ; les étapes, appels d'outils, entrées/sorties IA et journaux sont audités dans la trace centrale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel kanan hanya menangani tampilan dan ekspor artefak; langkah, panggilan alat, masukan/keluaran AI, dan log diaudit di jejak tengah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello destro gestisce solo la visualizzazione e l'esportazione degli artefatti; passaggi, chiamate agli strumenti, input/output AI e log sono verificati nella traccia centrale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右ペインはアーティファクトの表示とエクスポートのみを扱います。ステップ、ツール呼び出し、AIの入出力、ログは中央のトレースで監査されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 창은 아티팩트 보기 및 내보내기만 처리합니다. 단계, 도구 호출, AI 입력/출력 및 로그는 중간 추적에서 감사됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het rechterpaneel behandelt alleen artefactweergave en -export; stappen, toolaanroepen, AI-invoer/-uitvoer en logboeken worden gecontroleerd in de middelste trace."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawy panel obsługuje tylko przeglądanie i eksport artefaktów; kroki, wywołania narzędzi, wejście/wyjście AI i logi są audytowane w środkowym śladzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel direito lida apenas com visualização e exportação de artefatos; etapas, chamadas de ferramentas, entrada/saída de IA e logs são auditados no rastro central."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правая панель предназначена только для просмотра и экспорта артефактов; шаги, вызовы инструментов, ввод/вывод ИИ и журналы проверяются в средней трассировке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağ panel yalnızca yapıt görüntüleme ve dışa aktarma işlemlerini yapar; adımlar, araç çağrıları, AI giriş/çıkışı ve günlükler orta izleme bölümünde denetlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Права панель обробляє лише перегляд та експорт артефактів; кроки, виклики інструментів, введення/виведення ШІ та журнали аудитуються в середній трасі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn bên phải chỉ xử lý xem và xuất tạo phẩm; các bước, lệnh gọi công cụ, đầu vào/đầu ra AI và nhật ký được kiểm tra trong dấu vết ở giữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前右栏只承载产出物查看与导出；步骤、工具调用、AI 输入输出和日志在中栏 trace 中展开审计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側面板僅處理產出物檢視與匯出；步驟、工具呼叫、AI 輸入/輸出和日誌請在中間追蹤中審查。"
          }
        }
      }
    },
