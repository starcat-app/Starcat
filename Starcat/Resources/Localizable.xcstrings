        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein KI-Anbieter ist mit der README-Übersetzungsaufgabe verknüpft. Öffnen Sie Einstellungen → KI, um dies zu beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
