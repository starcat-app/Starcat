    "activity.undoStar.clearAll.confirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف جميع سجلات تاريخ التراجع عن النجمة بشكل دائم."
          }
        },
        "de" : {
          "stringUnit" : {
