        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會撤銷目前 GitHub 使用者對 Starcat for GitHub 的授權，並使其他 Starcat 安裝中的專案權限失效。個人和組織中的 GitHub App 仍會保留。"
          }
        }
