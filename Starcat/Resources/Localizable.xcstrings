        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより context.xml とそのメタデータが削除されます。後で再生成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 context.xml과 해당 메타데이터를 제거합니다. 나중에 다시 생성할 수 있습니다."
