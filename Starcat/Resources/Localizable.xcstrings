        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 是 GitHub, Inc. 的註冊商標。Apple、macOS 與 Swift 是 Apple Inc. 的商標。Starcat 與上述公司無關聯、未經其背書或贊助。"
          }
        }
      }
