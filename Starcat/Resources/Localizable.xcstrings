    "settings.githubListGrouping.enabled.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyze ungrouped starred repositories in the background and add only high-confidence matches to permitted groups."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台分析未分组的仓库，仅将高置信度结果添加到已授权的分组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景分析未分組的倉庫，僅將高置信度結果加入已授權的分組。"
          }
        }
      }
    },
    "settings.githubListGrouping.enabled.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable AI auto-grouping"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 AI 自动分组"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用 AI 自動分組"
          }
        }
      }
    },
    "settings.githubListGrouping.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each group must also allow background auto-grouping in its editor before AI can add repositories to it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个分组还需要在分组编辑器中允许后台自动分组，AI 才能向其中添加仓库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個分組還需要在分組編輯器中允許背景自動分組，AI 才能向其中加入倉庫。"
          }
        }
      }
    },
    "settings.githubListGrouping.range.maxPerRun.description" : {
      "localizations" : {
