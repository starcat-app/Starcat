    "readme.translate.error.missingProvider" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد مزوّد ذكاء اصطناعي مرتبط بمهمة ترجمة README. افتح الإعدادات → الذكاء الاصطناعي لإصلاح ذلك."
          }
