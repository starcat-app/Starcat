    "settings.storage.clearAll.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete all rebuildable local cache and generated files. Starcat may need to fetch, translate, or regenerate content again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有可重建的本机缓存和生成文件。之后 Starcat 可能需要重新拉取、翻译或生成内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有可重建的本地缓存和生成文件。之后 Starcat 可能需要重新获取、翻译或生成内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再構築可能なローカルキャッシュと生成ファイルをすべて削除します。Starcatは再度コンテンツの取得、翻訳、生成を行う必要がある場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재구성 가능한 모든 로컬 캐시와 생성된 파일을 삭제합니다. Starcat이 콘텐츠를 다시 가져오거나, 번역하거나, 재생성해야 할 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle wiederherstellbaren lokalen Cache- und generierten Dateien. Starcat muss möglicherweise erneut Inhalte abrufen, übersetzen oder generieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tout le cache local et les fichiers générés reconstructibles. Starcat devra peut-être récupérer, traduire ou régénérer du contenu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina toda la caché local y archivos generados que se pueden reconstruir. Es posible que Starcat necesite obtener, traducir o regenerar contenido nuevamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui todo o cache local reconstruível e arquivos gerados. O Starcat pode precisar buscar, traduzir ou gerar conteúdo novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutta la cache locale ricostruibile e i file generati. Starcat potrebbe dover recuperare, tradurre o rigenerare i contenuti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить весь восстанавливаемый локальный кэш и сгенерированные файлы. Starcat может потребоваться повторно загрузить, перевести или сгенерировать содержимое."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder alle herbouwbare lokale cache en gegenereerde bestanden. Starcat moet mogelijk opnieuw ophalen, vertalen of genereren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń wszystkie możliwe do odtworzenia lokalne pliki pamięci podręcznej i wygenerowane pliki. Starcat może ponownie pobrać, przetłumaczyć lub wygenerować treści."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити весь локальний кеш і згенеровані файли, які можна відновити. Starcat може знову завантажувати, перекладати або генерувати вміст."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden oluşturulabilir tüm yerel önbelleği ve oluşturulan dosyaları siler. Starcat içeriği tekrar getirmek, çevirmek veya yeniden oluşturmak zorunda kalabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tất cả bộ nhớ đệm cục bộ có thể xây dựng lại và các tệp đã tạo. Starcat có thể cần tải, dịch hoặc tạo lại nội dung."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus semua cache lokal yang dapat dibangun ulang dan file yang dibuat. Starcat mungkin perlu mengambil, menerjemahkan, atau membuat ulang konten lagi."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف كل الذاكرة المؤقتة المحلية القابلة لإعادة البناء والملفات المنشأة. قد يحتاج Starcat إلى جلب المحتوى أو ترجمته أو إنشائه مرة أخرى."
          }
        }
      }
    },
    "settings.storage.clearAll.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same as clearing every cache above (README, images, downloaded ZIPs, translation, search, Code Context, CodeFlow)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等同于一次性清理上面所有缓存（README、图片、已下载的仓库 ZIP、翻译、搜索、代码上下文、CodeFlow）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等同于一次性清除上述所有缓存（README、图片、已下载的仓库 ZIP、翻译、搜索、代码上下文、CodeFlow）。"
          }
        },
        "ja" : {
          "stringUnit" : {
