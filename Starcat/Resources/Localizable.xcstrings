    "rag.workspace.inspector.metadata.help.freshness.definition.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts repositories with a non-empty private note edited, or an AI summary generated, in the last 30 days. An older summary is not automatically invalid."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计近 30 天编辑过非空私有笔记、或生成过 AI 摘要的项目数。超过 30 天的摘要不会因此被判定为失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计近 30 天编辑过非空私有笔记、或生成过 AI 摘要的项目数。超过 30 天的摘要不会因此被判定为失效。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去30日以内に編集された空でないプライベートノート、または生成されたAIサマリーを持つリポジトリをカウントします。古いサマリーは自動的に無効にはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 30일 동안 편집된 비공개 노드나 생성된 AI 요약이 있는 저장소를 집계합니다. 오래된 요약이 자동으로 무효화되지는 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt Repositories mit einer nicht leeren privaten Notiz, die bearbeitet wurde, oder einer KI-Zusammenfassung, die in den letzten 30 Tagen generiert wurde. Eine ältere Zusammenfassung ist nicht automatisch ungültig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les dépôts avec une note privée non vide modifiée, ou un résumé IA généré, au cours des 30 derniers jours. Un résumé plus ancien n'est pas automatiquement invalide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta repositorios con una nota privada no vacía editada, o un resumen de IA generado, en los últimos 30 días. Un resumen antiguo no se invalida automáticamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta repositórios com uma nota privada não vazia editada, ou um resumo de IA gerado, nos últimos 30 dias. Um resumo mais antigo não é automaticamente inválido."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta i repository con una nota privata non vuota modificata o un riepilogo IA generato negli ultimi 30 giorni. Un riepilogo più vecchio non è automaticamente invalido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитываются репозитории с непустой личной заметкой, отредактированной, или сводкой ИИ, созданной за последние 30 дней. Более старая сводка не считается автоматически устаревшей."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt repositories met een niet-lege privénotitie die is bewerkt, of een AI-samenvatting die is gegenereerd, in de laatste 30 dagen. Een oudere samenvatting wordt niet automatisch als ongeldig beschouwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlicza repozytoria z niepustą prywatną notatką edytowaną lub podsumowaniem AI wygenerowanym w ciągu ostatnich 30 dni. Starsze podsumowanie nie jest automatycznie nieaktualne."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Враховує репозиторії з непустою приватною нотаткою, яку редагували, або підсумком ШІ, створеним за останні 30 днів. Старіший підсумок не вважається автоматично недійсним."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son 30 günde düzenlenen boş olmayan özel notu veya oluşturulan yapay zeka özeti olan depoları sayar. Eski bir özet otomatik olarak geçersiz sayılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm các kho lưu trữ có ghi chú riêng tư không rỗng được chỉnh sửa hoặc tóm tắt AI được tạo trong 30 ngày qua. Một tóm tắt cũ không tự động bị vô hiệu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung repositori dengan catatan pribadi tidak kosong yang diedit, atau ringkasan AI yang dihasilkan, dalam 30 hari terakhir. Ringkasan lama tidak otomatis tidak valid."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عد المستودعات التي تم تحرير ملاحظة خاصة غير فارغة فيها، أو تم إنشاء ملخص ذكاء اصطناعي لها، خلال آخر 30 يومًا. الملخص الأقدم لا يصبح غير صالح تلقائيًا."
          }
        }
      }
    },
