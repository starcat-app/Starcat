    "rag.browser.repoContext.delete.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يزيل context.xml والبيانات الوصفية الخاصة به. يمكنك إنشاؤها مرة أخرى لاحقًا."
          }
        },
        "de" : {
