    "rag.browser.repoContext.settings.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتمكين سياق الكود في إعدادات AI قبل إنشاء RepoContext XML. لن يغير Starcat هذا الإعداد تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie den Code-Kontext in den KI-Einstellungen, bevor Sie RepoContext-XML generieren. Starcat wird diese Einstellung nicht automatisch ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable code context in AI Settings before generating RepoContext XML. Starcat will not change this setting automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilita el contexto de código en los ajustes de IA antes de generar el XML de RepoContext. Starcat no cambiará esta configuración automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le contexte de code dans les réglages IA avant de générer le XML RepoContext. Starcat ne modifiera pas ce réglage automatiquement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan konteks kode di Pengaturan AI sebelum membuat XML RepoContext. Starcat tidak akan mengubah pengaturan ini secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita il contesto del codice nelle Impostazioni AI prima di generare il XML di RepoContext. Starcat non modificherà questa impostazione automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepoContext XML を生成する前に、AI 設定でコードコンテキストを有効にしてください。Starcat はこの設定を自動的に変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepoContext XML을 생성하기 전에 AI 설정에서 코드 컨텍스트를 활성화하세요. Starcat이 이 설정을 자동으로 변경하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel codecontext in AI-instellingen in voordat u RepoContext XML genereert. Starcat zal deze instelling niet automatisch wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz kontekst kodu w ustawieniach AI przed wygenerowaniem pliku RepoContext XML. Starcat nie zmieni tego ustawienia automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o contexto de código nos Ajustes de IA antes de gerar o XML do RepoContext. O Starcat não alterará essa configuração automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите контекст кода в настройках AI перед генерацией RepoContext XML. Starcat не будет менять этот параметр автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepoContext XML oluşturmadan önce AI Ayarları'nda kod bağlamını etkinleştirin. Starcat bu ayarı otomatik olarak değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть контекст коду в налаштуваннях AI перед генерацією RepoContext XML. Starcat не змінюватиме це налаштування автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật ngữ cảnh mã trong Cài đặt AI trước khi tạo RepoContext XML. Starcat sẽ không tự động thay đổi cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在 AI 设置中开启代码上下文，再生成 RepoContext XML。Starcat 不会自动修改此设置。"
