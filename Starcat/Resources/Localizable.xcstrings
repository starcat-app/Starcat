        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie ein Token in GitHub → Einstellungen → Entwicklereinstellungen → Persönliche Zugriffstoken → Token (klassisch) mit den Bereichen public_repo und read:user."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate a token in GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic), with public_repo and read:user scopes."
