    "rag.workspace.inspector.plan.help.networkPlan.definition.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether live external evidence is needed and what Starcat will fetch from GitHub or the public web. Shown only when the Planner requests network access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否需要拉取实时外部证据，以及将从 GitHub 或公开互联网获取什么。仅在 Planner 请求联网时出现。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.networkPlan.definition.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is network plan?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联网计划是什么？"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.networkPlan.field.liveEvidence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live context: whether stale local chunks are insufficient and network fetch is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时上下文：本地分片是否不足以安全回答，必须联网补充。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.networkPlan.field.remoteContext": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub remote context: Issues, PRs, or other GitHub API resources with query and per-repo limits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 远程上下文：Issues、PR 等 GitHub API 资源及其查询词与每仓库上限。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.networkPlan.field.webSearch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web search: public internet queries when enabled in Composer and approved by the Planner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互联网搜索：Composer 已开启联网且 Planner 认为需要时，发起的公开网页检索。"
          }
        }
