    "settings.undoStar.shortenMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف السجلات الأقدم من فترة الاحتفاظ الجديدة نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge, die älter als die neue Aufbewahrungsdauer sind, werden endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records older than the new retention period will be permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros anteriores al nuevo período de retención se eliminarán permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements antérieurs à la nouvelle période de conservation seront définitivement supprimés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan yang lebih lama dari periode retensi baru akan dihapus secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I record più vecchi del nuovo periodo di conservazione verranno eliminati definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい保持期間より古い記録は完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 보관 기간보다 오래된 기록은 영구적으로 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records ouder dan de nieuwe bewaarperiode worden permanent verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekordy starsze niż nowy okres przechowywania zostaną trwale usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros mais antigos que o novo período de retenção serão excluídos permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи старше нового срока хранения будут удалены безвозвратно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni saklama süresinden daha eski kayıtlar kalıcı olarak silinecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи, старші за новий термін зберігання, буде остаточно видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản ghi cũ hơn thời gian lưu giữ mới sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过新保留时间的记录将被永久删除，此操作不可撤销。"
