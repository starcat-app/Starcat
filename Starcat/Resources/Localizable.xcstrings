    "rag.workspace.empty.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use @ to select one or more knowledge-base repositories, or ask across the whole knowledge base."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 @ 选择一个或多个知识库仓库，或直接面向整个知识库提问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
