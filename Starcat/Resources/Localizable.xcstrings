    "tagManagement.mergeMessageFormat" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Will merge %1$d other tag(s) into \"%2$@\". Repos with merged tags will be moved to \"%2$@\". This cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将把其它 %1$d 个标签合并到「%2$@」。被合并标签关联的仓库会自动转挂到「%2$@」名下。此操作不可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將把其他 %1$d 個標籤合併到「%2$@」。被合併標籤關聯的倉庫將移至「%2$@」。此操作無法復原。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の%1$d個のタグを「%2$@」にマージします。マージされたタグが付いたリポジトリは「%2$@」に移動されます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d개의 다른 태그가 \"%2$@\"(으)로 병합됩니다. 병합된 태그가 있는 저장소는 \"%2$@\"(으)로 이동됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d andere(s) Tag(s) werden in \"%2$@\" zusammengeführt. Repos mit zusammengeführten Tags werden zu \"%2$@\" verschoben. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionnera %1$d autre(s) tag(s) dans « %2$@ ». Les dépôts avec les tags fusionnés seront déplacés vers « %2$@ ». Cette action est irréversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fusionarán %1$d otra(s) etiqueta(s) en \"%2$@\". Los repositorios con etiquetas fusionadas se moverán a \"%2$@\". Esto no se puede deshacer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesclará %1$d outra(s) tag(s) em \"%2$@\". Os repositórios com as tags mescladas serão movidos para \"%2$@\". Isso não pode ser desfeito."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno uniti %1$d altri tag in \"%2$@\". I repository con i tag uniti verranno spostati in \"%2$@\". Questa operazione non può essere annullata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет объединено %1$d других тегов в «%2$@». Репозитории с объединёнными тегами будут перемещены в «%2$@». Это действие необратимо."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden %1$d andere tag(s) samengevoegd in \"%2$@\". Repositories met samengevoegde tags worden verplaatst naar \"%2$@\". Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to scalenie %1$d innych tagów z „%2$@”. Repozytoria ze scalonymi tagami zostaną przeniesione do „%2$@”. Tej operacji nie można cofnąć."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде об’єднано %1$d інший(і) тег(и) у \"%2$@\". Репозиторії з об’єднаними тегами буде переміщено до \"%2$@\". Цю дію не можна скасувати."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d diğer etiket \"%2$@\" ile birleştirilecek. Birleştirilen etiketlere sahip depolar \"%2$@\" konumuna taşınacak. Bu işlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sẽ hợp nhất %1$d thẻ khác vào \"%2$@\". Các kho lưu trữ có thẻ được hợp nhất sẽ được chuyển sang \"%2$@\". Hành động này không thể hoàn tác."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akan menggabungkan %1$d tag lain ke dalam \"%2$@\". Repositori dengan tag yang digabungkan akan dipindahkan ke \"%2$@\". Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم دمج %1$d وسم (أوسمة) أخرى في \"%2$@\". سيتم نقل المستودعات ذات الأوسمة المدمجة إلى \"%2$@\". لا يمكن التراجع عن هذا الإجراء."
          }
        }
      }
    },
