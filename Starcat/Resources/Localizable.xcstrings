    "smartCollections.editor.presets.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in presets are AND approximations, not exact copies of system collections."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置预设为 AND 近似，与系统集合 OR 逻辑不完全一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建預設為 AND 近似，並非系統集合的完全複製。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みプリセットはAND近似であり、システムコレクションの正確なコピーではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 프리셋은 시스템 컬렉션의 정확한 복사본이 아닌 AND 근사치입니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrierte Vorgaben sind UND-Annäherungen, keine exakten Kopien von Systemkollektionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages intégrés sont des approximations ET, pas des copies exactes des collections système."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes predefinidos integrados son aproximaciones Y, no copias exactas de las colecciones del sistema."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As predefinições integradas são aproximações E, não cópias exatas das coleções do sistema."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preset integrati sono approssimazioni AND, non copie esatte delle raccolte di sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенные пресеты — это AND-приближения, а не точные копии системных коллекций."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingebouwde presets zijn EN-benaderingen, geen exacte kopieën van systeemverzamelingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wbudowane presety są przybliżeniami AND, a nie dokładnymi kopiami kolekcji systemowych."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вбудовані пресети є наближеннями AND, а не точними копіями системних колекцій."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerleşik ön ayarlar, sistem koleksiyonlarının birebir kopyaları değil, VE yaklaşımlarıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ cài sẵn là xấp xỉ AND, không phải bản sao chính xác của bộ sưu tập hệ thống."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preset bawaan adalah perkiraan AND, bukan salinan persis dari koleksi sistem."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات المسبقة المضمنة هي تقريبات AND، وليست نسخًا طبق الأصل من مجموعات النظام."
          }
        }
      }
    },
