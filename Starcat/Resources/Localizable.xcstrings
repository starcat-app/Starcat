    "settings.autoTidy.range.sortOrder.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether each run prefers recently starred, earliest starred, or random stars."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "决定每轮优先处理最近、最早或随机选择的 Star。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "决定每轮优先处理最近、最早或随机选择的 Star。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各実行で最近スターを付けたもの、最も古いもの、ランダムのいずれを優先するかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 실행에서 최근에 별표 표시된 항목, 가장 오래된 항목 또는 무작위 항목을 선호할지 선택합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie, ob jeder Durchlauf zuletzt gespeicherte, zuerst gespeicherte oder zufällige Sterne bevorzugt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si chaque exécution privilégie les étoiles récentes, les plus anciennes ou aléatoires."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si cada ejecución prefiere los destacados recientes, los más antiguos o aleatorios."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se cada execução prefere estrelas recentes, mais antigas ou aleatórias."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se ogni esecuzione preferisce le stelle recenti, le più vecchie o casuali."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, предпочитает ли каждый запуск недавно отмеченные, самые старые или случайные звёзды."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of elke run de voorkeur geeft aan recent gemarkeerde, eerst gemarkeerde of willekeurige sterren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy każdy przebieg preferuje ostatnio oznaczone, najwcześniej oznaczone czy losowe gwiazdki."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, чи кожен запуск віддає перевагу нещодавно позначеним, найстарішим або випадковим зіркам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her çalıştırmanın en son yıldızlanan, en eski yıldızlanan veya rastgele yıldızları tercih edip etmeyeceğini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn mỗi lần chạy ưu tiên sao gần đây, sao cũ nhất hay sao ngẫu nhiên."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apakah setiap proses lebih memilih bintang yang baru dibintangi, paling awal dibintangi, atau acak."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كانت كل دُفعة تُفضل النجوم المضافة مؤخرًا، أو الأقدم، أو العشوائية."
          }
        }
      }
    },
