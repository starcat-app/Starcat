    "about.overview.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat transforms your flat GitHub Stars collection into a searchable, taggable, private-note-enabled knowledge base. MVP focuses on local data reliability and smooth reading experience first, then gradually adds AI summarization and tag recommendations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 将扁平的 GitHub 收藏转化为可搜索、可打标签、可写私有笔记的知识库。MVP 阶段优先保证本地数据可靠、阅读体验顺滑，再逐步接入 AI 摘要与标签推荐。"
          }
        }
      }
    },
    "about.overview.feature.aiReserved.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summaries, tag suggestions, and semantic search all write back to user data only after confirmation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要、标签建议和语义搜索都采用用户确认后写入。"
          }
        }
      }
    },
