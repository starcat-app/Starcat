    "about.overview.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize — Sync Stars from GitHub to a fast local library.\nUnderstand — Tags, private notes, and native README reading.\nRediscover — Search and filter your way back to the right repo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理 — 从 GitHub 拉取 Stars，本地缓存，告别网页翻找。\n理解 — 标签分类、私有笔记、README 原生渲染，把仓库读懂。\n找回 — 全文搜索与多维筛选，让收藏真正为你所用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理 — 從 GitHub 同步 Stars 至快速的本機資料庫。\n理解 — 標籤、私人筆記與原生 README 閱讀。\n重新發現 — 搜尋與篩選，輕鬆找回正確的儲存庫。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理 — GitHubからスターを高速なローカルライブラリに同期。\n理解 — タグ、プライベートノート、ネイティブREADMEリーディング。\n再発見 — 検索とフィルタで目的のリポジトリに戻る。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정리 — GitHub에서 Star를 동기화하여 빠른 로컬 라이브러리로.\n이해 — 태그, 개인 노트 및 네이티브 README 읽기.\n재발견 — 검색 및 필터로 올바른 저장소로 다시 찾아가기."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organisieren – Synchronisiere Sterne von GitHub in eine schnelle lokale Bibliothek.\nVerstehen – Tags, private Notizen und natives README-Lesen.\nWiederentdecken – Suche und filtere dich zurück zum richtigen Repository."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organisez — Synchronisez les étoiles de GitHub vers une bibliothèque locale rapide.\nComprenez — Tags, notes privées et lecture native des README.\nRedécouvrez — Recherchez et filtrez pour retrouver le bon dépôt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiza — Sincroniza estrellas de GitHub a una biblioteca local rápida.\nComprende — Etiquetas, notas privadas y lectura nativa de README.\nRedescubre — Busca y filtra para volver al repositorio correcto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize — Sincronize Estrelas do GitHub para uma biblioteca local rápida.\nEntenda — Tags, notas privadas e leitura nativa de README.\nRedescubra — Pesquise e filtre seu caminho de volta ao repositório certo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizza — Sincronizza le Stelle da GitHub in una libreria locale veloce.\nComprendi — Tag, note private e lettura nativa dei README.\nRiscopri — Cerca e filtra per ritrovare il repository giusto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Организуйте — синхронизируйте звёзды GitHub в быструю локальную библиотеку.\nПонимайте — теги, личные заметки и нативное чтение README.\nНаходите заново — ищите и фильтруйте, чтобы вернуться к нужному репозиторию."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiseer — Synchroniseer sterren van GitHub naar een snelle lokale bibliotheek.\nBegrijp — Tags, privénotities en native README-lezing.\nHerontdek — Zoek en filter uw weg terug naar de juiste repo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizuj — synchronizuj gwiazdki z GitHub do szybkiej lokalnej biblioteki.\nZrozum — tagi, prywatne notatki i natywne czytanie README.\nOdkryj na nowo — wyszukuj i filtruj, aby wrócić do odpowiedniego repozytorium."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Організовуйте — синхронізуйте зірки з GitHub у швидку локальну бібліотеку.\nРозумійте — теги, приватні нотатки та рідне читання README.\nВідкривайте заново — шукайте та фільтруйте, щоб знайти потрібний репозиторій."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle — GitHub'dan Yıldızları hızlı bir yerel kütüphaneye senkronize edin.\nAnla — Etiketler, özel notlar ve yerel README okuma.\nYeniden Keşfet — Doğru depoya geri dönmek için arama ve filtreleme yapın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp xếp — Đồng bộ Stars từ GitHub vào thư viện cục bộ nhanh.\nHiểu — Thẻ, ghi chú riêng tư và đọc README gốc.\nKhám phá lại — Tìm kiếm và lọc để quay lại đúng kho lưu trữ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur — Sinkronkan Stars dari GitHub ke perpustakaan lokal yang cepat.\nPahami — Tag, catatan pribadi, dan pembacaan README asli.\nTemukan Kembali — Cari dan filter untuk menemukan repositori yang tepat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظّم — مزامنة النجوم من GitHub إلى مكتبة محلية سريعة.\nافهم — وسوم وملاحظات خاصة وقراءة README أصلية.\nأعد الاكتشاف — ابحث وصفِّ طريقك إلى المستودع الصحيح."
          }
        }
      }
    },
    "about.overview.feature.aiReserved.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstract, AI repository chat, code maps, tag suggestions, and semantic search have been fully integrated with AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要、AI仓库对话、代码图谱、标签建议和语义搜索已全面接入 AI。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要、AI 儲存庫對話、程式碼圖譜、標籤建議與語意搜尋已全面整合 AI。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要約、AIリポジトリチャット、コードマップ、タグ提案、セマンティック検索がAIと完全に統合されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요약, AI 저장소 채팅, 코드 맵, 태그 제안 및 의미 검색이 AI와 완전히 통합되었습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammenfassung, KI-Repository-Chat, Code-Karten, Tag-Vorschläge und semantische Suche wurden vollständig mit KI integriert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le résumé, le chat IA du dépôt, les cartes de code, les suggestions de tags et la recherche sémantique sont entièrement intégrés à l'IA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumen, chat de repositorio con IA, mapas de código, sugerencias de etiquetas y búsqueda semántica están completamente integrados con IA."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumo, chat de repositório com IA, mapas de código, sugestões de tags e pesquisa semântica foram totalmente integrados com IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstract, chat AI sui repository, mappe del codice, suggerimenti di tag e ricerca semantica sono stati completamente integrati con l'AI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аннотации, чат с репозиторием, карты кода, предложения тегов и семантический поиск полностью интегрированы с ИИ."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstract, AI-repositorychat, codekaarten, tagsuggesties en semantisch zoeken zijn volledig geïntegreerd met AI."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streszczenie, czat z repozytorium AI, mapy kodu, sugestie tagów i wyszukiwanie semantyczne zostały w pełni zintegrowane z AI."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абстрагування, чат з репозиторієм, карти коду, пропозиції тегів та семантичний пошук повністю інтегровані зі ШІ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özet, AI depo sohbeti, kod haritaları, etiket önerileri ve anlamsal arama, AI ile tamamen entegre edilmiştir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tóm tắt, trò chuyện AI với kho lưu trữ, bản đồ mã, gợi ý thẻ và tìm kiếm ngữ nghĩa đã được tích hợp đầy đủ với AI."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstrak, obrolan repositori AI, peta kode, saran tag, dan pencarian semantik telah sepenuhnya terintegrasi dengan AI."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملخص، ودردشة مستودع الذكاء الاصطناعي، وخرائط الكود، واقتراحات الوسوم، والبحث الدلالي تم دمجها بالكامل مع الذكاء الاصطناعي."
          }
        }
      }
    },
