    "settings.storage.chatHistory.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلسات الدردشة على القرص من نافذة مساعد الذكاء الاصطناعي لكل مستودع. ليست مساحة عمل Knowledge RAG. يقوم LRU بإخلاء أقدم الجلسات عندما يتجاوز الإجمالي 100 ميغابايت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat-Sitzungen auf der Festplatte aus dem KI-Assistentenfenster pro Repository. Nicht der Knowledge-RAG-Arbeitsbereich. LRU entfernt die ältesten Sitzungen, wenn die Gesamtgröße 100 MB überschreitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-disk chat sessions from the per-repo AI assistant window. Not the Knowledge RAG workspace. LRU evicts oldest sessions when total exceeds 100 MB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiones de chat en disco de la ventana de asistente de IA por repositorio. No es el espacio de trabajo RAG de conocimiento. LRU elimina las sesiones más antiguas cuando el total supera los 100 MB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions de discussion sur disque depuis la fenêtre d'assistant IA par dépôt. Pas l'espace de travail RAG de connaissances. LRU supprime les sessions les plus anciennes lorsque le total dépasse 100 Mo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi obrolan di disk dari jendela asisten AI per repo. Bukan ruang kerja Knowledge RAG. LRU menghapus sesi terlama saat total melebihi 100 MB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessioni chat su disco dalla finestra assistente AI per repository. Non lo spazio di lavoro Knowledge RAG. LRU rimuove le sessioni più vecchie quando il totale supera 100 MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリごとのAIアシスタントウィンドウからのディスク上のチャットセッション。Knowledge RAGワークスペースは含みません。合計が100 MBを超えると、LRUが最も古いセッションを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장소별 AI 어시스턴트 창의 디스크 채팅 세션입니다. Knowledge RAG 작업 공간이 아닙니다. 총 100MB 초과 시 LRU로 가장 오래된 세션을 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatsessies op schijf van het per-repo AI-assistentvenster. Niet de Knowledge RAG-werkruimte. LRU verwijdert oudste sessies wanneer het totaal 100 MB overschrijdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesje czatu na dysku z okna asystenta AI dla repozytorium. Nie dotyczy obszaru roboczego Knowledge RAG. LRU usuwa najstarsze sesje, gdy suma przekroczy 100 MB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões de chat em disco do assistente de IA por repositório. Não é o espaço de trabalho RAG de Conhecimento. LRU remove as sessões mais antigas quando o total excede 100 MB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеансы чата на диске из окна ИИ-помощника репозитория. Не относится к рабочей области Knowledge RAG. LRU удаляет самые старые сеансы, когда общий объём превышает 100 МБ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depo başına AI asistan penceresinden diskteki sohbet oturumları. Knowledge RAG çalışma alanı değil. LRU, toplam 100 MB'ı aştığında en eski oturumları çıkarır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанси чату на диску з вікна AI-помічника для репозиторію. Не стосується робочої області Knowledge RAG. LRU видаляє найстаріші сеанси, коли загальний обсяг перевищує 100 МБ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên trò chuyện trên đĩa từ cửa sổ trợ lý AI cho từng kho. Không phải không gian làm việc RAG tri thức. LRU loại bỏ các phiên cũ nhất khi tổng vượt quá 100 MB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按仓库保存的 AI 助手窗口对话，不含知识库 RAG 工作台。总占用超过 100 MB 时按最久未访问优先淘汰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個倉庫 AI 助手視窗的對話工作階段（不含知識庫 RAG 工作台）。總量超過 100 MB 時，LRU 會淘汰最舊的工作階段。"
          }
        }
      }
    },
    "settings.storage.chatHistoryBackend.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مكان تخزين سجل محادثة مساعد الذكاء الاصطناعي الجديد للمستودع. لا يؤثر على مساحة عمل Knowledge RAG. أعد تشغيل Starcat للتطبيق؛ لا يتم ترحيل السجل الحالي تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie, wo der Chatverlauf des neuen Repository-KI-Assistenten gespeichert wird. Hat keine Auswirkung auf den Knowledge-RAG-Arbeitsbereich. Starten Sie Starcat neu, um die Änderung zu übernehmen; vorhandener Verlauf wird nicht automatisch migriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose where new repo AI assistant chat history is stored. Does not affect the Knowledge RAG workspace. Restart Starcat to apply; existing history is not migrated automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige dónde se almacena el historial de chat del asistente de IA del nuevo repositorio. No afecta al espacio de trabajo RAG de conocimiento. Reinicia Starcat para aplicar; el historial existente no se migra automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez où stocker l'historique des discussions de l'assistant IA du dépôt. N'affecte pas l'espace de travail RAG de connaissances. Redémarrez Starcat pour appliquer ; l'historique existant n'est pas migré automatiquement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih di mana riwayat obrolan asisten AI repo baru disimpan. Tidak memengaruhi ruang kerja Knowledge RAG. Mulai ulang Starcat untuk menerapkan; riwayat yang ada tidak dimigrasi secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli dove archiviare la cronologia chat dell'assistente AI per nuovi repository. Non influisce sullo spazio di lavoro Knowledge RAG. Riavvia Starcat per applicare; la cronologia esistente non viene migrata automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいリポジトリAIアシスタントチャット履歴の保存場所を選択します。Knowledge RAGワークスペースには影響しません。適用するにはStarcatを再起動してください。既存の履歴は自動的に移行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 저장소 AI 어시스턴트 채팅 기록을 저장할 위치를 선택합니다. Knowledge RAG 작업 공간에는 영향을 주지 않습니다. Starcat을 다시 시작해야 적용되며, 기존 기록은 자동으로 마이그레이션되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies waar nieuwe repo AI-assistent-chatgeschiedenis wordt opgeslagen. Heeft geen invloed op de Knowledge RAG-werkruimte. Herstart Starcat om toe te passen; bestaande geschiedenis wordt niet automatisch gemigreerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, gdzie przechowywana jest historia czatu asystenta AI dla nowych repozytoriów. Nie wpływa na obszar roboczy Knowledge RAG. Uruchom ponownie Starcat, aby zastosować; istniejąca historia nie jest migrowana automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha onde o histórico de chat do assistente de IA do repositório é armazenado. Não afeta o espaço de trabalho RAG de Conhecimento. Reinicie o Starcat para aplicar; o histórico existente não é migrado automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, где хранить историю чата ИИ-помощника репозитория. Не влияет на рабочую область Knowledge RAG. Перезапустите Starcat для применения; существующая история не переносится автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni depo AI asistan sohbet geçmişinin nerede saklanacağını seçin. Knowledge RAG çalışma alanını etkilemez. Uygulamak için Starcat'ı yeniden başlatın; mevcut geçmiş otomatik olarak taşınmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, де зберігати історію чату AI-помічника для нових репозиторіїв. Не впливає на робочу область Knowledge RAG. Перезапустіть Starcat, щоб застосувати зміни; існуюча історія не переноситься автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn nơi lưu trữ lịch sử trò chuyện AI kho mới. Không ảnh hưởng đến không gian làm việc RAG tri thức. Khởi động lại Starcat để áp dụng; lịch sử hiện tại không được tự động di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择仓库 AI 助手新对话历史的写入位置，不影响知识库 RAG 工作台。需重启应用后生效；已有历史不会自动迁移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇新倉庫 AI 助手對話記錄的儲存位置，不影響知識庫 RAG 工作台。需重新啟動 Starcat 才能套用；現有記錄不會自動遷移。"
          }
        }
      }
    },
