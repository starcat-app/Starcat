    "smartCollections.editor.validation.createdConflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Created within and created older than cannot both be set."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近创建」与「长期未创建」不能同时设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近創建」與「長期未創建」不能同時設定。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作成日時「以内」と「より前」は同時に設定できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생성 기간과 생성 이전 기간을 동시에 설정할 수 없습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Erstellt innerhalb“ und „Erstellt vor mehr als“ können nicht beide gesetzt sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créé depuis et créé depuis plus de ne peuvent pas être définis ensemble."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden establecer a la vez «Creado en los últimos» y «Creado hace más de»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criado nos últimos e criado há mais de não podem ser definidos ao mesmo tempo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è possibile impostare sia 'Creato entro' che 'Creato da più di'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нельзя одновременно задать «создано в течение» и «создано старше»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemaakt binnen en gemaakt ouder dan kunnen niet beide worden ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utworzono w ciągu i utworzono dawniej niż nie mogą być ustawione jednocześnie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можна одночасно встановити «Створено протягом» і «Створено більше ніж»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturulan ve oluşturulandan eski aynı anda ayarlanamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đặt đồng thời 'đã tạo trong' và 'đã tạo lâu hơn'."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuat dalam dan dibuat lebih lama dari tidak dapat diatur bersamaan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تعيين كل من \"تم الإنشاء خلال\" و\"تم الإنشاء منذ أكثر من\" معًا."
          }
        }
      }
    },
