    "paywall.direct.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم الدفع في متصفحك. الصق مفتاح الترخيص من صفحة النجاح أو الإيصال لتفعيل Pro على هذا الـ Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung erfolgt in Ihrem Browser. Fügen Sie den Lizenzschlüssel von der Erfolgsseite oder der Quittung ein, um Pro auf diesem Mac zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment opens in your browser. Paste the license key from the success page or receipt to activate Pro on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago se abre en tu navegador. Pega la clave de licencia de la página de éxito o el recibo para activar Pro en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement s'effectue dans votre navigateur. Collez la clé de licence depuis la page de confirmation ou le reçu pour activer Pro sur ce Mac."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran dibuka di browser Anda. Tempelkan kunci lisensi dari halaman sukses atau tanda terima untuk mengaktifkan Pro di Mac ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento si apre nel browser. Incolla la chiave di licenza dalla pagina di successo o dalla ricevuta per attivare Pro su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いはブラウザで開きます。成功ページまたは領収書からライセンスキーを貼り付けて、このMacでProをアクティベートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결제는 브라우저에서 진행됩니다. 성공 페이지 또는 영수증에서 라이선스 키를 붙여넣어 이 Mac에서 Pro를 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betaling opent in uw browser. Plak de licentiesleutel van de succespagina of de bon om Pro op deze Mac te activeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatność otwiera się w przeglądarce. Wklej klucz licencyjny ze strony sukcesu lub paragonu, aby aktywować Pro na tym Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagamento abre no seu navegador. Cole a chave de licença da página de sucesso ou do recibo para ativar o Pro neste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата открывается в вашем браузере. Вставьте лицензионный ключ со страницы успеха или из чека, чтобы активировать Pro на этом Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödeme tarayıcınızda açılır. Bu Mac'te Pro'yu etkinleştirmek için başarı sayfasındaki veya makbuzdaki lisans anahtarını yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата відкривається у вашому браузері. Вставте ліцензійний ключ зі сторінки успіху або квитанції, щоб активувати Pro на цьому Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanh toán mở trong trình duyệt của bạn. Dán khóa bản quyền từ trang thành công hoặc biên lai để kích hoạt Pro trên máy Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支付会在浏览器打开。完成后粘贴成功页或收据里的授权码，即可在这台 Mac 激活 Pro。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款將在瀏覽器中開啟。請從成功頁面或收據中貼上授權金鑰，以在此 Mac 上啟用 Pro。"
          }
        }
      }
    },
