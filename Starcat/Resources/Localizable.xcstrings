    "settings.mcp.agentSetup.cliPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Please install and verify the official Starcat CLI from %1$@. Prefer Homebrew on macOS or Linux (`brew tap dong4j/starcat-cli && brew install starcat`); otherwise use the official Release installer for this platform. Then run `starcat doctor --json`. If it is not paired, ask me to copy one-time pairing instructions from Starcat." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请从 %1$@ 安装并验证官方 Starcat CLI。macOS 或 Linux 优先使用 Homebrew（`brew tap dong4j/starcat-cli && brew install starcat`），其他情况使用适合当前平台的官方 Release 安装脚本。然后运行 `starcat doctor --json`；如果尚未配对，请让我从 Starcat 复制一次性配对说明。" } }
      }
    },
