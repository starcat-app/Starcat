    "rag.workspace.debug.clear.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى حذف آثار تصحيح RAG في الذاكرة وملفات JSON المحفوظة بشكل دائم للمحادثة الحالية. لا يحذف الرسائل أو فهرس قاعدة المعرفة أو بيانات المستودع أو بيانات التصحيح من المحادثات الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht dauerhaft die RAG-Debug-Traces im Speicher und gespeicherte Debug-JSON-Dateien für die aktuelle Unterhaltung. Es löscht keine Nachrichten, den Wissensdatenbank-Index, Repository-Daten oder Debug-Daten aus anderen Unterhaltungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes the RAG debug traces in memory and saved Debug JSON files for the current conversation. It does not delete messages, the knowledge base index, repository data, or debug data from other conversations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente los rastros de depuración RAG en memoria y los archivos JSON de depuración guardados para la conversación actual. No elimina mensajes, el índice de la base de conocimiento, datos del repositorio ni datos de depuración de otras conversaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement les traces de débogage RAG en mémoire et les fichiers JSON de débogage sauvegardés pour la conversation en cours. Cela ne supprime pas les messages, l'index de la base de connaissances, les données du dépôt ni les données de débogage des autres conversations."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus permanen jejak debug RAG di memori dan file Debug JSON yang tersimpan untuk percakapan saat ini. Ini tidak menghapus pesan, indeks basis pengetahuan, data repositori, atau data debug dari percakapan lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione elimina definitivamente le tracce di debug RAG in memoria e i file JSON di debug salvati per la conversazione corrente. Non elimina messaggi, l'indice della knowledge base, i dati del repository o i dati di debug di altre conversazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、現在の会話のRAGデバッグトレース（メモリ内）と保存されたデバッグJSONファイルが完全に削除されます。メッセージ、ナレッジベースインデックス、リポジトリデータ、他の会話のデバッグデータは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 대화의 메모리 내 RAG 디버그 추적과 저장된 Debug JSON 파일을 영구 삭제합니다. 메시지, 지식 베이스 인덱스, 저장소 데이터 또는 다른 대화의 디버그 데이터는 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de RAG-debugtraces in het geheugen en opgeslagen Debug JSON-bestanden voor het huidige gesprek permanent verwijderd. Berichten, de kennisbankindex, repositorygegevens of debuggegevens van andere gesprekken worden niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie śladów debugowania RAG w pamięci i zapisanych plików JSON debugowania dla bieżącej rozmowy. Nie usuwa wiadomości, indeksu bazy wiedzy, danych repozytorium ani danych debugowania z innych rozmów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui permanentemente os rastros de depuração RAG na memória e os arquivos JSON de depuração salvos para a conversa atual. Não exclui mensagens, o índice da base de conhecimento, dados do repositório ou dados de depuração de outras conversas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это навсегда удалит отладочные трассировки RAG в памяти и сохранённые файлы Debug JSON для текущего разговора. Сообщения, индекс базы знаний, данные репозитория и отладочные данные других разговоров не будут затронуты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, geçerli konuşma için bellekteki RAG hata ayıklama izlerini ve kaydedilmiş Debug JSON dosyalarını kalıcı olarak siler. Mesajları, bilgi tabanı dizinini, depo verilerini veya diğer konuşmalardaki hata ayıklama verilerini silmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це остаточно видаляє трасування налагодження RAG у пам'яті та збережені файли Debug JSON для поточної розмови. Це не видаляє повідомлення, індекс бази знань, дані репозиторію або дані налагодження з інших розмов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa vĩnh viễn các dấu vết gỡ lỗi RAG trong bộ nhớ và các tệp JSON gỡ lỗi đã lưu cho hội thoại hiện tại. Nó không xóa tin nhắn, chỉ mục cơ sở tri thức, dữ liệu kho lưu trữ hoặc dữ liệu gỡ lỗi từ các hội thoại khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会永久删除当前会话的内存 RAG 调试轨迹和已保存的 Debug JSON 文件。不会删除对话消息、知识库索引、仓库数据或其他会话的调试数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會永久刪除目前會話的記憶體 RAG 調試軌跡和已儲存的 Debug JSON 檔案。不會刪除對話訊息、知識庫索引、倉庫資料或其他會話的調試資料。"
          }
        }
      }
    },
