    "settings.pro.direct.updates.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعد التنزيل التلقائي التحديثات في الخلفية. قد يطلب Sparkle التأكيد قبل التثبيت أو إعادة التشغيل."
