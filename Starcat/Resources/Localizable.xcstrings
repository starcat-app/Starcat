        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tamamlanamadı çünkü %@ beklenmeyen bir yanıt döndürdü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
