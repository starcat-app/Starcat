    "rag.workspace.error.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ ما أثناء التحدث إلى قاعدة المعرفة. يرجى المحاولة مرة أخرى بعد قليل. إذا استمر الحدوث، فانقر على ملاحظات وأخبرنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Kommunikation mit der Wissensdatenbank ist ein Fehler aufgetreten. Bitte versuchen Sie es in einem Moment erneut. Falls es weiterhin auftritt, tippen Sie auf „Feedback“ und teilen Sie uns dies mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong while talking to the knowledge base. Please try again in a moment. If it keeps happening, tap Feedback and tell us."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal al comunicarse con la base de conocimiento. Intente de nuevo en un momento. Si sigue ocurriendo, toque Comentarios y díganos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu lors de la communication avec la base de connaissances. Veuillez réessayer dans un instant. Si cela persiste, appuyez sur Commentaires et dites-le nous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjadi kesalahan saat berkomunikasi dengan basis pengetahuan. Silakan coba lagi sebentar. Jika terus terjadi, ketuk Umpan Balik dan beri tahu kami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa è andato storto durante la comunicazione con la knowledge base. Riprova tra un momento. Se continua, tocca Feedback e diccelo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナレッジベースとの通信中に問題が発生しました。しばらくしてからもう一度お試しください。問題が続く場合は、フィードバックをタップしてお知らせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지식 베이스와 통신하는 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요. 계속 발생하면 피드백을 눌러 알려주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is iets misgegaan tijdens het communiceren met de kennisbank. Probeer het later opnieuw. Als het blijft gebeuren, tik op Feedback en laat het ons weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś poszło nie tak podczas komunikacji z bazą wiedzy. Spróbuj ponownie za chwilę. Jeśli problem będzie się powtarzał, kliknij „Opinia” i powiedz nam o tym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo deu errado ao conversar com a base de conhecimento. Tente novamente em instantes. Se persistir, toque em Feedback e nos avise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то пошло не так при обращении к базе знаний. Пожалуйста, повторите попытку через некоторое время. Если это повторяется, нажмите «Обратная связь» и сообщите нам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgi tabanıyla konuşurken bir şeyler ters gitti. Lütfen bir süre sonra tekrar deneyin. Devam ederse, Geri Bildirim'e dokunun ve bize bildirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось пішло не так під час спілкування з базою знань. Будь ласка, спробуйте ще раз за хвилину. Якщо це повторюється, натисніть «Зворотний зв'язок» і повідомте нам."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra lỗi khi liên lạc với cơ sở tri thức. Vui lòng thử lại sau. Nếu vẫn tiếp diễn, hãy nhấn Phản hồi và cho chúng tôi biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向知识库提问时出了点问题，请稍后再试。若反复出现，可点「反馈」告诉我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向知識庫提問時出了點問題，請稍後再試。若反覆出現，可點「回饋」告訴我們。"
          }
        }
      }
    },
    "rag.workspace.error.network.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من اتصالك بالشبكة وحالة الموفر، ثم حاول مرة أخرى. لا يزال سؤالك محفوظًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Ihre Netzwerkverbindung und den Status des Anbieters und versuchen Sie es erneut. Ihre Frage bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your network connection and the provider status, then try again. Your question is still preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique su conexión de red y el estado del proveedor, luego intente de nuevo. Su pregunta aún se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre connexion réseau et l'état du fournisseur, puis réessayez. Votre question est toujours conservée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa koneksi jaringan Anda dan status penyedia, lalu coba lagi. Pertanyaan Anda tetap tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione di rete e lo stato del provider, poi riprova. La tua domanda è ancora conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続とプロバイダーの状態を確認してから再試行してください。質問内容は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 연결과 제공자 상태를 확인한 후 다시 시도하세요. 질문은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je netwerkverbinding en de providerstatus en probeer het opnieuw. Je vraag blijft behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź połączenie sieciowe i status dostawcy, a następnie spróbuj ponownie. Twoje pytanie jest nadal zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua conexão de rede e o status do provedor e tente novamente. Sua pergunta ainda está preservada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте сетевое подключение и статус провайдера, затем повторите попытку. Ваш вопрос сохранён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ bağlantınızı ve sağlayıcı durumunu kontrol edin, ardından tekrar deneyin. Sorunuz hâlâ korunuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте підключення до мережі та статус постачальника, потім повторіть спробу. Ваше запитання збережено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra kết nối mạng và trạng thái nhà cung cấp, sau đó thử lại. Câu hỏi của bạn vẫn được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络和服务状态后再试；你的问题已保留。"
          }
