    "repoHealth.rules.missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missing signals use conservative defaults, so a partial report may score lower than a fully indexed project."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺失信号会使用保守默认值，因此部分数据缺失的报告分数可能低于完整收录项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺失訊號會使用保守預設值，因此部分資料缺失的報告分數可能低於完整收錄的專案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欠落したシグナルには控えめなデフォルトが適用されるため、部分的なレポートは完全にインデックスされたプロジェクトよりも低いスコアになる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누락된 신호는 보수적 기본값을 사용하므로, 부분 보고서는 완전히 색인된 프로젝트보다 점수가 낮을 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlende Signale verwenden konservative Standardwerte, daher kann ein unvollständiger Bericht niedriger bewertet werden als ein vollständig indexiertes Projekt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signaux manquants utilisent des valeurs par défaut prudentes, donc un rapport partiel peut avoir un score inférieur à celui d'un projet entièrement indexé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las señales faltantes usan valores conservadores predeterminados, por lo que un informe parcial puede puntuar más bajo que un proyecto completamente indexado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinais ausentes usam padrões conservadores, então um relatório parcial pode ter pontuação menor que um projeto totalmente indexado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnali mancanti usano valori predefiniti conservativi, quindi un report parziale può avere un punteggio inferiore rispetto a un progetto completamente indicizzato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсутствующие сигналы заменяются консервативными значениями по умолчанию, поэтому частичный отчёт может иметь более низкую оценку, чем полностью проиндексированный проект."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontbrekende signalen gebruiken conservatieve standaarden, dus een gedeeltelijk rapport kan lager scoren dan een volledig geïndexeerd project."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakujące sygnały są zastępowane konserwatywnymi wartościami domyślnymi, więc częściowy raport może mieć niższy wynik niż w pełni indeksowany projekt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відсутні сигнали використовують консервативні значення, тому частковий звіт може мати нижчу оцінку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksik sinyaller varsayılan muhafazakâr değerleri kullanır, bu nedenle kısmi bir rapor tam indekslenmiş bir projeden daha düşük puan alabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tín hiệu thiếu sẽ sử dụng giá trị mặc định thận trọng, do đó báo cáo một phần có thể có điểm thấp hơn dự án được lập chỉ mục đầy đủ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinyal yang hilang menggunakan default konservatif, sehingga laporan parsial mungkin mendapat skor lebih rendah daripada proyek yang terindeks penuh."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم الإشارات المفقودة الإعدادات الافتراضية المتحفظة، لذا قد يسجل التقرير الجزئي أقل من مشروع مفهرس بالكامل."
          }
        }
      }
    },
