    "rag.workspace.debug.retrieval.funnel.rankingFormat" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتيب الأجزاء: %1$lld جزءًا فريدًا؛ %2$lld مستبعدة بواسطة حد المستودع، %3$lld بواسطة الحد الإجمالي، و%4$lld بواسطة حد درجة الاسترجاع المجمعة."
