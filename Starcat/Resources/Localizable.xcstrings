    "settings.general.interfaceScale.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضبط حجم النص الخاص بـ Starcat. ينطبق حاليًا على مساحة عمل الوكيل أولاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Starcat-spezifische Textgröße an. Gilt derzeit zuerst für den Agent-Arbeitsbereich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust Starcat-specific text size. Currently applies to the Agent workspace first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el tamaño del texto específico de Starcat. Actualmente se aplica primero al espacio de trabajo del Agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster la taille du texte propre à Starcat. S'applique d'abord à l'espace de travail Agent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan ukuran teks khusus Starcat. Saat ini berlaku untuk ruang kerja Agen terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la dimensione del testo specifica di Starcat. Attualmente si applica principalmente all'area di lavoro Agent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat固有のテキストサイズを調整します。現在は主にエージェントワークスペースに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 특정 텍스트 크기를 조정합니다. 현재는 에이전트 작업 공간에 먼저 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de Starcat-specifieke tekstgrootte aan. Dit is momenteel van toepassing op de Agent-werkruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj rozmiar tekstu specyficzny dla Starcat. Obecnie dotyczy przede wszystkim obszaru roboczego Agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
