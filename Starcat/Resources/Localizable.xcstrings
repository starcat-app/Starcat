    "agent.definition.overlapScan.defaultPrompt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan my starred repositories, find groups with overlapping functionality, and only give suggestions without making changes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描我已 star 的仓库，找出功能重叠的项目组，先给建议，不要自动修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描我 star 的倉庫，找出功能重疊的群組，只給建議，不要自動修改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スターを付けたリポジトリをスキャンし、機能が重複しているグループを見つけて、変更は行わずに提案のみを行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 별표 표시한 저장소를 스캔하여 중복 기능이 있는 그룹을 찾고, 변경 없이 제안만 제공합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine markierten Repositories scannen, Gruppen mit überlappender Funktionalität finden und nur Vorschläge ohne Änderungen geben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
