    "rag.workspace.state.noCandidates" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No repositories match the current filters. Remove a condition or select a different repository."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
