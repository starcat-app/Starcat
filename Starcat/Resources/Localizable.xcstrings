    "onboarding.step6.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم مساحة عمل الوكيل للمهام الأطول: يمكن لـ Starcat تحضير السياق، وإظهار كل خطوة، واستدعاء الأدوات، والاحتفاظ بالمخرجات المُنشأة في مكان واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie den Agent-Arbeitsbereich für längere Aufgaben: Starcat kann Kontext vorbereiten, jeden Schritt anzeigen, Werkzeuge aufrufen und generierte Artefakte an einem Ort aufbewahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Agent workspace for longer tasks: Starcat can prepare context, show each step, call tools, and keep generated artifacts in one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el espacio de trabajo del Agente para tareas más largas: Starcat puede preparar contexto, mostrar cada paso, llamar herramientas y mantener los artefactos generados en un solo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l'espace de travail Agent pour des tâches plus longues : Starcat peut préparer le contexte, montrer chaque étape, appeler des outils et conserver les artefacts générés au même endroit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan ruang kerja Agen untuk tugas yang lebih panjang: Starcat dapat menyiapkan konteks, menunjukkan setiap langkah, memanggil alat, dan menyimpan artefak yang dihasilkan di satu tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lo spazio di lavoro Agente per attività più lunghe: Starcat può preparare il contesto, mostrare ogni passaggio, chiamare strumenti e mantenere gli artefatti generati in un unico posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントワークスペースを長時間のタスクに使用：Starcatがコンテキストを準備し、各ステップを表示し、ツールを呼び出し、生成されたアーティファクトを一箇所に保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 작업 공간을 사용하여 긴 작업을 처리하세요: Starcat이 컨텍스트를 준비하고, 각 단계를 보여주며, 도구를 호출하고, 생성된 아티팩트를 한 곳에 보관합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de Agent-werkruimte voor langere taken: Starcat kan context voorbereiden, elke stap tonen, tools aanroepen en gegenereerde artefacten op één plek bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj obszaru roboczego Agenta do dłuższych zadań: Starcat może przygotować kontekst, pokazać każdy krok, wywołać narzędzia i przechowywać wygenerowane artefakty w jednym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o espaço de trabalho do Agente para tarefas mais longas: o Starcat pode preparar o contexto, mostrar cada etapa, chamar ferramentas e manter os artefatos gerados em um só lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте рабочее пространство агента для длительных задач: Starcat может подготовить контекст, показывать каждый шаг, вызывать инструменты и сохранять созданные артефакты в одном месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha uzun görevler için Ajan çalışma alanını kullanın: Starcat bağlamı hazırlayabilir, her adımı gösterebilir, araçları çağırabilir ve oluşturulan yapıtları tek bir yerde tutabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте робочий простір агента для тривалих завдань: Starcat може підготувати контекст, показати кожен крок, викликати інструменти та зберігати створені артефакти в одному місці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng không gian làm việc Agent cho các tác vụ dài hơn: Starcat có thể chuẩn bị ngữ cảnh, hiển thị từng bước, gọi công cụ và giữ các tạo phẩm ở một nơi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把更长的任务交给 Agent 工作台：Starcat 会准备上下文、展示步骤、调用工具，并集中保留生成的产物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把更長的任務交給 Agent 工作台：Starcat 會準備上下文、展示步驟、呼叫工具，並集中保留生成的產物。"
          }
        }
      }
    },
