    "settings.storage.recommendation.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتائج المستودعات المشابهة المخزنة مؤقتًا لكل مستودع (مدة الصلاحية 7 أيام عندما تكون غير فارغة، ساعة واحدة عندما تكون فارغة)."
