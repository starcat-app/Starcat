    "rag.workspace.context.budget.help.footnote" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعداد الرموز هي تقديرات محلية لحدود الميزانية، وليست فواتير دقيقة من المزود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token-Zahlen sind lokale Schätzungen für Budgetgrenzen, keine exakte Anbieterabrechnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token counts are local estimates for budget boundaries, not exact provider billing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recuentos de tokens son estimaciones locales para los límites del presupuesto, no la facturación exacta del proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes de jetons sont des estimations locales pour les limites budgétaires, pas la facturation exacte du fournisseur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitungan token adalah perkiraan lokal untuk batas anggaran, bukan penagihan penyedia yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I conteggi dei token sono stime locali per i limiti di budget, non la fatturazione esatta del provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークン数は予算境界のローカル推定値であり、プロバイダーの正確な請求額ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰 수는 예산 경계에 대한 로컬 추정치이며, 정확한 제공자 청구 금액이 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokentellingen zijn lokale schattingen voor budgetgrenzen, niet exacte providerfacturering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczby tokenów to lokalne szacunki granic budżetu, a nie dokładne rozliczenia dostawcy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contagens de tokens são estimativas locais para limites de orçamento, não o faturamento exato do provedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество токенов — это локальные оценки для границ бюджета, а не точный биллинг провайдера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token sayıları, bütçe sınırları için yerel tahminlerdir, kesin sağlayıcı faturalaması değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість токенів — це локальні оцінки для меж бюджету, а не точний розрахунок постачальника."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lượng token là ước tính cục bộ cho ranh giới ngân sách, không phải hóa đơn chính xác của nhà cung cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 token 均为本地估算，用于预算边界判断，不代表 Provider 精确计费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 token 均為本地估算，用於預算邊界判斷，不代表 Provider 精確計費。"
          }
        }
      }
    },
