    "rag.workspace.error.attachment.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the attachments or choose a supported, readable file, then ask again. Your question is preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请移除附件或换用可读取的支持文件后再问；原问题已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請移除附件或換用可讀取的支援檔案後再問；原問題已保留。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルを削除するか、サポートされている読み取り可能なファイルを選択してから再度質問してください。質問内容は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첨부 파일을 제거하거나 지원되는 읽기 가능한 파일을 선택한 후 다시 질문하세요. 질문은 유지됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernen Sie die Anhänge oder wählen Sie eine unterstützte, lesbare Datei und fragen Sie erneut. Ihre Frage bleibt erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez les pièces jointes ou choisissez un fichier pris en charge et lisible, puis posez à nouveau la question. Votre question est conservée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimine los archivos adjuntos o elija un archivo compatible y legible, luego vuelva a preguntar. Su pregunta se conserva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remova os anexos ou escolha um arquivo compatível e legível e pergunte novamente. Sua pergunta foi preservada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi gli allegati o scegli un file supportato e leggibile, poi chiedi di nuovo. La tua domanda è conservata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалите вложения или выберите поддерживаемый читаемый файл, затем задайте вопрос снова. Ваш вопрос сохранён."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder de bijlagen of kies een ondersteund, leesbaar bestand en stel de vraag opnieuw. Je vraag blijft behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń załączniki lub wybierz obsługiwany, czytelny plik, a następnie zapytaj ponownie. Twoje pytanie zostało zachowane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаліть вкладення або виберіть підтримуваний файл, який можна прочитати, і запитайте знову. Ваше запитання збережено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekleri kaldırın veya desteklenen, okunabilir bir dosya seçin, ardından tekrar sorun. Sorunuz korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa các tệp đính kèm hoặc chọn một tệp được hỗ trợ, có thể đọc được, sau đó hỏi lại. Câu hỏi của bạn được giữ nguyên."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus lampiran atau pilih file yang didukung dan dapat dibaca, lalu tanyakan lagi. Pertanyaan Anda tetap tersimpan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
