    "ai.assistant.summary.empty.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Project Context analyzes the repository's code structure during summary generation to improve accuracy. Code is prepared only after you click Generate Summary."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启项目上下文后，生成摘要时会分析仓库代码结构，帮助 AI 更准确地理解项目；相关代码仅在点击「生成摘要」后准备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟專案上下文後，生成摘要時會分析倉庫程式碼結構，幫助 AI 更準確地理解專案；相關程式碼僅在點擊「生成摘要」後準備。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、プロジェクトコンテキストはサマリー生成時にリポジトリのコード構造を分析し、精度を向上させます。コードは「サマリーを生成」をクリックした後にのみ準備されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 프로젝트 컨텍스트가 요약 생성 중에 저장소의 코드 구조를 분석하여 정확도를 높입니다. 코드는 '요약 생성'을 클릭한 후에만 준비됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, analysiert der Projektkontext während der Zusammenfassung die Codestruktur des Repositorys, um die Genauigkeit zu verbessern. Code wird erst nach Klicken auf „Zusammenfassung generieren“ vorbereitet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'il est activé, le contexte du projet analyse la structure du code du dépôt pendant la génération du résumé pour améliorer la précision. Le code est préparé uniquement après avoir cliqué sur Générer le résumé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, el Contexto del proyecto analiza la estructura del código del repositorio durante la generación del resumen para mejorar la precisión. El código se prepara solo después de hacer clic en Generar resumen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o Contexto do Projeto analisa a estrutura do código do repositório durante a geração do resumo para melhorar a precisão. O código é preparado somente após clicar em Gerar Resumo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivato, il Contesto Progetto analizza la struttura del codice del repository durante la generazione del riepilogo per migliorare la precisione. Il codice viene preparato solo dopo aver cliccato Genera Riepilogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении контекст проекта анализирует структуру кода репозитория во время генерации сводки для повышения точности. Код подготавливается только после нажатия «Сгенерировать сводку»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld analyseert Projectcontext de codestructuur van de repository tijdens het genereren van de samenvatting voor een hogere nauwkeurigheid. Code wordt pas voorbereid nadat u op 'Samenvatting genereren' klikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu, Kontekst projektu analizuje strukturę kodu repozytorium podczas generowania podsumowania, aby zwiększyć dokładność. Kod jest przygotowywany dopiero po kliknięciu Generuj podsumowanie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо увімкнено, контекст проєкту аналізує структуру коду репозиторію під час генерації підсумку для підвищення точності. Код готується лише після натискання «Згенерувати підсумок»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, Proje Bağlamı özet oluşturma sırasında deponun kod yapısını analiz ederek doğruluğu artırır. Kod yalnızca Özet Oluştur'a tıkladıktan sonra hazırlanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được bật, Ngữ cảnh dự án sẽ phân tích cấu trúc mã của kho lưu trữ trong quá trình tạo tóm tắt để cải thiện độ chính xác. Mã chỉ được chuẩn bị sau khi bạn nhấp vào Tạo Tóm tắt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
