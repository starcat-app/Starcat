    "agent.workspace.confirmation.placeholder" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a run needs to write tags, status, or unstar, confirmation will appear here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要写入标签、状态或取消 star 时，会在这里等待你确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當執行需要寫入標籤、狀態或取消加星號時，確認訊息會顯示在此處。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中にタグ、ステータスの書き込み、またはスター解除が必要な場合、確認がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 시 태그, 상태 또는 별표 취소를 작성해야 하는 경우 여기에 확인이 표시됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Ausführung Tags, Status oder Entmarkierung schreiben muss, erscheint hier die Bestätigung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'une exécution doit écrire des étiquettes, un statut ou retirer une étoile, la confirmation apparaîtra ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando una ejecución necesite escribir etiquetas, estado o dejar de destacar, la confirmación aparecerá aquí."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma execução precisar escrever tags, status ou desfavoritar, a confirmação aparecerá aqui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un'esecuzione deve scrivere tag, stato o rimuovere la stella, la conferma apparirà qui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда выполнение требует записи тегов, статуса или снятия звёзд, здесь появится подтверждение."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer een uitvoering tags, status of ontmarkering moet schrijven, verschijnt hier bevestiging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy uruchomienie wymaga zapisania tagów, statusu lub usunięcia gwiazdki, potwierdzenie pojawi się tutaj."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли запуск потребує запису тегів, статусу або видалення зірочки, підтвердження з'явиться тут."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir çalıştırma etiket, durum yazma veya yıldız kaldırma gerektirdiğinde onay burada görünecektir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi một lần chạy cần ghi thẻ, trạng thái hoặc bỏ gắn sao, xác nhận sẽ xuất hiện ở đây."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika eksekusi perlu menulis tag, status, atau menghapus bintang, konfirmasi akan muncul di sini."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يحتاج التشغيل إلى كتابة وسوم أو حالة أو إلغاء تنجيم، سيظهر التأكيد هنا."
          }
        }
      }
    },
