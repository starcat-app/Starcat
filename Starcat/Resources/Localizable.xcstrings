    "settings.ai.prompt.placeholders.footnote.translation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: {targetLanguage} must appear in either prompt; the source-data placeholder for the selected mode belongs in the User Prompt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说明：{targetLanguage} 必须出现在任一 Prompt 中；当前模式的源数据占位符应放在 User Prompt。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說明：{targetLanguage} 必須出現在任一 Prompt 中；當前模式的源數據佔位符應放在 User Prompt。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注：{targetLanguage} はどちらかのプロンプトに含める必要があります。選択したモードのソースデータプレースホルダーはユーザープロンプトに属します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: {targetLanguage}는 두 프롬프트 중 하나에 나타나야 합니다. 선택한 모드의 소스 데이터 플레이스홀더는 사용자 프롬프트에 속합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: {targetLanguage} muss in einem der Prompts vorkommen; der Quelldaten-Platzhalter für den ausgewählten Modus gehört in den Benutzer-Prompt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : {targetLanguage} doit apparaître dans l'un des prompts ; l'espace réservé des données source pour le mode sélectionné appartient au prompt utilisateur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: {targetLanguage} debe aparecer en cualquiera de los prompts; el marcador de datos fuente para el modo seleccionado pertenece al Prompt de Usuario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: {targetLanguage} deve aparecer em um dos prompts; o placeholder de dados de origem para o modo selecionado pertence ao Prompt do Usuário."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: {targetLanguage} deve apparire in uno dei due prompt; il segnaposto dei dati sorgente per la modalità selezionata appartiene al Prompt Utente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: {targetLanguage} должен присутствовать в одном из запросов; заполнитель исходных данных для выбранного режима должен находиться в пользовательском запросе."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: {targetLanguage} moet in een van beide prompts voorkomen; de placeholder voor de bron-data van de geselecteerde modus hoort in de gebruikersprompt."
          }
        },
        "pl" : {
