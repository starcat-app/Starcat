    "sharecard.action.shareToX.help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ البطاقة إلى الحافظة وافتح X.com — الصق الصورة في تغريدتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte in die Zwischenablage kopieren und X.com öffnen – füge das Bild in deinen Tweet ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the card to clipboard and open X.com — paste the image into your tweet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la tarjeta al portapapeles y abre X.com — pega la imagen en tu tuit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier la carte dans le presse-papiers et ouvrir X.com — collez l'image dans votre tweet."
