    "explore.help.newReleases.rule.release" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستثنى المسودات، والإصدارات التجريبية، والإصدارات بدون أصول قابلة للتنزيل، والمستودعات المؤرشفة، والتفرعات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwürfe, Vorabversionen, Releases ohne herunterladbare Dateien, archivierte Repositories und Forks sind ausgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drafts, prereleases, releases without downloadable assets, archived repositories, and forks are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se excluyen borradores, versiones previas, versiones sin archivos descargables, repositorios archivados y bifurcaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les brouillons, préversions, versions sans ressources téléchargeables, dépôts archivés et forks sont exclus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draf, prarilis, rilis tanpa aset yang dapat diunduh, repositori yang diarsipkan, dan fork tidak disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bozze, prerelease, release senza asset scaricabili, repository archiviati e fork sono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書き、プレリリース、ダウンロード可能なアセットのないリリース、アーカイブされたリポジトリ、フォークは除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안, 사전 릴리스, 다운로드 가능한 자산이 없는 릴리스, 보관된 저장소 및 포크는 제외됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concepten, prereleases, releases zonder downloadbare bestanden, gearchiveerde repositories en forks worden uitgesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersje robocze, wydania wstępne, wydania bez plików do pobrania, zarchiwizowane repozytoria i forki są wykluczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rascunhos, pré-lançamentos, releases sem ativos para download, repositórios arquivados e forks são excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Черновики, предварительные версии, релизы без загружаемых файлов, архивированные репозитории и форки исключаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taslaklar, ön sürümler, indirilebilir varlıkları olmayan sürümler, arşivlenmiş depolar ve çatallar hariç tutulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чернетки, попередні версії, релізи без завантажуваних файлів, архівовані репозиторії та форки виключені."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản nháp, bản phát hành trước, bản phát hành không có tài sản tải xuống, kho lưu trữ đã lưu trữ và fork đều bị loại trừ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
