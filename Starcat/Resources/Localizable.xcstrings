          }
        }
      }
    },
    "settings.pro.benefit.release.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch more repositories for new Releases, with in-app signals and optional notifications so important version bumps are harder to miss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可追踪更多仓库的 Release 更新，应用内信号与可选通知一起用，重要版本发布更不容易漏掉。"
          }
        }
      }
    },
    "settings.pro.benefit.release.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release tracking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Release 追踪"
          }
        }
      }
    },
    "settings.pro.benefit.repoContext.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock RepoContextPacker, CodeFlow, and codebase-context workflows so AI answers stay grounded in the actual source tree of the repo you are viewing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 RepoContextPacker、CodeFlow 与仓库上下文工作流，让 AI 回答贴着当前仓库的真实源码结构展开。"
          }
        }
      }
    },
    "settings.pro.benefit.repoContext.title": {
      "extractionState": "manual",
      "localizations": {
