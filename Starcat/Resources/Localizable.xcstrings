    "settings.mcp.localWrites.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow local MCP tools to write notes, statuses, and tags. This never performs GitHub remote star/unstar actions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许本地 MCP 工具写入笔记、状态和标签。此开关不会执行 GitHub 远端 star/unstar 操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許本地 MCP 工具寫入筆記、狀態和標籤。此操作絕不會執行 GitHub 遠端 star/unstar 動作。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルMCPツールがノート、ステータス、タグを書き込むことを許可します。これはGitHub上のスター/アンスター操作を決して実行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 MCP 도구가 메모, 상태 및 태그를 쓸 수 있도록 허용합니다. 이는 GitHub 원격 별표/별표 해제 작업을 수행하지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie lokalen MCP-Tools, Notizen, Status und Tags zu schreiben. Dies führt niemals GitHub-Fernaktionen wie Star/Unstar aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les outils MCP locaux à écrire des notes, des statuts et des tags. Cela n'effectue jamais d'actions d'étoile/désétoile à distance sur GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que las herramientas MCP locales escriban notas, estados y etiquetas. Esto nunca realiza acciones de estrella/desestrella en GitHub remoto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que ferramentas MCP locais gravem notas, status e etiquetas. Isso nunca executa ações remotas de estrelar/desestrelar no GitHub."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti agli strumenti MCP locali di scrivere note, stati e tag. Questo non esegue mai azioni remote di stella/non stella su GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить локальным MCP-инструментам записывать заметки, статусы и теги. Это никогда не выполняет удалённые действия star/unstar на GitHub."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale MCP-tools toestaan om notities, statussen en tags te schrijven. Dit voert nooit GitHub-verre ster-/ontster-acties uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól lokalnym narzędziom MCP na zapisywanie notatek, statusów i tagów. To nigdy nie wykonuje zdalnych akcji star/unstar w GitHub."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити локальним MCP-інструментам записувати нотатки, статуси та теги. Це ніколи не виконує дії зірок/анзірк GitHub віддалено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel MCP araçlarının not, durum ve etiket yazmasına izin ver. Bu asla GitHub uzak yıldız/yıldız kaldırma işlemleri gerçekleştirmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép các công cụ MCP cục bộ ghi ghi chú, trạng thái và thẻ. Thao tác này không bao giờ thực hiện hành động star/unstar từ xa trên GitHub."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan alat MCP lokal untuk menulis catatan, status, dan tag. Ini tidak pernah melakukan tindakan star/unstar jarak jauh GitHub."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح لأدوات MCP المحلية بكتابة الملاحظات والحالات والعلامات. هذا لا يقوم أبدًا بإجراءات الإضافة/الإزالة عن بعد على GitHub."
          }
        }
      }
    },
