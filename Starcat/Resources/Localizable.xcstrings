    "rag.workspace.inspector.retrievalScore.actualCalculationUnavailable" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الاقتباس الأقدم لا يحتفظ بمدخلات الاسترجاع، لذا لا يمكن إعادة حسابه بدقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses ältere Zitat behält seine Abrufeingaben nicht, daher kann es nicht exakt neu berechnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This older citation does not retain its retrieval inputs, so it cannot be recalculated exactly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cita más antigua no conserva sus entradas de recuperación, por lo que no se puede recalcular exactamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette citation plus ancienne ne conserve pas ses entrées de récupération, elle ne peut donc pas être recalculée exactement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutipan lama ini tidak menyimpan masukan pengambilannya, sehingga tidak dapat dihitung ulang secara tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa citazione più vecchia non conserva i suoi input di recupero, quindi non può essere ricalcolata esattamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この古い引用は検索入力を保持していないため、正確に再計算できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이전 인용은 검색 입력을 보존하지 않으므로 정확히 재계산할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze oudere citatie behoudt de ophaalinvoer niet, dus kan niet exact worden herberekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten starszy cytat nie zachowuje swoich danych wejściowych wyszukiwania, więc nie można go dokładnie przeliczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta citação mais antiga não retém suas entradas de recuperação, portanto não pode ser recalculada exatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта более старая цитата не сохраняет свои входные данные поиска, поэтому её нельзя точно пересчитать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eski alıntı, erişim girdilerini saklamadığı için tam olarak yeniden hesaplanamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це старіше цитування не зберігає вхідні дані пошуку, тому його не можна точно перерахувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trích dẫn cũ này không lưu giữ đầu vào truy xuất, nên không thể tính lại chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该历史引用未保留当时的检索参数，无法精确复算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該歷史引用未保留當時的檢索參數，無法精確複算。"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.cosine" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشابه جيب التمام: التشابه الدلالي الخام بين السؤال وهذا المقطع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosinus-Ähnlichkeit: die rohe semantische Ähnlichkeit zwischen der Frage und diesem Block."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosine similarity: the raw semantic similarity between the question and this chunk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similitud coseno: la similitud semántica bruta entre la pregunta y este fragmento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similarité cosinus : la similarité sémantique brute entre la question et ce fragment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemiripan kosinus: kemiripan semantik mentah antara pertanyaan dan potongan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similarità coseno: la similarità semantica grezza tra la domanda e questo blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コサイン類似度：質問とこのチャンクの生の意味的類似度。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코사인 유사도: 질문과 이 청크 간의 원시 의미 유사도입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosinusovereenkomst: de ruwe semantische gelijkenis tussen de vraag en dit brok."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podobieństwo cosinusowe: surowe podobieństwo semantyczne między pytaniem a tym fragmentem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similaridade de cosseno: a similaridade semântica bruta entre a pergunta e este trecho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Косинусное сходство: необработанное семантическое сходство между вопросом и этим фрагментом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosinüs benzerliği: soru ile bu parça arasındaki ham anlamsal benzerlik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Косинусна подібність: сира семантична подібність між запитанням і цим фрагментом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tương đồng cosine: độ tương đồng ngữ nghĩa thô giữa câu hỏi và đoạn này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余弦相似度：问题与该分片的原始语义相似度。"
