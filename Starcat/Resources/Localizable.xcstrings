          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane z GitHub na żywo wymagają dokładnego zakresu repozytorium. Dodaj @repository i zapytaj ponownie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для живих даних GitHub потрібна точна область репозиторію. Додайте @repository і запитайте знову."
          }
        },
        "tr" : {
          "stringUnit" : {
