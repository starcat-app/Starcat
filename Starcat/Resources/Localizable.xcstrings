    "settings.mcp.enabled.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expose Starcat capabilities to local agents through a Pro-only localhost MCP endpoint."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过仅限 Pro 的 localhost MCP endpoint 向本机 Agent 暴露 Starcat 能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過僅限 Pro 的 localhost MCP 端點向本機 Agent 公開 Starcat 功能。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro専用のlocalhost MCPエンドポイントを通じて、Starcatの機能をローカルエージェントに公開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 전용 로컬호스트 MCP 엔드포인트를 통해 로컬 에이전트에 Starcat 기능을 노출합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat-Fähigkeiten für lokale Agenten über einen Pro-exklusiven localhost MCP-Endpunkt bereitstellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposer les capacités de Starcat aux agents locaux via un point de terminaison MCP localhost réservé aux abonnés Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expone las capacidades de Starcat a agentes locales a través de un endpoint MCP localhost solo para Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expor as capacidades do Starcat a agentes locais por meio de um endpoint MCP localhost exclusivo para Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esponi le capacità di Starcat agli agenti locali tramite un endpoint MCP localhost solo per Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставить возможности Starcat локальным агентам через конечную точку MCP localhost, доступную только в Pro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel Starcat-mogelijkheden beschikbaar voor lokale agents via een alleen-Pro localhost MCP-eindpunt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij możliwości Starcat lokalnym agentom przez punkt końcowy MCP localhost dostępny tylko w wersji Pro."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрити можливості Starcat для локальних агентів через кінцеву точку MCP localhost, доступну лише для Pro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat yeteneklerini yerel aracılara yalnızca Pro'ya özel bir localhost MCP uç noktası aracılığıyla göster."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị khả năng của Starcat cho các tác nhân cục bộ thông qua điểm cuối MCP localhost chỉ dành cho Pro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspos kemampuan Starcat ke agen lokal melalui endpoint MCP localhost khusus Pro."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض إمكانيات Starcat للوكلاء المحليين من خلال نقطة نهاية MCP على localhost حصرية لـ Pro."
          }
        }
      }
    },
