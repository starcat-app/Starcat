    "settings.pro.subtitle.preview" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشترك لفتح ميزات Pro للذكاء الاصطناعي والبحث وتتبع الإصدارات وحدود محلية أعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnieren Sie, um Pro-Funktionen für KI, Suche, Release-Verfolgung und höhere lokale Grenzen freizuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribe to unlock Pro features for AI, search, release tracking, and higher local limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suscríbase para desbloquear funciones Pro para IA, búsqueda, seguimiento de versiones y límites locales más altos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnez-vous pour débloquer les fonctionnalités Pro pour l'IA, la recherche, le suivi des versions et des limites locales plus élevées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlangganan untuk membuka fitur Pro untuk AI, pencarian, pelacakan rilis, dan batas lokal yang lebih tinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbonati per sbloccare le funzionalità Pro per AI, ricerca, monitoraggio delle release e limiti locali più elevati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録して、AI、検索、リリース追跡、およびより高いローカル制限の Pro 機能をアンロックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독하여 AI, 검색, 릴리스 추적 및 로컬 제한 상향 등 Pro 기능을 잠금 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonneer om Pro-functies te ontgrendelen voor AI, zoeken, release-tracking en hogere lokale limieten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrybuj, aby odblokować funkcje Pro dla AI, wyszukiwania, śledzenia wydań i wyższych limitów lokalnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assine para desbloquear recursos Pro de IA, busca, acompanhamento de lançamentos e limites locais maiores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпишитесь, чтобы разблокировать функции Pro для ИИ, поиска, отслеживания релизов и более высоких локальных лимитов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zeka, arama, sürüm takibi ve daha yüksek yerel sınırlar için Pro özelliklerini etkinleştirmek üzere abone olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підпишіться, щоб отримати функції Pro для ШІ, пошуку, відстеження релізів та вищих локальних лімітів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng ký để mở khóa các tính năng Pro cho AI, tìm kiếm, theo dõi bản phát hành và giới hạn cục bộ cao hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅后解锁 AI、搜索、Release 追踪与更高本地额度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱以解鎖 AI、搜尋、版本追蹤及更高的本機限制等 Pro 功能。"
          }
        }
      }
    },
