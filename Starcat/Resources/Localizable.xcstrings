    "explore.help.discover.rule.catalog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starcat combines high-attention repositories, repositories active in the last 30 days, and newer repositories created in the last year."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Starcat 综合收录高关注度、近 30 天活跃，以及近一年出现的新项目。"
          }
        }
      }
    },
    "explore.help.discover.rule.ranking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendations consider recent activity, topic relevance, and platform fit."
          }
