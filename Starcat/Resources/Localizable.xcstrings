    "settings.ai.privacy.notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat does not relay AI requests through any of our servers. Summaries, tag suggestions and semantic search send the minimum repository metadata / README excerpt directly to your selected provider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 不经过自建服务器转发 AI 请求。摘要、推荐标签和语义搜索会把必要的仓库元数据 / README 摘要发送给你选择的 Provider。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 不會透過任何自有伺服器轉發 AI 請求。摘要、標籤建議與語義搜尋會將最少的儲存庫中繼資料/README 摘要直接傳送至你選擇的 Provider。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StarcatはAIリクエストを自社サーバーを経由して中継しません。要約、タグ提案、セマンティック検索は、最小限のリポジトリメタデータ/README抜粋を選択したプロバイダに直接送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat은 당사 서버를 통해 AI 요청을 중계하지 않습니다. 요약, 태그 제안 및 의미 검색은 최소한의 저장소 메타데이터/README 발췌문을 선택한 제공업체에 직접 전송합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat leitet KI-Anfragen nicht über unsere Server weiter. Zusammenfassungen, Tag-Vorschläge und semantische Suche senden die minimalen Repository-Metadaten/README-Auszüge direkt an Ihren ausgewählten Anbieter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat ne relaie pas les requêtes IA via ses serveurs. Les résumés, suggestions d'étiquettes et la recherche sémantique envoient directement les métadonnées minimales du dépôt / un extrait du README à votre fournisseur choisi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat no retransmite solicitudes de IA a través de ninguno de nuestros servidores. Los resúmenes, las sugerencias de etiquetas y la búsqueda semántica envían los metadatos mínimos del repositorio / un extracto del README directamente a tu proveedor seleccionado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starcat não retransmite solicitações de IA por nenhum de nossos servidores. Resumos, sugestões de tags e busca semântica enviam o mínimo de metadados do repositório / trecho do README diretamente ao provedor selecionado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat non inoltra richieste AI attraverso i nostri server. Riepiloghi, suggerimenti di tag e ricerca semantica inviano i metadati minimi del repository / estratto README direttamente al provider selezionato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat не передаёт AI-запросы через свои серверы. Сводки, предложения тегов и семантический поиск отправляют минимальные метаданные репозитория / выдержку из README напрямую выбранному провайдеру."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat stuurt AI-verzoeken niet via onze servers. Samenvattingen, tag-suggesties en semantisch zoeken sturen minimale repository-metadata/README-fragmenten rechtstreeks naar uw geselecteerde provider."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat nie przekazuje żądań AI przez swoje serwery. Podsumowania, sugestie tagów i wyszukiwanie semantyczne wysyłają minimalne metadane repozytorium / fragment README bezpośrednio do wybranego dostawcy."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat не передає AI-запити через власні сервери. Підсумки, пропозиції тегів та семантичний пошук надсилають мінімальні метадані репозиторію / фрагмент README безпосередньо вашому обраному провайдеру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat, AI isteklerini kendi sunucuları üzerinden iletmez. Özetler, etiket önerileri ve anlamsal arama, minimum depo meta verilerini / README alıntısını doğrudan seçtiğiniz sağlayıcıya gönderir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat không chuyển tiếp yêu cầu AI qua bất kỳ máy chủ nào của chúng tôi. Tóm tắt, gợi ý thẻ và tìm kiếm ngữ nghĩa chỉ gửi siêu dữ liệu kho lưu trữ tối thiểu / đoạn trích README trực tiếp đến nhà cung cấp bạn đã chọn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat tidak meneruskan permintaan AI melalui server kami. Ringkasan, saran tag, dan pencarian semantik mengirim metadata repositori minimal / kutipan README langsung ke penyedia yang Anda pilih."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقوم Starcat بتمرير طلبات الذكاء الاصطناعي عبر أي من خوادمنا. الملخصات واقتراحات العلامات والبحث الدلالي ترسل الحد الأدنى من بيانات المستودع / مقتطف README مباشرة إلى مزود الخدمة الذي اخترته."
          }
        }
      }
    },
