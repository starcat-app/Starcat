    "settings.diagnostics.telemetry.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخزين حمولات MetricKit محليًا كملخصات تشخيصية في هذا الإصدار؛ ولا يتم تحميلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit-Nutzlasten werden in dieser Version lokal als Diagnosezusammenfassungen gespeichert; sie werden nicht hochgeladen."
          }
        },
        "en" : {
