    "rag.workspace.retrieval.sources.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مصادر المعرفة التي يمكنها المشاركة في الاسترجاع المحلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie aus, welche Wissensquellen am lokalen Abruf teilnehmen können."
