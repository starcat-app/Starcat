        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先在 GitHub 檢查 Starcat 的組織存取權限。現有通知和已讀狀態會保留，Starcat 只會重設同步位置並重新取得最近 300 條通知。"
          }
        }
      }
