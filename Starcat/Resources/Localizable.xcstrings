    "settings.integration.codeFlow.outputDir.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبديل الدليل ينقل ملفات HTML والبيانات الوصفية الحالية لـ CodeFlow. تبقى ملفات ZIP المصدر المشتركة في حاوية التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Wechseln des Verzeichnisses werden vorhandene CodeFlow-HTML und Metadaten migriert. Die gemeinsamen Quell-ZIPs bleiben im App-Container."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching the directory migrates existing CodeFlow HTML and metadata. The shared source ZIPs remain in the app container."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el directorio migra el HTML y los metadatos existentes de CodeFlow. Los ZIPs de código fuente compartidos permanecen en el contenedor de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de répertoire migre le HTML et les métadonnées CodeFlow existants. Les ZIP sources partagés restent dans le conteneur de l'application."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengganti direktori akan memigrasi HTML dan metadata CodeFlow yang ada. ZIP sumber bersama tetap berada di kontainer aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare directory migra i file HTML e metadati CodeFlow esistenti. Gli ZIP sorgente condivisi rimangono nel contenitore app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディレクトリを切り替えると、既存のCodeFlow HTMLとメタデータが移行されます。共有ソースZIPはアプリコンテナに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디렉토리를 전환하면 기존 CodeFlow HTML 및 메타데이터가 마이그레이션됩니다. 공유 소스 ZIP은 앱 컨테이너에 남아 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wijzigen van de map migreert bestaande CodeFlow-HTML en -metadata. De gedeelde bron-ZIP's blijven in de app-container."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana katalogu migruje istniejące pliki HTML i metadane CodeFlow. Współdzielone archiwa ZIP źródła pozostają w kontenerze aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o diretório migra HTML e metadados existentes do CodeFlow. Os ZIPs de origem compartilhados permanecem no contêiner do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смена папки переносит существующие HTML и метаданные CodeFlow. Общие ZIP-архивы исходников остаются в папке приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizini değiştirmek, mevcut CodeFlow HTML ve meta verilerini taşır. Paylaşılan kaynak ZIP'leri uygulama kapsayıcısında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміна каталогу переносить наявні HTML та метадані CodeFlow. Спільні ZIP-архіви вихідного коду залишаються в контейнері програми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển đổi thư mục sẽ di chuyển HTML và siêu dữ liệu CodeFlow hiện có. Các tệp ZIP nguồn được chia sẻ vẫn nằm trong vùng chứa ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换目录时会迁移现有 CodeFlow HTML 与 metadata；共享源码 ZIP 仍保存在应用容器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換目錄時會遷移現有 CodeFlow HTML 與 metadata；共享原始碼 ZIP 仍保留在應用程式容器中。"
          }
        }
      }
    },
