    "settings.listPreferences.reset.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى مسح خيارات اللغة المحفوظة، والفرز، والتصفية، والقائمة الافتراضية. لن يمسح ذاكرة التخزين المؤقت للمستودعات، أو سجل البحث، أو العلامات، أو الملاحظات، أو حالة قاعدة المعرفة، أو قواعد المجموعات الذكية، أو المسودات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht gespeicherte Sprach-, Sortier-, Filter- und Standardlistenauswahlen. Repository-Cache, Suchverlauf, Tags, Notizen, Wissensdatenbank, intelligente Sammlungsregeln und Entwürfe bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clears saved language, sort, filter, and default list choices. It will not clear repository cache, search history, tags, notes, knowledge base state, smart collection rules, or drafts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra las opciones guardadas de idioma, orden, filtro y lista predeterminada. No borrará la caché del repositorio, el historial de búsqueda, las etiquetas, las notas, el estado de la base de conocimiento, las reglas de colecciones inteligentes ni los borradores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela efface les choix enregistrés de langue, tri, filtre et liste par défaut. Cela n'efface pas le cache du dépôt, l'historique de recherche, les tags, les notes, l'état de la base de connaissances, les règles de collection intelligente ou les brouillons."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus pilihan bahasa, pengurutan, filter, dan daftar default yang tersimpan. Ini tidak akan menghapus cache repositori, riwayat pencarian, tag, catatan, status basis pengetahuan, aturan koleksi pintar, atau draf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione cancella le scelte salvate di lingua, ordinamento, filtro ed elenco predefinito. Non cancellerà la cache del repository, la cronologia delle ricerche, i tag, le note, lo stato della knowledge base, le regole delle raccolte intelligenti o le bozze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された言語、並び替え、フィルター、デフォルトリストの選択をクリアします。リポジトリキャッシュ、検索履歴、タグ、メモ、ナレッジベースの状態、スマートコレクションルール、下書きはクリアしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 언어, 정렬, 필터 및 기본 목록 선택이 지워집니다. 저장소 캐시, 검색 기록, 태그, 메모, 지식 기반 상태, 스마트 컬렉션 규칙 또는 초안은 지워지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden opgeslagen taal-, sorteer-, filter- en standaardlijstkeuzes gewist. De repositorycache, zoekgeschiedenis, tags, notities, kennisbankstatus, slimme verzamelregels of concepten worden niet gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to wyczyszczenie zapisanych ustawień języka, sortowania, filtrowania i domyślnego wyboru listy. Nie wpłynie na pamięć podręczną repozytorium, historię wyszukiwania, tagi, notatki, stan bazy wiedzy, reguły kolekcji inteligentnych ani wersje robocze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso limpa as escolhas salvas de idioma, ordenação, filtro e lista padrão. Não limpará o cache do repositório, histórico de pesquisa, etiquetas, notas, estado da base de conhecimento, regras de coleções inteligentes ou rascunhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это очистит сохранённые настройки языка, сортировки, фильтра и списка по умолчанию. Кеш репозиториев, история поиска, теги, заметки, состояние базы знаний, правила умных коллекций и черновики не будут затронуты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem kaydedilmiş dil, sıralama, filtre ve varsayılan liste seçimlerini temizler. Depo önbelleğini, arama geçmişini, etiketleri, notları, bilgi tabanı durumunu, akıllı koleksiyon kurallarını veya taslakları temizlemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це очищає збережені налаштування мови, сортування, фільтра та вибору списку за замовчуванням. Не впливає на кеш репозиторію, історію пошуку, теги, нотатки, стан бази знань, правила розумних колекцій або чернетки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa các lựa chọn ngôn ngữ, sắp xếp, bộ lọc và danh sách mặc định đã lưu. Sẽ không xóa bộ nhớ đệm kho lưu trữ, lịch sử tìm kiếm, thẻ, ghi chú, trạng thái cơ sở tri thức, quy tắc bộ sưu tập thông minh hoặc bản nháp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除已保存的语言、排序、筛选和默认列表选择，不会清除仓库缓存、搜索历史、标签、笔记、知识库状态、Smart Collection 规则或草稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清除已儲存的語言、排序、篩選和預設列表選擇，不會清除倉庫快取、搜尋記錄、標籤、筆記、知識庫狀態、Smart Collection 規則或草稿。"
          }
        }
      }
    },
