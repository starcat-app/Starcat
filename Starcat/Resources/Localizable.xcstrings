    "rag.workspace.inspector.metadata.help.artifacts.definition.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coverage is calculated from repositories currently in the knowledge base. Only aggregate counts are shown; note and summary content is never exposed here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖率以当前已入库项目为范围。这里只展示聚合数量，不展示笔记或摘要正文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖率以当前已入库项目为范围。这里只展示聚合数量，不展示笔记或摘要正文。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カバレッジは現在ナレッジベースにあるリポジトリから計算されます。集計数のみ表示され、ノートやサマリーの内容はここで公開されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적용 범위는 현재 지식 베이스에 있는 저장소에서 계산됩니다. 집계 수만 표시되며, 노트 및 요약 콘텐츠는 여기에 표시되지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abdeckung wird aus den Repositories berechnet, die sich derzeit in der Wissensdatenbank befinden. Es werden nur aggregierte Zahlen angezeigt; Notiz- und Zusammenfassungsinhalte werden hier nie offengelegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couverture est calculée à partir des dépôts actuellement dans la base de connaissances. Seuls les totaux agrégés sont affichés ; le contenu des notes et des résumés n'est jamais exposé ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cobertura se calcula a partir de los repositorios actualmente en la base de conocimiento. Solo se muestran recuentos agregados; el contenido de notas y resúmenes nunca se expone aquí."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cobertura é calculada a partir dos repositórios atualmente na base de conhecimento. Apenas contagens agregadas são exibidas; o conteúdo de notas e resumos nunca é exposto aqui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copertura è calcolata dai repository attualmente nella knowledge base. Vengono mostrati solo i conteggi aggregati; il contenuto di note e riepiloghi non viene mai esposto qui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Охват рассчитывается по репозиториям, находящимся в базе знаний. Показываются только общие количества; содержимое заметок и сводок здесь никогда не раскрывается."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dekking wordt berekend op basis van repositories die zich momenteel in de kennisbank bevinden. Alleen totale aantallen worden getoond; notitie- en samenvattingsinhoud wordt hier nooit weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrycie jest obliczane na podstawie repozytoriów znajdujących się obecnie w bazie wiedzy. Pokazywane są tylko zagregowane liczby; notatki i podsumowania nie są tutaj ujawniane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покриття розраховується на основі репозиторіїв, які зараз є в базі знань. Показуються лише загальні кількості; вміст нотаток і підсумків ніколи не розкривається."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsam, bilgi tabanındaki depolar üzerinden hesaplanır. Yalnızca toplam sayılar gösterilir; not ve özet içeriği burada asla gösterilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phạm vi phủ được tính từ các kho lưu trữ hiện có trong cơ sở tri thức. Chỉ hiển thị số liệu tổng hợp; nội dung ghi chú và tóm tắt không bao giờ được hiển thị ở đây."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cakupan dihitung dari repositori yang saat ini ada di basis pengetahuan. Hanya jumlah agregat yang ditampilkan; konten catatan dan ringkasan tidak pernah diekspos di sini."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حساب التغطية من المستودعات الموجودة حاليًا في قاعدة المعرفة. يتم عرض الأعداد الإجمالية فقط؛ لا يتم عرض محتوى الملاحظات والملخصات هنا أبدًا."
          }
        }
      }
    },
    "rag.workspace.inspector.metadata.help.artifacts.definition.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do these numbers mean?"
          }
