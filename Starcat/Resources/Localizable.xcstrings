    "about.privacy.whatWeWontDo.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن نبيع المعلومات الشخصية، أو نستخدم الملاحظات المحلية للإعلانات، أو نعيد كتابة اقتراحات الذكاء الاصطناعي تلقائياً إلى بيانات المستخدم دون تأكيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verkaufen keine persönlichen Daten, verwenden keine lokalen Notizen für Werbung und schreiben KI-Vorschläge nicht ohne Bestätigung automatisch in Benutzerdaten zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will not sell personal information, use local notes for advertising, or automatically write AI suggestions back to user data without confirmation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No venderemos información personal, usaremos notas locales para publicidad ni escribiremos automáticamente sugerencias de IA en los datos del usuario sin confirmación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne vendrons pas d'informations personnelles, n'utiliserons pas de notes locales pour la publicité, ni n'écrirons automatiquement des suggestions IA dans les données utilisateur sans confirmation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak akan menjual informasi pribadi, menggunakan catatan lokal untuk iklan, atau secara otomatis menulis saran AI kembali ke data pengguna tanpa konfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non venderemo informazioni personali, non utilizzeremo note locali per pubblicità e non scriveremo automaticamente suggerimenti AI nei dati dell'utente senza conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人情報を販売したり、ローカルノートを広告に使用したり、確認なしにAI提案をユーザーデータに自動書き込みしたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 정보를 판매하지 않으며, 광고에 개인 노트를 사용하지 않으며, 확인 없이 AI 제안을 사용자 데이터에 자동으로 기록하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We zullen geen persoonlijke informatie verkopen, lokale notities gebruiken voor advertenties of automatisch AI-suggesties terugschrijven naar gebruikersgegevens zonder bevestiging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie będziemy sprzedawać danych osobowych, używać lokalnych notatek do reklam ani automatycznie zapisywać sugestii AI do danych użytkownika bez potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não venderemos informações pessoais, usaremos notas locais para publicidade ou escreveremos automaticamente sugestões de IA de volta aos dados do usuário sem confirmação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы не будем продавать личную информацию, использовать локальные заметки для рекламы или автоматически записывать предложения ИИ в пользовательские данные без подтверждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişisel bilgileri satmayacağız, yerel notları reklam için kullanmayacağız veya AI önerilerini onay olmadan kullanıcı verilerine otomatik olarak yazmayacağız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми не продаватимемо особисту інформацію, не використовуватимемо локальні нотатки для реклами та не записуватимемо автоматично пропозиції ШІ в дані користувача без підтвердження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi sẽ không bán thông tin cá nhân, sử dụng ghi chú cục bộ cho quảng cáo hoặc tự động ghi lại các gợi ý AI vào dữ liệu người dùng mà không có xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会出售个人信息，不会把本地笔记用于广告，也不会在未经确认时自动把 AI 建议写回用户数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會出售個人資訊，不會將本地筆記用於廣告，也不會在未經確認時自動將 AI 建議寫回用戶資料。"
          }
        }
      }
    },
