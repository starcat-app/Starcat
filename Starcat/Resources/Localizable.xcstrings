    "onboarding.step2.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح مستودعًا ودع Starcat يساعدك في قراءته: تشرح ملخصات الذكاء الاصطناعي المشروع، ويكشف CodeFlow الهيكل، ويبقى README على بعد نقرة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie ein Repository und lassen Sie Starcat Ihnen beim Lesen helfen: KI-Zusammenfassungen erklären das Projekt, CodeFlow zeigt die Struktur und die README ist nur einen Klick entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a repository and let Starcat help you read it: AI summaries explain the project, CodeFlow reveals structure, and README stays one click away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un repositorio y deja que Starcat te ayude a leerlo: los resúmenes de IA explican el proyecto, CodeFlow revela la estructura y el README está a un clic de distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez un dépôt et laissez Starcat vous aider à le lire : les résumés IA expliquent le projet, CodeFlow révèle la structure et le README reste à un clic."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka repositori dan biarkan Starcat membantu Anda membacanya: ringkasan AI menjelaskan proyek, CodeFlow mengungkap struktur, dan README hanya satu klik jauhnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri un repository e lascia che Starcat ti aiuti a leggerlo: i riassunti IA spiegano il progetto, CodeFlow ne rivela la struttura e il README è a un clic di distanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリを開いて、Starcatが読むのを手伝います：AIサマリーでプロジェクトを説明、CodeFlowで構造を表示、READMEはワンクリックで表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장소를 열고 Starcat이 읽기를 도와드립니다: AI 요약이 프로젝트를 설명하고, CodeFlow가 구조를 보여주며, README는 한 번의 클릭으로 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open een repository en laat Starcat je helpen deze te lezen: AI-samenvattingen leggen het project uit, CodeFlow onthult de structuur en README is altijd één klik verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz repozytorium, a Starcat pomoże Ci je przeczytać: podsumowania AI wyjaśniają projekt, CodeFlow pokazuje strukturę, a README jest zawsze pod ręką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra um repositório e deixe o Starcat ajudar na leitura: resumos com IA explicam o projeto, o CodeFlow revela a estrutura e o README fica a um clique de distância."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте репозиторий, и Starcat поможет вам его изучить: сводки ИИ объясняют проект, CodeFlow показывает структуру, а README всегда в одном клике."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir depo açın ve Starcat'ın okumanıza yardımcı olmasına izin verin: Yapay zeka özetleri projeyi açıklar, CodeFlow yapıyı ortaya çıkarır ve README her zaman bir tık uzağınızdadır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте репозиторій, і Starcat допоможе його прочитати: ШІ-підсумки пояснюють проєкт, CodeFlow показує структуру, а README завжди за один клік."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở một kho lưu trữ và để Starcat giúp bạn đọc nó: tóm tắt AI giải thích dự án, CodeFlow tiết lộ cấu trúc và README chỉ cách một cú nhấp chuột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开一个仓库后，Starcat 用 AI 摘要解释项目，用 CodeFlow 展示结构，并保留完整 README 阅读体验。"
