    "error.user.service.recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again later. If you use a custom service URL or API Key, test it in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请稍后重试；如果你使用自定义服务地址或 API Key，请在设置中测试连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請稍後重試。若您使用自訂服務網址或 API Key，請在設定中測試連線。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後でもう一度お試しください。カスタムサービスURLまたはAPIキーを使用している場合は、設定でテストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 다시 시도하세요. 사용자 정의 서비스 URL 또는 API 키를 사용하는 경우 설정에서 테스트하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie es später erneut. Wenn Sie eine benutzerdefinierte Dienst-URL oder einen API-Schlüssel verwenden, testen Sie diese in den Einstellungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez plus tard. Si vous utilisez une URL de service ou une clé API personnalisée, testez-la dans les réglages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo más tarde. Si usas una URL de servicio o clave API personalizada, pruébala en Ajustes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente novamente mais tarde. Se você usa uma URL de serviço personalizada ou Chave de API, teste-a nos Ajustes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprova più tardi. Se usi un URL di servizio personalizzato o una chiave API, testalo nelle Impostazioni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите попытку позже. Если вы используете собственный URL сервиса или API-ключ, проверьте их в настройках."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer het later opnieuw. Als je een aangepaste service-URL of API-sleutel gebruikt, test deze dan in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj ponownie później. Jeśli używasz niestandardowego adresu URL usługi lub klucza API, przetestuj go w Ustawieniach."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте пізніше. Якщо ви використовуєте власну URL-адресу служби або ключ API, перевірте їх у налаштуваннях."
          }
        },
