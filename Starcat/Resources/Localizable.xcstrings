        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) %@에서 예상치 못한 응답을 반환하여 완료할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kon niet worden voltooid omdat %@ een onverwacht antwoord gaf."
