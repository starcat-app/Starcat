    "rag.workspace.rerank.model.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required by Cohere-compatible services. TEI selects its model when the server starts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cohere-compatible 服务必填；TEI 在服务启动时确定模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cohere-compatible 服務必填；TEI 在服務啟動時決定模型。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cohere互換サービスで必須。TEIはサーバー起動時にモデルを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cohere 호환 서비스에 필요합니다. TEI는 서버 시작 시 모델을 선택합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich für Cohere-kompatible Dienste. TEI wählt sein Modell beim Serverstart aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requis par les services compatibles Cohere. TEI sélectionne son modèle au démarrage du serveur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requerido por servicios compatibles con Cohere. TEI selecciona su modelo al iniciar el servidor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigatório para serviços compatíveis com Cohere. O TEI seleciona seu modelo quando o servidor inicia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesto dai servizi compatibili con Cohere. TEI seleziona il proprio modello all'avvio del server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется для сервисов, совместимых с Cohere. TEI выбирает модель при запуске сервера."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist door Cohere-compatibele services. TEI selecteert zijn model wanneer de server start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagane przez usługi zgodne z Cohere. TEI wybiera swój model podczas uruchamiania serwera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обов'язково для служб, сумісних з Cohere. TEI вибирає свою модель під час запуску сервера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
