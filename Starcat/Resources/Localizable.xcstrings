    "settings.pro.account.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offer codes are redeemed with Apple's sheet. Subscription management opens your Apple Account page."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优惠码通过 Apple 官方窗口兑换；订阅管理会打开你的 Apple 账户页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優惠碼透過 Apple 官方表單兌換；訂閱管理會開啟你的 Apple 帳號頁面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オファーコードはAppleのシートで引き換えられます。サブスクリプション管理はAppleアカウントページを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할인 코드는 Apple 시트를 통해 사용됩니다. 구독 관리는 Apple 계정 페이지로 이동합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angebotscodes werden mit dem Apple-Blatt eingelöst. Die Abonnementverwaltung öffnet Ihre Apple-Kontoseite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes promotionnels sont échangés via la feuille Apple. La gestion des abonnements ouvre votre page de compte Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códigos de oferta se canjean con la hoja de Apple. La gestión de suscripciones abre tu página de cuenta de Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Códigos de oferta são resgatados com a folha da Apple. O gerenciamento de assinatura abre a página da sua Conta Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici offerta vengono riscattati con il foglio di Apple. La gestione dell'abbonamento apre la pagina del tuo account Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коды предложений активируются через лист Apple. Управление подпиской открывает страницу вашей учётной записи Apple."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanbiedingscodes worden ingewisseld via het Apple-scherm. Abonnementsbeheer opent uw Apple-accountpagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kody promocyjne są realizowane za pomocą arkusza Apple. Zarządzanie subskrypcją otwiera stronę Twojego konta Apple."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промокоди активуються через аркуш Apple. Керування підпискою відкриває сторінку вашого облікового запису Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teklif kodları Apple'ın sayfası ile kullanılır. Abonelik yönetimi Apple Hesap sayfanızı açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã ưu đãi được đổi qua bảng của Apple. Quản lý đăng ký sẽ mở trang Tài khoản Apple của bạn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode penawaran ditukarkan dengan lembar Apple. Manajemen langganan membuka halaman Akun Apple Anda."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
