    "rag.workspace.error.feedback.bodyIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please describe what you were doing when this happened (optional).\n\nThe technical details below are included automatically to help diagnose the issue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在上方补充你当时在做什么（可选）。\n\n下方技术细节会自动附上，方便排查问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在上方補充你當時在做什麼（選填）。\n\n下方技術細節會自動附上，方便排查問題。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この問題が発生したときに行っていた操作を説明してください（任意）。\n\n以下の技術詳細は、問題の診断に役立てるために自動的に含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 문제가 발생했을 때 무엇을 하고 있었는지 설명해 주세요(선택 사항).\n\n아래 기술 세부 정보는 문제 진단을 돕기 위해 자동으로 포함됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte beschreiben Sie, was Sie getan haben, als dies passierte (optional).\n\nDie technischen Details unten werden automatisch hinzugefügt, um die Diagnose des Problems zu unterstützen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez décrire ce que vous faisiez lorsque cela s'est produit (facultatif).\n\nLes détails techniques ci-dessous sont inclus automatiquement pour aider à diagnostiquer le problème."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describa qué estaba haciendo cuando ocurrió esto (opcional).\n\nLos detalles técnicos a continuación se incluyen automáticamente para ayudar a diagnosticar el problema."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva o que você estava fazendo quando isso aconteceu (opcional).\n\nOs detalhes técnicos abaixo são incluídos automaticamente para ajudar a diagnosticar o problema."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi cosa stavi facendo quando è successo (opzionale).\n\nI dettagli tecnici qui sotto sono inclusi automaticamente per aiutare a diagnosticare il problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, опишите, что вы делали, когда это произошло (необязательно).\n\nТехнические детали ниже включены автоматически для диагностики проблемы."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf wat je aan het doen was toen dit gebeurde (optioneel).\n\nDe technische details hieronder worden automatisch meegestuurd om het probleem te helpen diagnosticeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz, co robiłeś, gdy to się stało (opcjonalnie).\n\nSzczegóły techniczne poniżej są dołączane automatycznie, aby pomóc w diagnozowaniu problemu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишіть, що ви робили, коли це сталося (необов'язково).\n\nТехнічні деталі нижче додаються автоматично, щоб допомогти діагностувати проблему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen bunun olduğu sırada ne yaptığınızı açıklayın (isteğe bağlı).\n\nAşağıdaki teknik ayrıntılar, sorunu teşhis etmeye yardımcı olmak için otomatik olarak eklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui lòng mô tả bạn đang làm gì khi điều này xảy ra (không bắt buộc).\n\nCác chi tiết kỹ thuật bên dưới được bao gồm tự động để giúp chẩn đoán sự cố."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silakan jelaskan apa yang Anda lakukan saat ini terjadi (opsional).\n\nDetail teknis di bawah ini disertakan secara otomatis untuk membantu mendiagnosis masalah."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى وصف ما كنت تفعله عند حدوث ذلك (اختياري).\n\nالتفاصيل التقنية أدناه مضمنة تلقائيًا للمساعدة في تشخيص المشكلة."
          }
        }
      }
    },
