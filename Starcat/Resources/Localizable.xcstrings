    "settings.externalSearch.includeWebInAll.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Global Search → All mixes in web results. The Web category always searches externally regardless of this setting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，全局搜索选择「全部」时会混入网页结果；「网页」分类始终单独搜索，不受此开关影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，全局搜索选择「全部」时会混入网页结果；「网页」分类始终单独搜索，不受此开关影响。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、グローバル検索→すべてにWeb結果が混在します。Webカテゴリはこの設定に関係なく常に外部検索を行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 글로벌 검색 > 모두에 웹 결과가 혼합됩니다. 웹 카테고리는 이 설정과 관계없이 항상 외부를 검색합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, mischt die globale Suche → Alle Webergebnisse ein. Die Kategorie Web sucht unabhängig von dieser Einstellung immer extern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, la recherche globale → Tout mélange les résultats Web. La catégorie Web effectue toujours une recherche externe, indépendamment de ce paramètre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, Búsqueda global → Todo mezcla resultados web. La categoría Web siempre busca externamente independientemente de esta configuración."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, a Pesquisa Global → Todos mistura resultados da web. A categoria Web sempre pesquisa externamente, independentemente desta configuração."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando abilitato, la Ricerca Globale → Tutto mescola i risultati web. La categoria Web cerca sempre all'esterno indipendentemente da questa impostazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении глобальный поиск → Всё смешивает веб-результаты. Категория «Веб» всегда выполняет внешний поиск независимо от этой настройки."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer ingeschakeld, mengt Globaal zoeken → Alles webresultaten. De categorie Web zoekt altijd extern, ongeacht deze instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, Globalne wyszukiwanie → Wszystko miesza wyniki sieciowe. Kategoria Sieć zawsze wyszukuje zewnętrznie niezależnie od tego ustawienia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, глобальний пошук → Усе змішує веб-результати. Категорія \"Веб\" завжди шукає зовні незалежно від цього налаштування."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, Global Arama → Tümü web sonuçlarını karıştırır. Web kategorisi, bu ayardan bağımsız olarak her zaman harici arama yapar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được bật, Tìm kiếm toàn cầu → Tất cả sẽ kết hợp kết quả web. Danh mục Web luôn tìm kiếm bên ngoài bất kể cài đặt này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat diaktifkan, Pencarian Global → Semua mencampur hasil web. Kategori Web selalu mencari secara eksternal terlepas dari pengaturan ini."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التمكين، يمزج البحث الشامل → الكل نتائج الويب. فئة الويب تبحث دائمًا خارجيًا بغض النظر عن هذا الإعداد."
          }
        }
      }
    },
