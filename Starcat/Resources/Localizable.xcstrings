    "settings.integration.browserPlugin.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم نقطة النهاية هذه مع مفتاح API المحلي من الإعدادات > التكاملات > مفتاح API المحلي. المفتاح يصرح فقط بالوصول المحلي loopback."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie diesen Endpunkt mit dem lokalen API-Schlüssel aus Einstellungen > Integrationen > Lokaler API-Schlüssel. Der Schlüssel autorisiert nur lokalen Loopback-Zugriff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this endpoint with the Local API Key from Settings > Integrations > Local API Key. The key only authorizes local loopback access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa este endpoint con la clave de API local de Ajustes > Integraciones > Clave de API local. La clave solo autoriza acceso de bucle local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez ce point d'accès avec la clé API locale depuis Réglages > Intégrations > Clé API locale. La clé n'autorise que l'accès en boucle locale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan endpoint ini dengan Kunci API Lokal dari Pengaturan > Integrasi > Kunci API Lokal. Kunci hanya mengotorisasi akses loopback lokal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa questo endpoint con la chiave API locale da Impostazioni > Integrazioni > Chiave API locale. La chiave autorizza solo l'accesso locale in loopback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 > 統合 > ローカルAPIキーのエンドポイントとローカルAPIキーを使用します。キーはローカルループバックアクセスのみを許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 > 통합 > 로컬 API 키의 엔드포인트와 로컬 API 키를 사용하세요. 키는 로컬 루프백 접근만 승인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik dit eindpunt met de lokale API-sleutel uit Instellingen > Integraties > Lokale API-sleutel. De sleutel autoriseert alleen lokale loopback-toegang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj tego punktu końcowego z lokalnym kluczem API z Ustawienia > Integracje > Lokalny klucz API. Klucz autoryzuje tylko dostęp lokalny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use este endpoint com a Chave de API Local em Ajustes > Integrações > Chave de API Local. A chave autoriza apenas acesso local de loopback."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте эту конечную точку с локальным API-ключом из Настроек > Интеграции > Локальный API-ключ. Ключ авторизует только локальный доступ через loopback."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uç noktayı Ayarlar > Entegrasyonlar > Yerel API Anahtarı'ndaki Yerel API Anahtarı ile kullanın. Anahtar yalnızca yerel geri döngü erişimini yetkilendirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте цю кінцеву точку з локальним ключем API з Налаштувань > Інтеграції > Локальний ключ API. Ключ авторизує лише локальний зворотний зв'язок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng điểm cuối này với Khóa API Cục bộ từ Cài đặt > Tích hợp > Khóa API Cục bộ. Khóa chỉ cho phép truy cập loopback cục bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在浏览器插件中填写 endpoint，并使用「设置 → 集成 → 本地 API Key」中的 key。该 key 只授权本机 loopback 访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在瀏覽器外掛中使用此端點，並搭配「設定 > 整合 > 本地 API 金鑰」中的金鑰。該金鑰僅授權本機迴路存取。"
          }
        }
      }
    },
