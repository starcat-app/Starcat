    "activity.following.clear.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إزالة جميع أحداث المتابعة من هذا الجهاز. يمكن جلبها مرة أخرى عند التحديث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies entfernt alle Folge-Ereignisse von diesem Gerät. Sie können bei Aktualisierung erneut abgerufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes all following events from this device. They can be fetched again on refresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los eventos de seguimiento de este dispositivo. Se pueden volver a obtener al actualizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime tous les événements d'abonnement de cet appareil. Ils peuvent être récupérés lors d'une actualisation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua acara mengikuti dari perangkat ini. Acara dapat diambil lagi saat muat ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove tutti gli eventi seguiti da questo dispositivo. Possono essere recuperati di nuovo con un aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、このデバイスからすべてのフォローイベントが削除されます。更新時に再取得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 모든 팔로잉 이벤트가 제거됩니다. 새로고침 시 다시 가져올 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert alle volgende gebeurtenissen van dit apparaat. Ze kunnen opnieuw worden opgehaald bij vernieuwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie wszystkich zdarzeń obserwowanych z tego urządzenia. Można je ponownie pobrać po odświeżeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove todos os eventos de seguindo deste dispositivo. Eles podem ser buscados novamente ao atualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все события подписок с этого устройства. Их можно будет загрузить снова при обновлении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, tüm takip olaylarını bu cihazdan kaldırır. Yenileme ile tekrar getirilebilirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить усі події відстеження з цього пристрою. Їх можна буде завантажити знову після оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa tất cả sự kiện đang theo dõi khỏi thiết bị này. Chúng có thể được tải lại khi làm mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除本机全部关注动态。刷新后可从 GitHub 重新拉取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除本機全部關注動態。重新整理後可從 GitHub 重新拉取。"
          }
        }
      }
    },
