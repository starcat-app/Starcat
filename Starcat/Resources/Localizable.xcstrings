    "about.overview.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize — Sync Stars from GitHub to a fast local library.\nUnderstand — Tags, private notes, and native README reading.\nRediscover — Search and filter your way back to the right repo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理 — 从 GitHub 拉取 Stars，本地缓存，告别网页翻找。\n理解 — 标签分类、私有笔记、README 原生渲染，把仓库读懂。\n找回 — 全文搜索与多维筛选，让收藏真正为你所用。"
          }
        }
      }
    },
    "about.overview.feature.aiReserved.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstract, AI repository chat, code maps, tag suggestions, and semantic search have been fully integrated with AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要、AI仓库对话、代码图谱、标签建议和语义搜索已全面接入 AI。"
          }
        }
      }
    },
