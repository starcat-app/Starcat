    "explore.help.popular.cache.update" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحديث: بعد انتهاء صلاحية التخزين المؤقت، يقوم Starcat بتحديث الكتالوج المشترك وإعادة حساب قائمة Popular."
