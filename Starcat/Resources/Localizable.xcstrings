    "about.eula.term1.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمنحك Starcat ترخيصاً محدوداً وغير حصري وغير قابل للتحويل لتثبيت واستخدام هذا البرنامج على أجهزة Apple التي تملكها أو تتحكم بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat gewährt Ihnen eine eingeschränkte, nicht ausschließliche, nicht übertragbare Lizenz zur Installation und Nutzung dieser Software auf Apple-Geräten, die Sie besitzen oder kontrollieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat grants you a limited, non-exclusive, non-transferable license to install and use this software on Apple devices you own or control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat le otorga una licencia limitada, no exclusiva e intransferible para instalar y usar este software en dispositivos Apple que posea o controle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat vous accorde une licence limitée, non exclusive et non transférable pour installer et utiliser ce logiciel sur les appareils Apple que vous possédez ou contrôlez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat memberikan Anda lisensi terbatas, non-eksklusif, dan tidak dapat dialihkan untuk menginstal dan menggunakan perangkat lunak ini pada perangkat Apple yang Anda miliki atau kendalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat ti concede una licenza limitata, non esclusiva e non trasferibile per installare e utilizzare questo software su dispositivi Apple di tua proprietà o controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatは、お客様が所有または管理するAppleデバイスに本ソフトウェアをインストールして使用するための、限定的、非排他的、譲渡不可のライセンスを付与します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat는 귀하가 소유하거나 제어하는 Apple 기기에서 이 소프트웨어를 설치하고 사용할 수 있는 제한적, 비독점적, 양도 불가능한 라이선스를 부여합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat verleent u een beperkte, niet-exclusieve, niet-overdraagbare licentie om deze software te installeren en te gebruiken op Apple-apparaten die u bezit of beheert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat udziela Ci ograniczonej, niewyłącznej, nieprzenoszalnej licencji na instalację i używanie tego oprogramowania na urządzeniach Apple, które posiadasz lub kontrolujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat concede a você uma licença limitada, não exclusiva e intransferível para instalar e usar este software em dispositivos Apple que você possui ou controla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat предоставляет вам ограниченную, неисключительную, непередаваемую лицензию на установку и использование этого программного обеспечения на устройствах Apple, которыми вы владеете или управляете."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat size, sahip olduğunuz veya kontrol ettiğiniz Apple cihazlarında bu yazılımı yükleme ve kullanma için sınırlı, münhasır olmayan, devredilemez bir lisans verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat надає вам обмежену, невиключну, непередавану ліцензію на встановлення та використання цього програмного забезпечення на пристроях Apple, якими ви володієте або керуєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat cấp cho bạn giấy phép hạn chế, không độc quyền, không thể chuyển nhượng để cài đặt và sử dụng phần mềm này trên các thiết bị Apple bạn sở hữu hoặc kiểm soát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 授予您有限、非独占、不可转让的许可，用于在您拥有或控制的 Apple 设备上安装和使用本软件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 授予您有限、非專屬、不可轉讓的許可，得於您擁有或控制的 Apple 裝置上安裝與使用本軟體。"
          }
        }
      }
    },
