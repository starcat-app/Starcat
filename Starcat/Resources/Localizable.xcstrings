    "settings.pro.direct.deactivate.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac will lose Pro access. You can activate the license again on another Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 将失去 Pro 权益。你可以在另一台 Mac 上重新激活该许可证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 將失去 Pro 存取權。您可以在另一台 Mac 上重新啟用該授權。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacはProアクセスを失います。別のMacでライセンスを再有効化できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 Pro 액세스가 손실됩니다. 다른 Mac에서 라이선스를 다시 활성화할 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac verliert den Pro-Zugriff. Sie können die Lizenz auf einem anderen Mac erneut aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac perdra l'accès Pro. Vous pouvez réactiver la licence sur un autre Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac perderá el acceso Pro. Puedes activar la licencia nuevamente en otro Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac perderá o acesso Pro. Você pode ativar a licença novamente em outro Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac perderà l'accesso Pro. Puoi attivare nuovamente la licenza su un altro Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac потеряет доступ Pro. Вы сможете активировать лицензию на другом Mac."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
