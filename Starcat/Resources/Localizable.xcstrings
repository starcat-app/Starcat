    "rag.workspace.inspector.plan.help.contextBudget.definition.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد التخطيط والاسترجاع، تخصص Starcat نافذة سياق النموذج عبر أجزاء الموجه وتدرج مساحة الإخراج المحجوزة بشكل منفصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Planung und dem Abruf weist Starcat das Modell-Kontextfenster auf die Eingabeabschnitte auf und reserviert den Ausgabebereich separat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After planning and retrieval, Starcat allocates the model context window across prompt segments and lists reserved output space separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de la planificación y recuperación, Starcat asigna la ventana de contexto del modelo entre los segmentos de entrada y reserva el espacio de salida por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la planification et la récupération, Starcat alloue la fenêtre de contexte du modèle entre les segments de prompt et réserve séparément l'espace de sortie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah perencanaan dan pengambilan, Starcat mengalokasikan jendela konteks model di seluruh segmen prompt dan mencantumkan ruang keluaran yang dicadangkan secara terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo la pianificazione e il recupero, Starcat alloca la finestra di contesto del modello tra i segmenti del prompt e riserva separatamente lo spazio di output."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画と検索後、Starcatはモデルのコンテキストウィンドウをプロンプトセグメントに割り当て、予約された出力スペースを別途表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획 및 검색 후 Starcat은 모델 컨텍스트 창을 프롬프트 세그먼트에 할당하고 예약된 출력 공간을 별도로 나열합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na planning en ophalen verdeelt Starcat het modelcontextvenster over promptsegmenten en reserveert apart uitvoerruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po planowaniu i wyszukiwaniu Starcat przydziela okno kontekstu modelu pomiędzy segmenty monitu i osobno rezerwuje miejsce na odpowiedź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após o planejamento e a recuperação, o Starcat aloca a janela de contexto do modelo entre os segmentos do prompt e lista o espaço de saída reservado separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После планирования и поиска Starcat распределяет окно контекста модели по сегментам подсказки и отдельно указывает зарезервированное место для вывода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlama ve getirme işleminden sonra Starcat, model bağlam penceresini istem bölümlerine ayırır ve ayrılmış çıktı alanını ayrıca listeler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після планування та пошуку Starcat розподіляє вікно контексту моделі між сегментами запиту та окремо вказує зарезервований простір для виведення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi lập kế hoạch và truy xuất, Starcat phân bổ cửa sổ ngữ cảnh của mô hình qua các phân đoạn lời nhắc và liệt kê riêng không gian đầu ra dự trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划与检索完成后，系统按当前模型 Context Window 为本轮 Prompt 分配各分片，并单独列出预留的输出空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計劃與檢索完成後，Starcat 會按當前模型 Context Window 為本輪 Prompt 分配各分片，並單獨列出預留的輸出空間。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.contextBudget.definition.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما هي ميزانية السياق؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist das Kontextbudget?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is context budget?"
          }
        },
        "es" : {
