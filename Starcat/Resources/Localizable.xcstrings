    "agent.definition.repoAlternatives.defaultPrompt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find 3-5 more active alternatives similar to the current repository and generate a comparison table."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
