    "settings.mcp.agentSetup.mcp.agent.help": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask Codex, Claude Code, or another AI agent to configure and verify the MCP service." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "让 Codex、Claude Code 或其他 AI Agent 配置并验证 MCP Service。" } }
