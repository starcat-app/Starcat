          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime tous les événements d'abonnement de cet appareil. Ils peuvent être récupérés lors d'une actualisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
