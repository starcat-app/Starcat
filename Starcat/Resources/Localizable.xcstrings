    "settings.diagnostics.telemetry.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit payloads are stored locally as diagnostic summaries in this version; they are not uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前版本只把 MetricKit payload 记录为本地诊断摘要，不上传原始数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前版本只把 MetricKit payload 记录为本地诊断摘要，不上传原始数据。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKitペイロードはこのバージョンでは診断サマリーとしてローカルに保存され、アップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit 페이로드는 이 버전에서 진단 요약으로 로컬에 저장되며 업로드되지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit-Nutzlasten werden in dieser Version lokal als Diagnosezusammenfassungen gespeichert; sie werden nicht hochgeladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données MetricKit sont stockées localement sous forme de résumés de diagnostic dans cette version ; elles ne sont pas téléchargées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cargas de MetricKit se almacenan localmente como resúmenes de diagnóstico en esta versión; no se cargan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os payloads do MetricKit são armazenados localmente como resumos de diagnóstico nesta versão; eles não são enviados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I payload MetricKit vengono archiviati localmente come riepiloghi diagnostici in questa versione; non vengono caricati."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полезные данные MetricKit хранятся локально в виде диагностических сводок в этой версии; они не загружаются."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit-payloads worden lokaal opgeslagen als diagnostische samenvattingen in deze versie; ze worden niet geüpload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ładunki MetricKit są przechowywane lokalnie jako podsumowania diagnostyczne w tej wersji; nie są przesyłane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цій версії корисні навантаження MetricKit зберігаються локально як діагностичні підсумки; вони не завантажуються."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit yükleri bu sürümde tanılama özetleri olarak yerel olarak saklanır; yüklenmezler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải trọng MetricKit được lưu trữ cục bộ dưới dạng tóm tắt chẩn đoán trong phiên bản này; chúng không được tải lên."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payload MetricKit disimpan secara lokal sebagai ringkasan diagnostik di versi ini; tidak diunggah."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخزين حمولات MetricKit محليًا كملخصات تشخيصية في هذا الإصدار؛ ولا يتم تحميلها."
          }
        }
      }
    },
