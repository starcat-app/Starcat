    "settings.externalSearch.aiContext.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التمكين، يجلب ملخص المستودع بالذكاء الاصطناعي والدردشة مواد ويب خارجية إلى المطالبة. يستخدم RAG لقاعدة المعرفة مفتاح الويب لكل سؤال في المحرر ولا يتم التحكم به هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, rufen die KI-Repository-Zusammenfassung und der KI-Chat externes Webmaterial in die Eingabeaufforderung ab. Die Wissensdatenbank-RAG verwendet den pro Frage verfügbaren Web-Schalter im Composer und wird hier nicht gesteuert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, repo AI summary and AI chat fetch external web material into the prompt. Knowledge base RAG uses the per-question web toggle in the composer and is not controlled here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, el resumen de IA del repositorio y el chat de IA obtienen material web externo en la indicación. El RAG de la base de conocimiento usa el interruptor web por pregunta en el compositor y no se controla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, le résumé IA et le chat IA du dépôt intègrent du contenu Web externe dans l'invite. La RAG de la base de connaissances utilise le bouton Web par question dans le compositeur et n'est pas contrôlée ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat diaktifkan, ringkasan AI repositori dan obrolan AI mengambil materi web eksternal ke dalam prompt. RAG basis pengetahuan menggunakan sakelar web per pertanyaan di komposer dan tidak dikendalikan di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando abilitato, il riepilogo AI del repository e la chat AI recuperano materiale web esterno nel prompt. Il RAG della knowledge base utilizza l'interruttore web per domanda nel compositore e non è controllato qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、リポジトリのAIサマリーとAIチャットがプロンプトに外部Web素材を取り込みます。ナレッジベースRAGはコンポーザー内の質問ごとのWebトグルを使用し、ここでは制御されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 저장소 AI 요약 및 AI 채팅이 프롬프트에 외부 웹 자료를 가져옵니다. 지식 기반 RAG는 작성기의 질문별 웹 토글을 사용하며 여기서 제어되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer ingeschakeld, halen repo-AI-samenvatting en AI-chat extern webmateriaal op in de prompt. Kennisbank-RAG gebruikt de per-vraag webknop in de composer en wordt hier niet geregeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, podsumowanie AI repozytorium i czat AI pobierają zewnętrzne materiały sieciowe do podpowiedzi. RAG bazy wiedzy używa przełącznika sieciowego na pytanie w kompozytorze i nie jest kontrolowane tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o resumo de IA do repositório e o chat de IA buscam material web externo para o prompt. O RAG da base de conhecimento usa o botão de alternância web por pergunta no compositor e não é controlado aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении сводка ИИ репозитория и чат ИИ получают внешний веб-материал в подсказку. RAG базы знаний использует переключатель веб-поиска для каждого вопроса в компоновщике и не управляется здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, depo AI özeti ve AI sohbeti, isteme harici web materyali getirir. Bilgi tabanı RAG'si, besteci içindeki soru bazında web geçişini kullanır ve buradan kontrol edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, підсумок ШІ репозиторію та чат ШІ отримують зовнішні веб-матеріали в підказку. RAG бази знань використовує перемикач вебу для кожного запитання в композиторі та не контролюється тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được bật, tóm tắt AI kho lưu trữ và trò chuyện AI sẽ lấy tài liệu web bên ngoài vào lời nhắc. RAG cơ sở tri thức sử dụng nút chuyển đổi web cho mỗi câu hỏi trong trình soạn thảo và không được kiểm soát ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，仓库 AI 摘要与 AI 对话会拉取外部网页材料写入 prompt。知识库 RAG 由问答栏联网开关单独控制，不受此设置影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，仓库 AI 摘要与 AI 对话会拉取外部网页材料写入 prompt。知识库 RAG 由问答栏联网开关单独控制，不受此设置影响。"
          }
        }
      }
    },
