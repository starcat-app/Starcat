          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша заметка изменилась во время генерации. Черновик AI сохранён; сгенерируйте заново, чтобы включить последние правки."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
