    "ai.client.error.authenticationRejected" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض مزود الذكاء الاصطناعي بيانات الاعتماد. حدّث مفتاح API في إعدادات الذكاء الاصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der KI-Anbieter hat die Anmeldedaten abgelehnt. Aktualisieren Sie den API-Schlüssel in den KI-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI provider rejected the credential. Update the API key in AI Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor de IA rechazó la credencial. Actualiza la clave API en los ajustes de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur IA a rejeté l'identifiant. Mettez à jour la clé API dans les réglages IA."
          }
        },
        "id" : {
          "stringUnit" : {
