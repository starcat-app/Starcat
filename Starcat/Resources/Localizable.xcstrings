        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengambil data dari github.com/trending untuk menampilkan tampilan Trending (filter berdasarkan bahasa dan rentang waktu)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza github.com/trending per alimentare la vista Trending (filtra per linguaggio e intervallo di tempo)."
