    "agent.textGeneration.error.missingAPIKey" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current AI provider is missing an API key. Add the API key for that provider in Settings first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 AI Provider 缺少 API Key。请先到设置页填写对应服务商的 API Key。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前 AI 提供者缺少 API 金鑰。請先在設定中新增該提供者的 API 金鑰。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のAIプロバイダにAPIキーが設定されていません。設定でプロバイダのAPIキーを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 AI 제공업체에 API 키가 없습니다. 설정에서 해당 제공업체의 API 키를 추가하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem aktuellen KI-Anbieter fehlt ein API-Schlüssel. Füge zuerst den API-Schlüssel für diesen Anbieter in den Einstellungen hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur d'IA actuel n'a pas de clé API. Ajoutez d'abord la clé API pour ce fournisseur dans les Réglages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al proveedor de IA actual le falta una clave API. Añade la clave API para ese proveedor en Ajustes primero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor de IA atual está sem uma chave de API. Adicione a chave de API para esse provedor nas Configurações primeiro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al provider AI corrente manca una chiave API. Aggiungi la chiave API per quel provider nelle Impostazioni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У текущего AI-провайдера отсутствует API-ключ. Сначала добавьте API-ключ для этого провайдера в настройках."
          }
        },
        "nl" : {
          "stringUnit" : {
