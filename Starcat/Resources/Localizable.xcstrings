          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF 排名項：權重 /（60 + 排名），讓排名只細化結果而不主導結果。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF順位項：重み / (60 + 順位)。順位は結果を支配せずに調整する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF 순위 항: 가중치 / (60 + 순위)로, 순위가 결과를 세분화하지만 지배하지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF-Rangbegriff: Gewicht / (60 + Rang), sodass der Rang das Ergebnis verfeinert, nicht dominiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terme de rang RRF : poids / (60 + rang), donc le rang affine plutôt que domine le résultat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Término de rango RRF: peso / (60 + rango), por lo que el rango refina en lugar de dominar el resultado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termo de classificação RRF: peso / (60 + classificação), para que a classificação refine em vez de dominar o resultado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine rango RRF: peso / (60 + rango), quindi il rango perfeziona piuttosto che dominare il risultato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Член RRF ранга: вес / (60 + ранг), поэтому ранг уточняет, а не доминирует над результатом."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF-rangterm: gewicht / (60 + rang), dus rang verfijnt het resultaat in plaats van domineert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termin pozycji RRF: waga / (60 + pozycja), więc pozycja udoskonala, a nie dominuje wyniku."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Член рангу RRF: вага / (60 + ранг), тому ранг уточнює, а не домінує результат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF sıra terimi: ağırlık / (60 + sıra), böylece sıra sonucu iyileştirir, domine etmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hạng RRF: trọng số / (60 + hạng), do đó hạng tinh chỉnh chứ không chi phối kết quả."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istilah peringkat RRF: bobot / (60 + peringkat), sehingga peringkat menyempurnakan daripada mendominasi hasil."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حد رتبة RRF: الوزن / (60 + الرتبة)، لذا تنقح الرتبة النتيجة بدلاً من أن تهيمن عليها."
          }
        }
      }
    },
