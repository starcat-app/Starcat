    "settings.pro.benefit.ai.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own API key for summaries, tags, chat, batch tidy, README translation, and semantic search—without routing private prompts through a shared key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自带 API Key，完成摘要、标签、对话、批量整理、README 翻译与语义搜索；私有提示词不经过共享密钥。"
          }
        }
      }
    },
    "settings.pro.benefit.ai.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI workflows with your own key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自带 Key 的 AI 工作流"
          }
        }
      }
    },
    "settings.pro.benefit.badge.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prominent PRO badge appears on your avatar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录用户头像右下角展示醒目的 PRO 徽章。"
