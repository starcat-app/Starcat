      }
    },
    "settings.mcp.agentSetup.skillManualPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Install starcat-skill Manually\n\nChoose one user-level destination.\n\nCodex:\n```bash\nmkdir -p \"$HOME/.codex/skills\"\ngit clone %1$@ \"$HOME/.codex/skills/starcat-skill\"\n```\n\nClaude Code:\n```bash\nmkdir -p \"$HOME/.claude/skills\"\ngit clone %1$@ \"$HOME/.claude/skills/starcat-skill\"\n```\n\nIf the destination already exists, update it with `git -C <skill-path> pull --ff-only`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "# 手动安装 starcat-skill\n\n选择一个用户级安装目录。\n\nCodex：\n```bash\nmkdir -p \"$HOME/.codex/skills\"\ngit clone %1$@ \"$HOME/.codex/skills/starcat-skill\"\n```\n\nClaude Code：\n```bash\nmkdir -p \"$HOME/.claude/skills\"\ngit clone %1$@ \"$HOME/.claude/skills/starcat-skill\"\n```\n\n如果目标目录已存在，请使用 `git -C <skill-path> pull --ff-only` 更新。"
          }
        }
      }
    },
    "settings.mcp.agentSetup.skillPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please install and verify starcat-skill: %1$@"
