    "agent.artifact.repoAlternatives.error.unknownRepositoryFormat" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Repo Alternatives references source repository %lld outside the frozen run context." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仓库替代方案引用了冻结运行上下文之外的源仓库 %lld。" } },
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تشير بدائل المستودع إلى المستودع المصدر %lld خارج سياق التشغيل المجمّد." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Repo-Alternativen verweist auf das Quell-Repository %lld außerhalb des eingefrorenen Ausführungskontexts." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Alternativas de repositorio hace referencia al repositorio de origen %lld fuera del contexto de ejecución congelado." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les alternatives de dépôt font référence au dépôt source %lld hors du contexte d’exécution figé." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Alternatif repositori merujuk repositori sumber %lld di luar konteks proses yang dibekukan." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Le alternative al repository fanno riferimento al repository di origine %lld al di fuori del contesto di esecuzione congelato." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リポジトリ代替候補が凍結された実行コンテキスト外のソースリポジトリ %lld を参照しています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장소 대안이 동결된 실행 컨텍스트 외부의 소스 저장소 %lld를 참조합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Repository-alternatieven verwijst naar bronrepository %lld buiten de bevroren uitvoeringscontext." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Alternatywy repozytorium odwołują się do repozytorium źródłowego %lld poza zamrożonym kontekstem uruchomienia." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Alternativas de repositório faz referência ao repositório de origem %lld fora do contexto de execução congelado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Альтернативы репозитория ссылаются на исходный репозиторий %lld вне замороженного контекста запуска." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Depo alternatifleri, dondurulmuş çalıştırma bağlamı dışındaki %lld kaynak deposuna başvuruyor." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Альтернативи репозиторію посилаються на вихідний репозиторій %lld поза замороженим контекстом запуску." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Phương án thay thế kho lưu trữ tham chiếu kho nguồn %lld ngoài bối cảnh chạy đã đóng băng." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "儲存庫替代方案引用了凍結執行內容之外的來源儲存庫 %lld。" } }
      }
