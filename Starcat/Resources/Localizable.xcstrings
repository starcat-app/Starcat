    "settings.ai.locked.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحضر مفتاحك الخاص بعد الترقية. Pro يفتح طبقة سير عمل الذكاء الاصطناعي في Starcat؛ تكاليف API للمزوّد لا تزال على حسابك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringen Sie nach dem Upgrade Ihren eigenen Schlüssel mit. Pro schaltet die KI-Workflow-Ebene von Starcat frei; die API-Kosten des Anbieters verbleiben auf Ihrem Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring your own key after upgrading. Pro unlocks Starcat's AI workflow layer; provider API costs still belong to your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae tu propia clave después de actualizar. Pro desbloquea la capa de flujo de trabajo de IA de Starcat; los costos de API del proveedor siguen siendo de tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apportez votre propre clé après la mise à niveau. Pro déverrouille la couche de workflow IA de Starcat ; les coûts API du fournisseur restent à votre charge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawa kunci Anda sendiri setelah upgrade. Pro membuka lapisan alur kerja AI Starcat; biaya API penyedia tetap menjadi tanggungan akun Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta la tua chiave dopo l'aggiornamento. Pro sblocca il livello dei flussi di lavoro AI di Starcat; i costi API del provider rimangono a carico del tuo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップグレード後に独自のキーを持ち込めます。ProでStarcatのAIワークフローレイヤーが解放されます。プロバイダのAPI費用はお客様のアカウントに請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업그레이드 후 자체 키를 가져오세요. Pro는 Starcat의 AI 워크플로 레이어를 잠금 해제합니다. 제공자 API 비용은 귀하의 계정에 부과됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem uw eigen sleutel mee na upgraden. Pro ontgrendelt de AI-workflowlaag van Starcat; provider-API-kosten blijven voor uw rekening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przynieś własny klucz po aktualizacji. Pro odblokowuje warstwę przepływu pracy AI Starcat; koszty API dostawcy nadal obciążają Twoje konto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traga sua própria chave após a atualização. O Pro desbloqueia a camada de fluxo de trabalho de IA do Starcat; os custos da API do provedor ainda pertencem à sua conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принесите свой ключ после обновления. Pro открывает уровень AI-рабочих процессов Starcat; затраты на API провайдера остаются на вашем аккаунте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükseltmeden sonra kendi anahtarınızı getirin. Pro, Starcat'ın AI iş akışı katmanının kilidini açar; sağlayıcı API maliyetleri yine hesabınıza aittir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принесіть власний ключ після оновлення. Pro розблоковує рівень AI-робочих процесів Starcat; витрати на API постачальника все ще належать вашому обліковому запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mang khóa của bạn sau khi nâng cấp. Pro mở khóa lớp quy trình AI của Starcat; chi phí API của nhà cung cấp vẫn thuộc tài khoản của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级后即可使用自己的 Key。Pro 解锁 Starcat 的 AI 工作流层，服务商 API 费用仍由你的账户承担。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級後即可使用自己的 Key。Pro 解鎖 Starcat 的 AI 工作流程層，服務商 API 費用仍由你的帳戶承擔。"
          }
        }
      }
    },
