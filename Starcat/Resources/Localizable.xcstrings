        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 검색에 참여할 지식 소스를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies welke kennisbronnen kunnen deelnemen aan lokaal ophalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, które źródła wiedzy mogą uczestniczyć w lokalnym wyszukiwaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quais fontes de conhecimento podem participar da recuperação local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
