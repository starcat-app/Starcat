    "rag.workspace.inspector.plan.help.contextBudget.definition.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After planning and retrieval, Starcat allocates the model context window across prompt segments and lists reserved output space separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划与检索完成后，系统按当前模型 Context Window 为本轮 Prompt 分配各分片，并单独列出预留的输出空间。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.contextBudget.definition.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is context budget?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文预算是什么？"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.contextBudget.field.reservedOutput": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserved output: tokens set aside for the model reply; not counted in the usage percentage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预留输出：为模型回答保留的分片；不计入顶部占用百分比。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.contextBudget.field.segments": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input segments: system, history, question, evidence, remote content, and attachments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入分片：系统提示、历史、问题、证据、远程内容与附件。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.contextBudget.field.window": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window total: the configured context window for the selected model."
          }
