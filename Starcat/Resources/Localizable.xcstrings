    "explore.help.discover.cache.offline": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline handling: if the update fails, Starcat keeps the last successful cache and warns that the content may be out of date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线处理：更新失败时继续使用上次成功缓存，并提示内容可能不是最新。"
          }
        }
      }
    },
    "explore.help.discover.cache.ttl": {
      "extractionState": "stale",
