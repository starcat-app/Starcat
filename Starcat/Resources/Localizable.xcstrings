        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력 세그먼트만 표시, 예약된 출력은 숨겨지지만 내부적으로 차감됨"
          }
        },
        "de" : {
          "stringUnit" : {
