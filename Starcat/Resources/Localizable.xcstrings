          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: A reclassificação não retornou %lld candidatos enviados; sua ordem de recuperação híbrida foi mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: Rerank не вернул %lld отправленных кандидатов; их порядок гибридного поиска сохранён."
          }
        },
        "tr" : {
          "stringUnit" : {
