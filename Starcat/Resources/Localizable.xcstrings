    "githubStarLists.error.orgOAuthRestricted.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub blocked this group update because the repository belongs to a restricted organization."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该仓库属于受限组织，GitHub 拦截了这次分组更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此倉庫屬於受限組織，GitHub 已攔截此次群組更新。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリが制限された組織に属しているため、GitHubがこのグループの更新をブロックしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub이 이 그룹 업데이트를 차단했습니다. 저장소가 제한된 조직에 속해 있기 때문입니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat diese Gruppenaktualisierung blockiert, da das Repository zu einer eingeschränkten Organisation gehört."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub a bloqué cette mise à jour de groupe car le dépôt appartient à une organisation restreinte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub bloqueó esta actualización de grupo porque el repositorio pertenece a una organización restringida."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GitHub bloqueou esta atualização de grupo porque o repositório pertence a uma organização restrita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ha bloccato questo aggiornamento del gruppo perché il repository appartiene a un'organizzazione con restrizioni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub заблокировал это обновление группы, так как репозиторий принадлежит ограниченной организации."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub heeft deze groepsupdate geblokkeerd omdat de repository tot een beperkte organisatie behoort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub zablokował tę aktualizację grupy, ponieważ repozytorium należy do ograniczonej organizacji."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub заблокував це оновлення групи, оскільки репозиторій належить обмеженій організації."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub bu grup güncellemesini engelledi çünkü depo kısıtlı bir kuruluşa ait."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
