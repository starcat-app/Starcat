    "settings.storage.ragHistory.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions, answers, and citation metadata from the Knowledge RAG workspace. Stored in the main database, separate from per-repo AI assistant chat history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
