    "error.user.decoding.recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول تحديث Starcat. إذا استمر الفشل، قم بتصدير سجلات التصحيح وأرسلها إلى dong4j."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie, Starcat zu aktualisieren. Falls das Problem weiterhin besteht, exportieren Sie Debug-Protokolle und senden Sie sie an dong4j."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try updating Starcat. If it still fails, export debug logs and send them to dong4j."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta actualizar Starcat. Si sigue fallando, exporta los registros de depuración y envíalos a dong4j."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de mettre à jour Starcat. Si le problème persiste, exportez les journaux de débogage et envoyez-les à dong4j."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba perbarui Starcat. Jika masih gagal, ekspor log debug dan kirimkan ke dong4j."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova ad aggiornare Starcat. Se persiste, esporta i log di debug e inviali a dong4j."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatをアップデートしてください。それでも失敗する場合は、デバッグログを書き出してdong4jに送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat을 업데이트해 보세요. 그래도 실패하면 디버그 로그를 내보내 dong4j에게 보내주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer Starcat bij te werken. Als het blijft mislukken, exporteer dan debuglogs en stuur ze naar dong4j."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj zaktualizować Starcat. Jeśli nadal nie działa, wyeksportuj logi debugowania i wyślij je do dong4j."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente atualizar o Starcat. Se ainda falhar, exporte os registros de depuração e envie para dong4j."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте обновить Starcat. Если проблема сохранится, экспортируйте отладочные логи и отправьте их dong4j."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat'ı güncellemeyi deneyin. Hala başarısız olursa, hata ayıklama günlüklerini dışa aktarın ve dong4j'e gönderin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте оновити Starcat. Якщо проблема не зникне, експортуйте журнали налагодження та надішліть їх dong4j."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thử cập nhật Starcat. Nếu vẫn thất bại, hãy xuất nhật ký gỡ lỗi và gửi cho dong4j."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请尝试更新 Starcat；如果仍失败，请导出调试日志发给 dong4j。"
          }
        },
