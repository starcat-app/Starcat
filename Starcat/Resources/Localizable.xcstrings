          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для живых данных GitHub требуется точная область репозитория. Добавьте @репозиторий и задайте вопрос снова."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
