          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーが不完全な応答を返しました。もう一度お試しください。質問内容は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공자가 불완전한 응답을 반환했습니다. 다시 시도하세요. 질문은 유지됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anbieter hat eine unvollständige Antwort zurückgegeben. Versuchen Sie es erneut; Ihre Frage bleibt erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur a renvoyé une réponse incomplète. Réessayez ; votre question est conservée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor devolvió una respuesta incompleta. Intente de nuevo; su pregunta se conserva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor retornou uma resposta incompleta. Tente novamente; sua pergunta foi preservada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider ha restituito una risposta incompleta. Riprova; la tua domanda è conservata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер вернул неполный ответ. Повторите попытку; ваш вопрос сохранён."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De provider heeft een onvolledig antwoord geretourneerd. Probeer het opnieuw; je vraag blijft behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca zwrócił niekompletną odpowiedź. Spróbuj ponownie; twoje pytanie zostało zachowane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постачальник повернув неповну відповідь. Спробуйте ще раз; ваше запитання збережено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlayıcı eksik bir yanıt döndürdü. Tekrar deneyin; sorunuz korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà cung cấp trả về phản hồi không đầy đủ. Thử lại; câu hỏi của bạn được giữ nguyên."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyedia mengembalikan respons yang tidak lengkap. Coba lagi; pertanyaan Anda tetap tersimpan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد الموفر استجابة غير مكتملة. حاول مرة أخرى؛ تم الاحتفاظ بسؤالك."
          }
        }
      }
    },
