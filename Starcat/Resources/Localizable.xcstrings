    "ai.context.storage.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبديل المجلدات ينقل ملفات context.xml و metadata.json الموجودة. تبقى ملفات ZIP المصدر المشتركة في حاوية التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wechseln von Verzeichnissen migriert vorhandene context.xml und metadata.json. Gemeinsam genutzte Quell-ZIPs bleiben im App-Container."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching directories migrates existing context.xml and metadata.json. Shared source ZIPs remain in the app container."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar de directorio migra los context.xml y metadata.json existentes. Los ZIP de origen compartidos permanecen en el contenedor de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de dossier migre les context.xml et metadata.json existants. Les ZIP sources partagés restent dans le conteneur de l'application."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengganti direktori akan memigrasi context.xml dan metadata.json yang ada. ZIP sumber bersama tetap berada di kontainer aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare cartella migra i file context.xml e metadata.json esistenti. Gli ZIP sorgente condivisi rimangono nel contenitore dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディレクトリを切り替えると、既存のcontext.xmlとmetadata.jsonが移行されます。共有ソースZIPはアプリコンテナに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디렉토리를 전환하면 기존 context.xml과 metadata.json이 마이그레이션됩니다. 공유 소스 ZIP은 앱 컨테이너에 남아 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wisselen van mappen migreert bestaande context.xml en metadata.json. Gedeelde bron-ZIP's blijven in de app-container."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana katalogów migruje istniejące pliki context.xml i metadata.json. Współdzielone archiwa ZIP źródła pozostają w kontenerze aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar diretórios migra context.xml e metadata.json existentes. ZIPs de origem compartilhados permanecem no contêiner do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключение папок переносит существующие context.xml и metadata.json. Общие ZIP-архивы исходного кода остаются в контейнере приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizin değiştirmek mevcut context.xml ve metadata.json dosyalarını taşır. Paylaşılan kaynak ZIP'leri uygulama kapsayıcısında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемикання каталогів переносить наявні context.xml та metadata.json. Спільні ZIP-файли вихідного коду залишаються в контейнері програми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển đổi thư mục sẽ di chuyển context.xml và metadata.json hiện có. Các tệp ZIP nguồn dùng chung vẫn nằm trong vùng chứa ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换目录时会迁移现有 context.xml 与 metadata.json；共享源码 ZIP 仍保存在应用容器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換目錄時會遷移現有的 context.xml 與 metadata.json；共享原始碼 ZIP 仍保存在應用程式容器。"
          }
        }
      }
    },
    "ai.embedding.error.authenticationRejected" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض مزود التضمين بيانات الاعتماد. قم بتحديث مفتاح API في إعدادات الذكاء الاصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Embedding-Anbieter hat die Anmeldedaten abgelehnt. Aktualisieren Sie den API-Schlüssel in den KI-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The embedding provider rejected the credential. Update the API key in AI Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor de embeddings rechazó la credencial. Actualiza la clave API en Ajustes de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur d'embedding a rejeté les identifiants. Mettez à jour la clé API dans les réglages IA."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyedia embedding menolak kredensial. Perbarui kunci API di Pengaturan AI."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider di embedding ha rifiutato la credenziale. Aggiorna la chiave API in Impostazioni IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋め込みプロバイダーが認証情報を拒否しました。AI設定でAPIキーを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임베딩 제공자가 자격 증명을 거부했습니다. AI 설정에서 API 키를 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De embeddingprovider heeft de inloggegevens geweigerd. Werk de API-sleutel bij in AI-instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca osadzania odrzucił poświadczenie. Zaktualizuj klucz API w ustawieniach AI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor de embedding rejeitou a credencial. Atualize a chave da API em Configurações de IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер эмбеддингов отклонил учётные данные. Обновите API-ключ в настройках ИИ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gömme sağlayıcı kimlik bilgisini reddetti. AI Ayarları'nda API anahtarını güncelleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постачальник вбудовувань відхилив облікові дані. Оновіть ключ API в налаштуваннях ШІ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà cung cấp nhúng đã từ chối thông tin xác thực. Cập nhật khóa API trong Cài đặt AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向量化服务商拒绝了当前凭据，请在 AI 设置中更新 API Key。"
          }
        },
        "zh-Hant" : {
