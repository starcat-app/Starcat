    "about.eula.term2.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Except as expressly permitted by applicable law, you may not reverse engineer, redistribute, rent, sell, or remove copyright or license notices from this software."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除适用法律明确允许外，您不得反向工程、再分发、出租、出售或移除本软件中的版权与许可声明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除適用法律明確允許外，您不得對本軟體進行反向工程、再散布、出租、銷售，或移除著作權與許可聲明。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用法で明示的に許可されている場合を除き、本ソフトウェアのリバースエンジニアリング、再配布、レンタル、販売、または著作権表示やライセンス表示の削除を行ってはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 법률에서 명시적으로 허용하는 경우를 제외하고, 이 소프트웨어를 리버스 엔지니어링, 재배포, 임대, 판매하거나 저작권 또는 라이선스 고지를 제거할 수 없습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofern nicht ausdrücklich durch geltendes Recht erlaubt, dürfen Sie diese Software nicht dekompilieren, weiterverbreiten, vermieten, verkaufen oder Urheberrechts- oder Lizenzhinweise entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauf autorisation expresse par la loi applicable, vous ne pouvez pas désosser, redistribuer, louer, vendre ou supprimer les avis de droit d'auteur ou de licence de ce logiciel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo que la ley aplicable lo permita expresamente, no podrá realizar ingeniería inversa, redistribuir, alquilar, vender ni eliminar avisos de derechos de autor o licencia de este software."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exceto conforme expressamente permitido pela lei aplicável, você não pode fazer engenharia reversa, redistribuir, alugar, vender ou remover avisos de direitos autorais ou licença deste software."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo quanto espressamente consentito dalla legge applicabile, non puoi decompilare, ridistribuire, noleggiare, vendere o rimuovere avvisi di copyright o licenza da questo software."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За исключением случаев, прямо разрешённых применимым законодательством, вы не можете декомпилировать, распространять, сдавать в аренду, продавать или удалять уведомления об авторских правах или лицензиях из этого программного обеспечения."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalve zoals uitdrukkelijk toegestaan door de toepasselijke wetgeving, mag u deze software niet reverse-engineeren, herdistribueren, verhuren, verkopen of auteursrecht- of licentiemeldingen verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z wyjątkiem przypadków wyraźnie dozwolonych przez obowiązujące prawo, nie wolno dekompilować, redystrybuować, wynajmować, sprzedawać ani usuwać informacji o prawach autorskich lub licencji z tego oprogramowania."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За винятком випадків, прямо дозволених чинним законодавством, ви не маєте права здійснювати зворотне проектування, розповсюджувати, здавати в оренду, продавати або видаляти повідомлення про авторські права чи ліцензії з цього програмного забезпечення."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli yasanın açıkça izin verdiği durumlar dışında, bu yazılımı tersine mühendislik yapamaz, yeniden dağıtamaz, kiralayamaz, satamaz veya telif hakkı ya da lisans bildirimlerini kaldıramazsınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trừ khi được pháp luật áp dụng cho phép rõ ràng, bạn không được dịch ngược, phân phối lại, cho thuê, bán hoặc xóa thông báo bản quyền hoặc giấy phép khỏi phần mềm này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecuali diizinkan secara tegas oleh hukum yang berlaku, Anda tidak boleh melakukan rekayasa balik, mendistribusikan ulang, menyewakan, menjual, atau menghapus pemberitahuan hak cipta atau lisensi dari perangkat lunak ini."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "باستثناء ما يسمح به القانون المعمول به صراحةً، لا يجوز لك إجراء هندسة عكسية أو إعادة توزيع أو تأجير أو بيع أو إزالة إشعارات حقوق النشر أو الترخيص من هذا البرنامج."
          }
        }
      }
    },
