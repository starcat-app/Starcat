    "rag.workspace.inspector.plan.help.networkPlan.field.liveEvidence" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السياق المباشر: ما إذا كانت الأجزاء المحلية القديمة غير كافية ويلزم جلب الشبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Kontext: ob veraltete lokale Blöcke nicht ausreichen und ein Netzwerkabruf erforderlich ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live context: whether stale local chunks are insufficient and network fetch is required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexto en vivo: si los fragmentos locales desactualizados son insuficientes y se requiere recuperación de red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexte en direct : si les morceaux locaux obsolètes sont insuffisants et qu'une récupération réseau est nécessaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteks langsung: apakah potongan lokal yang basi tidak mencukupi dan pengambilan jaringan diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contesto live: se i chunk locali obsoleti sono insufficienti e è necessario il recupero dalla rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブコンテキスト: 古いローカルチャンクで不十分でネットワーク取得が必要かどうか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 컨텍스트: 오래된 로컬 청크가 충분하지 않아 네트워크 가져오기가 필요한지 여부입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live context: of verouderde lokale chunks onvoldoende zijn en netwerkophalen nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontekst na żywo: czy lokalne fragmenty są nieaktualne i wymagane jest pobranie z sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexto ao vivo: se os fragmentos locais desatualizados são insuficientes e é necessária uma busca na rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живой контекст: достаточно ли устаревших локальных фрагментов или требуется сетевая загрузка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı bağlam: eski yerel parçaların yetersiz olup olmadığı ve ağ getirmesinin gerekli olup olmadığı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живий контекст: чи недостатньо застарілих локальних фрагментів і чи потрібне отримання з мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngữ cảnh trực tiếp: liệu các đoạn cục bộ cũ có không đủ và cần tìm nạp qua mạng hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时上下文：本地分片是否不足以安全回答，必须联网补充。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時上下文：本地分片是否不足以安全回答，必須聯網補充。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.networkPlan.field.remoteContext" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سياق GitHub البعيد: المشكلات، طلبات السحب، أو موارد GitHub API الأخرى مع استعلام وحدود لكل مستودع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub-Remote-Kontext: Issues, PRs oder andere GitHub-API-Ressourcen mit Abfrage- und Pro-Repo-Limits."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub remote context: Issues, PRs, or other GitHub API resources with query and per-repo limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexto remoto de GitHub: Issues, PRs u otros recursos de la API de GitHub con límites por consulta y por repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
