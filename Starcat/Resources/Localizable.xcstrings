    },
    "rag.workspace.inspector.plan.help.retrievalFunnel.field.rerank": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rerank: optional second-pass scoring when a rerank provider is configured."
