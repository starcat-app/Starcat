    "rag.workspace.inspector.plan.help.repoContext.steps.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How context.xml is built"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "context.xml 生成步骤"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目代码"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.windowFit.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packer first builds context.xml under the configured Token budget. When the full prompt is assembled, the remaining model window may be smaller. Starcat then trims complete XML nodes—fileList, then keyFiles, then entryPoints, and finally directory-tree text—so the result stays valid <repository> XML instead of a hard-cut fragment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Packer 会先按设置的 Token 预算生成完整 context.xml。拼进整轮 Prompt 时，模型剩余窗口可能更小。此时 Starcat 会按完整 XML 节点裁剪：先 fileList，再 keyFiles，再 entryPoints，最后缩短目录树文本，保证结果仍是合法的 <repository> XML，而不是硬截断的半截标签。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.windowFit.case.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed: window fit cannot produce valid XML within budget; the step degrades and the answer continues without project code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败：无法在预算内产出合法 XML；本步降级，回答继续进行但不带项目代码。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.windowFit.case.full": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full XML fit: the original XML fits the remaining window; nothing is removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整装入：原始 XML 装得进剩余窗口，未做裁剪。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.windowFit.case.trimmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimmed to fit: files or directory text were removed so a valid XML still fits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已裁剪装入：删除了部分文件节点或缩短了目录树文本，使合法 XML 仍能装入。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.windowFit.cases.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible outcomes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能出现的结果"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.windowFit.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is window fit?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口适配是什么？"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.retrievalFunnel.definition.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual retrieval statistics for this turn: how many repositories and chunks passed each stage from candidates to final evidence. This replays execution, not the Planner's intent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮检索的实际统计：从候选仓库到最终证据，各阶段通过了多少仓库与分片。这是执行回放，不是 Planner 的意图描述。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.retrievalFunnel.definition.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is retrieval funnel?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检索漏斗是什么？"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.retrievalFunnel.field.candidates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidates: repositories that entered the funnel after plan filters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选仓库：经过计划筛选后进入漏斗的仓库数。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.retrievalFunnel.field.fusion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusion: unique chunks after merging keyword and vector results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "融合：关键词与向量结果合并去重后的唯一分片数。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.retrievalFunnel.field.keyword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyword recall: raw hits vs. chunks accepted after keyword scoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键词召回：原始命中数 vs. 评分后采纳的分片数。"
