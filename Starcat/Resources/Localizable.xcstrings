    "settings.mcp.pairing.sheet.security" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وافق فقط إذا كنت قد بدأت الاقتران. يتلقى الجهاز اعتمادًا مستقلاً يمكن إبطاله لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmigen Sie nur, wenn Sie das Pairing initiiert haben. Das Gerät erhält eine unabhängige Berechtigung, die später widerrufen werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approve only if you initiated pairing. The device receives an independent credential that can be revoked later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba solo si iniciaste el emparejamiento. El dispositivo recibe una credencial independiente que puede revocarse más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvez uniquement si vous avez initié l'appairage. L'appareil reçoit une information d'identification indépendante qui peut être révoquée ultérieurement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setujui hanya jika Anda memulai pemasangan. Perangkat menerima kredensial independen yang dapat dicabut nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva solo se hai avviato tu l'abbinamento. Il dispositivo riceve una credenziale indipendente che può essere revocata in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分がペアリングを開始した場合のみ承認してください。デバイスは後で取り消し可能な独立した資格情報を受け取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 페어링을 시작한 경우에만 승인하세요. 장치는 나중에 해지할 수 있는 독립적인 자격 증명을 받습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keur alleen goed als je de koppeling hebt gestart. Het apparaat ontvangt een onafhankelijke referentie die later kan worden ingetrokken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdź tylko wtedy, gdy sam zainicjowałeś parowanie. Urządzenie otrzymuje niezależne poświadczenie, które można później odwołać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove apenas se você iniciou o emparelhamento. O dispositivo recebe uma credencial independente que pode ser revogada posteriormente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтверждайте, только если вы инициировали сопряжение. Устройство получает независимые учётные данные, которые можно отозвать позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca eşlemeyi siz başlattıysanız onaylayın. Cihaz, daha sonra iptal edilebilecek bağımsız bir kimlik bilgisi alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтверджуйте, лише якщо ви ініціювали сполучення. Пристрій отримує незалежні облікові дані, які можна відкликати пізніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ phê duyệt nếu bạn đã khởi tạo ghép nối. Thiết bị nhận được thông tin xác thực độc lập có thể bị thu hồi sau đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你主动发起配对时允许。该设备将获得可单独撤销的独立凭据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在你主動發起配對時核准。該裝置將獲得可稍後撤銷的獨立憑證。"
          }
        }
      }
    },
