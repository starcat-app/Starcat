    "settings.mcp.port.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digits only. Leave empty and tap Restart to use default port 5555."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能输入数字。留空后点「重启」将使用默认端口 5555。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能輸入數字。留空並點選「重新啟動」以使用預設連接埠 5555。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数字のみ。空のままにして再起動をタップすると、デフォルトポート5555が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫자만 입력 가능합니다. 비워 두고 다시 시작을 누르면 기본 포트 5555가 사용됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Ziffern. Leer lassen und auf „Neu starten“ tippen, um den Standardport 5555 zu verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffres uniquement. Laissez vide et appuyez sur Redémarrer pour utiliser le port par défaut 5555."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo dígitos. Déjalo vacío y pulsa Reiniciar para usar el puerto predeterminado 5555."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas dígitos. Deixe em branco e toque em Reiniciar para usar a porta padrão 5555."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cifre. Lascia vuoto e tocca Riavvia per usare la porta predefinita 5555."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только цифры. Оставьте пустым и нажмите «Перезапустить», чтобы использовать порт по умолчанию 5555."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen cijfers. Laat leeg en tik op Herstart om de standaardpoort 5555 te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko cyfry. Pozostaw puste i dotknij Uruchom ponownie, aby użyć domyślnego portu 5555."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише цифри. Залиште порожнім і натисніть «Перезапустити», щоб використовувати порт за замовчуванням 5555."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca rakamlar. Varsayılan port 5555'i kullanmak için boş bırakın ve Yeniden Başlat'a dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ chữ số. Để trống và nhấn Khởi động lại để dùng cổng mặc định 5555."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya angka. Kosongkan dan ketuk Mulai Ulang untuk menggunakan port default 5555."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرقام فقط. اتركه فارغًا واضغط على إعادة التشغيل لاستخدام المنفذ الافتراضي 5555."
          }
        }
      }
    },
    "settings.mcp.privateNotes.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow MCP tools to read repository private notes and reading status. Keep this off unless the connected agent should see that data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 MCP 工具读取仓库私有笔记和阅读状态。只有当连接的 Agent 应该看到这些数据时才开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 MCP 工具讀取儲存庫的私人筆記和閱讀狀態。除非已連接的 Agent 應看到該資料，否則請保持關閉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCPツールがリポジトリのプライベートノートと既読状態を読み取ることを許可します。接続されたエージェントがそのデータを表示する必要がある場合を除き、オフのままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 도구가 저장소의 개인 노트와 읽기 상태를 읽을 수 있도록 허용합니다. 연결된 에이전트가 해당 데이터를 확인해야 하는 경우가 아니라면 이 기능을 끄세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP-Tools erlauben, private Notizen und Lesestatus des Repositorys zu lesen. Deaktiviert lassen, es sei denn, der verbundene Agent soll diese Daten sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les outils MCP à lire les notes privées du dépôt et l'état de lecture. Désactivez cette option sauf si l'agent connecté doit voir ces données."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que las herramientas MCP lean las notas privadas del repositorio y el estado de lectura. Mantén esto desactivado a menos que el agente conectado deba ver esos datos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que ferramentas MCP leiam notas privadas e status de leitura do repositório. Mantenha desativado, a menos que o agente conectado precise ver esses dados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti agli strumenti MCP di leggere le note private del repository e lo stato di lettura. Tienilo disattivato a meno che l'agente connesso non debba vedere quei dati."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить инструментам MCP читать приватные заметки репозитория и статус чтения. Оставьте выключенным, если подключенный агент не должен видеть эти данные."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP-tools toestaan om privénotities en leesstatus van de repository te lezen. Houd dit uitgeschakeld tenzij de verbonden agent die gegevens mag zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól narzędziom MCP na odczyt prywatnych notatek repozytorium i statusu czytania. Wyłącz tę opcję, chyba że podłączony agent powinien widzieć te dane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити інструментам MCP читати приватні нотатки репозиторію та статус читання. Вимкніть, якщо підключений агент не повинен бачити ці дані."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP araçlarının depo özel notlarını ve okuma durumunu okumasına izin verin. Bağlı aracı bu verileri görmemeliyse kapalı tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép công cụ MCP đọc ghi chú riêng tư và trạng thái đọc của kho lưu trữ. Tắt nếu tác nhân kết nối không cần thấy dữ liệu đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan alat MCP membaca catatan pribadi repositori dan status bacaan. Matikan ini kecuali agen yang terhubung perlu melihat data tersebut."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح لأدوات MCP بقراءة الملاحظات الخاصة وحالة القراءة للمستودعات. أبقِ هذا الخيار معطلاً ما لم يكن الوكيل المتصل بحاجة لرؤية تلك البيانات."
          }
        }
      }
    },
