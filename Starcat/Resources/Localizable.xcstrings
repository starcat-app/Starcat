    "activity.announcement.activityV1.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activity now aggregates Starcat announcements, subscribed releases, recent stars, repository updates, and local suggestions. GitHub Events and Watch/Follow sources will be added after the local model is stable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活动页现在会聚合 Starcat 公告、已订阅 Release、最近星标、仓库更新和本地建议。GitHub Events 与 Watch/Follow 来源会在本地模型稳定后再接入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活動頁現在會聚合 Starcat 公告、已訂閱 Release、最近星標、倉庫更新和本地建議。GitHub Events 與 Watch/Follow 來源會在本地模型穩定後再接入。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティは、Starcatのお知らせ、購読リリース、最近のスター、リポジトリ更新、ローカル提案を集約します。GitHub EventsとWatch/Followソースは、ローカルモデルが安定した後に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활동은 이제 Starcat 공지, 구독한 릴리스, 최근 Star, 저장소 업데이트 및 로컬 제안을 집계합니다. GitHub Events 및 Watch/Follow 소스는 로컬 모델이 안정화된 후 추가됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktivität fasst jetzt Starcat-Ankündigungen, abonnierte Releases, kürzliche Sterne, Repository-Updates und lokale Vorschläge zusammen. GitHub-Ereignisse und Watch/Follow-Quellen werden hinzugefügt, sobald das lokale Modell stabil ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activité regroupe désormais les annonces Starcat, les versions suivies, les étoiles récentes, les mises à jour des dépôts et les suggestions locales. Les événements GitHub et les sources Watch/Follow seront ajoutés après la stabilisation du modèle local."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad ahora agrega anuncios de Starcat, lanzamientos suscritos, estrellas recientes, actualizaciones de repositorios y sugerencias locales. Las fuentes de Eventos de GitHub y Seguir/Seguidos se agregarán después de que el modelo local sea estable."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atividades agora agrega anúncios do Starcat, lançamentos inscritos, estrelas recentes, atualizações de repositórios e sugestões locais. Eventos do GitHub e fontes de Watch/Follow serão adicionados após o modelo local estar estável."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Attività ora aggrega annunci di Starcat, release seguite, stelle recenti, aggiornamenti dei repository e suggerimenti locali. Eventi GitHub e sorgenti Watch/Follow saranno aggiunte dopo che il modello locale sarà stabile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активность теперь объединяет объявления Starcat, подписанные релизы, недавние звёзды, обновления репозиториев и локальные предложения. События GitHub и источники Watch/Follow будут добавлены после стабилизации локальной модели."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activiteit verzamelt nu Starcat-aankondigingen, geabonneerde releases, recente sterren, repository-updates en lokale suggesties. GitHub Events en Watch/Follow-bronnen worden toegevoegd nadat het lokale model stabiel is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywność agreguje teraz ogłoszenia Starcat, subskrybowane wydania, ostatnie gwiazdki, aktualizacje repozytoriów i lokalne sugestie. Źródła GitHub Events i Watch/Follow zostaną dodane po ustabilizowaniu lokalnego modelu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активність тепер об'єднує оголошення Starcat, підписані релізи, нещодавні зірки, оновлення репозиторіїв та локальні пропозиції. Події GitHub та джерела Watch/Follow будуть додані після стабілізації локальної моделі."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinlik artık Starcat duyurularını, abone olunan sürümleri, son yıldızları, depo güncellemelerini ve yerel önerileri bir araya getiriyor. GitHub Etkinlikleri ve İzle/Takip kaynakları, yerel model kararlı hale geldikten sonra eklenecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoạt động hiện tổng hợp các thông báo của Starcat, bản phát hành đã đăng ký, sao gần đây, cập nhật kho lưu trữ và đề xuất cục bộ. Nguồn GitHub Events và Watch/Follow sẽ được thêm sau khi mô hình cục bộ ổn định."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitas sekarang mengumpulkan pengumuman Starcat, rilis yang diikuti, bintang terbaru, pembaruan repositori, dan saran lokal. Sumber GitHub Events dan Watch/Follow akan ditambahkan setelah model lokal stabil."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع النشاط الآن إعلانات Starcat، والإصدارات المشترك بها، والنجوم الحديثة، وتحديثات المستودعات، والاقتراحات المحلية. ستُضاف مصادر أحداث GitHub والمتابعة/المراقبة بعد استقرار النموذج المحلي."
          }
        }
      }
    },
