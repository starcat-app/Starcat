    "settings.storage.clearAll.sheet.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة الذاكرة المؤقتة القابلة لإعادة البناء فقط، وستُعاد تخزين هذه البيانات مؤقتًا حسب الحاجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur den wiederherstellbaren Cache entfernen; diese Daten werden bei Bedarf erneut zwischengespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only remove the reconstructible cache, and these data will be recached as needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo elimina la caché reconstruible; estos datos se volverán a almacenar en caché según sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime uniquement le cache reconstructible ; ces données seront remises en cache si nécessaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya hapus cache yang dapat dibangun ulang, dan data ini akan di-cache ulang sesuai kebutuhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove solo la cache ricostruibile; questi dati verranno ricaricati quando necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再構築可能なキャッシュのみを削除します。これらのデータは必要に応じて再キャッシュされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재구성 가능한 캐시만 제거하며, 필요에 따라 다시 캐시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder alleen de herbouwbare cache; deze gegevens worden indien nodig opnieuw gecachet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń tylko odtwarzalną pamięć podręczną; te dane zostaną ponownie zapisane w razie potrzeby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remova apenas o cache reconstruível, e esses dados serão recriados conforme necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляется только восстанавливаемый кэш; эти данные будут повторно кэшированы по мере необходимости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca yeniden oluşturulabilir önbelleği kaldırır, bu veriler ihtiyaç duyuldukça yeniden önbelleğe alınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляється лише відновлюваний кеш; ці дані будуть повторно закешовані за потреби."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ xóa bộ nhớ đệm có thể tái tạo và dữ liệu này sẽ được lưu lại khi cần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
