      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة النجمة من المستودعات المحددة (يتم تخطي العناصر غير المضافة مسبقًا)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sternmarkierung bei ausgewählten Repos entfernen (bereits entfernte werden übersprungen)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unstar selected repos (already-unstarred items are skipped)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar destacado de repositorios seleccionados (los ya sin destacar se omiten)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer l'étoile des dépôts sélectionnés (les éléments déjà sans étoile sont ignorés)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
