    "readme.translate.error.structureBroken" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model returned segment data that could not be aligned safely. Completed translations are kept; try again or switch model."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型返回的分段结果无法安全对齐，已保留完成的译文，请重试或切换模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型傳回的分段資料無法安全對齊。已保留完成的翻譯，請重試或切換模型。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルが安全に整列できないセグメントデータを返しました。完了した翻訳は保持されます。再試行するかモデルを切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델이 안전하게 정렬할 수 없는 세그먼트 데이터를 반환했습니다. 완료된 번역은 유지되며, 다시 시도하거나 모델을 전환하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell hat Segmentdaten zurückgegeben, die nicht sicher ausgerichtet werden konnten. Abgeschlossene Übersetzungen bleiben erhalten; versuchen Sie es erneut oder wechseln Sie das Modell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle a renvoyé des données de segment qui n'ont pas pu être alignées en toute sécurité. Les traductions terminées sont conservées ; réessayez ou changez de modèle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo devolvió datos de segmento que no pudieron alinearse de forma segura. Las traducciones completadas se conservan; inténtalo de nuevo o cambia de modelo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo retornou dados de segmento que não puderam ser alinhados com segurança. As traduções concluídas foram mantidas; tente novamente ou mude de modelo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello ha restituito dati segmentati che non possono essere allineati in modo sicuro. Le traduzioni completate sono mantenute; riprova o cambia modello."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель вернула сегментированные данные, которые не удалось безопасно выровнять. Завершённые переводы сохранены; попробуйте снова или смените модель."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het model retourneerde segmentgegevens die niet veilig konden worden uitgelijnd. Voltooide vertalingen blijven behouden; probeer het opnieuw of schakel over naar een ander model."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model zwrócił dane segmentów, których nie można bezpiecznie dopasować. Ukończone tłumaczenia są zachowane; spróbuj ponownie lub zmień model."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель повернула сегментовані дані, які не вдалося безпечно вирівняти. Завершені переклади збережено; спробуйте ще раз або змініть модель."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model, güvenli bir şekilde hizalanamayan segment verileri döndürdü. Tamamlanan çeviriler korunur; tekrar deneyin veya modeli değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình trả về dữ liệu phân đoạn không thể căn chỉnh an toàn. Các bản dịch đã hoàn thành được giữ lại; thử lại hoặc chuyển mô hình."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model mengembalikan data segmen yang tidak dapat disejajarkan dengan aman. Terjemahan yang selesai tetap disimpan; coba lagi atau ganti model."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد النموذج بيانات مقطعية لا يمكن محاذاتها بأمان. تم الاحتفاظ بالترجمات المكتملة؛ حاول مرة أخرى أو غيّر النموذج."
          }
        }
      }
    },
