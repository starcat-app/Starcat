    "about.copyright.paragraph2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم Starcat والأيقونة وتصميم واجهة المستخدم محمية بموجب قوانين حقوق النشر والعلامات التجارية. يُحظر إعادة إنتاج أو توزيع أو بيع أو إعادة نشر هذا البرنامج دون إذن كتابي صريح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name, das Symbol und das UI-Design von Starcat sind urheberrechtlich und markenrechtlich geschützt. Die Vervielfältigung, Verbreitung, der Verkauf oder die anderweitige Veröffentlichung dieser Software ohne ausdrückliche schriftliche Genehmigung ist untersagt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Starcat name, icon, and UI design are protected by copyright and trademark laws. Reproduction, distribution, sale, or other re-publication of this software without explicit written authorization is prohibited."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre, el icono y el diseño de la interfaz de Starcat están protegidos por leyes de derechos de autor y marcas comerciales. Queda prohibida la reproducción, distribución, venta o cualquier otra republicación de este software sin autorización explícita por escrito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom, l'icône et la conception de l'interface utilisateur de Starcat sont protégés par les lois sur le droit d'auteur et les marques. La reproduction, la distribution, la vente ou toute autre republication de ce logiciel sans autorisation écrite explicite est interdite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama, ikon, dan desain UI Starcat dilindungi oleh undang-undang hak cipta dan merek dagang. Reproduksi, distribusi, penjualan, atau publikasi ulang perangkat lunak ini tanpa izin tertulis eksplisit dilarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome, l'icona e il design dell'interfaccia di Starcat sono protetti da leggi sul copyright e sui marchi. La riproduzione, distribuzione, vendita o altra ripubblicazione di questo software senza esplicita autorizzazione scritta è vietata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatの名称、アイコン、UIデザインは著作権法および商標法で保護されています。明示的な書面による許可なく、本ソフトウェアの複製、配布、販売、その他の再公開を禁止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 이름, 아이콘 및 UI 디자인은 저작권 및 상표법에 의해 보호됩니다. 명시적인 서면 승인 없이 이 소프트웨어를 복제, 배포, 판매 또는 재발행하는 것은 금지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De naam, het pictogram en de UI-ontwerpen van Starcat worden beschermd door auteursrecht- en handelsmerkwetten. Reproductie, distributie, verkoop of andere herpublicatie van deze software zonder expliciete schriftelijke toestemming is verboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa, ikona i interfejs użytkownika Starcat są chronione prawem autorskim i znakami towarowymi. Powielanie, dystrybucja, sprzedaż lub inne publikowanie tego oprogramowania bez wyraźnej pisemnej zgody jest zabronione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome, ícone e design de interface do Starcat são protegidos por leis de direitos autorais e marcas registradas. A reprodução, distribuição, venda ou outra republicação deste software sem autorização explícita por escrito é proibida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Название, иконка и дизайн интерфейса Starcat защищены авторским правом и законами о товарных знаках. Воспроизведение, распространение, продажа или иная публикация этого программного обеспечения без явного письменного разрешения запрещены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat adı, simgesi ve kullanıcı arayüzü tasarımı telif hakkı ve ticari marka yasalarıyla korunmaktadır. Bu yazılımın açık yazılı izin olmadan çoğaltılması, dağıtılması, satılması veya başka şekilde yeniden yayımlanması yasaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назва, іконка та дизайн інтерфейсу Starcat захищені авторським правом і законами про товарні знаки. Відтворення, розповсюдження, продаж або інша публікація цього програмного забезпечення без явного письмового дозволу заборонена."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên, biểu tượng và thiết kế giao diện của Starcat được bảo vệ bởi luật bản quyền và nhãn hiệu. Nghiêm cấm sao chép, phân phối, bán hoặc tái xuất bản phần mềm này mà không có sự cho phép bằng văn bản rõ ràng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 名称、图标和界面设计受版权和商标相关法律保护。未经明确书面授权，不得复制、分发、出售或以其它方式重新发布本软件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 名稱、圖示與介面設計受著作權及商標法保護。未經明確書面授權，禁止複製、散布、銷售或以其他方式重新發布本軟體。"
          }
        }
      }
    },
    "about.copyright.paragraph3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub هي علامة تجارية مسجلة لشركة GitHub, Inc. Apple وmacOS وSwift هي علامات تجارية لشركة Apple Inc. Starcat ليست تابعة أو معتمدة أو مدعومة من أي من هذه الشركات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ist eine eingetragene Marke von GitHub, Inc. Apple, macOS und Swift sind Marken von Apple Inc. Starcat ist weder mit diesen Unternehmen verbunden, noch wird es von ihnen unterstützt oder gesponsert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub is a registered trademark of GitHub, Inc. Apple, macOS, and Swift are trademarks of Apple Inc. Starcat is not affiliated with, endorsed by, or sponsored by any of these companies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub es una marca registrada de GitHub, Inc. Apple, macOS y Swift son marcas comerciales de Apple Inc. Starcat no está afiliado, respaldado ni patrocinado por ninguna de estas empresas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub est une marque déposée de GitHub, Inc. Apple, macOS et Swift sont des marques d'Apple Inc. Starcat n'est affilié, approuvé ou parrainé par aucune de ces sociétés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub adalah merek dagang terdaftar dari GitHub, Inc. Apple, macOS, dan Swift adalah merek dagang dari Apple Inc. Starcat tidak berafiliasi, didukung, atau disponsori oleh perusahaan mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub è un marchio registrato di GitHub, Inc. Apple, macOS e Swift sono marchi di Apple Inc. Starcat non è affiliato, approvato o sponsorizzato da nessuna di queste società."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubはGitHub, Inc.の登録商標です。Apple、macOS、SwiftはApple Inc.の商標です。Starcatはこれらの企業と提携、承認、または支援を受けていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub는 GitHub, Inc.의 등록 상표입니다. Apple, macOS 및 Swift는 Apple Inc.의 상표입니다. Starcat는 이들 회사와 제휴, 보증 또는 후원 관계가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub is een geregistreerd handelsmerk van GitHub, Inc. Apple, macOS en Swift zijn handelsmerken van Apple Inc. Starcat is niet gelieerd aan, onderschreven door of gesponsord door een van deze bedrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub jest zastrzeżonym znakiem towarowym GitHub, Inc. Apple, macOS i Swift są znakami towarowymi Apple Inc. Starcat nie jest powiązany, zatwierdzony ani sponsorowany przez żadną z tych firm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub é uma marca registrada da GitHub, Inc. Apple, macOS e Swift são marcas registradas da Apple Inc. Starcat não é afiliado, endossado ou patrocinado por nenhuma dessas empresas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub является зарегистрированным товарным знаком GitHub, Inc. Apple, macOS и Swift являются товарными знаками Apple Inc. Starcat не аффилирован, не одобрен и не спонсируется ни одной из этих компаний."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub, GitHub, Inc. şirketinin tescilli ticari markasıdır. Apple, macOS ve Swift, Apple Inc. şirketinin ticari markalarıdır. Starcat, bu şirketlerden hiçbiriyle bağlantılı, onlar tarafından onaylanmış veya desteklenmiş değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub є зареєстрованою торговою маркою GitHub, Inc. Apple, macOS і Swift є торговими марками Apple Inc. Starcat не пов'язаний, не схвалений і не спонсорується жодною з цих компаній."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub là nhãn hiệu đã đăng ký của GitHub, Inc. Apple, macOS và Swift là nhãn hiệu của Apple Inc. Starcat không liên kết, được xác nhận hay tài trợ bởi bất kỳ công ty nào trong số này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 是 GitHub, Inc. 的注册商标。Apple、macOS 和 Swift 是 Apple Inc. 的商标。Starcat 与上述公司不存在从属或背书关系。"
          }
