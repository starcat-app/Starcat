    "authV2.pat.error.invalidToken" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token is invalid, expired, or revoked. Please check and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token 无效、已过期或被撤销，请检查后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token 無效、已過期或已被撤銷，請檢查後重試。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンが無効、期限切れ、または取り消されています。確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰이 유효하지 않거나 만료되었거나 취소되었습니다. 확인 후 다시 시도하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token ist ungültig, abgelaufen oder widerrufen. Bitte überprüfen und erneut versuchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton est invalide, expiré ou révoqué. Veuillez vérifier et réessayer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token no es válido, ha caducado o ha sido revocado. Verifícalo e inténtalo de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token é inválido, expirou ou foi revogado. Verifique e tente novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il token non è valido, è scaduto o è stato revocato. Controlla e riprova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токен недействителен, истёк или отозван. Проверьте и попробуйте снова."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token is ongeldig, verlopen of ingetrokken. Controleer en probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token jest nieprawidłowy, wygasł lub został odwołany. Sprawdź i spróbuj ponownie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токен недійсний, прострочений або відкликаний. Перевірте та спробуйте знову."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token geçersiz, süresi dolmuş veya iptal edilmiş. Lütfen kontrol edip tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token không hợp lệ, đã hết hạn hoặc bị thu hồi. Vui lòng kiểm tra và thử lại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
