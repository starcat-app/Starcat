    "rag.workspace.inspector.plan.help.executionStrategy.definition.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Starcat will query your local knowledge base: execution mode, repository filters, sorting, and optional structured analytics. This is the Planner's local retrieval plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Starcat 如何在本地知识库中检索：执行模式、仓库筛选、排序，以及可选的结构化统计。这是 Planner 给出的本地检索方案。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.executionStrategy.definition.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is execution strategy?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行策略是什么？"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.executionStrategy.field.analytics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics: optional structured aggregation over metadata (count, top-N, averages)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结构化分析：对元数据做聚合统计（计数、Top-N、均值等）。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.executionStrategy.field.candidateLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidate limit: maximum repositories entering the retrieval funnel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选上限：进入检索漏斗的仓库数量上限。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.executionStrategy.field.filters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters: repository constraints inferred from your question (language, stars, tags, etc.)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选条件：Planner 从问题推断的仓库约束（语言、Star 数、标签等）。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.executionStrategy.field.mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan mode: semantic-only, filtered semantic, structured-only, or guided discovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划模式：纯语义、带过滤语义、仅结构化，或引导发现。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.executionStrategy.field.sort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort: how candidate repositories are ordered before retrieval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序：检索前候选仓库的排列方式。"
          }
        }
      }
    },
