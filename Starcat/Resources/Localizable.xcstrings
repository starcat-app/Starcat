    "rag.workspace.inspector.metadata.help.availability.definition.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded chunks are intentionally hidden from retrieval. No README means no README source was built; no indexable source means the repository has no active, non-excluded RAG chunk from any source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排除分片不会参与召回；无 README 表示未生成 README 来源；无可索引来源表示该项目不存在任何未排除的 RAG 来源分片。"
          }
        }
      }
    },
    "rag.workspace.inspector.metadata.help.availability.definition.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why can retrieval miss?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么可能召回不到？"
          }
        }
      }
    },
