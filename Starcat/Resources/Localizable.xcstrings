    "rag.workspace.inspector.plan.help.repoContext.definition.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when Composer enables Deep Thinking with exactly one selected project. Starcat analyzes that repository's source tree, builds a context.xml, and injects it into the Generator prompt as {repoContextSection}. It does not run when Deep Thinking is off or when zero/multiple projects are selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Composer 开启「深度思考」且恰好选中 1 个项目时使用。Starcat 会分析该仓库源码树，生成 context.xml，并作为 {repoContextSection} 注入 Generator Prompt。未开启深度思考，或未选 / 多选项目时不会走这条链路。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.definition.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is project code?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目代码是什么？"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.field.budget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token budget: the packer budget from Settings used when building XML."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 预算：设置中的打包预算，用于生成 XML。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.repoContext.field.cache": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparation: reused an existing cache or generated XML this turn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成方式：复用已有缓存，或本轮重新生成 XML。"
          }
        }
