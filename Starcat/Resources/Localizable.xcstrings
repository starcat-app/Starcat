    "ai.client.error.responseTruncated" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اقتطاع استجابة الذكاء الاصطناعي بسبب حد الرموز المميزة الأقصى. قم بزيادة الحد الأقصى للرموز أو تقصير الإدخال."
