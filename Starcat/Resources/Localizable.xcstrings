    "about.privacy.futureCloud.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزامنة CloudKit تكون فقط لحاوية iCloud الخاصة بالمستخدم؛ سيتم توفير مفتاح تشغيل صريح ومدخل لإدارة البيانات في الإعدادات قبل الإصدار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit-Synchronisierung erfolgt nur im eigenen iCloud-Container des Benutzers; vor der Veröffentlichung wird in den Einstellungen ein expliziter Schalter und ein Datenverwaltungseintrag bereitgestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit sync is only for the user's own iCloud container; explicit switch and data management entry will be provided in Settings before release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización con CloudKit es solo para el contenedor iCloud del usuario; se proporcionará un interruptor explícito y una entrada de gestión de datos en Configuración antes del lanzamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation CloudKit est réservée au propre conteneur iCloud de l'utilisateur ; un interrupteur explicite et une entrée de gestion des données seront fournis dans les Réglages avant la publication."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi CloudKit hanya untuk wadah iCloud pengguna sendiri; sakelar eksplisit dan entri manajemen data akan disediakan di Pengaturan sebelum rilis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione CloudKit è solo per il contenitore iCloud dell'utente; un interruttore esplicito e una voce di gestione dei dati saranno forniti in Impostazioni prima del rilascio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit同期はユーザー自身のiCloudコンテナのみを対象とし、リリース前に設定で明示的なスイッチとデータ管理エントリを提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit 동기화는 사용자 자신의 iCloud 컨테이너에만 해당됩니다. 출시 전에 설정에서 명시적 스위치와 데이터 관리 항목이 제공됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit-synchronisatie is alleen voor de eigen iCloud-container van de gebruiker; expliciete schakelaar en gegevensbeheeroptie worden vóór de release in Instellingen geplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja CloudKit dotyczy tylko własnego kontenera iCloud użytkownika; przed wydaniem w Ustawieniach zostanie dodany wyraźny przełącznik i wpis zarządzania danymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização do CloudKit é apenas para o próprio contêiner iCloud do usuário; uma chave explícita e entrada de gerenciamento de dados serão fornecidas em Configurações antes do lançamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация CloudKit предназначена только для собственного контейнера iCloud пользователя; перед релизом в настройках будет предоставлен явный переключатель и запись управления данными."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit senkronizasyonu yalnızca kullanıcının kendi iCloud kapsayıcısı içindir; sürümden önce Ayarlar'da açık bir anahtar ve veri yönetimi girişi sağlanacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізація CloudKit призначена лише для власного контейнера iCloud користувача; перед випуском у налаштуваннях буде надано явний перемикач та запис керування даними."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ CloudKit chỉ dành cho vùng chứa iCloud của riêng người dùng; công tắc rõ ràng và mục quản lý dữ liệu sẽ được cung cấp trong Cài đặt trước khi phát hành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit 同步只用于用户自己的 iCloud 容器，发布前会在设置页提供明确开关与数据管理入口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit 同步僅用於用戶自己的 iCloud 容器，發布前會在設定頁提供明確開關與資料管理入口。"
          }
        }
      }
    },
