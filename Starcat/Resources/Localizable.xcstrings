    "settings.pro.direct.deactivate.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيفقد جهاز Mac هذا وصول Pro. يمكنك تنشيط الترخيص مرة أخرى على جهاز Mac آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac verliert den Pro-Zugriff. Sie können die Lizenz auf einem anderen Mac erneut aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac will lose Pro access. You can activate the license again on another Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac perderá el acceso Pro. Puedes activar la licencia nuevamente en otro Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac perdra l'accès Pro. Vous pouvez réactiver la licence sur un autre Mac."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini akan kehilangan akses Pro. Anda dapat mengaktifkan lisensi lagi di Mac lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac perderà l'accesso Pro. Puoi attivare nuovamente la licenza su un altro Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacはProアクセスを失います。別のMacでライセンスを再有効化できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 Pro 액세스가 손실됩니다. 다른 Mac에서 라이선스를 다시 활성화할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac verliest Pro-toegang. U kunt de licentie op een andere Mac opnieuw activeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Mac straci dostęp Pro. Możesz ponownie aktywować licencję na innym Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac perderá o acesso Pro. Você pode ativar a licença novamente em outro Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac потеряет доступ Pro. Вы сможете активировать лицензию на другом Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac Pro erişimini kaybedecek. Lisansı başka bir Mac'te etkinleştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей Mac втратить доступ до Pro. Ви зможете активувати ліцензію на іншому Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy Mac này sẽ mất quyền truy cập Pro. Bạn có thể kích hoạt lại giấy phép trên máy Mac khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 将失去 Pro 权益。你可以在另一台 Mac 上重新激活该许可证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 將失去 Pro 存取權。您可以在另一台 Mac 上重新啟用該授權。"
          }
        }
      }
    },
