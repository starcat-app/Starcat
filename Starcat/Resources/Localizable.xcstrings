    "agent.workspace.inspector.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View, copy, and export artifacts from this Agent run; inspect execution in the middle trace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看、复制、导出本轮 Agent 产出物；执行过程在中栏 trace 中审计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視、複製和匯出此 Agent 執行的產出物；在中間追蹤中檢查執行過程。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェント実行からアーティファクトを表示、コピー、エクスポートします。中央のトレースで実行を検査します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 에이전트 실행에서 아티팩트를 보고, 복사하고, 내보냅니다. 중간 추적에서 실행을 검사합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artefakte aus dieser Agent-Ausführung anzeigen, kopieren und exportieren; Ausführung in der mittleren Spur prüfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher, copier et exporter les artefacts de cette exécution de l'agent ; inspecter l'exécution dans la trace centrale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve, copia y exporta artefactos de esta ejecución del agente; inspecciona la ejecución en la traza central."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizar, copiar e exportar artefatos desta execução do Agente; inspecionar a execução no rastro central."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza, copia ed esporta artefatti da questa esecuzione dell'agente; ispeziona l'esecuzione nella traccia centrale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просматривайте, копируйте и экспортируйте артефакты из этого запуска агента; проверяйте выполнение в средней трассировке."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk, kopieer en exporteer artefacten van deze Agent-uitvoering; inspecteer uitvoering in de middelste trace."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlaj, kopiuj i eksportuj artefakty z tego uruchomienia agenta; sprawdzaj wykonanie w środkowym śladzie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переглядайте, копіюйте та експортуйте артефакти з цього запуску агента; перевіряйте виконання в середній трасі."
          }
        },
        "tr" : {
          "stringUnit" : {
