    },
    "githubStarLists.error.orgOAuthRestricted.impact" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat cannot update this repository's list membership through the GitHub API."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 无法通过 GitHub API 修改该仓库的分组。"
          }
        }
      }
    },
    "githubStarLists.error.orgOAuthRestricted.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This repository belongs to an organization that restricts third-party OAuth App access. Starcat cannot update its GitHub list membership through the API. If you are only a starrer, you may not have a way to request approval; you can still change this list on GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该仓库所属组织限制了第三方 OAuth App 访问。Starcat 无法通过 GitHub API 修改它的分组。如果你只是普通 Star 用户，通常没有可申请授权的入口；你仍然可以在 GitHub 网页端手动操作。"
          }
        }
      }
    },
    "githubStarLists.error.orgOAuthRestricted.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a token scope issue or a local data error. It is GitHub's organization-level OAuth App policy, and ordinary starrers may not have an approval path."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是 token scope 或本地数据错误，而是 GitHub 组织级 OAuth App 策略；普通 Star 用户通常没有可申请授权的入口。"
          }
        }
      }
    },
    "githubStarLists.error.orgOAuthRestricted.reason" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
