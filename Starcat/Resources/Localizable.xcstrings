    "settings.ai.task.noAvailableModel" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(لا يوجد نموذج متاح — اختبر النماذج وجلبها، أو فعّل النموذج المخصص)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Kein verfügbares Modell – testen und Modelle abrufen oder benutzerdefiniertes Modell aktivieren)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(No available model — test and fetch models, or turn on Custom model)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(No hay modelo disponible: prueba y obtén modelos, o activa \"Modelo personalizado\")"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Aucun modèle disponible — testez et récupérez les modèles, ou activez le modèle personnalisé)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Tidak ada model tersedia — uji dan ambil model, atau aktifkan Model kustom)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Nessun modello disponibile — testa e recupera modelli, o attiva Modello personalizzato)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（利用可能なモデルがありません。テストしてモデルを取得するか、カスタムモデルをオンにしてください）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(사용 가능한 모델 없음 — 모델을 테스트 및 가져오거나 사용자 정의 모델을 켜십시오)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Geen beschikbaar model — test en haal modellen op, of schakel 'Aangepast model' in)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
