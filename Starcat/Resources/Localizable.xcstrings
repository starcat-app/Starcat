          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预留输出：为模型回答保留的分片；不计入顶部占用百分比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
