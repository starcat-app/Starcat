    "settings.storage.resetAll.completed.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat has signed out locally and removed the selected user's local database, caches, generated files, settings, and local credentials. Restart Starcat, or quit and reopen it manually, then sign in again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 已在本机退出登录，并移除当前用户的本地数据库、缓存、生成文件、设置和本机凭据。你可以重启 Starcat，或退出后手动重新打开应用，然后重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 已在本機登出，並移除所選使用者的本地資料庫、快取、產生的檔案、設定和本機憑證。請重新啟動 Starcat，或手動結束並重新開啟，然後重新登入。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatはローカルでサインアウトし、選択したユーザーのローカルデータベース、キャッシュ、生成ファイル、設定、ローカル認証情報を削除しました。Starcatを再起動するか、終了して手動で再度開き、サインインし直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat이 로컬에서 로그아웃하고 선택한 사용자의 로컬 데이터베이스, 캐시, 생성된 파일, 설정 및 로컬 자격 증명을 제거했습니다. Starcat을 다시 시작하거나 종료 후 다시 열고 로그인하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat hat sich lokal abgemeldet und die lokale Datenbank, Caches, generierte Dateien, Einstellungen und lokale Anmeldedaten des ausgewählten Benutzers entfernt. Starten Sie Starcat neu oder beenden und öffnen Sie es manuell erneut, und melden Sie sich dann wieder an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat s'est déconnecté localement et a supprimé la base de données locale, les caches, les fichiers générés, les réglages et les identifiants locaux de l'utilisateur sélectionné. Redémarrez Starcat, ou quittez-le et rouvrez-le manuellement, puis reconnectez-vous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat ha cerrado sesión localmente y ha eliminado la base de datos local, cachés, archivos generados, ajustes y credenciales locales del usuario seleccionado. Reinicia Starcat, o ciérralo y ábrelo manualmente, luego inicia sesión de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starcat fez logout localmente e removeu o banco de dados local, caches, arquivos gerados, configurações e credenciais locais do usuário selecionado. Reinicie o Starcat, ou saia e reabra-o manualmente, e faça login novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat ha effettuato il logout locale e rimosso il database locale, le cache, i file generati, le impostazioni e le credenziali locali dell'utente selezionato. Riavvia Starcat, oppure esci e riaprilo manualmente, quindi accedi di nuovo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat выполнил локальный выход и удалил локальную базу данных, кеши, сгенерированные файлы, настройки и учётные данные выбранного пользователя. Перезапустите Starcat или закройте и откройте его вручную, затем войдите снова."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat is lokaal afgemeld en heeft de lokale database, caches, gegenereerde bestanden, instellingen en lokale inloggegevens van de geselecteerde gebruiker verwijderd. Start Starcat opnieuw op of sluit het af en open het handmatig opnieuw, en meld je vervolgens opnieuw aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat wylogował się lokalnie i usunął lokalną bazę danych, pamięci podręczne, wygenerowane pliki, ustawienia i poświadczenia wybranego użytkownika. Uruchom ponownie Starcat lub zamknij i otwórz go ręcznie, a następnie zaloguj się ponownie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat вийшов із системи локально та видалив локальну базу даних, кеші, згенеровані файли, налаштування та локальні облікові дані вибраного користувача. Перезапустіть Starcat або закрийте та відкрийте його вручну, потім увійдіть знову."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat yerel olarak oturumu kapattı ve seçilen kullanıcının yerel veritabanını, önbelleklerini, oluşturulan dosyalarını, ayarlarını ve yerel kimlik bilgilerini kaldırdı. Starcat'ı yeniden başlatın veya manuel olarak kapatıp tekrar açın, ardından yeniden oturum açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat đã đăng xuất cục bộ và xóa cơ sở dữ liệu cục bộ, bộ nhớ đệm, tệp đã tạo, cài đặt và thông tin xác thực cục bộ của người dùng đã chọn. Khởi động lại Starcat, hoặc thoát và mở lại thủ công, sau đó đăng nhập lại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat telah keluar secara lokal dan menghapus database lokal, cache, file yang dihasilkan, pengaturan, dan kredensial lokal pengguna yang dipilih. Mulai ulang Starcat, atau keluar dan buka kembali secara manual, lalu masuk lagi."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قام Starcat بتسجيل الخروج محليًا وأزال قاعدة البيانات المحلية للمستخدم المحدد، والذاكرة المؤقتة، والملفات المنشأة، والإعدادات، وبيانات الاعتماد المحلية. أعد تشغيل Starcat، أو أغلقه وافتحه يدويًا، ثم سجل الدخول مرة أخرى."
          }
        }
      }
    },
