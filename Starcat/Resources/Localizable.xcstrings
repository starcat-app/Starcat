    "error.user.unknown.recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again. If it repeats, export debug logs and send them to dong4j."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重试；如果重复出现，请导出调试日志发给 dong4j。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請重試。若重複發生，請匯出除錯日誌並傳送給 dong4j。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度お試しください。繰り返す場合は、デバッグログをエクスポートしてdong4jに送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시도하세요. 반복되면 디버그 로그를 내보내 dong4j에게 보내주세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie es erneut. Wenn das Problem wiederholt auftritt, exportieren Sie Debug-Protokolle und senden Sie sie an dong4j."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez. Si le problème se répète, exportez les journaux de débogage et envoyez-les à dong4j."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo. Si se repite, exporta los registros de depuración y envíalos a dong4j."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente novamente. Se repetir, exporte os registros de depuração e envie para dong4j."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprova. Se si ripete, esporta i log di debug e inviali a dong4j."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите попытку. Если ошибка повторится, экспортируйте отладочные логи и отправьте их dong4j."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer het opnieuw. Als het zich herhaalt, exporteer dan debuglogs en stuur ze naar dong4j."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj ponownie. Jeśli problem się powtarza, wyeksportuj logi debugowania i wyślij je do dong4j."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте знову. Якщо проблема повториться, експортуйте журнали налагодження та надішліть їх dong4j."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar deneyin. Tekrarlarsa, hata ayıklama günlüklerini dışa aktarın ve dong4j'e gönderin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thử lại. Nếu lặp lại, hãy xuất nhật ký gỡ lỗi và gửi cho dong4j."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba lagi. Jika berulang, ekspor log debug dan kirimkan ke dong4j."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول مرة أخرى. إذا تكرر الأمر، قم بتصدير سجلات التصحيح وأرسلها إلى dong4j."
          }
        }
      }
    },
