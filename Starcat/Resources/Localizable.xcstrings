          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI sağlayıcı kimlik bilgisini reddetti. AI Ayarları'nda API anahtarını güncelleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постачальник AI відхилив облікові дані. Оновіть API-ключ у налаштуваннях AI."
