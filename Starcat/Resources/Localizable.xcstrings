    "rag.workspace.addToLibrary.emptyCandidatesSubtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتمييز المزيد من المستودعات على GitHub، أو افتح متصفح المعرفة لمراجعة ما أضفته بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star mehr Repositories auf GitHub oder öffne den Wissensbrowser, um zu überprüfen, was du bereits hinzugefügt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star more repositories on GitHub, or open the knowledge browser to review what you already added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque más repositorios en GitHub, o abra el navegador de conocimiento para revisar lo que ya añadió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d'autres dépôts sur GitHub, ou ouvrez le navigateur de connaissances pour revoir ce que vous avez déjà ajouté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri bintang lebih banyak repositori di GitHub, atau buka peramban pengetahuan untuk meninjau yang sudah ditambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi altre stelle su GitHub o apri il browser della knowledge base per rivedere ciò che hai già aggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubでさらにリポジトリをスターするか、ナレッジブラウザを開いて追加済みのものを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub에서 저장소를 더 Star하거나, 지식 브라우저를 열어 이미 추가한 내용을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer meer repositories op GitHub, of open de kennisbankbrowser om te bekijken wat je al hebt toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz więcej repozytoriów gwiazdką na GitHubie lub otwórz przeglądarkę wiedzy, aby przejrzeć już dodane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque mais repositórios com estrela no GitHub ou abra o navegador de conhecimento para revisar o que já foi adicionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте больше репозиториев на GitHub или откройте обозреватель знаний, чтобы просмотреть уже добавленные."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub'da daha fazla depo yıldızlayın veya bilgi tarayıcısını açarak daha önce eklediklerinizi gözden geçirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначте більше репозиторіїв на GitHub або відкрийте браузер знань, щоб переглянути додані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy star thêm kho lưu trữ trên GitHub, hoặc mở trình duyệt tri thức để xem lại những gì bạn đã thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
