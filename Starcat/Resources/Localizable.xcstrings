    "settings.storage.clearRecommendation.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة جميع نتائج المستودعات المشابهة المخزنة مؤقتًا. في المرة القادمة التي تفتح فيها تفاصيل مستودع، سيتم جلب التوصيات مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle zwischengespeicherten Ergebnisse für ähnliche Repos werden entfernt. Beim nächsten Öffnen eines Repo-Details werden die Empfehlungen erneut abgerufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All cached similar-repository results will be removed. The next time you open a repo detail, recommendations will be fetched again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los resultados cacheados de repositorios similares. La próxima vez que abras un detalle de repositorio, las recomendaciones se obtendrán de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les résultats de dépôts similaires mis en cache seront supprimés. La prochaine fois que vous ouvrirez un détail de dépôt, les recommandations seront récupérées à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua hasil repositori serupa yang di-cache akan dihapus. Saat Anda membuka detail repo lagi, rekomendasi akan diambil ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i risultati di repository simili memorizzati nella cache verranno rimossi. La prossima volta che aprirai un dettaglio del repository, le raccomandazioni verranno recuperate di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュされたすべての類似リポジトリ結果が削除されます。次にリポジトリ詳細を開いたときに、おすすめが再度取得されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시된 모든 유사 저장소 결과가 제거됩니다. 다음에 저장소 상세를 열 때 추천을 다시 가져옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gecachte resultaten van vergelijkbare repositories worden verwijderd. De volgende keer dat je een repo-detail opent, worden aanbevelingen opnieuw opgehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie zapisane wyniki podobnych repozytoriów zostaną usunięte. Przy następnym otwarciu szczegółów repozytorium rekomendacje zostaną pobrane ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os resultados em cache de repositórios similares serão removidos. Na próxima vez que você abrir os detalhes de um repositório, as recomendações serão buscadas novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все кешированные результаты похожих репозиториев будут удалены. При следующем открытии деталей репозитория рекомендации будут загружены заново."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önbelleğe alınmış tüm benzer-depo sonuçları kaldırılacak. Bir sonraki depo detayını açtığınızda öneriler yeniden getirilecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі кешовані результати схожих репозиторіїв буде видалено. Наступного разу, коли ви відкриєте деталі репозиторію, рекомендації буде отримано знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả kết quả kho lưu trữ tương tự đã lưu trong bộ nhớ đệm sẽ bị xóa. Lần tới khi bạn mở chi tiết kho lưu trữ, các đề xuất sẽ được tải lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有缓存的相似推荐结果都会被删除。下次打开 repo 详情时会重新拉取推荐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有缓存的相似推荐结果都会被删除。下次打开仓库详情时会重新获取推荐。"
          }
        }
      }
    },
