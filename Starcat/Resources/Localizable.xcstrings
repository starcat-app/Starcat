    "settings.mcp.agentSetup.cli.manual.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ أمر install.sh الرسمي وشغّله في Terminal. الوجهة الافتراضية هي ~/.local/bin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie den offiziellen install.sh-Befehl und führen Sie ihn im Terminal aus. Das Standardziel ist ~/.local/bin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the official install.sh command and run it in Terminal. The default destination is ~/.local/bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el comando oficial install.sh y ejecútalo en Terminal. El destino predeterminado es ~/.local/bin."
