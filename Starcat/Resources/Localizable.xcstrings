    "settings.pro.benefit.confetti.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a confetti animation right after a simulated activation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟开通成功后立即播放彩纸动画。"
          }
        }
      }
    },
    "settings.pro.benefit.confetti.title": {
