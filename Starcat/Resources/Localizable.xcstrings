    "rag.workspace.retrieval.perRepositoryLimit.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأقصى لعدد الأجزاء المُحتفظ بها من نفس المستودع. يختار النظام الأجزاء بالترتيب النهائي؛ بعد أن يصل المستودع إلى هذا الحد، يتم تخطي أجزائه اللاحقة وتستمر أجزاء المستودعات الأخرى في ملء النتيجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl von Chunks, die aus demselben Repository beibehalten werden. Das System wählt Chunks in der endgültigen Reihenfolge aus; nachdem ein Repository dieses Limit erreicht hat, werden seine späteren Chunks übersprungen und Chunks aus anderen Repositorys füllen das Ergebnis weiter auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum number of chunks retained from the same repository. The system selects chunks in final order; after a repository reaches this limit, its later chunks are skipped and chunks from other repositories continue to fill the result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de fragmentos retenidos del mismo repositorio. El sistema selecciona fragmentos en orden final; después de que un repositorio alcanza este límite, sus fragmentos posteriores se omiten y los fragmentos de otros repositorios continúan llenando el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximum de fragments conservés du même dépôt. Le système sélectionne les fragments dans l'ordre final ; après qu'un dépôt atteint cette limite, ses fragments suivants sont ignorés et les fragments d'autres dépôts continuent à remplir le résultat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah maksimum potongan yang dipertahankan dari repositori yang sama. Sistem memilih potongan dalam urutan akhir; setelah repositori mencapai batas ini, potongan selanjutnya dilewati dan potongan dari repositori lain terus mengisi hasil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero massimo di blocchi conservati dallo stesso repository. Il sistema seleziona i blocchi in ordine finale; dopo che un repository raggiunge questo limite, i suoi blocchi successivi vengono saltati e i blocchi di altri repository continuano a riempire il risultato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じリポジトリから保持されるチャンクの最大数。システムは最終順序でチャンクを選択します。リポジトリがこの制限に達すると、それ以降のチャンクはスキップされ、他のリポジトリのチャンクが結果を埋め続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동일한 저장소에서 유지되는 최대 청크 수입니다. 시스템은 최종 순서로 청크를 선택하며, 저장소가 이 제한에 도달하면 이후 청크는 건너뛰고 다른 저장소의 청크가 결과를 채웁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum aantal brokken dat uit dezelfde repository wordt behouden. Het systeem selecteert brokken in uiteindelijke volgorde; nadat een repository deze limiet heeft bereikt, worden de latere brokken overgeslagen en vullen brokken uit andere repositories het resultaat aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna liczba fragmentów zachowanych z tego samego repozytorium. System wybiera fragmenty w końcowej kolejności; po osiągnięciu limitu przez repozytorium, jego późniejsze fragmenty są pomijane, a fragmenty z innych repozytoriów wypełniają wynik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de fragmentos retidos do mesmo repositório. O sistema seleciona fragmentos na ordem final; após um repositório atingir este limite, seus fragmentos posteriores são ignorados e fragmentos de outros repositórios continuam a preencher o resultado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное количество фрагментов, сохраняемых из одного репозитория. Система выбирает фрагменты в итоговом порядке; после достижения лимита для репозитория его последующие фрагменты пропускаются, а фрагменты из других репозиториев продолжают заполнять результат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı depodan korunan maksimum parça sayısı. Sistem parçaları nihai sıraya göre seçer; bir depo bu limite ulaştığında, sonraki parçaları atlanır ve diğer depolardan gelen parçalar sonucu doldurmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальна кількість фрагментів, що зберігаються з одного репозиторію. Система вибирає фрагменти в остаточному порядку; після досягнення цього ліміту репозиторієм його наступні фрагменти пропускаються, а фрагменти з інших репозиторіїв продовжують заповнювати результат."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lượng khối tối đa được giữ lại từ cùng một kho lưu trữ. Hệ thống chọn các khối theo thứ tự cuối cùng; sau khi một kho lưu trữ đạt đến giới hạn này, các khối sau của nó bị bỏ qua và các khối từ kho lưu trữ khác tiếp tục lấp đầy kết quả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一仓库最多保留多少条分片。系统按重排后的顺序逐条选择；仓库达到上限后，会跳过该仓库后续分片，继续选择其他仓库的分片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一倉庫最多保留多少條分片。系統按重排後的順序逐條選取；倉庫達到上限後，會跳過該倉庫後續分片，繼續選取其他倉庫的分片。"
          }
        }
      }
    },
