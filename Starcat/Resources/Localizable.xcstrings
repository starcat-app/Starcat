    "settings.pro.direct.devices.deactivate.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device will lose access to Starcat Pro until the license is activated again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备将失去 Starcat Pro 权益，直到再次激活该许可证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置將失去 Starcat Pro 存取權，直到再次啟用授權。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは、ライセンスが再度有効化されるまでStarcat Proにアクセスできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 라이선스가 다시 활성화될 때까지 Starcat Pro에 접근할 수 없습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät verliert den Zugriff auf Starcat Pro, bis die Lizenz erneut aktiviert wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil perdra l’accès à Starcat Pro jusqu’à ce que la licence soit réactivée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo perderá el acceso a Starcat Pro hasta que la licencia se active de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo perderá o acesso ao Starcat Pro até que a licença seja ativada novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo perderà l'accesso a Starcat Pro fino a quando la licenza non verrà riattivata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство потеряет доступ к Starcat Pro до повторной активации лицензии."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat verliest toegang tot Starcat Pro totdat de licentie opnieuw wordt geactiveerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie straci dostęp do Starcat Pro do czasu ponownej aktywacji licencji."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій втратить доступ до Starcat Pro, доки ліцензію не буде активовано знову."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz, lisans yeniden etkinleştirilene kadar Starcat Pro'ya erişemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này sẽ mất quyền truy cập Starcat Pro cho đến khi giấy phép được kích hoạt lại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini akan kehilangan akses ke Starcat Pro hingga lisensi diaktifkan kembali."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيفقد هذا الجهاز الوصول إلى Starcat Pro حتى يتم تنشيط الترخيص مرة أخرى."
          }
        }
      }
    },
