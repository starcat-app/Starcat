    "agent.definition.untaggedTidy.defaultPrompt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan a tag taxonomy for my uncategorized starred repos. Preview first and do not write automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帮我给未分类的 starred repo 规划一套 tag 体系，先预览，不要自动写入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幫我為未分類的 starred repo 規劃一套 tag 體系，先預覽，不要自動寫入。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未分類のスター付きリポジトリにタグ分類を計画してください。まずプレビューし、自動書き込みはしないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분류되지 않은 별표 표시한 저장소를 위한 태그 분류 체계를 계획합니다. 미리 보고 자동으로 작성하지 마세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane eine Tag-Taxonomie für meine unkategorisierten markierten Repos. Vorschau zuerst und nicht automatisch schreiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifier une taxonomie d'étiquettes pour mes dépôts favoris non catégorisés. Prévisualiser d'abord et ne pas écrire automatiquement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica una taxonomía de etiquetas para mis repositorios destacados sin categorizar. Primero previsualiza y no escribas automáticamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planejar uma taxonomia de tags para meus repositórios favoritados não categorizados. Visualizar primeiro e não escrever automaticamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica una tassonomia di tag per i miei repository con stella non categorizzati. Mostra prima un'anteprima e non scrivere automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спланируй таксономию тегов для моих некатегоризированных репозиториев. Сначала покажи предпросмотр и не записывай автоматически."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan een tagtaxonomie voor mijn ongecategoriseerde gemarkeerde repos. Eerst voorbeeld bekijken en niet automatisch schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanuj taksonomię tagów dla moich nieskategoryzowanych repozytoriów oznaczonych gwiazdką. Najpierw podgląd, nie zapisuj automatycznie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спланувати таксономію тегів для моїх некатегоризованих репозиторіїв з зірочками. Спочатку показати попередній перегляд і не записувати автоматично."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorize edilmemiş yıldızlı depolarım için bir etiket taksonomisi planla. Önce önizle ve otomatik olarak yazma."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lập kế hoạch phân loại thẻ cho các kho lưu trữ chưa phân loại của tôi. Xem trước trước và không tự động ghi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rencanakan taksonomi tag untuk repositori berbintang saya yang tidak terkategori. Pratinjau dulu dan jangan tulis secara otomatis."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطط لتصنيف وسوم لمستودعاتي المميزة بنجمة غير المصنفة. قم بالمعاينة أولاً ولا تكتب تلقائيًا."
          }
        }
      }
    },
