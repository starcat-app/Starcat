    "rag.workspace.empty.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم @ لتحديد مستودع واحد أو أكثر من قاعدة المعرفة، أو اسأل عبر قاعدة المعرفة بأكملها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie @, um ein oder mehrere Repositories der Wissensdatenbank auszuwählen oder fragen Sie die gesamte Wissensdatenbank ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use @ to select one or more knowledge-base repositories, or ask across the whole knowledge base."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use @ para seleccionar uno o más repositorios de la base de conocimiento, o pregunte en toda la base de conocimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez @ pour sélectionner un ou plusieurs dépôts de la base de connaissances, ou interrogez l'ensemble de la base de connaissances."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan @ untuk memilih satu atau lebih repositori basis pengetahuan, atau bertanya di seluruh basis pengetahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa @ per selezionare uno o più repository della knowledge base, o chiedi all'intera knowledge base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@ を使用して 1 つ以上のナレッジベースリポジトリを選択するか、ナレッジベース全体に質問してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@를 사용하여 하나 이상의 지식 베이스 리포지토리를 선택하거나 전체 지식 베이스에 질문하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik @ om een of meer kennisbank-repositories te selecteren, of stel een vraag over de hele kennisbank."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj @, aby wybrać jedno lub więcej repozytoriów bazy wiedzy, lub zadaj pytanie w całej bazie wiedzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use @ para selecionar um ou mais repositórios da base de conhecimento ou pergunte em toda a base de conhecimento."
          }
