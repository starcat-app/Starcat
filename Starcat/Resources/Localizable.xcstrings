    "settings.undoStar.deleteNowMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All undo star records older than the current retention period will be permanently deleted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过当前保留时间的所有 Unstar 记录将被永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過目前保留期限的所有取消星號記錄將被永久刪除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の保持期間より古いすべてのアンドゥスター記録が完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 보존 기간보다 오래된 모든 실행 취소 별표 기록이 영구적으로 삭제됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Stern-Rückgängig-Datensätze, die älter als der aktuelle Aufbewahrungszeitraum sind, werden endgültig gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les enregistrements d'annulation d'étoile plus anciens que la période de conservation actuelle seront définitivement supprimés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los registros de deshacer estrella anteriores al período de retención actual se eliminarán permanentemente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os registros de desfazer estrela mais antigos que o período de retenção atual serão permanentemente excluídos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i record di stella annullata più vecchi del periodo di conservazione corrente verranno eliminati definitivamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все записи отмены звёзд, старше текущего срока хранения, будут безвозвратно удалены."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle ongedaan maak-ster-records ouder dan de huidige bewaarperiode worden permanent verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie rekordy cofnięcia gwiazdki starsze niż bieżący okres przechowywania zostaną trwale usunięte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі записи скасування зірок, старіші за поточний термін зберігання, буде остаточно видалено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli saklama süresinden daha eski tüm geri alma yıldızı kayıtları kalıcı olarak silinecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả các bản ghi sao hoàn tác cũ hơn thời gian lưu giữ hiện tại sẽ bị xóa vĩnh viễn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua catatan undo star yang lebih lama dari periode retensi saat ini akan dihapus secara permanen."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف جميع سجلات نجمة التراجع الأقدم من فترة الاحتفاظ الحالية بشكل دائم."
          }
        }
      }
    },
