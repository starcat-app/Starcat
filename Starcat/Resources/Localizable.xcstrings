    "explore.help.weekly.cache.offline" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعامل دون اتصال: إذا فشل التحديث، يظل آخر تخزين مؤقت ناجح متاحًا للتصفح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline-Verhalten: Bei fehlgeschlagenem Update bleibt der letzte erfolgreiche Cache zum Durchsuchen verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline handling: if the update fails, the last successful cache remains available for browsing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manejo sin conexión: si la actualización falla, la última caché exitosa permanece disponible para navegación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestion hors ligne : si la mise à jour échoue, le dernier cache réussi reste disponible pour la navigation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penanganan offline: jika pembaruan gagal, cache terakhir yang berhasil tetap tersedia untuk dijelajahi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestione offline: se l'aggiornamento fallisce, l'ultima cache valida rimane disponibile per la navigazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン処理：更新に失敗した場合、最後に成功したキャッシュは引き続き閲覧可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 처리: 업데이트가 실패하면 마지막으로 성공한 캐시를 계속 탐색할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline afhandeling: als de update mislukt, blijft de laatste succesvolle cache beschikbaar om te browsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługa offline: jeśli aktualizacja się nie powiedzie, ostatni udany cache pozostaje dostępny do przeglądania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratamento offline: se a atualização falhar, o último cache bem-sucedido permanece disponível para navegação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обработка офлайн: если обновление не удалось, последний успешный кеш остаётся доступным для просмотра."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışı işleme: güncelleme başarısız olursa son başarılı önbellek göz atma için kullanılabilir durumda kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автономна робота: якщо оновлення не вдається, останній успішний кеш залишається доступним для перегляду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử lý ngoại tuyến: nếu cập nhật thất bại, bộ nhớ đệm thành công cuối cùng vẫn khả dụng để duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线处理：更新失败时继续保留上次成功缓存，不影响已有内容浏览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線處理：若更新失敗，保留最後一次成功的快取，不影響瀏覽。"
          }
        }
      }
    },
    "explore.help.awesome.cache.offline" : {
