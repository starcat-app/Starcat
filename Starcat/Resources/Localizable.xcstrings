        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台 Mac 上索引全部已 Star 仓库，包括私有仓库名称和你的笔记；这些内容可能出现在 macOS Spotlight 结果中。关闭后会删除 Starcat 的 Spotlight 索引。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這台 Mac 上索引全部已加星號的倉庫，包括私有倉庫名稱和你的筆記；這些內容可能出現在 macOS Spotlight 結果中。關閉後會刪除 Starcat 的 Spotlight 索引。"
          }
