    },
    "settings.mcp.agentSetup.pair.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pair a device" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "配对设备" } }
      }
    },
    "settings.mcp.agentSetup.pairPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Please start this one-time Starcat pairing session, provide the URI below through stdin, then wait for me to approve the device in Starcat:\n\nCommand:\nstarcat pair --stdin\n\nOne-time pairing URI:\n%1$@\n\nPass the URI only through stdin. Do not place it in command arguments, print it, or persist it." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请启动下面的一次性 Starcat 配对会话，通过 stdin 提供 URI，然后等待我在 Starcat 中确认设备：\n\n命令：\nstarcat pair --stdin\n\n一次性配对 URI：\n%1$@\n\n只允许通过 stdin 传入 URI，不要把它放入命令参数、输出或持久化。" } }
      }
    },
    "settings.mcp.agentSetup.mcp.manual.copy": {
      "extractionState": "manual",
