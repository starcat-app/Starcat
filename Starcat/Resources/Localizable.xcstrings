    "rag.workspace.retrieval.finalChunkLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final Chunk Limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终分片上限"
          }
        }
      }
    },
    "rag.workspace.retrieval.finalChunkLimit.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of chunks used as LLM context for this answer. The per-repository chunk limit is applied first, then the top N chunks in final order are selected. If other repositories do not have enough chunks, the actual count can be lower than this limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮最多使用多少条分片作为 LLM 上下文。先应用“单仓库分片上限”，再按最终排序取前 N 条；其他仓库分片不足时，实际数量可能少于此上限。"
          }
        }
      }
    },
    "rag.workspace.retrieval.minimumSimilarity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum Vector Similarity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最低向量相似度"
          }
        }
      }
    },
    "rag.workspace.retrieval.minimumSimilarity.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector results below this score are excluded. Exact keyword matches remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于此分数的向量结果不会参与检索；关键词精确匹配不受影响。"
          }
        }
      }
    },
    "rag.workspace.retrieval.perRepositoryLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-Repository Chunk Limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单仓库分片上限"
          }
        }
      }
    },
    "rag.workspace.retrieval.perRepositoryLimit.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of chunks retained from the same repository. The system selects chunks in final order; after a repository reaches this limit, its later chunks are skipped and chunks from other repositories continue to fill the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一仓库最多保留多少条分片。系统按重排后的顺序逐条选择；仓库达到上限后，会跳过该仓库后续分片，继续选择其他仓库的分片。"
          }
        }
      }
    },
