    "settings.aiIndex.rebuildAll.confirmMessage" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى تشغيل كل مستودع مميز بنجمة عبر واجهة برمجة التطبيقات للتضمين. سيتم استبدال ذاكرة التخزين المؤقت للمتجهات المحلية بعد النجاح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird jedes gespeicherte Repository über die Embedding-API verarbeitet. Der lokale Vektor-Cache wird nach Erfolg ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will run every starred repository through the embedding API. The local vector cache will be replaced after success."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto ejecutará cada repositorio destacado a través de la API de incrustación. La caché de vectores local se reemplazará tras el éxito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela exécutera chaque dépôt suivi via l'API d'embedding. Le cache vectoriel local sera remplacé après succès."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menjalankan setiap repositori yang dibintangi melalui API embedding. Cache vektor lokal akan diganti setelah berhasil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eseguirà ogni repository stellato attraverso l'API di embedding. La cache locale dei vettori verrà sostituita dopo il successo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、スター付きのすべてのリポジトリが埋め込みAPIを通じて実行されます。成功後、ローカルベクトルキャッシュが置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 별표 표시된 저장소가 임베딩 API를 통해 실행됩니다. 성공 후 로컬 벡터 캐시가 교체됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit voert elke gemarkeerde repository door de inbeddings-API. De lokale vectorcache wordt na succes vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to przetworzenie każdego oznaczonego gwiazdką repozytorium przez API osadzania. Lokalna pamięć podręczna wektorów zostanie zastąpiona po powodzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso executará todos os repositórios favoritados pela API de incorporação. O cache de vetores local será substituído após o sucesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это запустит каждый отмеченный репозиторий через API встраивания. Локальный кеш векторов будет заменён после успеха."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, yıldızlanan her depoyu yerleştirme API'sinden geçirecektir. Yerel vektör önbelleği başarılı olduktan sonra değiştirilecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це запустить кожен позначений зірочкою репозиторій через API вбудовування. Локальний кеш векторів буде замінено після успіху."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ chạy mọi kho lưu trữ đã gắn sao qua API nhúng. Bộ nhớ đệm vector cục bộ sẽ được thay thế sau khi thành công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将让所有 starred 仓库重新走一次 embedding API，本地向量缓存会被替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將讓所有 starred 倉庫重新走一次 embedding API，本地向量緩存會被替換。"
          }
        }
      }
    },
