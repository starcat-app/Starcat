    "rag.workspace.network.noProvider" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتوفر مزود بحث خارجي. قم بتمكينه والتحقق منه في الإعدادات أولاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein externer Suchanbieter verfügbar. Aktiviere und verifiziere einen in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No External Search provider is available. Enable and verify one in Settings first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún proveedor de búsqueda externa disponible. Actívalo y verifícalo primero en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fournisseur de recherche externe disponible. Activez-en un dans Réglages d'abord."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada penyedia Pencarian Eksternal yang tersedia. Aktifkan dan verifikasi satu di Pengaturan terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun provider di ricerca esterna disponibile. Abilita e verifica prima nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部検索プロバイダが利用できません。設定で有効にして確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 검색 제공자를 사용할 수 없습니다. 먼저 설정에서 활성화하고 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen externe zoekprovider beschikbaar. Schakel er een in en verifieer deze in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępnego dostawcy wyszukiwania zewnętrznego. Włącz i zweryfikuj go w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum provedor de Pesquisa Externa disponível. Habilite e verifique um nas Configurações primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет доступного провайдера внешнего поиска. Сначала включите и проверьте его в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici Arama sağlayıcısı mevcut değil. Önce Ayarlar'dan birini etkinleştirin ve doğrulayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає доступного постачальника зовнішнього пошуку. Спочатку ввімкніть і перевірте його в налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có nhà cung cấp Tìm kiếm bên ngoài nào khả dụng. Hãy bật và xác minh một nhà cung cấp trong Cài đặt trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可用的 External Search Provider，请先在设置中启用并验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可用的 External Search Provider，請先在設定中啟用並驗證。"
