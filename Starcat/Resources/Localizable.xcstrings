    "settings.autoTidy.trigger.onLaunch.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the app launches, wait 60 seconds and tidy one batch of untagged stars."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用启动 60 秒后，自动整理一轮未分类 Star。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用启动 60 秒后，自动整理一轮未分类 Star。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ起動後、60秒待機してタグなしスターの1バッチを整理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 실행 후 60초를 기다린 후 태그되지 않은 별표 한 배치를 정리합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem App-Start 60 Sekunden warten und einen Batch unmarkierter Sterne aufräumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le lancement de l'application, attendre 60 secondes et trier un lot d'étoiles non étiquetées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de que la app se inicie, espera 60 segundos y ordena un lote de destacados sin etiquetar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após o aplicativo iniciar, aguarda 60 segundos e organiza um lote de estrelas sem tags."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo l'avvio dell'app, attendi 60 secondi e ordina un batch di stelle senza tag."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После запуска приложения подождать 60 секунд и обработать один пакет неотмеченных звёзд."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht na het starten van de app 60 seconden en ruim één batch ongetagde sterren op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po uruchomieniu aplikacji odczekaj 60 sekund i uporządkuj jedną partię nieotagowanych gwiazdek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після запуску програми зачекайте 60 секунд і впорядкуйте один пакет не позначених тегами зірок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama başlatıldıktan sonra 60 saniye bekleyin ve bir grup etiketlenmemiş yıldızı düzenleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi ứng dụng khởi động, chờ 60 giây và dọn dẹp một lô các sao chưa gắn thẻ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah aplikasi diluncurkan, tunggu 60 detik dan rapikan satu batch bintang tanpa tag."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إطلاق التطبيق، انتظر 60 ثانية وقم بترتيب دُفعة واحدة من النجوم غير الموسومة."
          }
        }
      }
    },
