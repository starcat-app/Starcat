    "settings.ai.prompt.placeholders.footnote.chat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: the Chat task does not use the User Prompt template — user messages go directly to the model through the conversation messages array."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说明：Chat 任务不使用 User Prompt 模板——用户消息直接通过对话 messages 数组传给模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說明：Chat 任務不使用 User Prompt 模板——用戶消息直接通過對話 messages 數組傳給模型。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注：チャットタスクはユーザープロンプトテンプレートを使用しません。ユーザーメッセージは会話メッセージ配列を通じて直接モデルに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 채팅 작업은 사용자 프롬프트 템플릿을 사용하지 않습니다. 사용자 메시지는 대화 메시지 배열을 통해 모델로 직접 전송됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Die Chat-Aufgabe verwendet nicht die Benutzer-Prompt-Vorlage – Benutzernachrichten gehen direkt über das Konversationsnachrichten-Array an das Modell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : la tâche de chat n'utilise pas le modèle de prompt utilisateur — les messages de l'utilisateur sont envoyés directement au modèle via le tableau des messages de la conversation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: la tarea Chat no usa la plantilla de Prompt de Usuario — los mensajes del usuario van directamente al modelo a través del array de mensajes de la conversación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: a tarefa de Chat não usa o modelo de Prompt do Usuário — as mensagens do usuário vão diretamente para o modelo através do array de mensagens da conversa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: l'attività Chat non utilizza il modello Prompt Utente — i messaggi dell'utente vanno direttamente al modello attraverso l'array dei messaggi della conversazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: задача «Чат» не использует шаблон пользовательского запроса — сообщения пользователя отправляются напрямую модели через массив сообщений разговора."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: de Chat-taak gebruikt niet de gebruikersprompt-sjabloon — gebruikersberichten gaan rechtstreeks naar het model via de conversatieberichten-array."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: zadanie Czat nie używa szablonu Prompt użytkownika – wiadomości użytkownika są wysyłane bezpośrednio do modelu przez tablicę wiadomości konwersacji."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примітка: завдання Chat не використовує шаблон User Prompt — повідомлення користувача надсилаються безпосередньо моделі через масив повідомлень розмови."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not: Sohbet görevi Kullanıcı İstemi şablonunu kullanmaz — kullanıcı mesajları, konuşma mesajları dizisi aracılığıyla doğrudan modele gider."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu ý: tác vụ Chat không sử dụng mẫu User Prompt — tin nhắn người dùng được gửi trực tiếp đến mô hình thông qua mảng tin nhắn hội thoại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan: tugas Chat tidak menggunakan template Prompt Pengguna — pesan pengguna langsung dikirim ke model melalui array pesan percakapan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: مهمة الدردشة لا تستخدم قالب موجه المستخدم — رسائل المستخدم تذهب مباشرة إلى النموذج عبر مصفوفة رسائل المحادثة."
          }
        }
      }
    },
