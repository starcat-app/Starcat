    "settings.services.trending.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخرج من github.com/trending لتشغيل عرض الشائع (التصفية حسب اللغة والنطاق الزمني)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht github.com/trending für die Trending-Ansicht (Filter nach Sprache und Zeitraum)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrapes github.com/trending to power the Trending view (filter by language and time range)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrae github.com/trending para alimentar la vista de Tendencias (filtre por idioma y rango de tiempo)."
