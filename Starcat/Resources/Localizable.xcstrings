          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cargas de MetricKit se almacenan localmente como resúmenes de diagnóstico en esta versión; no se cargan."
          }
        },
        "fr" : {
          "stringUnit" : {
