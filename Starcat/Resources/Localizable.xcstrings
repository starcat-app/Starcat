    "about.eula.term3.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز GitHub والوسوم والملاحظات والبيانات المخزنة مؤقتاً هي بيانات مستخدم. يرجى تأكيد تأثير العمليات قبل مسح ذاكرة التخزين المؤقت أو إلغاء التنجيم أو الاستيراد/التصدير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub-Tokens, Tags, Notizen und zwischengespeicherte Daten sind Benutzerdaten. Bitte bestätigen Sie die Auswirkungen von Vorgängen, bevor Sie den Cache leeren, Sterne entfernen oder importieren/exportieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub tokens, tags, notes, and cached data are user data. Please confirm the impact of operations before clearing cache, unstarring, or importing/exporting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tokens, etiquetas, notas y datos en caché de GitHub son datos del usuario. Confirme el impacto de las operaciones antes de limpiar la caché, dejar de seguir o importar/exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jetons GitHub, les tags, les notes et les données en cache sont des données utilisateur. Veuillez confirmer l'impact des opérations avant de vider le cache, de retirer une étoile ou d'importer/exporter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token GitHub, tag, catatan, dan data cache adalah data pengguna. Harap konfirmasi dampak operasi sebelum membersihkan cache, menghapus bintang, atau mengimpor/mengekspor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I token GitHub, i tag, le note e i dati memorizzati nella cache sono dati dell'utente. Conferma l'impatto delle operazioni prima di cancellare la cache, rimuovere le stelle o importare/esportare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubトークン、タグ、メモ、キャッシュデータはユーザーデータです。キャッシュのクリア、スター解除、インポート/エクスポートを行う前に、操作の影響を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 토큰, 태그, 노트 및 캐시된 데이터는 사용자 데이터입니다. 캐시 지우기, 별표 제거 또는 가져오기/내보내기 전에 작업의 영향을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub-tokens, tags, notities en gecachte gegevens zijn gebruikersgegevens. Bevestig de impact van bewerkingen voordat u de cache wist, sterren verwijdert of importeert/exporteert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeny GitHub, tagi, notatki i dane w pamięci podręcznej są danymi użytkownika. Przed wyczyszczeniem pamięci podręcznej, usunięciem gwiazdki lub importem/eksportem potwierdź wpływ operacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens do GitHub, tags, notas e dados em cache são dados do usuário. Confirme o impacto das operações antes de limpar o cache, remover estrelas ou importar/exportar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токены GitHub, теги, заметки и кэшированные данные являются пользовательскими данными. Пожалуйста, подтвердите влияние операций перед очисткой кэша, удалением звёзд или импортом/экспортом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub token'ları, etiketler, notlar ve önbelleğe alınmış veriler kullanıcı verileridir. Önbelleği temizleme, yıldızdan çıkarma veya içe/dışa aktarma işlemlerinden önce işlemlerin etkisini onaylayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токени GitHub, теги, нотатки та кешовані дані є даними користувача. Перед очищенням кешу, видаленням зірок або імпортом/експортом підтвердьте вплив операцій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token GitHub, thẻ, ghi chú và dữ liệu đã lưu trong bộ nhớ đệm là dữ liệu người dùng. Vui lòng xác nhận tác động của các thao tác trước khi xóa bộ nhớ đệm, bỏ sao hoặc nhập/xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub token、标签、笔记和缓存数据属于用户数据。请在清理缓存、取消 Star 或导入导出前自行确认操作影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub token、標籤、筆記與快取資料屬於使用者資料。清除快取、取消星號或匯入/匯出前，請自行確認操作影響。"
          }
        }
      }
    },
