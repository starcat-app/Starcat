    "rag.workspace.debug.privacy.repoContext" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخزين آثار التصحيح محليًا. قد تحتوي مرحلة الموجه النهائية على XML كامل لكود المشروع؛ يؤدي مسح آثار هذه المحادثة إلى حذف نسخة التصحيح المحلية تلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug-Traces werden lokal gespeichert. Die finale Prompt-Stufe kann das vollständige Projektcode-XML enthalten; das Löschen der Traces dieser Unterhaltung löscht diese lokale Debug-Kopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug traces are stored locally. The final Prompt stage may contain complete repository-insights and project-code XML; clearing this conversation's traces deletes that local debug copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los rastros de depuración se almacenan localmente. La etapa final del Prompt puede contener el XML completo del código del proyecto; borrar los rastros de esta conversación elimina esa copia local de depuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les traces de débogage sont stockées localement. L'étape finale de l'invite peut contenir le code XML complet du projet ; effacer les traces de cette conversation supprime cette copie locale de débogage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jejak debug disimpan secara lokal. Tahap Prompt akhir mungkin berisi XML kode proyek lengkap; menghapus jejak percakapan ini akan menghapus salinan debug lokal tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tracce di debug sono memorizzate localmente. La fase finale del Prompt può contenere l'XML completo del codice del progetto; cancellare le tracce di questa conversazione elimina quella copia locale di debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグトレースはローカルに保存されます。最終的なプロンプト段階には完全なプロジェクトコードXMLが含まれる場合があり、この会話のトレースを消去すると、そのローカルデバッグコピーが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버그 추적은 로컬에 저장됩니다. 최종 프롬프트 단계에는 전체 프로젝트 코드 XML이 포함될 수 있습니다. 이 대화의 추적을 지우면 로컬 디버그 복사본이 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugtraces worden lokaal opgeslagen. De uiteindelijke promptfase kan de volledige projectcode-XML bevatten; het wissen van de traces van dit gesprek verwijdert die lokale debugkopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ślady debugowania są przechowywane lokalnie. Końcowy etap promptu może zawierać pełny XML kodu projektu; wyczyszczenie śladów tej rozmowy usuwa tę lokalną kopię debugowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rastros de depuração são armazenados localmente. O estágio final do Prompt pode conter o XML completo do código do projeto; limpar os rastros desta conversa exclui essa cópia de depuração local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отладочные трассировки хранятся локально. Финальный этап промпта может содержать полный XML кода проекта; очистка трассировок этого разговора удалит локальную копию отладки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata ayıklama izleri yerel olarak depolanır. Son İstem aşaması, tam proje kodu XML'ini içerebilir; bu konuşmanın izlerini temizlemek, o yerel hata ayıklama kopyasını siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трасування налагодження зберігаються локально. Останній етап Prompt може містити повний XML коду проєкту; очищення трасувань цієї розмови видаляє цю локальну копію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu vết gỡ lỗi được lưu trữ cục bộ. Giai đoạn Prompt cuối cùng có thể chứa toàn bộ XML mã dự án; xóa dấu vết của hội thoại này sẽ xóa bản sao gỡ lỗi cục bộ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调试记录保存在本地；最终 Prompt 阶段可能包含完整仓库洞察与项目代码 XML。清空当前会话调试记录会删除这份本地调试副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調試記錄儲存在本地；最終 Prompt 階段可能包含完整專案程式碼 XML。清空目前會話調試記錄會刪除這份本地調試副本。"
          }
        }
      }
    },
