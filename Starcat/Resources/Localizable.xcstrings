    "settings.diagnostics.privacy.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive is designed to exclude GitHub tokens, API keys, AI prompts, README bodies, and private notes. It may include service names, status codes, repository full names, local file paths, and error summaries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断包设计上不包含 GitHub token、API Key、AI prompt、README 正文和私有笔记。它可能包含服务名、状态码、仓库 full name、本地文件路径和错误摘要。"
          }
        }
      }
    },
    "settings.diagnostics.privacy.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
