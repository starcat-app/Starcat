          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra solo segmentos de entrada; la salida reservada está oculta pero se deduce internamente"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra apenas segmentos de entrada; a saída reservada fica oculta, mas ainda é deduzida internamente"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
