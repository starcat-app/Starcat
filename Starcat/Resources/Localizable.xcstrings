          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 저장소와 유사한 3~5개의 더 활발한 대안을 찾고 비교 표를 생성하세요."
          }
        },
        "de" : {
          "stringUnit" : {
