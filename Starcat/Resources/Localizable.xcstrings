      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزّن مفاتيح API بشكل آمن على جهاز Mac هذا. قد يستهلك الاختبار طلب بحث واحد من المزود."
