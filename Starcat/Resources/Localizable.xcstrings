        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再度サインインするか、このサービスに設定されたAPIキーを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 로그인하거나 이 서비스에 대해 구성된 API 키를 확인하세요."
