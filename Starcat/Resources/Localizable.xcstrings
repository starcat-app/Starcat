    "error.user.unauthorized.recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل الدخول مرة أخرى أو تحقق من مفتاح API المكون لهذه الخدمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich erneut an oder überprüfen Sie den für diesen Dienst konfigurierten API-Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in again or check the API Key configured for this service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
