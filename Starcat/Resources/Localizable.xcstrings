    "rag.workspace.prompt.placeholder.repoContextSection" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML كود المشروع المحدد مع الالتزام، التجزئة، وعلامة الاقتباس. له ميزانية مستقلة عن الأدلة المفهرسة ويكون فارغًا ما لم يتم تمكين التفكير العميق لمشروع واحد بالضبط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Code-XML des ausgewählten Projekts mit Commit, Hash und Zitierungsmarkierung. Es hat ein unabhängiges Budget von indizierten Beweisen und ist leer, wenn Deep Thinking nicht für genau ein Projekt aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected project's code XML with commit, hash, and citation marker. It has an independent budget from indexed evidence and is empty unless deep thinking is enabled for exactly one project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML del código del proyecto seleccionado con commit, hash y marcador de cita. Tiene un presupuesto independiente de la evidencia indexada y está vacío a menos que el pensamiento profundo esté habilitado para exactamente un proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code XML du projet sélectionné avec commit, hash et marqueur de citation. Il a un budget indépendant des preuves indexées et est vide sauf si la réflexion approfondie est activée pour exactement un projet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML kode proyek yang dipilih dengan commit, hash, dan penanda kutipan. Memiliki anggaran independen dari bukti yang diindeks dan kosong kecuali pemikiran mendalam diaktifkan untuk tepat satu proyek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML del codice del progetto selezionato con commit, hash e marcatore di citazione. Ha un budget indipendente dalle prove indicizzate ed è vuoto a meno che il pensiero profondo non sia abilitato per esattamente un progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したプロジェクトのコードXML（コミット、ハッシュ、引用マーカー付き）。インデックスエビデンスとは独立した予算を持ち、深い思考が有効なプロジェクトが1つの場合のみ空ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 프로젝트의 코드 XML(커밋, 해시 및 인용 마커 포함)입니다. 인덱싱된 증거와 별도의 예산을 가지며, 정확히 하나의 프로젝트에 대해 심층 사고가 활성화된 경우에만 비어 있지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde projectcode-XML met commit, hash en citatiemarkering. Het heeft een onafhankelijk budget van geïndexeerd bewijs en is leeg tenzij diep denken is ingeschakeld voor precies één project."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod XML wybranego projektu z znacznikami commitu, skrótu i cytowania. Ma niezależny budżet od indeksowanych dowodów i jest pusty, chyba że włączone jest głębokie myślenie dla dokładnie jednego projektu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML do código do projeto selecionado com commit, hash e marcador de citação. Possui um orçamento independente das evidências indexadas e fica vazio a menos que o pensamento profundo esteja ativado para exatamente um projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML-код выбранного проекта с коммитом, хешем и маркером цитирования. Имеет независимый бюджет от индексированных свидетельств и пуст, если глубокое мышление не включено ровно для одного проекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen projenin kod XML'i, işleme, hash ve alıntı işaretçisiyle. Dizinlenmiş kanıtlardan bağımsız bir bütçesi vardır ve yalnızca tam olarak bir proje için derin düşünme etkinse boş değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML коду вибраного проєкту з комітом, хешем і маркером цитування. Має незалежний бюджет від індексованих доказів і порожній, якщо глибоке мислення не ввімкнено рівно для одного проєкту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã XML của dự án đã chọn với cam kết, hàm băm và dấu trích dẫn. Nó có ngân sách độc lập với bằng chứng đã lập chỉ mục và trống trừ khi bật suy nghĩ sâu cho chính xác một dự án."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中单项目的代码 XML，包含 commit、内容哈希与引用标记；预算独立于索引分片证据，只有在单项目开启深度思考时才有内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取專案的程式碼 XML，包含 commit、內容雜湊與引用標記；預算獨立於索引分片證據，只有在單一專案啟用深度思考時才有內容。"
          }
        }
      }
    },
