        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повний XML помістився: оригінальний XML поміщається в решту вікна; нічого не видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
