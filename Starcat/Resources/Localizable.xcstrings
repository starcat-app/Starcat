    "agent.definition.overlapScan.defaultPrompt" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح مستودعاتي المميزة بنجمة، وابحث عن مجموعات ذات وظائف متداخلة، وقدم اقتراحات فقط دون إجراء تغييرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine markierten Repositories scannen, Gruppen mit überlappender Funktionalität finden und nur Vorschläge ohne Änderungen geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan my starred repositories, find groups with overlapping functionality, and only give suggestions without making changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea mis repositorios destacados, encuentra grupos con funcionalidad superpuesta y solo da sugerencias sin hacer cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyser mes dépôts favoris, trouver les groupes aux fonctionnalités redondantes et ne donner que des suggestions sans effectuer de modifications."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai repositori berbintang saya, temukan grup dengan fungsionalitas tumpang tindih, dan hanya berikan saran tanpa melakukan perubahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza i miei repository con stella, trova gruppi con funzionalità sovrapposte e fornisci solo suggerimenti senza apportare modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スターを付けたリポジトリをスキャンし、機能が重複しているグループを見つけて、変更は行わずに提案のみを行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 별표 표시한 저장소를 스캔하여 중복 기능이 있는 그룹을 찾고, 변경 없이 제안만 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan mijn gemarkeerde repositories, vind groepen met overlappende functionaliteit en geef alleen suggesties zonder wijzigingen aan te brengen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeskanuj moje oznaczone gwiazdką repozytoria, znajdź grupy o nakładającej się funkcjonalności i podaj tylko sugestie bez wprowadzania zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinar meus repositórios favoritados, encontrar grupos com funcionalidades sobrepostas e dar apenas sugestões sem fazer alterações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просканируй мои отмеченные звёздами репозитории, найди группы с пересекающейся функциональностью и дай только предложения без внесения изменений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıldızlı depolarımı tara, örtüşen işlevselliğe sahip grupları bul ve yalnızca değişiklik yapmadan öneriler sun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканувати мої репозиторії з зірочками, знайти групи з перекриттям функціоналу та надати лише пропозиції без внесення змін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quét các kho lưu trữ đã gắn sao của tôi, tìm các nhóm có chức năng chồng chéo và chỉ đưa ra gợi ý mà không thực hiện thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描我已 star 的仓库，找出功能重叠的项目组，先给建议，不要自动修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描我 star 的倉庫，找出功能重疊的群組，只給建議，不要自動修改。"
          }
        }
      }
    },
