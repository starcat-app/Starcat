    "explore.help.discover.cache.offline" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline handling: if the update fails, Starcat keeps the last successful cache and warns that the content may be out of date."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线处理：更新失败时继续使用上次成功缓存，并提示内容可能不是最新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線處理：若更新失敗，Starcat 會保留最後一次成功的快取，並提示內容可能不是最新。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン処理：更新に失敗した場合、Starcatは最後に成功したキャッシュを保持し、コンテンツが古い可能性があることを警告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 처리: 업데이트에 실패하면 Starcat은 마지막으로 성공한 캐시를 유지하고 콘텐츠가 오래되었을 수 있음을 경고합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline-Handhabung: Wenn das Update fehlschlägt, behält Starcat den letzten erfolgreichen Cache und warnt, dass der Inhalt veraltet sein könnte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestion hors ligne : si la mise à jour échoue, Starcat conserve le dernier cache réussi et avertit que le contenu peut être obsolète."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manejo sin conexión: si la actualización falla, Starcat conserva la última caché exitosa y advierte que el contenido puede estar desactualizado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratamento offline: se a atualização falhar, o Starcat mantém o último cache bem-sucedido e avisa que o conteúdo pode estar desatualizado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestione offline: se l'aggiornamento fallisce, Starcat mantiene l'ultima cache riuscita e avvisa che il contenuto potrebbe essere obsoleto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обработка офлайн: если обновление не удаётся, Starcat сохраняет последний успешный кэш и предупреждает, что содержимое может быть устаревшим."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline afhandeling: als de update mislukt, behoudt Starcat de laatste succesvolle cache en waarschuwt dat de inhoud mogelijk verouderd is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługa offline: jeśli aktualizacja się nie powiedzie, Starcat zachowuje ostatnią udaną pamięć podręczną i ostrzega, że treść może być nieaktualna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обробка в автономному режимі: якщо оновлення не вдається, Starcat зберігає останній успішний кеш і попереджає, що вміст може бути застарілим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışı işleme: güncelleme başarısız olursa, Starcat son başarılı önbelleği tutar ve içeriğin güncel olmayabileceği konusunda uyarır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử lý ngoại tuyến: nếu cập nhật thất bại, Starcat giữ lại bộ nhớ đệm thành công cuối cùng và cảnh báo rằng nội dung có thể đã lỗi thời."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penanganan offline: jika pembaruan gagal, Starcat menyimpan cache sukses terakhir dan memperingatkan bahwa konten mungkin kedaluwarsa."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعامل دون اتصال: إذا فشل التحديث، يحتفظ Starcat بآخر ذاكرة تخزين مؤقت ناجحة ويحذر من أن المحتوى قد يكون قديمًا."
          }
        }
      }
    },
