    "settings.storage.clearAnySearch.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال جميع نتائج البحث الخارجي المخزنة مؤقتًا (البحث العام + السياق الخارجي للذكاء الاصطناعي). ستعيد عمليات البحث والملخصات اللاحقة الاستعلام عبر الشبكة وتستهلك حصة API."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle zwischengespeicherten externen Suchergebnisse (globale Suche + KI-externer Kontext) werden entfernt. Nachfolgende Suchen und Zusammenfassungen werden das Netzwerk erneut abfragen und API-Kontingent verbrauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All cached External Search results (global search + AI external context) will be removed. Subsequent searches and summaries will re-query the network and consume API quota."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los resultados de búsqueda externa almacenados en caché (búsqueda global + contexto externo de IA). Las búsquedas y resúmenes posteriores volverán a consultar la red y consumirán cuota de API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les résultats de recherche externe mis en cache (recherche globale + contexte IA externe) seront supprimés. Les recherches et résumés ultérieurs interrogeront à nouveau le réseau et consommeront le quota API."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua hasil Pencarian Eksternal yang di-cache (pencarian global + konteks eksternal AI) akan dihapus. Pencarian dan ringkasan selanjutnya akan meminta ulang jaringan dan menggunakan kuota API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i risultati di ricerca esterna memorizzati nella cache (ricerca globale + contesto esterno AI) verranno rimossi. Ricerche e riepiloghi successivi richiederanno nuove query di rete e consumeranno quota API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュされたすべての外部検索結果（グローバル検索＋AI外部コンテキスト）が削除されます。以降の検索と要約ではネットワークに再問い合わせを行い、APIクォータを消費します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시된 모든 외부 검색 결과(전역 검색 + AI 외부 컨텍스트)가 제거됩니다. 이후 검색 및 요약은 네트워크에 다시 쿼리하고 API 할당량을 소비합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gecachete externe zoekresultaten (globaal zoeken + AI externe context) worden verwijderd. Volgende zoekopdrachten en samenvattingen zullen opnieuw het netwerk bevragen en API-quota verbruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie zapisane wyniki wyszukiwania zewnętrznego (wyszukiwanie globalne + zewnętrzny kontekst AI) zostaną usunięte. Kolejne wyszukiwania i podsumowania będą ponownie wysyłać zapytania do sieci i zużywać limit API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os resultados de Pesquisa Externa em cache (pesquisa global + contexto externo de IA) serão removidos. Pesquisas e resumos subsequentes consultarão a rede novamente e consumirão cota de API."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все кэшированные результаты внешнего поиска (глобальный поиск + внешний контекст ИИ) будут удалены. Последующие поиски и сводки будут повторно запрашивать сеть и расходовать квоту API."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önbelleğe alınmış tüm Harici Arama sonuçları (genel arama + AI harici bağlam) kaldırılacak. Sonraki aramalar ve özetler ağı tekrar sorgulayacak ve API kotasını tüketecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі кешовані результати зовнішнього пошуку (глобальний пошук + зовнішній контекст AI) буде видалено. Подальші пошуки та підсумки повторно виконуватимуть мережеві запити та витрачатимуть квоту API."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả kết quả tìm kiếm bên ngoài đã lưu (tìm kiếm toàn cục + ngữ cảnh AI bên ngoài) sẽ bị xóa. Các tìm kiếm và tóm tắt sau sẽ truy vấn lại mạng và tiêu tốn hạn mức API."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已缓存的所有 External Search 检索结果（全局搜索 + AI 外部上下文）将被清空。下一次搜索 / 摘要会重新打网络,并消耗 API 配额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已缓存的所有外部搜索结果（全局搜索 + AI 外部上下文）将被清空。后续搜索和摘要将重新查询网络并消耗 API 配额。"
          }
        }
      }
    },
