        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 언어만 글로벌 언어 필터에 표시됩니다. 자체적으로 목록을 필터링하지는 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur diese Sprachen erscheinen im globalen Sprachfilter. Dies filtert Listen nicht von selbst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls ces langages apparaissent dans le filtre de langage global. Cela ne filtre pas les listes par lui-même."
