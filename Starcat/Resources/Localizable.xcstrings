        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: l'attività Chat non utilizza il modello Prompt Utente — i messaggi dell'utente vanno direttamente al modello attraverso l'array dei messaggi della conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注：チャットタスクはユーザープロンプトテンプレートを使用しません。ユーザーメッセージは会話メッセージ配列を通じて直接モデルに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 채팅 작업은 사용자 프롬프트 템플릿을 사용하지 않습니다. 사용자 메시지는 대화 메시지 배열을 통해 모델로 직접 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: de Chat-taak gebruikt niet de gebruikersprompt-sjabloon — gebruikersberichten gaan rechtstreeks naar het model via de conversatieberichten-array."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: zadanie Czat nie używa szablonu Prompt użytkownika – wiadomości użytkownika są wysyłane bezpośrednio do modelu przez tablicę wiadomości konwersacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
