          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что такое бюджет контекста?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlam bütçesi nedir?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що таке бюджет контексту?"
          }
        },
        "vi" : {
          "stringUnit" : {
