    "ai.context.settings.maximumArchiveSize.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to complete repository ZIP downloads for AI Summary, AI Chat, Knowledge Base project context, CodeFlow, and CodebaseMemory. Processing stops when an archive exceeds this limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影响 AI 摘要、AI 对话、知识库项目上下文、CodeFlow 和 CodebaseMemory 的完整仓库 ZIP 下载；压缩包超过此上限时将停止处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影響 AI 摘要、AI 對話、知識庫專案上下文、CodeFlow 和 CodebaseMemory 的完整倉庫 ZIP 下載；壓縮檔超過此上限時將停止處理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIサマリー、AIチャット、ナレッジベースのプロジェクトコンテキスト、CodeFlow、CodebaseMemoryのための完全なリポジトリZIPダウンロードに適用されます。アーカイブがこの制限を超えると処理が停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 요약, AI 채팅, 지식 베이스 프로젝트 컨텍스트, CodeFlow 및 CodebaseMemory의 전체 리포지토리 ZIP 다운로드에 적용됩니다. 아카이브가 이 제한을 초과하면 처리가 중단됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für vollständige Repository-ZIP-Downloads für KI-Zusammenfassung, KI-Chat, Wissensdatenbank-Projektkontext, CodeFlow und CodebaseMemory. Die Verarbeitung wird gestoppt, wenn ein Archiv dieses Limit überschreitet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique aux téléchargements complets de ZIP de dépôt pour le résumé IA, le chat IA, le contexte de projet de la base de connaissances, CodeFlow et CodebaseMemory. Le traitement s'arrête lorsqu'une archive dépasse cette limite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a las descargas ZIP completas del repositorio para Resumen IA, Chat IA, contexto de proyecto de Base de Conocimiento, CodeFlow y CodebaseMemory. El procesamiento se detiene cuando un archivo supera este límite."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se a downloads completos de ZIP do repositório para Resumo de IA, Chat de IA, contexto de projeto da Base de Conhecimento, CodeFlow e CodebaseMemory. O processamento é interrompido quando um arquivo excede este limite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica ai download ZIP completi del repository per Riepilogo IA, Chat IA, contesto progetto Knowledge Base, CodeFlow e CodebaseMemory. L'elaborazione si interrompe quando un archivio supera questo limite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется к полным загрузкам ZIP репозитория для сводки ИИ, чата ИИ, контекста проекта базы знаний, CodeFlow и CodebaseMemory. Обработка прекращается, если архив превышает этот лимит."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor volledige repository-ZIP-downloads voor AI-samenvatting, AI-chat, projectcontext van Knowledge Base, CodeFlow en CodebaseMemory. Verwerking stopt wanneer een archief deze limiet overschrijdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy pełnych pobrań archiwum ZIP repozytorium dla podsumowania AI, czatu AI, kontekstu projektu bazy wiedzy, CodeFlow i CodebaseMemory. Przetwarzanie zostaje zatrzymane, gdy archiwum przekroczy ten limit."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовується до повних завантажень ZIP репозиторію для ШІ-підсумку, ШІ-чату, контексту проєкту бази знань, CodeFlow та CodebaseMemory. Обробка зупиняється, коли архів перевищує це обмеження."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Özeti, AI Sohbeti, Bilgi Tabanı proje bağlamı, CodeFlow ve CodebaseMemory için tam depo ZIP indirmelerine uygulanır. Arşiv bu sınırı aştığında işlem durur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng cho các bản tải xuống ZIP đầy đủ của kho cho Tóm tắt AI, Chat AI, ngữ cảnh dự án Cơ sở tri thức, CodeFlow và CodebaseMemory. Quá trình xử lý dừng khi tệp lưu trữ vượt quá giới hạn này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku untuk unduhan ZIP repositori lengkap untuk Ringkasan AI, Obrolan AI, konteks proyek Basis Pengetahuan, CodeFlow, dan CodebaseMemory. Pemrosesan berhenti ketika arsip melebihi batas ini."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على تنزيلات ZIP الكاملة للمستودع لملخص الذكاء الاصطناعي، دردشة الذكاء الاصطناعي، سياق مشروع قاعدة المعرفة، CodeFlow، و CodebaseMemory. تتوقف المعالجة عندما يتجاوز الأرشيف هذا الحد."
          }
        }
      }
    },
