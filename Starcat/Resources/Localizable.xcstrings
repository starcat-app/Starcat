    "settings.pro.benefit.ai.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحضر مفتاح API الخاص بك للملخصات والوسوم والدردشة والترتيب الدفعي وترجمة README والبحث الدلالي—دون توجيه المطالبات الخاصة عبر مفتاح مشترك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigenen API-Schlüssel für Zusammenfassungen, Tags, Chat, Batch-Bereinigung, README-Übersetzung und semantische Suche verwenden – ohne private Eingabeaufforderungen über einen gemeinsamen Schlüssel zu leiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring your own API key for summaries, tags, chat, batch tidy, README translation, and semantic search—without routing private prompts through a shared key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu propia clave API para resúmenes, etiquetas, chat, limpieza por lotes, traducción de README y búsqueda semántica, sin enrutar consultas privadas a través de una clave compartida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apportez votre propre clé API pour les résumés, les tags, le chat, le tri par lots, la traduction du README et la recherche sémantique, sans acheminer les requêtes privées via une clé partagée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawa kunci API Anda sendiri untuk ringkasan, tag, obrolan, batch rapi, terjemahan README, dan pencarian semantik—tanpa mengarahkan prompt pribadi melalui kunci bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la tua chiave API per riepiloghi, tag, chat, pulizia batch, traduzione README e ricerca semantica, senza instradare prompt privati attraverso una chiave condivisa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のAPIキーを使用して、要約、タグ、チャット、一括整理、README翻訳、セマンティック検索を実行できます。プライベートプロンプトが共有キーを経由しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자체 API 키를 사용하여 요약, 태그, 채팅, 일괄 정리, README 번역 및 의미 검색을 수행합니다. 개인 프롬프트가 공유 키를 통해 라우팅되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik uw eigen API-sleutel voor samenvattingen, tags, chat, batch-opruiming, README-vertaling en semantisch zoeken—zonder privé-prompts via een gedeelde sleutel te routeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przynieś własny klucz API do podsumowań, tagów, czatu, zbiorczego porządkowania, tłumaczenia README i wyszukiwania semantycznego – bez kierowania prywatnych promptów przez współdzielony klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traga sua própria chave de API para resumos, tags, chat, organização em lote, tradução de README e busca semântica — sem rotear prompts privados por uma chave compartilhada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте собственный ключ API для сводок, тегов, чата, пакетной очистки, перевода README и семантического поиска — без передачи приватных запросов через общий ключ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özetler, etiketler, sohbet, toplu düzenleme, README çevirisi ve anlamsal arama için kendi API anahtarınızı getirin; özel istemleri paylaşılan bir anahtar üzerinden yönlendirmeden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте власний ключ API для підсумків, тегів, чату, масового впорядкування, перекладу README та семантичного пошуку — без передачі приватних запитів через спільний ключ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mang khóa API của riêng bạn cho tóm tắt, thẻ, trò chuyện, dọn dẹp hàng loạt, dịch README và tìm kiếm ngữ nghĩa—mà không định tuyến các lời nhắc riêng tư qua khóa dùng chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自带 API Key，完成摘要、标签、对话、批量整理、README 翻译与语义搜索；私有提示词不经过共享密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自備 API Key 進行摘要、標籤、聊天、批次整理、README 翻譯和語意搜尋——無需透過共用金鑰傳送私人提示。"
          }
        }
      }
    },
