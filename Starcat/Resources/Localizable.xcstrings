    "explore.help.trending.rule.meaning" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trending reflects short-term attention changes and is not the same as long-term popularity."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趋势反映短期关注度变化，不等同于长期热门。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趨勢反映短期關注度變化，不等同於長期熱門。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレンドは短期的な注目度の変化を反映し、長期的な人気とは異なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trending은 단기적인 관심 변화를 반영하며 장기적인 인기와 동일하지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trends spiegeln kurzfristige Aufmerksamkeitsänderungen wider und sind nicht mit langfristiger Beliebtheit gleichzusetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tendances reflètent les changements d'attention à court terme et ne sont pas équivalentes à la popularité à long terme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tendencias reflejan cambios de atención a corto plazo y no son lo mismo que la popularidad a largo plazo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendências refletem mudanças de atenção de curto prazo e não são o mesmo que popularidade de longo prazo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tendenze riflettono cambiamenti di attenzione a breve termine e non equivalgono alla popolarità a lungo termine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренды отражают краткосрочные изменения внимания и не равны долгосрочной популярности."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trending weerspiegelt veranderingen in kortetermijnaandacht en is niet hetzelfde als langetermijnpopulariteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trendy odzwierciedlają krótkoterminowe zmiany uwagi, a nie długoterminową popularność."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренди відображають короткострокові зміни уваги і не є довгостроковою популярністю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trend olan, kısa vadeli dikkat değişikliklerini yansıtır ve uzun vadeli popülerlikle aynı değildir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thịnh hành phản ánh sự thay đổi chú ý trong ngắn hạn và không giống với mức độ phổ biến dài hạn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren mencerminkan perubahan perhatian jangka pendek dan tidak sama dengan popularitas jangka panjang."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعكس Trending تغيرات الاهتمام قصيرة المدى وليس مثل الشعبية طويلة المدى."
          }
        }
      }
    },
    "explore.help.trending.rule.period" : {
      "localizations" : {
        "en" : {
