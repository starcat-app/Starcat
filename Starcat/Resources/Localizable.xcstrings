          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrfachauswahl: Einzelfeld kann nicht bearbeitet werden; Löschen oder Zusammenführen möglich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélection multiple : impossible de modifier un champ unique ; vous pouvez supprimer ou fusionner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selección múltiple: no se puede editar un solo campo; se puede eliminar o combinar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleção múltipla: não é possível editar campo único; é possível Excluir ou Mesclar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selezione multipla: impossibile modificare un singolo campo; puoi Eliminare o Unire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Множественный выбор: нельзя редактировать одно поле; можно удалить или объединить."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meervoudige selectie: kan geen enkel veld bewerken; kan verwijderen of samenvoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybór wielokrotny: nie można edytować pojedynczego pola; można usunąć lub scalić."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
