    "rag.workspace.error.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong while talking to the knowledge base. Please try again in a moment. If it keeps happening, tap Feedback and tell us."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向知识库提问时出了点问题，请稍后再试。若反复出现，可点「反馈」告诉我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向知識庫提問時出了點問題，請稍後再試。若反覆出現，可點「回饋」告訴我們。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナレッジベースとの通信中に問題が発生しました。しばらくしてからもう一度お試しください。問題が続く場合は、フィードバックをタップしてお知らせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지식 베이스와 통신하는 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요. 계속 발생하면 피드백을 눌러 알려주세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Kommunikation mit der Wissensdatenbank ist ein Fehler aufgetreten. Bitte versuchen Sie es in einem Moment erneut. Falls es weiterhin auftritt, tippen Sie auf „Feedback“ und teilen Sie uns dies mit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu lors de la communication avec la base de connaissances. Veuillez réessayer dans un instant. Si cela persiste, appuyez sur Commentaires et dites-le nous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal al comunicarse con la base de conocimiento. Intente de nuevo en un momento. Si sigue ocurriendo, toque Comentarios y díganos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo deu errado ao conversar com a base de conhecimento. Tente novamente em instantes. Se persistir, toque em Feedback e nos avise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa è andato storto durante la comunicazione con la knowledge base. Riprova tra un momento. Se continua, tocca Feedback e diccelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то пошло не так при обращении к базе знаний. Пожалуйста, повторите попытку через некоторое время. Если это повторяется, нажмите «Обратная связь» и сообщите нам."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is iets misgegaan tijdens het communiceren met de kennisbank. Probeer het later opnieuw. Als het blijft gebeuren, tik op Feedback en laat het ons weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś poszło nie tak podczas komunikacji z bazą wiedzy. Spróbuj ponownie za chwilę. Jeśli problem będzie się powtarzał, kliknij „Opinia” i powiedz nam o tym."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось пішло не так під час спілкування з базою знань. Будь ласка, спробуйте ще раз за хвилину. Якщо це повторюється, натисніть «Зворотний зв'язок» і повідомте нам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgi tabanıyla konuşurken bir şeyler ters gitti. Lütfen bir süre sonra tekrar deneyin. Devam ederse, Geri Bildirim'e dokunun ve bize bildirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra lỗi khi liên lạc với cơ sở tri thức. Vui lòng thử lại sau. Nếu vẫn tiếp diễn, hãy nhấn Phản hồi và cho chúng tôi biết."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjadi kesalahan saat berkomunikasi dengan basis pengetahuan. Silakan coba lagi sebentar. Jika terus terjadi, ketuk Umpan Balik dan beri tahu kami."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ ما أثناء التحدث إلى قاعدة المعرفة. يرجى المحاولة مرة أخرى بعد قليل. إذا استمر الحدوث، فانقر على ملاحظات وأخبرنا."
          }
        }
      }
    },
