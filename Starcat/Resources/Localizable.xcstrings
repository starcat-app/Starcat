    "rag.workspace.inspector.plan.help.executionStrategy.definition.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف ستستعلم Starcat قاعدة معارفك المحلية: وضع التنفيذ، عوامل تصفية المستودعات، الترتيب، والتحليلات المنظمة الاختيارية. هذه هي خطة الاسترجاع المحلية للمخطط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Starcat Ihre lokale Wissensbasis abfragt: Ausführungsmodus, Repository-Filter, Sortierung und optionale strukturierte Analysen. Dies ist der lokale Abrufplan des Planners."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How Starcat will query your local knowledge base: execution mode, repository filters, sorting, and optional structured analytics. This is the Planner's local retrieval plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo Starcat consultará su base de conocimiento local: modo de ejecución, filtros de repositorio, ordenación y analíticas estructuradas opcionales. Este es el plan de recuperación local del planificador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment Starcat interrogera votre base de connaissances locale : mode d'exécution, filtres de dépôt, tri et analytiques structurées optionnelles. C'est le plan de récupération local du planificateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana Starcat akan menanyai basis pengetahuan lokal Anda: mode eksekusi, filter repositori, pengurutan, dan analitik terstruktur opsional. Ini adalah rencana pengambilan lokal Planner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come Starcat interrogherà la tua knowledge base locale: modalità di esecuzione, filtri repository, ordinamento e analisi strutturata opzionale. Questo è il piano di recupero locale del Planner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatがローカル知識ベースをクエリする方法: 実行モード、リポジトリフィルタ、並び替え、オプションの構造化分析。これはプランナーのローカル検索計画です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat이 로컬 지식 베이스를 쿼리하는 방법: 실행 모드, 저장소 필터, 정렬 및 선택적 구조화된 분석입니다. 이는 Planner의 로컬 검색 계획입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe Starcat je lokale kennisbank doorzoekt: uitvoeringsmodus, repositoryfilters, sortering en optionele gestructureerde analyses. Dit is het lokale ophaalplan van de Planner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak Starcat będzie przeszukiwać lokalną bazę wiedzy: tryb wykonania, filtry repozytoriów, sortowanie i opcjonalna analityka strukturalna. To lokalny plan wyszukiwania Planisty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o Starcat consultará sua base de conhecimento local: modo de execução, filtros de repositório, ordenação e análise estruturada opcional. Este é o plano de recuperação local do Planejador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как Starcat будет запрашивать вашу локальную базу знаний: режим выполнения, фильтры репозиториев, сортировка и опциональная структурированная аналитика. Это локальный план поиска планировщика."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat'ın yerel bilgi tabanınızı nasıl sorgulayacağı: yürütme modu, depo filtreleri, sıralama ve isteğe bağlı yapılandırılmış analitik. Bu, Planlayıcı'nın yerel getirme planıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як Starcat запитуватиме вашу локальну базу знань: режим виконання, фільтри репозиторіїв, сортування та додаткова структурована аналітика. Це локальний план пошуку планувальника."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách Starcat sẽ truy vấn cơ sở tri thức cục bộ của bạn: chế độ thực thi, bộ lọc kho lưu trữ, sắp xếp và phân tích có cấu trúc tùy chọn. Đây là kế hoạch truy xuất cục bộ của Planner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 如何在本地知识库中检索：执行模式、仓库筛选、排序，以及可选的结构化统计。这是 Planner 给出的本地检索方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 如何在本地知識庫中檢索：執行模式、倉庫篩選、排序，以及可選的結構化統計。這是 Planner 給出的本地檢索方案。"
          }
        }
      }
    },
