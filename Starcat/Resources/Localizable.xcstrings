    "activity.announcement.clear.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة جميع الإعلانات المخزنة محليًا. قم بالتحديث لجلبها من GitHub مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle lokal zwischengespeicherten Ankündigungen werden entfernt. Aktualisieren, um erneut von GitHub abzurufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All locally cached announcements will be removed. Refresh to fetch from GitHub again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los anuncios almacenados localmente. Actualice para obtenerlos de GitHub nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les annonces mises en cache localement seront supprimées. Actualisez pour les récupérer depuis GitHub."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua pengumuman yang di-cache secara lokal akan dihapus. Muat ulang untuk mengambil dari GitHub lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli annunci memorizzati localmente verranno rimossi. Aggiorna per recuperarli di nuovo da GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルにキャッシュされたすべてのお知らせが削除されます。更新してGitHubから再取得してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬에 캐시된 모든 공지사항이 제거됩니다. 새로고침하여 GitHub에서 다시 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle lokaal gecachte aankondigingen worden verwijderd. Vernieuw om opnieuw van GitHub op te halen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie lokalnie buforowane ogłoszenia zostaną usunięte. Odśwież, aby pobrać je ponownie z GitHuba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os anúncios armazenados localmente serão removidos. Atualize para buscar novamente do GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все локально кэшированные объявления будут удалены. Обновите, чтобы загрузить их снова с GitHub."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel olarak önbelleğe alınmış tüm duyurular kaldırılacak. Tekrar GitHub'dan almak için yenileyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі локально кешовані оголошення буде видалено. Оновіть, щоб завантажити з GitHub знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả thông báo đã lưu trong bộ nhớ đệm sẽ bị xóa. Làm mới để tải lại từ GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除本机全部公告。刷新后可从 GitHub 重新拉取。"
