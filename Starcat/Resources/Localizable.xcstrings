    "explore.help.trending.cache.offline" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline handling: if the update fails, the current cached ranking remains available and is not cleared."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线处理：更新失败时保留当前缓存，不会清空已有榜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線處理：若更新失敗，保留目前快取的排名，不會清空。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン処理：更新に失敗した場合、現在のキャッシュされたランキングは引き続き利用可能で、クリアされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 처리: 업데이트가 실패하면 현재 캐시된 순위가 유지되며 지워지지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline-Verhalten: Bei fehlgeschlagenem Update bleibt der aktuelle Cache erhalten und wird nicht gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestion hors ligne : si la mise à jour échoue, le classement en cache reste disponible et n'est pas effacé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manejo sin conexión: si la actualización falla, la clasificación en caché actual permanece disponible y no se borra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratamento offline: se a atualização falhar, o ranking em cache atual permanece disponível e não é limpo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestione offline: se l'aggiornamento fallisce, la classifica corrente in cache rimane disponibile e non viene cancellata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обработка офлайн: если обновление не удалось, текущий кешированный рейтинг остаётся доступным и не очищается."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline afhandeling: als de update mislukt, blijft de huidige gecachte ranglijst beschikbaar en wordt niet gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługa offline: jeśli aktualizacja się nie powiedzie, bieżący ranking w cache pozostaje dostępny i nie jest czyszczony."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автономна робота: якщо оновлення не вдається, поточний кешований рейтинг залишається доступним і не очищається."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışı işleme: güncelleme başarısız olursa mevcut önbelleğe alınmış sıralama kullanılabilir durumda kalır ve temizlenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử lý ngoại tuyến: nếu cập nhật thất bại, bảng xếp hạng được lưu trong bộ nhớ đệm hiện tại vẫn khả dụng và không bị xóa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penanganan offline: jika pembaruan gagal, peringkat cache saat ini tetap tersedia dan tidak dihapus."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعامل دون اتصال: إذا فشل التحديث، يظل الترتيب المخزن مؤقتًا الحالي متاحًا ولا يتم مسحه."
          }
        }
      }
    },
