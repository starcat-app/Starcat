    "rag.workspace.debug.rerank.appliedMissingResponseNoteFormat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: Rerank did not return %lld submitted candidates; their hybrid retrieval order was retained."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备注：Rerank 未返回 %lld 个已发送候选，已按综合检索顺序保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備註：Rerank 未返回 %lld 個已發送候選，已按綜合檢索順序保留。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注: Rerankは%lld件の提出候補を返しませんでした。ハイブリッド検索順序が保持されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: Rerank가 제출된 %lld개 후보를 반환하지 않아 하이브리드 검색 순서가 유지되었습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Rerank hat %lld eingereichte Kandidaten nicht zurückgegeben; deren hybride Abrufreihenfolge wurde beibehalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : Le reranking n'a pas renvoyé %lld candidats soumis ; leur ordre de récupération hybride a été conservé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Rerank no devolvió %lld candidatos enviados; se conservó su orden de recuperación híbrida."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: A reclassificação não retornou %lld candidatos enviados; sua ordem de recuperação híbrida foi mantida."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
