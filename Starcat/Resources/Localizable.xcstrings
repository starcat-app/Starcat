      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate external context search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚合搜索"
          }
        }
      }
    },
    "settings.externalSearch.aggregate.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate search is only used for AI context. It may send up to four provider requests, increase waiting time, and consume third-party quota. The Web tab still uses one selected provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚合搜索只用于 AI 外部上下文，可能同时请求最多 4 个 Provider，增加等待时间并消耗第三方额度。Web tab 仍只使用当前选中的单个 Provider。"
          }
        }
      }
    },
    "settings.externalSearch.aiContext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use external web context in repo AI summary and chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库 AI 摘要与对话使用外部网页上下文"
          }
        }
      }
    },
    "settings.externalSearch.aiContext.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, repo AI summary and AI chat fetch external web material into the prompt. Knowledge base RAG uses the per-question web toggle in the composer and is not controlled here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，仓库 AI 摘要与 AI 对话会拉取外部网页材料写入 prompt。知识库 RAG 由问答栏联网开关单独控制，不受此设置影响。"
          }
        }
      }
    },
