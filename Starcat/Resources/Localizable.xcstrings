    "settings.storage.resetAll.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Factory reset local Starcat data for the signed-in account. Use this only when local data corruption causes app issues."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将当前登录账号的 Starcat 本机数据恢复到首次安装状态。仅建议在本地数据异常导致应用问题时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將目前登入帳號的 Starcat 本地資料重設為出廠狀態。僅在本地資料損壞導致應用程式問題時使用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしているアカウントのStarcatローカルデータを工場出荷時状態にリセットします。ローカルデータの破損がアプリの問題を引き起こす場合にのみ使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인된 계정의 Starcat 로컬 데이터를 공장 초기화합니다. 로컬 데이터 손상으로 앱 문제가 발생할 때만 사용하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die lokalen Starcat-Daten für das angemeldete Konto auf die Werkseinstellungen zurück. Verwenden Sie dies nur, wenn eine Beschädigung lokaler Daten zu App-Problemen führt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialisation d'usine des données locales de Starcat pour le compte connecté. Utilisez cette option uniquement en cas de corruption des données locales causant des problèmes dans l'application."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece de fábrica los datos locales de Starcat para la cuenta con sesión iniciada. Úsalo solo cuando la corrupción de datos locales cause problemas en la app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefinição de fábrica dos dados locais do Starcat para a conta logada. Use apenas quando a corrupção de dados locais causar problemas no aplicativo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina i dati locali di Starcat alle impostazioni di fabbrica per l'account connesso. Usalo solo quando la corruzione dei dati locali causa problemi all'app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сброс локальных данных Starcat для текущей учётной записи до заводских настроек. Используйте только при повреждении локальных данных, вызывающем проблемы в приложении."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fabrieksreset van lokale Starcat-gegevens voor het aangemelde account. Gebruik dit alleen wanneer lokale gegevenscorruptie app-problemen veroorzaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywróć ustawienia fabryczne lokalnych danych Starcat dla zalogowanego konta. Użyj tylko wtedy, gdy uszkodzenie danych lokalnych powoduje problemy z aplikacją."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скинути локальні дані Starcat до заводських налаштувань для ввійденого облікового запису. Використовуйте це лише тоді, коли пошкодження локальних даних спричиняє проблеми з додатком."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açılmış hesap için Starcat yerel verilerini fabrika ayarlarına sıfırlayın. Bunu yalnızca yerel veri bozulması uygulama sorunlarına neden olduğunda kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khôi phục cài đặt gốc dữ liệu Starcat cục bộ cho tài khoản đã đăng nhập. Chỉ sử dụng khi dữ liệu cục bộ bị hỏng gây ra sự cố ứng dụng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset pabrik data lokal Starcat untuk akun yang masuk. Gunakan ini hanya jika kerusakan data lokal menyebabkan masalah aplikasi."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة تعيين بيانات Starcat المحلية لحساب المستخدم المسجل دخوله إلى إعدادات المصنع. استخدم هذا فقط عندما يتسبب تلف البيانات المحلية في مشاكل بالتطبيق."
          }
        }
      }
    },
