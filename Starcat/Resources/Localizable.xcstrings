    "agent.artifact.repoInsight.evidenceLimitation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, License, and maintenance activity are not claimed unless present in cited evidence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非引用证据中存在，否则不会断言 README、许可证和维护活动。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README، ترخيص، ونشاط الصيانة لا يتم ادعاءه إلا إذا كان موجودًا في الأدلة المدرجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Lizenz und Wartungsaktivität werden nur beansprucht, wenn sie im zitierten Beweis vorhanden sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Licencia y actividad de mantenimiento no se afirman a menos que estén presentes en las pruebas citadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le README, la licence et l'activité d'entretien ne sont pas revendiqués sauf s'ils sont présents dans les preuves citées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Lisensi, dan aktivitas pemeliharaan tidak diklaim kecuali ada dalam bukti yang dicantumkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Licenza e attività di manutenzione non sono inclusi se non presenti nelle prove citate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README、ライセンス、およびメンテナンス活動は引用された証拠に存在しない場合は主張されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, 라이선스 및 유지보수 활동은 인용된 증거에 존재할 때만 주장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Licentie en onderhoudsactiviteit worden niet geclaimd tenzij aanwezig in geciteerd bewijs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Licencja i aktywność utrzymania nie są uwzględniane, chyba że obecne w cytowanych dowodach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Licença e atividade de manutenção não são afirmados a menos que estejam presentes nas evidências citadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, лицензия и активность поддержки не указаны, если отсутствуют в цитируемых доказательствах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Lisans ve bakım aktiviteleri sadece alıntılanan kanıtlarda varsa iddia edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, ліцензія та активність підтримки не стверджуються, якщо їх немає у цитованому доказі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README, Giấy phép và hoạt động bảo trì không được tuyên bố trừ khi có trong bằng chứng trích dẫn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README、License 和維護活動僅在引用證據中存在時才會聲明。"
