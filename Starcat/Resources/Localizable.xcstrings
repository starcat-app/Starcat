    "settings.general.hideDockIcon.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى Starcat متاحًا من شريط القائمة. أوقف هذا إذا كنت تفضل الإرساء ومدخل Cmd+Tab."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat bleibt über die Menüleiste verfügbar. Deaktivieren Sie diese Option, wenn Sie das Dock und den Cmd+Tab-Eintrag bevorzugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat stays available from the menu bar. Turn this off if you prefer the Dock and Cmd+Tab entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat permanece disponible desde la barra de menú. Desactiva esto si prefieres el Dock y la entrada Cmd+Tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat reste accessible depuis la barre de menus. Désactivez cette option si vous préférez le Dock et le raccourci Cmd+Tab."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat tetap tersedia dari bilah menu. Matikan ini jika Anda lebih suka ikon Dock dan entri Cmd+Tab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat rimane disponibile dalla barra dei menu. Disattiva questa opzione se preferisci il Dock e l'ingresso Cmd+Tab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatはメニューバーから利用可能です。DockとCmd+Tabでの表示を希望する場合は、これをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat는 메뉴 막대에서 계속 사용할 수 있습니다. Dock 및 Cmd+Tab 항목을 선호하는 경우 이 옵션을 끄십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat blijft beschikbaar vanuit de menubalk. Schakel dit uit als u de Voorkeur geeft aan het Dock en Cmd+Tab."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat pozostaje dostępny z paska menu. Wyłącz to, jeśli wolisz ikonę w Docku i wpis Cmd+Tab."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starcat permanece disponível na barra de menus. Desative isso se preferir o Dock e a entrada Cmd+Tab."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat остаётся доступным из строки меню. Отключите это, если предпочитаете значок в Dock и переключение через Cmd+Tab."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat menü çubuğundan kullanılabilir durumda kalır. Dock ve Cmd+Tab girişini tercih ediyorsanız bunu kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat залишається доступним з рядка меню. Вимкніть це, якщо ви віддаєте перевагу піктограмі в Dock і Cmd+Tab."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat vẫn khả dụng từ thanh menu. Tắt tùy chọn này nếu bạn muốn có biểu tượng Dock và phím tắt Cmd+Tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 会保留在菜单栏中；如果你更习惯 Dock 和 Cmd+Tab 入口，可以关闭此项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 會保留在選單列中。如果你偏好 Dock 和 Cmd+Tab 切換，可以關閉此選項。"
          }
        }
      }
    },
