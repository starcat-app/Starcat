    "settings.storage.clearRAGIndex.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only deletes rebuildable chunks and embeddings. Repository data, README, notes, summaries, and library state are unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅删除可重建的分片和向量；仓库数据、README、笔记、摘要和知识库状态不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅删除可重建的分片和向量；仓库数据、README、笔记、摘要和知识库状态不受影响。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、再構築可能なチャンクと埋め込みのみが削除されます。リポジトリデータ、README、メモ、要約、ライブラリの状態は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재구성 가능한 청크와 임베딩만 삭제됩니다. 저장소 데이터, README, 노트, 요약 및 라이브러리 상태는 변경되지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht nur wiederherstellbare Chunks und Embeddings. Repository-Daten, README, Notizen, Zusammenfassungen und Bibliotheksstatus bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime uniquement les chunks et embeddings reconstructibles. Les données de dépôt, README, notes, résumés et l'état de la bibliothèque sont inchangés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo elimina fragmentos y embeddings reconstruibles. Los datos del repositorio, README, notas, resúmenes y estado de la biblioteca no se modifican."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui apenas blocos e embeddings reconstruíveis. Dados do repositório, README, notas, resumos e estado da biblioteca permanecem inalterados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina solo chunk e embedding ricostruibili. Dati repository, README, note, riepiloghi e stato libreria rimangono invariati."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удаляет только восстанавливаемые фрагменты и эмбеддинги. Данные репозитория, README, заметки, сводки и состояние библиотеки не изменяются."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert alleen herbouwbare chunks en embeddings. Repositorygegevens, README, notities, samenvattingen en bibliotheekstatus blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie tylko możliwych do odtworzenia fragmentów i osadzeń. Dane repozytorium, README, notatki, podsumowania i stan biblioteki pozostają bez zmian."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
