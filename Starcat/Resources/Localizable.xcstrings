    "rag.workspace.debug.retrieval.funnel.rankingFormat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chunk ranking: %1$lld unique chunks; %2$lld excluded by the per-repository limit, %3$lld by the total limit, and %4$lld by the combined retrieval-score threshold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分片排序：去重后 %1$lld 条；因单仓库上限排除 %2$lld 条、因总数上限排除 %3$lld 条、因综合检索分阈值排除 %4$lld 条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分片排序：去重後 %1$lld 條；因單倉庫上限排除 %2$lld 條、因總數上限排除 %3$lld 條、因綜合檢索分閾值排除 %4$lld 條。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンクランキング: %1$lld 個の一意チャンク; %2$lld 個がリポジトリごとの制限で除外、%3$lld 個が全体制限で除外、%4$lld 個が複合検索スコアしきい値で除外されました。"
