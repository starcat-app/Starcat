    "explore.help.discover.rule.catalog" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat combines high-attention repositories, repositories active in the last 30 days, and newer repositories created in the last year."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 综合收录高关注度、近 30 天活跃，以及近一年出现的新项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 綜合收錄高關注度、近 30 天活躍，以及近一年出現的新專案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatは、注目度の高いリポジトリ、過去30日間にアクティブなリポジトリ、過去1年以内に作成された新しいリポジトリを組み合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat은 주목도가 높은 저장소, 최근 30일 동안 활동한 저장소, 최근 1년 내에 생성된 최신 저장소를 결합합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat kombiniert Repositories mit hoher Aufmerksamkeit, Repositories, die in den letzten 30 Tagen aktiv waren, und neuere Repositories, die im letzten Jahr erstellt wurden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat combine les dépôts très suivis, les dépôts actifs au cours des 30 derniers jours et les dépôts plus récents créés au cours de la dernière année."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat combina repositorios de alta atención, repositorios activos en los últimos 30 días y repositorios más nuevos creados en el último año."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starcat combina repositórios de alta atenção, repositórios ativos nos últimos 30 dias e repositórios mais novos criados no último ano."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat combina repository ad alta attenzione, repository attivi negli ultimi 30 giorni e repository più recenti creati nell'ultimo anno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat объединяет репозитории с высоким вниманием, репозитории, активные за последние 30 дней, и новые репозитории, созданные за последний год."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat combineert repositories met veel aandacht, repositories die actief zijn in de afgelopen 30 dagen en nieuwere repositories die in het afgelopen jaar zijn gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat łączy repozytoria o wysokiej uwadze, repozytoria aktywne w ciągu ostatnich 30 dni oraz nowsze repozytoria utworzone w ciągu ostatniego roku."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat поєднує репозиторії з високою увагою, репозиторії, активні за останні 30 днів, та новіші репозиторії, створені за останній рік."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat, yüksek dikkat çeken depoları, son 30 günde aktif olan depoları ve son bir yılda oluşturulmuş daha yeni depoları birleştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat kết hợp các kho lưu trữ được chú ý cao, các kho lưu trữ hoạt động trong 30 ngày qua và các kho lưu trữ mới hơn được tạo trong năm qua."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat menggabungkan repositori dengan perhatian tinggi, repositori yang aktif dalam 30 hari terakhir, dan repositori yang lebih baru yang dibuat dalam setahun terakhir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع Starcat بين المستودعات عالية الاهتمام، والمستودعات النشطة في آخر 30 يومًا، والمستودعات الأحدث التي تم إنشاؤها في العام الماضي."
          }
        }
      }
    },
