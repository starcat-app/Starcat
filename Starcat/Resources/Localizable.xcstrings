    "agent.definition.repoAlternatives.defaultPrompt" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن 3-5 بدائل أكثر نشاطًا مشابهة للمستودع الحالي وأنشئ جدول مقارنة."
          }
