          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "К задаче перевода README не привязан ни один AI-провайдер. Откройте Настройки → AI, чтобы исправить это."
          }
        },
        "tr" : {
