    "explore.help.weekly.cache.update" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحديث: يستخدم Starcat التخزين المؤقت المحلي أثناء صلاحيته. بعد انتهاء الصلاحية، يعرض المحتوى المخزن مؤقتًا أولاً ويُحدِّث بصمت في الخلفية؛ التحديث اليدوي يطلب أحدث البيانات فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: Starcat verwendet den lokalen Cache, solange er gültig ist. Nach Ablauf wird der Cache zuerst angezeigt und im Hintergrund aktualisiert; manuelles Aktualisieren fordert sofort die neuesten Daten an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: Starcat uses the local cache while it is valid. After expiry, it shows the cached content first and refreshes silently in the background; manual refresh requests the latest data immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualización: Starcat usa la caché local mientras sea válida. Después de la expiración, muestra el contenido en caché primero y lo actualiza silenciosamente en segundo plano; la actualización manual solicita los datos más recientes de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise à jour : Starcat utilise le cache local tant qu'il est valide. Après expiration, il affiche d'abord le contenu en cache et l'actualise silencieusement en arrière-plan ; une actualisation manuelle demande les dernières données immédiatement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan: Starcat menggunakan cache lokal selama masih valid. Setelah kedaluwarsa, ia menampilkan konten cache terlebih dahulu dan menyegarkan secara diam-diam di latar belakang; penyegaran manual langsung meminta data terbaru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornamento: Starcat utilizza la cache locale finché è valida. Dopo la scadenza, mostra prima il contenuto in cache e lo aggiorna silenziosamente in background; l'aggiornamento manuale richiede immediatamente i dati più recenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新：Starcatは有効な間はローカルキャッシュを使用します。期限切れ後は、キャッシュされたコンテンツを最初に表示し、バックグラウンドで静かに更新します。手動更新は即座に最新データを要求します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트: Starcat는 캐시가 유효한 동안 로컬 캐시를 사용합니다. 만료 후에는 캐시된 콘텐츠를 먼저 표시하고 백그라운드에서 자동으로 새로고침합니다. 수동 새로고침은 즉시 최신 데이터를 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: Starcat gebruikt de lokale cache zolang deze geldig is. Na vervaldatum toont het eerst de gecachte inhoud en ververst het stil op de achtergrond; handmatig vernieuwen vraagt direct de nieuwste gegevens op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja: Starcat używa lokalnego cache, dopóki jest ważny. Po wygaśnięciu najpierw pokazuje zawartość z cache i odświeża w tle; ręczne odświeżenie natychmiast pobiera najnowsze dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualização: o Starcat usa o cache local enquanto for válido. Após expirar, mostra o conteúdo em cache primeiro e atualiza silenciosamente em segundo plano; a atualização manual solicita os dados mais recentes imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновление: Starcat использует локальный кеш, пока он действителен. После истечения срока сначала показывается кешированное содержимое, а затем оно бесшумно обновляется в фоне; ручное обновление запрашивает последние данные немедленно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme: Starcat geçerli olduğu sürece yerel önbelleği kullanır. Süre dolduktan sonra önce önbelleğe alınmış içeriği gösterir ve arka planda sessizce yeniler; manuel yenileme en son verileri hemen ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення: Starcat використовує локальний кеш, поки він дійсний. Після закінчення терміну спочатку показує кешований вміст і оновлює його у фоновому режимі; ручне оновлення негайно запитує останні дані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cập nhật: Starcat sử dụng bộ nhớ đệm cục bộ khi còn hiệu lực. Sau khi hết hạn, nó hiển thị nội dung được lưu trong bộ nhớ đệm trước và làm mới trong nền; làm mới thủ công sẽ yêu cầu dữ liệu mới nhất ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新方式：有效期内直接使用本地缓存；过期后先显示已有内容并在后台静默更新，手动刷新会立即请求最新数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
