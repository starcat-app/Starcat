    "settings.externalSearch.apiKey.anonymousDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous requests do not send an Authorization header. Testing an API Key always uses bearer mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名请求不会发送 Authorization header。测试 API Key 时始终使用 bearer 模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名请求不会发送 Authorization header。测试 API Key 时始终使用 bearer 模式。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名リクエストはAuthorizationヘッダーを送信しません。APIキーのテストは常にベアラーモードを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익명 요청은 Authorization 헤더를 보내지 않습니다. API 키 테스트는 항상 bearer 모드를 사용합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Anfragen senden keinen Authorization-Header. Das Testen eines API-Schlüssels verwendet immer den Bearer-Modus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes anonymes n'envoient pas d'en-tête Authorization. Tester une clé API utilise toujours le mode bearer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes anónimas no envían un encabezado de Autorización. Probar una clave API siempre usa el modo bearer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitações anônimas não enviam um cabeçalho de autorização. Testar uma chave de API sempre usa o modo portador."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste anonime non inviano un'intestazione Authorization. Il test di una chiave API utilizza sempre la modalità bearer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонимные запросы не отправляют заголовок Authorization. Тестирование ключа API всегда использует режим bearer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonieme verzoeken verzenden geen Authorization-header. Het testen van een API-sleutel gebruikt altijd de bearer-modus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądania anonimowe nie wysyłają nagłówka Authorization. Testowanie klucza API zawsze używa trybu bearer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонімні запити не надсилають заголовок Authorization. Тестування ключа API завжди використовує режим bearer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonim istekler Authorization başlığı göndermez. Bir API Anahtarını test etmek her zaman bearer modunu kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu ẩn danh không gửi tiêu đề Authorization. Kiểm tra khóa API luôn sử dụng chế độ bearer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan anonim tidak mengirim header Authorization. Pengujian Kunci API selalu menggunakan mode bearer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطلبات المجهولة لا ترسل ترويسة التفويض. اختبار مفتاح API يستخدم دائمًا وضع الحامل."
          }
        }
      }
    },
