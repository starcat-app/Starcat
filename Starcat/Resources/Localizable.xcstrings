    "settings.pro.direct.cancel.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancellation is scheduled for the end of the current billing period. Your current Pro access remains active until then."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消会预约到当前账期结束时执行；本期已开通的 Pro 权益仍可继续使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消將排定於目前計費週期結束時執行。在此之前，您目前的 Pro 存取權仍維持有效。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセルは現在の請求期間の終了時に予定されています。それまではProアクセスが有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소는 현재 청구 기간 종료 시 예약됩니다. 현재 Pro 액세스는 그때까지 유지됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kündigung ist für das Ende des aktuellen Abrechnungszeitraums geplant. Ihr aktueller Pro-Zugriff bleibt bis dahin aktiv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'annulation est programmée pour la fin de la période de facturation en cours. Votre accès Pro actuel reste actif jusqu'à cette date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cancelación está programada para el final del período de facturación actual. Tu acceso Pro actual permanece activo hasta entonces."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cancelamento está agendado para o final do período de cobrança atual. Seu acesso Pro atual permanece ativo até lá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'annullamento è programmato per la fine del periodo di fatturazione corrente. Il tuo attuale accesso Pro rimane attivo fino ad allora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмена запланирована на конец текущего расчётного периода. Ваш текущий доступ Pro остаётся активным до этого момента."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulering is gepland voor het einde van de huidige factureringsperiode. Uw huidige Pro-toegang blijft tot die tijd actief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulowanie jest zaplanowane na koniec bieżącego okresu rozliczeniowego. Twój obecny dostęp Pro pozostaje aktywny do tego czasu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скасування заплановано на кінець поточного розрахункового періоду. Ваш поточний доступ Pro залишається активним до цього часу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İptal, mevcut fatura döneminin sonu için planlanmıştır. Mevcut Pro erişiminiz o zamana kadar aktif kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc hủy được lên lịch vào cuối kỳ thanh toán hiện tại. Quyền truy cập Pro hiện tại của bạn vẫn hoạt động cho đến lúc đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembatalan dijadwalkan pada akhir periode penagihan saat ini. Akses Pro Anda saat ini tetap aktif hingga saat itu."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت جدولة الإلغاء لنهاية فترة الفوترة الحالية. يظل وصول Pro الحالي نشطًا حتى ذلك الحين."
          }
        }
      }
    },
    "settings.pro.direct.cancel.missingSubscription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No monthly subscription record is stored on this Mac. Open the Creem customer portal from your receipt to manage billing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 没有保存月订阅记录。请从 Creem 收据进入客户门户管理账单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 上未儲存每月訂閱記錄。請從您的 Creem 收據開啟客戶入口網站以管理帳單。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacに月額サブスクリプションの記録はありません。領収書からCreemカスタマーポータルを開いて請求を管理してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 저장된 월간 구독 기록이 없습니다. 영수증에서 Creem 고객 포털을 열어 청구를 관리하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac ist kein monatlicher Abonnementdatensatz gespeichert. Öffnen Sie das Creem-Kundenportal über Ihre Quittung, um die Abrechnung zu verwalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun abonnement mensuel n'est enregistré sur ce Mac. Ouvrez le portail client Creem à partir de votre reçu pour gérer la facturation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún registro de suscripción mensual almacenado en este Mac. Abre el portal de cliente de Creem desde tu recibo para gestionar la facturación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum registro de assinatura mensal está armazenado neste Mac. Abra o portal do cliente Creem a partir do seu recibo para gerenciar a cobrança."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun record di abbonamento mensile è memorizzato su questo Mac. Apri il portale clienti Creem dalla tua ricevuta per gestire la fatturazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом Mac нет записи о ежемесячной подписке. Откройте портал клиента Creem из вашего чека, чтобы управлять оплатой."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen maandelijks abonnementsrecord opgeslagen op deze Mac. Open het Creem-klantportaal via uw bon om de facturering te beheren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym Macu nie ma zapisu miesięcznej subskrypcji. Otwórz portal klienta Creem z paragonu, aby zarządzać rozliczeniami."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому Mac не збережено запису про щомісячну підписку. Відкрийте портал клієнта Creem зі свого рахунку, щоб керувати виставленням рахунків."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac'te kayıtlı aylık abonelik kaydı yok. Faturanızdan Creem müşteri portalını açarak ödemeyi yönetin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có bản ghi đăng ký hàng tháng nào được lưu trên máy Mac này. Mở cổng khách hàng Creem từ biên lai của bạn để quản lý thanh toán."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada catatan langganan bulanan yang disimpan di Mac ini. Buka portal pelanggan Creem dari tanda terima Anda untuk mengelola penagihan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد سجل اشتراك شهري مخزن على جهاز Mac هذا. افتح بوابة عملاء Creem من إيصالك لإدارة الفوترة."
          }
        }
      }
    },
