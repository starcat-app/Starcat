    "onboarding.step5.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn selected repositories into a local knowledge workspace. Ask questions across README, notes, and summaries, then inspect the cited evidence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把选中的仓库变成一个本地知识工作台。你可以跨 README、笔记和摘要提问，并检查答案引用的证据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把選中的倉庫變成一個本地知識工作台。你可以跨 README、筆記和摘要提問，並檢查答案引用的證據。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したリポジトリをローカルナレッジワークスペースに変換します。README、ノート、サマリーにわたって質問し、引用された証拠を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 저장소를 로컬 지식 작업 공간으로 전환하세요. README, 노트, 요약 전반에 걸쳐 질문하고 인용된 증거를 검토하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwandeln Sie ausgewählte Repositorys in einen lokalen Wissensarbeitsbereich. Stellen Sie Fragen zu README, Notizen und Zusammenfassungen und prüfen Sie die zitierten Belege."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez des dépôts sélectionnés en un espace de travail de connaissances local. Posez des questions sur les README, les notes et les résumés, puis inspectez les preuves citées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte repositorios seleccionados en un espacio de trabajo de conocimiento local. Haz preguntas sobre README, notas y resúmenes, luego inspecciona la evidencia citada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme repositórios selecionados em um espaço de conhecimento local. Faça perguntas sobre README, notas e resumos e depois inspecione as evidências citadas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma i repository selezionati in uno spazio di lavoro conoscitivo locale. Fai domande su README, note e riassunti, poi ispeziona le prove citate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превратите выбранные репозитории в локальное рабочее пространство знаний. Задавайте вопросы по README, заметкам и сводкам, затем изучайте цитируемые источники."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet geselecteerde repositories om in een lokale kenniswerkruimte. Stel vragen over README, notities en samenvattingen en bekijk de geciteerde bronnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień wybrane repozytoria w lokalną przestrzeń roboczą wiedzy. Zadawaj pytania dotyczące README, notatek i podsumowań, a następnie przeglądaj cytowane dowody."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетворіть вибрані репозиторії на локальний робочий простір знань. Ставте запитання щодо README, нотаток та підсумків, а потім перевіряйте наведені докази."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili depoları yerel bir bilgi çalışma alanına dönüştürün. README, notlar ve özetler arasında sorular sorun, ardından alıntılanan kanıtları inceleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biến các kho lưu trữ đã chọn thành không gian làm việc kiến thức cục bộ. Đặt câu hỏi qua README, ghi chú và tóm tắt, sau đó kiểm tra bằng chứng được trích dẫn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah repositori terpilih menjadi ruang kerja pengetahuan lokal. Ajukan pertanyaan di seluruh README, catatan, dan ringkasan, lalu periksa bukti yang dikutip."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حوّل المستودعات المحددة إلى مساحة عمل معرفية محلية. اطرح أسئلة عبر README والملاحظات والملخصات، ثم افحص الأدلة المستشهد بها."
          }
        }
      }
    },
