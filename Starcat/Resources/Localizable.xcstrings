    "githubStarLists.aiGrouping.explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI can suggest zero, one, or multiple existing Lists for each repository. It never creates Lists, removes memberships, or writes anything before you review the suggestions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 可以为每个仓库建议零个、一个或多个已有分组。AI 不会创建分组、移除已有关系，也不会在你审核前写入任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 可以為每個倉庫建議零個、一個或多個已有分組。AI 不會建立分組、移除已有關係，也不會在你審核前寫入任何內容。"
          }
        }
      }
    },
