      }
    },
    "rag.workspace.inspector.plan.help.repoContext.windowFit.case.full" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاءمة XML كاملة: XML الأصلي يناسب النافذة المتبقية؛ لا يتم إزالة أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständige XML-Passung: die ursprüngliche XML passt in das verbleibende Fenster; nichts wird entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full XML fit: the original XML fits the remaining window; nothing is removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML completo ajustado: el XML original cabe en la ventana restante; no se elimina nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML complet ajusté : le XML d'origine tient dans la fenêtre restante ; rien n'est supprimé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML penuh sesuai: XML asli sesuai dengan sisa jendela; tidak ada yang dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XML completo adattato: l'XML originale si adatta alla finestra rimanente; nulla viene rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全XML適合: 元のXMLが残りのウィンドウに収まり、何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 XML 핏: 원본 XML이 남은 윈도우에 맞음; 제거된 항목 없음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledige XML-passing: de originele XML past in het resterende venster; er wordt niets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełne dopasowanie XML: oryginalny XML mieści się w pozostałym oknie; nic nie jest usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste completo do XML: o XML original cabe na janela restante; nada é removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полное размещение XML: исходный XML помещается в оставшееся окно; ничего не удаляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
