          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Mac straci dostęp Pro. Możesz ponownie aktywować licencję na innym Macu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей Mac втратить доступ до Pro. Ви зможете активувати ліцензію на іншому Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac Pro erişimini kaybedecek. Lisansı başka bir Mac'te etkinleştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
