    "settings.storage.translation.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README مترجم بالذكاء الاصطناعي مخزن مؤقتًا على القرص. يتم إخلاؤه تلقائيًا عند تجاوز 50 ميجابايت أو 60 يومًا من عدم النشاط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-übersetzte READMEs, die auf der Festplatte zwischengespeichert werden. Automatische Entfernung bei Überschreitung von 50 MB oder 60 Tagen Inaktivität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-translated README cached on disk. Auto-evicted when exceeding 50 MB or 60 days idle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README traducido por IA almacenado en caché en disco. Se elimina automáticamente cuando supera los 50 MB o 60 días de inactividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README traduit par IA mis en cache sur le disque. Suppression automatique si dépasse 50 Mo ou 60 jours d'inactivité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README yang diterjemahkan AI di-cache di disk. Otomatis dihapus jika melebihi 50 MB atau tidak digunakan selama 60 hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README tradotto dall'AI memorizzato nella cache su disco. Viene rimosso automaticamente quando supera 50 MB o 60 giorni di inattività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI翻訳されたREADMEがディスクにキャッシュされます。50MBまたは60日間未使用で自動的に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 번역된 README가 디스크에 캐시됩니다. 50MB 초과 또는 60일 동안 사용하지 않으면 자동 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-vertaalde README op schijf gecachet. Automatisch verwijderd bij overschrijding van 50 MB of 60 dagen inactiviteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetłumaczone przez AI README zapisane na dysku. Automatycznie usuwane po przekroczeniu 50 MB lub 60 dni bezczynności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README traduzido por IA armazenado em cache no disco. Removido automaticamente ao exceder 50 MB ou 60 dias ocioso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переведённые AI README, кешированные на диске. Автоматически удаляются при превышении 50 МБ или 60 днях бездействия."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI tarafından çevrilmiş README diske önbelleğe alınır. 50 MB veya 60 gün boşta kalma sınırını aştığında otomatik olarak silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перекладені ШІ README, кешовані на диску. Автоматично видаляються при перевищенні 50 МБ або 60 днів бездіяльності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "README được dịch bằng AI được lưu trong bộ nhớ đệm trên đĩa. Tự động xóa khi vượt quá 50 MB hoặc không sử dụng trong 60 ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 翻译后的 README 落地磁盘缓存。超过 50 MB 或 60 天未访问时自动淘汰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 翻譯的 README 快取於磁碟。超過 50 MB 或 60 天未使用時自動清除。"
          }
        }
      }
