    "about.eula.term4.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقدم هذا البرنامج \"كما هو\" دون أي ضمانات من أي نوع. إلى أقصى حد يسمح به القانون، لا يتحمل المطور المسؤولية عن الأضرار المباشرة أو غير المباشرة الناشئة عن استخدامك لهذا البرنامج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Software wird „wie besehen“ ohne jegliche Gewährleistung bereitgestellt. Im gesetzlich zulässigen Umfang haftet der Entwickler nicht für direkte oder indirekte Schäden, die aus der Nutzung dieser Software entstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This software is provided \"as is\" without warranties of any kind. To the maximum extent permitted by law, the developer is not liable for direct or indirect damages arising from your use of this software."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este software se proporciona \"tal cual\", sin garantías de ningún tipo. En la máxima medida permitida por la ley, el desarrollador no es responsable por daños directos o indirectos derivados del uso de este software."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce logiciel est fourni « tel quel » sans garantie d'aucune sorte. Dans toute la mesure permise par la loi, le développeur n'est pas responsable des dommages directs ou indirects découlant de votre utilisation de ce logiciel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat lunak ini disediakan \"sebagaimana adanya\" tanpa jaminan apa pun. Sejauh diizinkan oleh hukum, pengembang tidak bertanggung jawab atas kerusakan langsung atau tidak langsung yang timbul dari penggunaan perangkat lunak ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo software viene fornito \"così com'è\" senza garanzie di alcun tipo. Nella misura massima consentita dalla legge, lo sviluppatore non è responsabile per danni diretti o indiretti derivanti dall'uso di questo software."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本ソフトウェアは「現状のまま」提供され、いかなる種類の保証もありません。適用法で認められる最大限の範囲において、開発者は本ソフトウェアの使用から生じる直接的または間接的な損害について責任を負いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 소프트웨어는 어떠한 종류의 보증 없이 \"있는 그대로\" 제공됩니다. 법률이 허용하는 최대 범위 내에서 개발자는 이 소프트웨어 사용으로 인해 발생하는 직접적 또는 간접적 손해에 대해 책임을 지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze software wordt geleverd 'zoals het is' zonder enige vorm van garantie. Voor zover maximaal toegestaan door de wet is de ontwikkelaar niet aansprakelijk voor directe of indirecte schade die voortvloeit uit uw gebruik van deze software."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To oprogramowanie jest dostarczane „tak jak jest” bez żadnych gwarancji. W maksymalnym zakresie dozwolonym przez prawo, twórca nie ponosi odpowiedzialności za bezpośrednie lub pośrednie szkody wynikające z używania tego oprogramowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este software é fornecido \"como está\", sem garantias de qualquer tipo. Na máxima extensão permitida por lei, o desenvolvedor não é responsável por danos diretos ou indiretos decorrentes do uso deste software."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это программное обеспечение предоставляется «как есть» без каких-либо гарантий. В максимальной степени, разрешённой законом, разработчик не несёт ответственности за прямые или косвенные убытки, возникшие в результате использования вами этого программного обеспечения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yazılım, hiçbir türde garanti olmaksızın \"olduğu gibi\" sağlanmaktadır. Yasaların izin verdiği azami ölçüde, geliştirici bu yazılımı kullanımınızdan kaynaklanan doğrudan veya dolaylı zararlardan sorumlu değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це програмне забезпечення надається «як є» без будь-яких гарантій. Максимально дозволеною законом мірою розробник не несе відповідальності за прямі чи непрямі збитки, що виникають внаслідок використання цього програмного забезпечення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần mềm này được cung cấp \"nguyên trạng\" mà không có bất kỳ bảo đảm nào. Trong phạm vi tối đa được pháp luật cho phép, nhà phát triển không chịu trách nhiệm về các thiệt hại trực tiếp hoặc gián tiếp phát sinh từ việc bạn sử dụng phần mềm này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本软件按「现状」提供，不附带任何明示或暗示的保证。在法律允许的最大范围内，开发者不对因使用本软件而产生的直接或间接损失承担责任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本軟體依「現狀」提供，不附帶任何明示或默示之擔保。於法律允許之最大範圍內，開發者不就因使用本軟體所生之直接或間接損害負擔責任。"
          }
        }
      }
    },
