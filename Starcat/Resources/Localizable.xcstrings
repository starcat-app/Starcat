    "explore.help.trending.cache.offline": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline handling: if the update fails, the current cached ranking remains available and is not cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线处理：更新失败时保留当前缓存，不会清空已有榜单。"
          }
        }
      }
    },
    "explore.help.trending.cache.ttl": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache lifetime: 1 hour for Daily, 6 hours for Weekly, and 24 hours for Monthly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存有效期：日榜 1 小时、周榜 6 小时、月榜 24 小时。"
          }
        }
      }
    },
    "explore.help.trending.cache.update": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update: after expiry, Starcat shows the existing ranking first and refreshes it in the background. Manual refresh requests the latest data immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新方式：过期后先显示已有榜单，同时在后台更新；手动刷新会立即请求最新数据。"
          }
        }
      }
    },
    "explore.help.trending.open": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn about Trending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解趋势的数据规则"
          }
        }
      }
    },
    "explore.help.trending.rule.meaning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trending reflects short-term attention changes and is not the same as long-term popularity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "趋势反映短期关注度变化，不等同于长期热门。"
          }
        }
      }
    },
    "explore.help.trending.rule.period": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows repositories from GitHub's daily, weekly, and monthly Trending lists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
