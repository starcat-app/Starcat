    "settings.mcp.agentSetup.cli.agent.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق هذا الطلب في Codex أو Claude Code أو أي وكيل ذكاء اصطناعي آخر ودعه يثبّت ويتحقق من CLI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie diese Anfrage in Codex, Claude Code oder einen anderen KI-Agenten ein und lassen Sie ihn die CLI installieren und überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste this request into Codex, Claude Code, or another AI agent and let it install and verify the CLI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega esta solicitud en Codex, Claude Code u otro agente de IA y deja que instale y verifique la CLI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez cette demande dans Codex, Claude Code ou un autre agent IA et laissez-le installer et vérifier la CLI."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempelkan permintaan ini ke Codex, Claude Code, atau agen AI lain dan biarkan ia menginstal serta memverifikasi CLI."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla questa richiesta in Codex, Claude Code o un altro agente AI e lascia che installi e verifichi la CLI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリクエストをCodex、Claude Code、または他のAIエージェントに貼り付けて、CLIのインストールと確認を実行させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 요청을 Codex, Claude Code 또는 다른 AI 에이전트에 붙여넣어 CLI를 설치하고 확인하도록 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plak dit verzoek in Codex, Claude Code of een andere AI-agent en laat het de CLI installeren en verifiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej to żądanie do Codex, Claude Code lub innego agenta AI, aby zainstalował i zweryfikował CLI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole esta solicitação no Codex, Claude Code ou outro agente de IA e deixe-o instalar e verificar a CLI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте этот запрос в Codex, Claude Code или другого ИИ-агента, и он установит и проверит CLI."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu isteği Codex, Claude Code veya başka bir yapay zeka aracısına yapıştırın ve CLI'yı kurup doğrulamasını sağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставте цей запит у Codex, Claude Code або іншого AI-агента, щоб він встановив і перевірив CLI."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán yêu cầu này vào Codex, Claude Code hoặc tác nhân AI khác và để nó cài đặt và xác minh CLI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
