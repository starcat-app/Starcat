    "settings.pro.direct.checkout.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح صفحة الدفع في متصفحك. بعد الدفع، استخدم مفتاح الترخيص من إيصالك لتنشيط Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Zahlungsseite in Ihrem Browser. Verwenden Sie nach der Zahlung den Lizenzschlüssel von Ihrer Quittung, um Pro zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the payment page in your browser. After payment, use the license key from your receipt to activate Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la página de pago en tu navegador. Después del pago, usa la clave de licencia de tu recibo para activar Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la page de paiement dans votre navigateur. Après le paiement, utilisez la clé de licence de votre reçu pour activer Pro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka halaman pembayaran di browser Anda. Setelah pembayaran, gunakan kunci lisensi dari tanda terima Anda untuk mengaktifkan Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la pagina di pagamento nel tuo browser. Dopo il pagamento, usa la chiave di licenza dalla ricevuta per attivare Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザで支払いページが開きます。支払い後、領収書のライセンスキーを使用してProを有効化してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저에서 결제 페이지가 열립니다. 결제 후 영수증의 라이선스 키를 사용하여 Pro를 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent de betalingspagina in uw browser. Na betaling gebruikt u de licentiesleutel van uw bon om Pro te activeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera stronę płatności w przeglądarce. Po dokonaniu płatności użyj klucza licencyjnego z paragonu, aby aktywować Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre a página de pagamento no seu navegador. Após o pagamento, use a chave de licença do seu recibo para ativar o Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает страницу оплаты в вашем браузере. После оплаты используйте лицензионный ключ из чека для активации Pro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödeme sayfasını tarayıcınızda açar. Ödemeden sonra, faturanızdaki lisans anahtarını kullanarak Pro'yu etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває сторінку оплати у вашому браузері. Після оплати використовуйте ліцензійний ключ з рахунку для активації Pro."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở trang thanh toán trong trình duyệt của bạn. Sau khi thanh toán, sử dụng khóa cấp phép từ biên lai để kích hoạt Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
