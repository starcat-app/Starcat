    "githubStarLists.editor.delete.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete the list on GitHub and remove its repository memberships."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会在 GitHub 删除该分组，并移除其中的仓库关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會在 GitHub 上刪除該群組，並移除其中的倉庫關聯。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによりGitHub上のリストが削除され、リポジトリのメンバーシップが解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub에서 목록이 삭제되고 저장소 멤버십이 제거됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht die Liste auf GitHub und entfernt ihre Repository-Mitgliedschaften."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera la liste sur GitHub et retirera ses appartenances aux dépôts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará la lista en GitHub y sus membresías de repositorio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá a lista no GitHub e removerá as associações de repositórios."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà l'elenco su GitHub e rimuoverà le sue appartenenze ai repository."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит список на GitHub и его членства в репозиториях."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert de lijst op GitHub en verwijdert de repositorylidmaatschappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie listy na GitHub i usunięcie jej członkostw w repozytoriach."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить список на GitHub і видалить членство в репозиторіях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, GitHub'daki listeyi ve depo üyeliklerini silecektir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa danh sách trên GitHub và loại bỏ tư cách thành viên kho lưu trữ của nó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus daftar di GitHub dan menghapus keanggotaan repositorinya."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف القائمة على GitHub وإزالة عضويات المستودعات المرتبطة بها."
          }
        }
      }
    },
