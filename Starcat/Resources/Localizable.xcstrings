    "settings.ai.prompt.placeholders.footnote.translation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: يجب أن يظهر {targetLanguage} في أي من الموجهين؛ العنصر النائب لبيانات المصدر للوضع المحدد ينتمي إلى موجه المستخدم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: {targetLanguage} muss in einem der Prompts vorkommen; der Quelldaten-Platzhalter für den ausgewählten Modus gehört in den Benutzer-Prompt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: {targetLanguage} must appear in either prompt; the source-data placeholder for the selected mode belongs in the User Prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: {targetLanguage} debe aparecer en cualquiera de los prompts; el marcador de datos fuente para el modo seleccionado pertenece al Prompt de Usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : {targetLanguage} doit apparaître dans l'un des prompts ; l'espace réservé des données source pour le mode sélectionné appartient au prompt utilisateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan: {targetLanguage} harus muncul di salah satu prompt; placeholder data sumber untuk mode yang dipilih berada di Prompt Pengguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: {targetLanguage} deve apparire in uno dei due prompt; il segnaposto dei dati sorgente per la modalità selezionata appartiene al Prompt Utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注：{targetLanguage} はどちらかのプロンプトに含める必要があります。選択したモードのソースデータプレースホルダーはユーザープロンプトに属します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: {targetLanguage}는 두 프롬프트 중 하나에 나타나야 합니다. 선택한 모드의 소스 데이터 플레이스홀더는 사용자 프롬프트에 속합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: {targetLanguage} moet in een van beide prompts voorkomen; de placeholder voor de bron-data van de geselecteerde modus hoort in de gebruikersprompt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: {targetLanguage} musi wystąpić w jednym z promptów; placeholder danych źródłowych dla wybranego trybu należy do Promptu użytkownika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: {targetLanguage} deve aparecer em um dos prompts; o placeholder de dados de origem para o modo selecionado pertence ao Prompt do Usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: {targetLanguage} должен присутствовать в одном из запросов; заполнитель исходных данных для выбранного режима должен находиться в пользовательском запросе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not: {targetLanguage} istemlerden birinde bulunmalıdır; seçilen mod için kaynak veri yer tutucusu Kullanıcı İstemine aittir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примітка: {targetLanguage} має бути присутнім в одному з запитів; заповнювач вихідних даних для вибраного режиму належить до User Prompt."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu ý: {targetLanguage} phải xuất hiện trong một trong hai lời nhắc; trình giữ chỗ dữ liệu nguồn cho chế độ đã chọn thuộc về User Prompt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说明：{targetLanguage} 必须出现在任一 Prompt 中；当前模式的源数据占位符应放在 User Prompt。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說明：{targetLanguage} 必須出現在任一 Prompt 中；當前模式的源數據佔位符應放在 User Prompt。"
          }
        }
      }
    },
    "settings.ai.prompt.placeholders.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احذف عنصرًا نائبًا من الموجه لتخطي حقن تلك البيانات؛ استخدم استعادة الافتراضي إذا أفسدت القالب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschen Sie einen Platzhalter aus dem Prompt, um das Einfügen dieser Daten zu überspringen; verwenden Sie „Standard wiederherstellen“, wenn Sie die Vorlage beschädigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete a placeholder from the prompt to skip injecting that data; use Restore Default if you break the template."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina un marcador del prompt para omitir la inyección de esos datos; usa Restablecer valores predeterminados si rompes la plantilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez un espace réservé du prompt pour éviter d'injecter ces données ; utilisez Restaurer les valeurs par défaut si vous cassez le modèle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus placeholder dari prompt untuk melewatkan penyuntikan data tersebut; gunakan Kembalikan Default jika Anda merusak template."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina un segnaposto dal prompt per saltare l'iniezione di quei dati; usa Ripristina Predefiniti se rompi il modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトからプレースホルダーを削除すると、そのデータの注入をスキップします。テンプレートを壊した場合は「デフォルトに戻す」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트에서 플레이스홀더를 삭제하면 해당 데이터 주입을 건너뜁니다. 템플릿을 망가뜨린 경우 기본값 복원을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder een placeholder uit de prompt om het injecteren van die data over te slaan; gebruik Standaard herstellen als u de sjabloon breekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń placeholder z promptu, aby pominąć wstrzykiwanie tych danych; użyj Przywróć domyślne, jeśli zepsujesz szablon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua um placeholder do prompt para pular a injeção desses dados; use Restaurar Padrão se você quebrar o modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалите заполнитель из запроса, чтобы пропустить вставку этих данных; используйте «Восстановить по умолчанию», если вы нарушили шаблон."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu verileri eklememek için istemden bir yer tutucuyu silin; şablonu bozarsanız Varsayılanı Geri Yükle'yi kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаліть заповнювач із запиту, щоб пропустити вставку цих даних; використовуйте «Відновити стандартні», якщо ви зламали шаблон."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa trình giữ chỗ khỏi lời nhắc để bỏ qua việc chèn dữ liệu đó; sử dụng Khôi phục mặc định nếu bạn làm hỏng mẫu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 prompt 里删掉占位符即不注入对应数据；改坏了点恢复默认按钮还原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 prompt 裡刪掉佔位符即不注入對應數據；改壞了點恢復默認按鈕還原。"
          }
        }
      }
    },
