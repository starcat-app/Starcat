    "explore.help.weekly.rule.inclusion" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر المشروع بعد أن يتم تضمينه من قبل مصدر واحد مفعَّل على الأقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Projekt erscheint, nachdem es von mindestens einer aktivierten Quelle aufgenommen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A project appears after it has been included by at least one enabled source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proyecto aparece después de haber sido incluido por al menos una fuente habilitada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un projet apparaît après avoir été inclus par au moins une source activée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek muncul setelah disertakan oleh setidaknya satu sumber yang diaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un progetto appare dopo essere stato incluso da almeno una fonte abilitata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトは、有効なソースの少なくとも1つに含まれた後に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트는 하나 이상의 활성화된 소스에 포함된 후에 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een project verschijnt nadat het is opgenomen door ten minste één ingeschakelde bron."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt pojawia się po dodaniu przez co najmniej jedno włączone źródło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um projeto aparece após ser incluído por pelo menos uma fonte habilitada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проект появляется после того, как его включил хотя бы один активный источник."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir proje, en az bir etkin kaynak tarafından dahil edildikten sonra görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проект з'являється після того, як його включило хоча б одне активоване джерело."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một dự án xuất hiện sau khi nó được bao gồm bởi ít nhất một nguồn đã bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目至少被一个已启用来源收录后才会出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案至少被一個已啟用來源收錄後才會出現。"
          }
        }
      }
    },
    "explore.help.weekly.rule.priority" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يأتي المشروع من مصادر متعددة، وتظهر المشاريع المثبتة من قبل المحرر أولاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Projekt kann aus mehreren Quellen stammen, und von Redakteuren angeheftete Projekte erscheinen zuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A project may come from multiple sources, and editor-pinned projects appear first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proyecto puede provenir de múltiples fuentes, y los proyectos fijados por el editor aparecen primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un projet peut provenir de plusieurs sources, et les projets épinglés par l'éditeur apparaissent en premier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek dapat berasal dari beberapa sumber, dan proyek yang disematkan editor muncul terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un progetto può provenire da più fonti e i progetti fissati dall'editor appaiono per primi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトは複数のソースから来る可能性があり、エディターがピン留めしたプロジェクトが最初に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트는 여러 소스에서 올 수 있으며, 편집자가 고정한 프로젝트가 먼저 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een project kan uit meerdere bronnen komen en door redactie vastgezette projecten worden eerst getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt może pochodzić z wielu źródeł, a projekty przypięte przez redaktora są wyświetlane jako pierwsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um projeto pode vir de várias fontes, e os projetos fixados pelo editor aparecem primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проект может быть из нескольких источников; закреплённые редактором проекты отображаются первыми."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir proje birden çok kaynaktan gelebilir ve editör tarafından sabitlenen projeler önce görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проект може походити з кількох джерел, і проекти, закріплені редактором, відображаються першими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một dự án có thể đến từ nhiều nguồn và các dự án được biên tập viên ghim sẽ xuất hiện trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一项目可能来自多个来源，编辑置顶的项目会优先展示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一專案可能來自多個來源，編輯置頂的專案會優先顯示。"
          }
        }
      }
    },
