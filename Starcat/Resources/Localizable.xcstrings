    "settings.externalSearch.aggregate.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggregate search is only used for AI context. It may send up to four provider requests, increase waiting time, and consume third-party quota. The Web tab still uses one selected provider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聚合搜索只用于 AI 外部上下文，可能同时请求最多 4 个 Provider，增加等待时间并消耗第三方额度。Web tab 仍只使用当前选中的单个 Provider。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聚合搜索只用于 AI 外部上下文，可能同时请求最多 4 个 Provider，增加等待时间并消耗第三方额度。Web tab 仍只使用当前选中的单个 Provider。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集約検索はAIコンテキストにのみ使用されます。最大4つのプロバイダリクエストを送信し、待機時間が増加し、サードパーティのクォータを消費する可能性があります。Webタブは引き続き1つの選択されたプロバイダを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통합 검색은 AI 컨텍스트에만 사용됩니다. 최대 4개의 제공자 요청을 보내고 대기 시간이 늘어나며 타사 할당량을 소비할 수 있습니다. 웹 탭은 여전히 선택한 제공자 하나를 사용합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aggregierte Suche wird nur für den KI-Kontext verwendet. Sie kann bis zu vier Anbieteranfragen senden, die Wartezeit verlängern und das Kontingent Dritter verbrauchen. Der Web-Tab verwendet weiterhin einen ausgewählten Anbieter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche agrégée est utilisée uniquement pour le contexte IA. Elle peut envoyer jusqu'à quatre requêtes de fournisseur, augmenter le temps d'attente et consommer le quota tiers. L'onglet Web utilise toujours un seul fournisseur sélectionné."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda agregada solo se usa para contexto de IA. Puede enviar hasta cuatro solicitudes de proveedor, aumentar el tiempo de espera y consumir cuota de terceros. La pestaña Web sigue usando un proveedor seleccionado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pesquisa agregada é usada apenas para contexto de IA. Pode enviar até quatro solicitações de provedor, aumentar o tempo de espera e consumir cota de terceiros. A aba Web ainda usa um provedor selecionado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca aggregata viene utilizzata solo per il contesto AI. Può inviare fino a quattro richieste al provider, aumentare i tempi di attesa e consumare la quota di terze parti. La scheda Web utilizza ancora un solo provider selezionato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агрегированный поиск используется только для контекста ИИ. Он может отправлять до четырёх запросов к провайдерам, увеличивать время ожидания и расходовать квоту сторонних сервисов. Вкладка «Веб» по-прежнему использует одного выбранного провайдера."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geaggregeerd zoeken wordt alleen gebruikt voor AI-context. Het kan maximaal vier providerverzoeken verzenden, de wachttijd verlengen en quota van derden verbruiken. Het tabblad Web gebruikt nog steeds één geselecteerde provider."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregacja wyszukiwania jest używana tylko do kontekstu AI. Może wysłać do czterech zapytań do dostawców, zwiększyć czas oczekiwania i zużyć limit zapytań stron trzecich. Zakładka Sieć nadal używa jednego wybranego dostawcy."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агрегований пошук використовується лише для контексту ШІ. Він може надсилати до чотирьох запитів до провайдерів, збільшувати час очікування та витрачати квоту сторонніх сервісів. Вкладка \"Веб\" все одно використовує одного вибраного провайдера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birleşik arama yalnızca AI bağlamı için kullanılır. En fazla dört sağlayıcı isteği gönderebilir, bekleme süresini artırabilir ve üçüncü taraf kotasını tüketebilir. Web sekmesi hala seçili bir sağlayıcıyı kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm kiếm tổng hợp chỉ được sử dụng cho ngữ cảnh AI. Nó có thể gửi tối đa bốn yêu cầu nhà cung cấp, tăng thời gian chờ và tiêu thụ hạn mức của bên thứ ba. Tab Web vẫn sử dụng một nhà cung cấp đã chọn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian agregat hanya digunakan untuk konteks AI. Ini dapat mengirim hingga empat permintaan penyedia, meningkatkan waktu tunggu, dan menghabiskan kuota pihak ketiga. Tab Web masih menggunakan satu penyedia yang dipilih."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم البحث المجمع فقط لسياق الذكاء الاصطناعي. قد يرسل ما يصل إلى أربعة طلبات للمزودين، ويزيد وقت الانتظار، ويستهلك حصة الطرف الثالث. لا يزال تبويب الويب يستخدم مزودًا واحدًا محددًا."
          }
        }
      }
    },
