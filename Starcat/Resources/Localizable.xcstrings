    "settings.mcp.agentSetup.pair.manual.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ أمر الاقتران الكامل، والصقه في طرفية الجهاز المستهدف، واضغط Enter، ثم وافق على الجهاز في Starcat. ينتهي الأمر بعد خمس دقائق ويعمل مرة واحدة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie den vollständigen Pairing-Befehl, fügen Sie ihn in das Terminal des Zielgeräts ein, drücken Sie die Eingabetaste und genehmigen Sie dann das Gerät in Starcat. Der Befehl läuft nach fünf Minuten ab und funktioniert nur einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the complete pairing command, paste it into the target device's terminal, press Enter, then approve the device in Starcat. The command expires after five minutes and works only once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el comando de emparejamiento completo, pégalo en la terminal del dispositivo de destino, presiona Enter y luego aprueba el dispositivo en Starcat. El comando caduca después de cinco minutos y funciona solo una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez la commande d'appairage complète, collez-la dans le terminal de l'appareil cible, appuyez sur Entrée, puis approuvez l'appareil dans Starcat. La commande expire après cinq minutes et ne fonctionne qu'une seule fois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin perintah pemasangan lengkap, tempelkan ke terminal perangkat target, tekan Enter, lalu setujui perangkat di Starcat. Perintah kedaluwarsa setelah lima menit dan hanya berfungsi sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia il comando di abbinamento completo, incollalo nel terminale del dispositivo di destinazione, premi Invio, quindi approva il dispositivo in Starcat. Il comando scade dopo cinque minuti e funziona una sola volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全なペアリングコマンドをコピーし、対象デバイスのターミナルに貼り付けてEnterキーを押し、Starcatでデバイスを承認してください。コマンドは5分で期限切れとなり、1回のみ使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전한 페어링 명령을 복사하여 대상 장치의 터미널에 붙여넣고 Enter를 누른 다음 Starcat에서 장치를 승인하세요. 명령은 5분 후에 만료되며 한 번만 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer de volledige koppelingsopdracht, plak deze in de terminal van het doelapparaat, druk op Enter en keur het apparaat vervolgens goed in Starcat. De opdracht verloopt na vijf minuten en werkt slechts één keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj kompletne polecenie parowania, wklej je w terminalu urządzenia docelowego, naciśnij Enter, a następnie zatwierdź urządzenie w Starcat. Polecenie wygasa po pięciu minutach i działa tylko raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie o comando de emparelhamento completo, cole-o no terminal do dispositivo de destino, pressione Enter e aprove o dispositivo no Starcat. O comando expira após cinco minutos e funciona apenas uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте полную команду сопряжения, вставьте её в терминал целевого устройства, нажмите Enter, затем подтвердите устройство в Starcat. Команда действует пять минут и работает только один раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam eşleme komutunu kopyalayın, hedef cihazın terminaline yapıştırın, Enter'a basın, ardından Starcat'ta cihazı onaylayın. Komut beş dakika sonra geçerliliğini yitirir ve yalnızca bir kez çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте повну команду сполучення, вставте її в термінал цільового пристрою, натисніть Enter, потім підтвердьте пристрій у Starcat. Команда дійсна п'ять хвилин і працює лише один раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép lệnh ghép nối hoàn chỉnh, dán vào terminal của thiết bị đích, nhấn Enter, sau đó phê duyệt thiết bị trong Starcat. Lệnh hết hạn sau năm phút và chỉ hoạt động một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制完整配对命令，在目标设备的终端中粘贴并按回车，然后回到 Starcat 确认设备。命令五分钟内有效且只能使用一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製完整配對命令，在目標裝置的終端機中貼上並按 Enter，然後回到 Starcat 確認裝置。命令五分鐘內有效且只能使用一次。"
          }
        }
      }
    },
