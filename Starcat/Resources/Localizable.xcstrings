    "githubStarLists.error.orgOAuthRestricted.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حظر GitHub تحديث هذه المجموعة لأن المستودع ينتمي إلى مؤسسة مقيدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat diese Gruppenaktualisierung blockiert, da das Repository zu einer eingeschränkten Organisation gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub blocked this group update because the repository belongs to a restricted organization."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
