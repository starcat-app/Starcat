    "settings.ai.locked.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro يفتح طبقة سير عمل الذكاء الاصطناعي. تبقى مفاتيح API الخاصة بك محلية ولا تُرسل أبداً إلى خوادم Starcat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro schaltet die KI-Workflow-Ebene frei. Ihre API-Schlüssel bleiben lokal und werden nie an Starcat-Server gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro unlocks the AI workflow layer. Your API keys remain local and are never sent to Starcat servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro desbloquea la capa de flujo de trabajo de IA. Tus claves API permanecen locales y nunca se envían a los servidores de Starcat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro déverrouille la couche de workflow IA. Vos clés API restent locales et ne sont jamais envoyées aux serveurs Starcat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro membuka lapisan alur kerja AI. Kunci API Anda tetap lokal dan tidak pernah dikirim ke server Starcat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro sblocca il livello dei flussi di lavoro AI. Le tue chiavi API rimangono locali e non vengono mai inviate ai server Starcat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat ProでAIワークフローレイヤーを解放。APIキーはローカルに保持され、Starcatサーバーに送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro는 AI 워크플로 레이어를 잠금 해제합니다. API 키는 로컬에 유지되며 Starcat 서버로 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro ontgrendelt de AI-workflowlaag. Uw API-sleutels blijven lokaal en worden nooit naar Starcat-servers verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro odblokowuje warstwę przepływu pracy AI. Twoje klucze API pozostają lokalne i nigdy nie są wysyłane na serwery Starcat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starcat Pro desbloqueia a camada de fluxo de trabalho de IA. Suas chaves de API permanecem locais e nunca são enviadas aos servidores do Starcat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro открывает уровень AI-рабочих процессов. Ваши API-ключи остаются локальными и никогда не отправляются на серверы Starcat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro, AI iş akışı katmanının kilidini açar. API anahtarlarınız yerel kalır ve asla Starcat sunucularına gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro розблоковує рівень AI-робочих процесів. Ваші API-ключі залишаються локальними та ніколи не надсилаються на сервери Starcat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro mở khóa lớp quy trình AI. Khóa API của bạn vẫn ở cục bộ và không bao giờ được gửi đến máy chủ Starcat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro 解锁 AI 工作流层；你的 API Key 仍只保存在本机，不会发送到 Starcat 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat Pro 解鎖 AI 工作流程層；你的 API Key 仍只保存在本機，不會傳送至 Starcat 伺服器。"
          }
        }
      }
    },
