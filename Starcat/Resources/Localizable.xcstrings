    "settings.mcp.agentSetup.cli.manual.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the official install.sh command and run it in Terminal. The default destination is ~/.local/bin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制官方 install.sh 命令并在终端运行，默认安装到 ~/.local/bin。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製官方 install.sh 命令並在終端機執行，預設安裝到 ~/.local/bin。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公式のinstall.shコマンドをコピーしてターミナルで実行します。デフォルトのインストール先は~/.local/binです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공식 install.sh 명령을 복사하여 터미널에서 실행하세요. 기본 설치 위치는 ~/.local/bin입니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie den offiziellen install.sh-Befehl und führen Sie ihn im Terminal aus. Das Standardziel ist ~/.local/bin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez la commande officielle install.sh et exécutez-la dans le Terminal. La destination par défaut est ~/.local/bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el comando oficial install.sh y ejecútalo en Terminal. El destino predeterminado es ~/.local/bin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie o comando oficial install.sh e execute-o no Terminal. O destino padrão é ~/.local/bin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia il comando install.sh ufficiale ed eseguilo in Terminale. La destinazione predefinita è ~/.local/bin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте официальную команду install.sh и выполните её в Терминале. По умолчанию установка производится в ~/.local/bin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer de officiële install.sh-opdracht en voer deze uit in Terminal. De standaardbestemming is ~/.local/bin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj oficjalne polecenie install.sh i uruchom je w Terminalu. Domyślnym miejscem docelowym jest ~/.local/bin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте офіційну команду install.sh і виконайте її в Терміналі. Типове розташування — ~/.local/bin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resmi install.sh komutunu kopyalayın ve Terminal'de çalıştırın. Varsayılan hedef ~/.local/bin dizinidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép lệnh install.sh chính thức và chạy trong Terminal. Đích đến mặc định là ~/.local/bin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin perintah install.sh resmi dan jalankan di Terminal. Tujuan default adalah ~/.local/bin."
