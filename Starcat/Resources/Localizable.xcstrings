    "workspace.chatModelRequired.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The RAG workspace requires at least one verified and enabled model assigned to the Chat task. You can use it after completing the configuration."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAG 工作台需要至少一个已验证、已启用，并分配给“对话”任务的模型。完成配置后即可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAG 工作台需要至少一個已驗證、已啟用並分配給「對話」任務的模型。完成設定後即可使用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAGワークスペースでは、Chatタスクに割り当てられた検証済みで有効なモデルが少なくとも1つ必要です。設定を完了すると使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAG 워크스페이스는 채팅 작업에 할당된 검증되고 활성화된 모델이 하나 이상 필요합니다. 설정을 완료한 후 사용할 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der RAG-Arbeitsbereich erfordert mindestens ein verifiziertes und aktiviertes Modell, das der Chat-Aufgabe zugewiesen ist. Sie können ihn nach Abschluss der Konfiguration verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'espace de travail RAG nécessite au moins un modèle vérifié et activé pour la tâche de chat. Vous pouvez l'utiliser après avoir terminé la configuration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio de trabajo RAG requiere al menos un modelo verificado y habilitado asignado a la tarea de Chat. Puedes usarlo después de completar la configuración."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço de trabalho RAG requer pelo menos um modelo verificado e habilitado atribuído à tarefa de Chat. Você pode usá-lo após concluir a configuração."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'area di lavoro RAG richiede almeno un modello verificato e abilitato assegnato all'attività Chat. Puoi usarla dopo aver completato la configurazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для RAG-рабочего пространства требуется хотя бы одна проверенная и включённая модель, назначенная задаче Chat. Вы сможете использовать его после завершения настройки."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De RAG-werkruimte vereist ten minste één geverifieerd en ingeschakeld model dat is toegewezen aan de Chat-taak. U kunt deze gebruiken na het voltooien van de configuratie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obszar roboczy RAG wymaga co najmniej jednego zweryfikowanego i włączonego modelu przypisanego do zadania czatu. Możesz go użyć po zakończeniu konfiguracji."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робоче середовище RAG потребує принаймні однієї перевіреної та ввімкненої моделі, призначеної для завдання чату. Ви можете використовувати його після завершення налаштування."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAG çalışma alanı, Sohbet görevine atanmış en az bir doğrulanmış ve etkin model gerektirir. Yapılandırmayı tamamladıktan sonra kullanabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gian làm việc RAG yêu cầu ít nhất một mô hình đã được xác minh và bật được gán cho tác vụ Chat. Bạn có thể sử dụng sau khi hoàn tất cấu hình."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kerja RAG memerlukan setidaknya satu model yang terverifikasi dan diaktifkan yang ditugaskan ke tugas Chat. Anda dapat menggunakannya setelah menyelesaikan konfigurasi."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب مساحة عمل RAG نموذجًا واحدًا على الأقل تم التحقق منه وتمكينه ومخصص لمهمة الدردشة. يمكنك استخدامها بعد إكمال التكوين."
          }
        }
      }
    },
