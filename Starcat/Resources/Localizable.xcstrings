    "rag.workspace.inspector.metadata.help.sourceCoverage.definition.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The main panel shows repositories with source content, then ready chunks. This popover also separates failed and stale chunks. Excluded chunks are omitted from chunk status counts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主面板依次显示有来源内容的项目数与就绪分片数；这里进一步区分失败和过期分片。分片状态统计不包含已排除分片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主面板顯示有來源內容的儲存庫，然後是就緒區塊。此彈出視窗還會區分失敗和過期的區塊。已排除的區塊不計入區塊狀態計數。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインパネルには、ソースコンテンツを持つリポジトリと、準備完了のチャンクが表示されます。このポップオーバーでは、失敗したチャンクと古いチャンクも分けて表示されます。除外されたチャンクはチャンクステータスカウントから除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인 패널은 소스 콘텐츠가 있는 저장소와 준비된 청크를 보여줍니다. 이 팝오버는 실패 및 오래된 청크도 분리하여 표시합니다. 제외된 청크는 청크 상태 수에 포함되지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hauptpanel zeigt Repositories mit Quellinhalt, dann bereite Chunks. Dieses Popover trennt auch fehlgeschlagene und veraltete Chunks. Ausgeschlossene Chunks werden bei den Chunk-Statuszahlen nicht berücksichtigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le panneau principal montre les dépôts avec du contenu source, puis les morceaux prêts. Cette pop-up sépare également les morceaux échoués et obsolètes. Les morceaux exclus sont omis des comptes de statut des morceaux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel principal muestra repositorios con contenido fuente, luego fragmentos listos. Este popover también separa fragmentos fallidos y obsoletos. Los fragmentos excluidos se omiten de los recuentos de estado de fragmentos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel principal mostra repositórios com conteúdo fonte e, em seguida, trechos prontos. Este popover também separa trechos com falha e obsoletos. Trechos excluídos são omitidos das contagens de status dos trechos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello principale mostra i repository con contenuto sorgente, poi i blocchi pronti. Questo popover separa anche i blocchi falliti e obsoleti. I blocchi esclusi sono omessi dai conteggi di stato dei blocchi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На основной панели показаны репозитории с исходным контентом, затем готовые фрагменты. Это всплывающее окно также разделяет неудачные и устаревшие фрагменты. Исключённые фрагменты не учитываются в подсчёте статуса фрагментов."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hoofdvenster toont repositories met broninhoud, vervolgens gereed zijnde brokken. Deze popover scheidt ook mislukte en verouderde brokken. Uitgesloten brokken worden niet meegenomen in de brokstatussen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Główny panel pokazuje repozytoria z treścią źródłową, a następnie gotowe fragmenty. Ten popover oddziela również fragmenty nieudane i nieaktualne. Wykluczone fragmenty są pomijane w liczbach stanu fragmentów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основна панель показує репозиторії з вихідним вмістом, потім готові фрагменти. Це спливаюче вікно також відокремлює невдалі та застарілі фрагменти. Виключені фрагменти не враховуються в кількості статусу фрагментів."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana panel, kaynak içeriği olan depoları, ardından hazır parçaları gösterir. Bu açılır pencere ayrıca başarısız ve bayat parçaları ayırır. Hariç tutulan parçalar, parça durumu sayımlarına dahil edilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng chính hiển thị các kho lưu trữ có nội dung nguồn, sau đó là các đoạn sẵn sàng. Popover này cũng tách riêng các đoạn bị lỗi và cũ. Các đoạn bị loại trừ được bỏ qua khỏi số lượng trạng thái đoạn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel utama menunjukkan repositori dengan konten sumber, lalu potongan siap. Popover ini juga memisahkan potongan gagal dan basi. Potongan yang dikecualikan tidak dihitung dalam jumlah status potongan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض اللوحة الرئيسية المستودعات التي تحتوي على محتوى مصدري، ثم الأجزاء الجاهزة. تفصل هذه النافذة المنبثقة أيضًا الأجزاء الفاشلة والقديمة. يتم استبعاد الأجزاء المستبعدة من تعدادات حالة الأجزاء."
          }
        }
      }
    },
