    "rag.workspace.inspector.plan.help.networkPlan.definition.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما إذا كانت هناك حاجة إلى أدلة خارجية مباشرة وما ستجلبه Starcat من GitHub أو الويب العام. يظهر فقط عندما يطلب المخطط الوصول إلى الشبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob externe Live-Belege benötigt werden und was Starcat von GitHub oder dem öffentlichen Web abruft. Wird nur angezeigt, wenn der Planner Netzwerkzugriff anfordert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether live external evidence is needed and what Starcat will fetch from GitHub or the public web. Shown only when the Planner requests network access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se necesita evidencia externa en vivo y qué obtendrá Starcat de GitHub o la web pública. Se muestra solo cuando el planificador solicita acceso a la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si des preuves externes en direct sont nécessaires et ce que Starcat récupérera depuis GitHub ou le web public. Affiché uniquement lorsque le planificateur demande un accès réseau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah bukti eksternal langsung diperlukan dan apa yang akan diambil Starcat dari GitHub atau web publik. Hanya ditampilkan saat Planner meminta akses jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sono necessarie evidenze esterne in tempo reale e cosa Starcat recupererà da GitHub o dal web pubblico. Mostrato solo quando il Planner richiede accesso alla rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブの外部証拠が必要かどうか、およびStarcatがGitHubや公開Webから何を取得するか。プランナーがネットワークアクセスを要求した場合のみ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 외부 증거가 필요한지 여부와 Starcat이 GitHub 또는 공개 웹에서 가져올 내용입니다. Planner가 네트워크 액세스를 요청할 때만 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of er live externe bewijs nodig is en wat Starcat van GitHub of het openbare web ophaalt. Alleen getoond wanneer de Planner netwerktoegang aanvraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy potrzebne są zewnętrzne dowody na żywo i co Starcat pobierze z GitHuba lub publicznego internetu. Wyświetlane tylko wtedy, gdy Planista zażąda dostępu do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se é necessária evidência externa ao vivo e o que o Starcat buscará no GitHub ou na web pública. Exibido apenas quando o Planejador solicita acesso à rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужны ли живые внешние данные и что Starcat будет загружать из GitHub или публичного веба. Показывается только когда планировщик запрашивает сетевой доступ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı harici kanıtın gerekli olup olmadığı ve Starcat'ın GitHub'dan veya genel web'den ne getireceği. Yalnızca Planlayıcı ağ erişimi istediğinde gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи потрібні живі зовнішні докази, і що Starcat отримає з GitHub або публічного вебу. Показується лише тоді, коли планувальник запитує доступ до мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liệu có cần bằng chứng trực tiếp từ bên ngoài hay không và Starcat sẽ tìm nạp gì từ GitHub hoặc web công cộng. Chỉ hiển thị khi Planner yêu cầu truy cập mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否需要拉取实时外部证据，以及将从 GitHub 或公开互联网获取什么。仅在 Planner 请求联网时出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否需要拉取即時外部證據，以及將從 GitHub 或公開網際網路獲取什麼。僅在 Planner 請求聯網時出現。"
          }
        }
      }
    },
