    "explore.help.discover.cache.update" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحديث: يستخدم Starcat ذاكرة التخزين المؤقت المحلية أثناء صلاحيتها ويجلب أحدث كتالوج مشاريع بعد انتهاء صلاحيتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: Starcat verwendet den lokalen Cache, solange er gültig ist, und ruft den neuesten Projektkatalog nach Ablauf ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: Starcat uses the local cache while it is valid and fetches the latest project catalog after it expires."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualización: Starcat usa la caché local mientras sea válida y obtiene el catálogo de proyectos más reciente después de que expire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise à jour : Starcat utilise le cache local tant qu'il est valide et récupère le catalogue de projets le plus récent après son expiration."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan: Starcat menggunakan cache lokal selama masih valid dan mengambil katalog proyek terbaru setelah kedaluwarsa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornamento: Starcat utilizza la cache locale mentre è valida e recupera il catalogo progetti più recente dopo la scadenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新：Starcatは有効な間はローカルキャッシュを使用し、期限切れ後に最新のプロジェクトカタログを取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트: Starcat은 캐시가 유효한 동안 로컬 캐시를 사용하고 만료 후 최신 프로젝트 카탈로그를 가져옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: Starcat gebruikt de lokale cache zolang deze geldig is en haalt de nieuwste projectcatalogus op nadat deze is verlopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja: Starcat używa lokalnej pamięci podręcznej, dopóki jest ważna, a po jej wygaśnięciu pobiera najnowszy katalog projektów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualização: o Starcat usa o cache local enquanto é válido e busca o catálogo de projetos mais recente após expirar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновление: Starcat использует локальный кэш, пока он действителен, и загружает последний каталог проектов после его истечения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme: Starcat, önbellek geçerliyken yerel önbelleği kullanır ve süresi dolduktan sonra en son proje kataloğunu getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення: Starcat використовує локальний кеш, поки він дійсний, і отримує останній каталог проєктів після його закінчення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
