          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : Candidats au reranking : %1$lld fragments ; les %2$lld fragments restants n'ont pas participé au reranking et ont conservé l'ordre de récupération hybride."
          }
        },
        "id" : {
          "stringUnit" : {
