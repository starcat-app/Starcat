    "settings.ai.prompt.placeholders.footnote.chat" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: مهمة الدردشة لا تستخدم قالب موجه المستخدم — رسائل المستخدم تذهب مباشرة إلى النموذج عبر مصفوفة رسائل المحادثة."
