    "rag.workspace.retrieval.minimumSimilarity.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستبعد نتائج المتجهات التي تقل عن هذه النتيجة. تظل مطابقات الكلمات المفتاحية الدقيقة متاحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vektorergebnisse unterhalb dieses Werts werden ausgeschlossen. Exakte Schlüsselwortübereinstimmungen bleiben verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vector results below this score are excluded. Exact keyword matches remain available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados vectoriales por debajo de esta puntuación se excluyen. Las coincidencias exactas de palabras clave permanecen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats vectoriels en dessous de ce score sont exclus. Les correspondances exactes par mot-clé restent disponibles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil vektor di bawah skor ini dikecualikan. Pencocokan kata kunci tepat tetap tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I risultati vettoriali al di sotto di questo punteggio vengono esclusi. Le corrispondenze esatte per parole chiave rimangono disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスコア未満のベクトル結果は除外されます。完全一致キーワードは引き続き利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 점수 미만의 벡터 결과는 제외됩니다. 정확한 키워드 일치는 계속 사용 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vectorresultaten onder deze score worden uitgesloten. Exacte trefwoordovereenkomsten blijven beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyniki wektorowe poniżej tego progu są wykluczane. Dokładne dopasowania słów kluczowych pozostają dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultados vetoriais abaixo desta pontuação são excluídos. Correspondências exatas por palavra-chave permanecem disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Векторные результаты ниже этого порога исключаются. Точные совпадения по ключевым словам остаются доступными."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu puanın altındaki vektör sonuçları hariç tutulur. Tam anahtar kelime eşleşmeleri kullanılabilir durumda kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Векторні результати з оцінкою нижче цього значення виключаються. Точні збіги ключових слів залишаються доступними."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết quả vector dưới điểm này bị loại trừ. Các kết quả khớp từ khóa chính xác vẫn có sẵn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低于此分数的向量结果不会参与检索；关键词精确匹配不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低於此分數的向量結果不會參與檢索；關鍵字精確比對不受影響。"
          }
        }
      }
    },
