    "rag.workspace.error.planner.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول إعادة صياغة السؤال أو حاول مرة أخرى. تم الاحتفاظ بسؤالك الأصلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie, die Frage umzuformulieren, oder versuchen Sie es erneut. Ihre ursprüngliche Frage bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try rephrasing the question or try again. Your original question is preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intente reformular la pregunta o intente de nuevo. Su pregunta original se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de reformuler la question ou réessayez. Votre question originale est conservée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba ulangi pertanyaan atau coba lagi. Pertanyaan asli Anda tetap tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a riformulare la domanda o riprova. La tua domanda originale è conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問を言い換えるか、もう一度お試しください。元の質問は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질문을 다시 표현하거나 다시 시도해 보세요. 원래 질문은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer de vraag anders te formuleren of probeer het opnieuw. Je oorspronkelijke vraag blijft behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj przeformułować pytanie lub spróbuj ponownie. Twoje oryginalne pytanie zostało zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente reformular a pergunta ou tente novamente. Sua pergunta original foi preservada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте переформулировать вопрос или повторите попытку. Ваш исходный вопрос сохранён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soruyu yeniden ifade etmeyi deneyin veya tekrar deneyin. Orijinal sorunuz korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте переформулювати запитання або повторіть спробу. Ваше оригінальне запитання збережено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thử diễn đạt lại câu hỏi hoặc thử lại. Câu hỏi gốc của bạn được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请调整问题表述后重试；原问题已保留。"
