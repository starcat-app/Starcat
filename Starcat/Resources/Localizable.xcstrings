    "error.user.network.recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من اتصال الشبكة، VPN/الوكيل، وعنوان الخدمة، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Ihre Netzwerkverbindung, VPN/Proxy und die Dienstadresse und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your network connection, VPN/proxy, and service address, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica tu conexión de red, VPN/proxy y dirección del servicio, luego inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre connexion réseau, VPN/proxy et l'adresse du service, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa koneksi jaringan, VPN/proxy, dan alamat layanan, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione di rete, VPN/proxy e l'indirizzo del servizio, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続、VPN/プロキシ、サービスアドレスを確認してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 연결, VPN/프록시 및 서비스 주소를 확인한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je netwerkverbinding, VPN/proxy en serviceadres en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź połączenie sieciowe, VPN/proxy i adres usługi, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua conexão de rede, VPN/proxy e endereço do serviço e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте сетевое подключение, VPN/прокси и адрес сервиса, затем повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ bağlantınızı, VPN/proxy'nizi ve hizmet adresinizi kontrol edin, ardından tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте мережеве з'єднання, VPN/проксі та адресу служби, потім спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra kết nối mạng, VPN/proxy và địa chỉ dịch vụ, sau đó thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络连接、VPN/代理和服务地址后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
