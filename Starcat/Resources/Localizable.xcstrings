    "settings.services.selfHost.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the source repository on GitHub. Fork & deploy it on your own infrastructure, then paste your URL here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 GitHub 打开源码仓库。Fork 后自行部署，再把地址粘贴到上方输入框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 GitHub 上開啟原始碼倉庫。Fork 後部署到自己的基礎設施，再將網址貼到上方輸入框。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubでソースリポジトリを開きます。フォークして独自のインフラにデプロイし、URLをここに貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub에서 소스 저장소를 엽니다. 포크하여 자체 인프라에 배포한 후 URL을 여기에 붙여넣으세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie das Quell-Repository auf GitHub. Forken und deployen Sie es auf Ihrer eigenen Infrastruktur, dann fügen Sie hier Ihre URL ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez le dépôt source sur GitHub. Forkez-le et déployez-le sur votre propre infrastructure, puis collez votre URL ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra el repositorio fuente en GitHub. Haga un fork y despliéguelo en su propia infraestructura, luego pegue su URL aquí."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o repositório fonte no GitHub. Faça um fork e implante na sua própria infraestrutura, depois cole sua URL aqui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri il repository sorgente su GitHub. Fai il fork e distribuiscilo sulla tua infrastruttura, poi incolla qui il tuo URL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте исходный репозиторий на GitHub. Сделайте форк и разверните на своей инфраструктуре, затем вставьте URL сюда."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de bronrepository op GitHub. Fork & implementeer op uw eigen infrastructuur en plak hier uw URL."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz repozytorium źródłowe na GitHubie. Sforkuj i wdróż na własnej infrastrukturze, a następnie wklej tutaj swój URL."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте вихідний репозиторій на GitHub. Форкніть і розгорніть на власній інфраструктурі, потім вставте URL сюди."
