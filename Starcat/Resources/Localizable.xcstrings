    "tagManagement.deleteMessageFormat" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف %d وسم (أوسمة). لن يتم حذف المستودعات المرتبطة بهذه الأوسمة، فقط سيتم إزالة ارتباطات الأوسمة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Tag(s) werden gelöscht. Repos mit diesen Tags werden nicht gelöscht, nur die Tag-Zuordnungen werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Will delete %d tag(s). Repos with these tags will not be deleted, only the tag associations will be removed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán %d etiqueta(s). Los repositorios con estas etiquetas no se eliminarán, solo se quitarán las asociaciones de etiquetas. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimera %d tag(s). Les dépôts avec ces tags ne seront pas supprimés, seules les associations de tags seront retirées. Cette action est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akan menghapus %d tag. Repositori dengan tag ini tidak akan dihapus, hanya asosiasi tag yang akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno eliminati %d tag. I repository con questi tag non verranno eliminati, solo le associazioni dei tag verranno rimosse. Questa operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d個のタグを削除します。これらのタグが付いたリポジトリは削除されず、タグの関連付けのみが解除されます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d개 태그가 삭제됩니다. 이 태그가 있는 저장소는 삭제되지 않으며, 태그 연결만 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden %d tag(s) verwijderd. Repositories met deze tags worden niet verwijderd, alleen de tag-koppelingen worden opgeheven. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie %d tagów. Repozytoria z tymi tagami nie zostaną usunięte, tylko powiązania tagów zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluirá %d tag(s). Os repositórios com essas tags não serão excluídos, apenas as associações de tags serão removidas. Isso não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет удалено %d тег(ов). Репозитории с этими тегами не будут удалены, только связи тегов. Это действие необратимо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d etiket silinecek. Bu etiketlere sahip depolar silinmeyecek, yalnızca etiket ilişkilendirmeleri kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде видалено %d тег(ів). Репозиторії з цими тегами не будуть видалені, лише зв’язки з тегами буде видалено. Цю дію не можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sẽ xóa %d thẻ. Các kho lưu trữ có thẻ này sẽ không bị xóa, chỉ có liên kết thẻ bị xóa. Hành động này không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除 %d 个标签。被打过此标签的仓库本身不会被删除，仅解除标签关联。此操作不可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除 %d 個標籤。帶有這些標籤的倉庫不會被刪除，僅解除標籤關聯。此操作無法復原。"
          }
        }
      }
    },
