    "rag.workspace.rerank.enabled.hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التمكين، تُرسل الأجزاء المُرشحة إلى خدمة إعادة الترتيب المُعدّة قبل اختيار الأجزاء النهائي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Kandidaten-Chunks vor der endgültigen Chunk-Auswahl an Ihren konfigurierten Rerank-Dienst gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, candidate chunks are sent to your configured rerank service before final chunk selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, los fragmentos candidatos se envían al servicio de rerank configurado antes de la selección final de fragmentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque activé, les fragments candidats sont envoyés à votre service de reclassement configuré avant la sélection finale des fragments."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat diaktifkan, potongan kandidat dikirim ke layanan rerank yang dikonfigurasi sebelum pemilihan potongan akhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando abilitato, i blocchi candidati vengono inviati al servizio di rerank configurato prima della selezione finale dei blocchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、最終チャンク選択の前に候補チャンクが設定されたRerankサービスに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 최종 청크 선택 전에 후보 청크가 구성된 재순위화 서비스로 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld, worden kandidaatbrokken naar uw geconfigureerde herordeningsservice gestuurd voordat de uiteindelijke brokselectie plaatsvindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, fragmenty kandydujące są wysyłane do skonfigurowanej usługi ponownego rankingu przed ostatecznym wyborem fragmentów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os fragmentos candidatos são enviados ao serviço de rerank configurado antes da seleção final dos fragmentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении фрагменты-кандидаты отправляются в настроенную службу переранжирования перед окончательным выбором."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, aday parçalar nihai parça seçiminden önce yapılandırılmış yeniden sıralama hizmetinize gönderilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо увімкнено, фрагменти-кандидати надсилаються до налаштованої служби переранжування перед остаточним вибором фрагментів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được bật, các khối ứng viên được gửi đến dịch vụ rerank đã cấu hình trước khi chọn khối cuối cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，候选分片会先发送到配置的 Rerank 服务，再选择最终分片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，候選分片會先傳送到設定的 Rerank 服務，再選取最終分片。"
          }
        }
      }
    },
