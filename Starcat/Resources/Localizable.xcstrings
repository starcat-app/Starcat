    "notification.sync.unauthorized.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت جلسة GitHub الخاصة بك. سجل الدخول مرة أخرى لاستئناف مزامنة المستودعات المميزة بنجمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre GitHub-Sitzung ist abgelaufen. Melden Sie sich erneut an, um die Synchronisierung der markierten Repositorys fortzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your GitHub session expired. Sign in again to resume syncing starred repositories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión de GitHub expiró. Inicia sesión de nuevo para reanudar la sincronización de repositorios destacados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session GitHub a expiré. Connectez-vous à nouveau pour reprendre la synchronisation des dépôts suivis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi GitHub Anda kedaluwarsa. Masuk lagi untuk melanjutkan sinkronisasi repositori yang dibintangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione GitHub è scaduta. Accedi di nuovo per riprendere la sincronizzazione dei repository stellati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubセッションの有効期限が切れました。スター付きリポジトリの同期を再開するには、もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 세션이 만료되었습니다. 별표 저장소 동기화를 다시 시작하려면 다시 로그인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je GitHub-sessie is verlopen. Log opnieuw in om de synchronisatie van gemarkeerde repositories te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja sesja GitHub wygasła. Zaloguj się ponownie, aby wznowić synchronizację oznaczonych repozytoriów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sessão do GitHub expirou. Faça login novamente para continuar sincronizando repositórios com estrela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш сеанс GitHub истёк. Войдите снова, чтобы продолжить синхронизацию отмеченных репозиториев."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub oturumunuzun süresi doldu. Yıldızlanan depoları senkronize etmeye devam etmek için tekrar oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін дії сеансу GitHub минув. Увійдіть знову, щоб продовжити синхронізацію позначених зірками репозиторіїв."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên GitHub của bạn đã hết hạn. Đăng nhập lại để tiếp tục đồng bộ kho lưu trữ đã gắn sao."
