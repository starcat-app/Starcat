    "settings.mcp.proOnly.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خدمة MCP متاحة للمستخدمين المحترفين فقط. يستمع الطرفية على 127.0.0.1 ويتطلب مفتاح API المحلي المشترك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der MCP-Dienst steht nur Pro-Benutzern zur Verfügung. Der Endpunkt lauscht auf 127.0.0.1 und benötigt den gemeinsamen lokalen API-Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP Service is available to Pro users only. The endpoint listens on 127.0.0.1 and requires the shared Local API Key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Servicio MCP está disponible solo para usuarios Pro. El endpoint escucha en 127.0.0.1 y requiere la Clave API Local compartida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service MCP est réservé aux utilisateurs Pro. Le point d'accès écoute sur 127.0.0.1 et nécessite la clé API locale partagée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan MCP hanya tersedia untuk pengguna Pro. Titik akhir mendengarkan di 127.0.0.1 dan memerlukan Kunci API Lokal bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio MCP è disponibile solo per utenti Pro. L'endpoint ascolta su 127.0.0.1 e richiede la chiave API locale condivisa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCPサービスはProユーザーのみ利用可能です。エンドポイントは127.0.0.1でリッスンし、共有ローカルAPIキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 서비스는 Pro 사용자만 사용할 수 있습니다. 엔드포인트는 127.0.0.1에서 수신 대기하며 공유 로컬 API 키가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP-service is alleen beschikbaar voor Pro-gebruikers. Het eindpunt luistert op 127.0.0.1 en vereist de gedeelde lokale API-sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa MCP jest dostępna tylko dla użytkowników Pro. Punkt końcowy nasłuchuje na 127.0.0.1 i wymaga udostępnionego lokalnego klucza API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Serviço MCP está disponível apenas para usuários Pro. O endpoint escuta em 127.0.0.1 e requer a Chave de API Local compartilhada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP Service доступен только пользователям Pro. Конечная точка прослушивает 127.0.0.1 и требует общий локальный ключ API."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP Hizmeti yalnızca Pro kullanıcılarına sunulur. Uç nokta 127.0.0.1 üzerinde dinler ve paylaşılan Yerel API Anahtarı gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба MCP доступна лише користувачам Pro. Кінцева точка слухає на 127.0.0.1 і потребує спільного локального ключа API."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ MCP chỉ dành cho người dùng Pro. Điểm cuối lắng nghe trên 127.0.0.1 và yêu cầu Khóa API cục bộ dùng chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP Service 仅 Pro 用户可用。Endpoint 只监听 127.0.0.1，并要求使用共享的本地 API Key。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP Service 僅供 Pro 使用者使用。端點監聽 127.0.0.1，並需要共用的 Local API Key。"
          }
        }
      }
    },
    "settings.mcp.remote.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبول اتصالات CLI المقترنة من أجهزة LAN أو VPN الموثوقة عبر TLS مثبت. أبقِ هذا الخيار معطلاً على الشبكات غير الموثوقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppelte CLI-Verbindungen von vertrauenswürdigen LAN- oder VPN-Geräten über gepinntes TLS akzeptieren. In unsicheren Netzwerken deaktiviert lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept paired CLI connections from trusted LAN or VPN devices over pinned TLS. Keep this off on untrusted networks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepta conexiones CLI emparejadas desde dispositivos LAN o VPN de confianza mediante TLS fijo. Mantén esto desactivado en redes no confiables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepter les connexions CLI appairées depuis des appareils LAN ou VPN de confiance via TLS épinglé. Désactivez cette option sur les réseaux non fiables."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima koneksi CLI berpasangan dari perangkat LAN atau VPN tepercaya melalui TLS tetap. Matikan ini di jaringan yang tidak tepercaya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetta connessioni CLI abbinate da dispositivi LAN o VPN fidati tramite TLS fissato. Tienilo disattivato su reti non fidate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定TLSを介して、信頼されたLANまたはVPNデバイスからのペアリングされたCLI接続を受け入れます。信頼されていないネットワークではオフのままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 있는 LAN 또는 VPN 장치에서 고정 TLS를 통해 페어링된 CLI 연결을 허용합니다. 신뢰할 수 없는 네트워크에서는 이 기능을 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepteer gekoppelde CLI-verbindingen van vertrouwde LAN- of VPN-apparaten via vastgezette TLS. Houd dit uitgeschakeld op onvertrouwde netwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akceptuj sparowane połączenia CLI z zaufanych urządzeń w sieci LAN lub VPN przez przypięty TLS. Wyłącz tę opcję w niezaufanych sieciach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceita conexões CLI pareadas de dispositivos confiáveis na LAN ou VPN via TLS fixado. Mantenha desativado em redes não confiáveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принимать парные CLI-подключения от доверенных устройств в локальной сети или через VPN по закреплённому TLS. Оставьте выключенным в ненадёжных сетях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenilir LAN veya VPN cihazlarından sabitlenmiş TLS üzerinden eşleştirilmiş CLI bağlantılarını kabul edin. Güvenilmeyen ağlarda kapalı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приймати парні з'єднання CLI з довірених пристроїв у локальній мережі або VPN через захищений TLS. Вимкніть у ненадійних мережах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chấp nhận kết nối CLI đã ghép nối từ thiết bị LAN hoặc VPN đáng tin cậy qua TLS cố định. Tắt trên mạng không đáng tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过证书 pinning 的 TLS 接受可信局域网或 VPN 设备连接；在不可信网络中请保持关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過固定 TLS 接受來自可信 LAN 或 VPN 裝置的配對 CLI 連線。在不可信網路上請保持關閉。"
          }
        }
      }
    },
