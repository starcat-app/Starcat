    "agent.workspace.assistant.completedFallback" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Agent run is complete. The key plan, tool process, and artifact references are preserved below; use the right pane to view, copy, or export artifacts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已经完成这轮 Agent run。下面保留了关键计划、工具过程和产物引用，右侧可以查看、复制或导出产出物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Agent 執行已完成。下方保留了關鍵計畫、工具流程和產出物參考；可使用右側面板檢視、複製或匯出產出物。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントの実行は完了しました。主要な計画、ツールのプロセス、アーティファクトの参照は以下に保持されています。右ペインでアーティファクトの表示、コピー、エクスポートができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 에이전트 실행이 완료되었습니다. 주요 계획, 도구 프로세스 및 아티팩트 참조는 아래에 보존되어 있습니다. 오른쪽 창을 사용하여 아티팩트를 보거나 복사하거나 내보내십시오."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Agent-Ausführung ist abgeschlossen. Der Schlüsselplan, der Tool-Prozess und die Artefaktverweise sind unten erhalten; verwende das rechte Fenster, um Artefakte anzuzeigen, zu kopieren oder zu exportieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette exécution de l'agent est terminée. Le plan clé, le processus d'outil et les références d'artefact sont conservés ci-dessous ; utilisez le volet droit pour afficher, copier ou exporter les artefacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ejecución del agente ha finalizado. El plan clave, el proceso de herramientas y las referencias de artefactos se conservan a continuación; usa el panel derecho para ver, copiar o exportar artefactos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta execução do Agente está concluída. O plano principal, o processo da ferramenta e as referências de artefatos são preservados abaixo; use o painel direito para visualizar, copiar ou exportar artefatos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa esecuzione dell'agente è completa. Il piano chiave, il processo degli strumenti e i riferimenti agli artefatti sono conservati di seguito; usa il pannello destro per visualizzare, copiare o esportare gli artefatti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот запуск агента завершён. Ключевой план, процесс инструментов и ссылки на артефакты сохранены ниже; используйте правую панель для просмотра, копирования или экспорта артефактов."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Agent-uitvoering is voltooid. Het belangrijkste plan, toolproces en artefactverwijzingen zijn hieronder bewaard; gebruik het rechterpaneel om artefacten te bekijken, kopiëren of exporteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To uruchomienie agenta jest zakończone. Kluczowy plan, proces narzędzi i odniesienia do artefaktów są zachowane poniżej; użyj prawego panelu, aby wyświetlić, skopiować lub wyeksportować artefakty."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей запуск агента завершено. Ключовий план, процес інструментів та посилання на артефакти збережено нижче; використовуйте праву панель для перегляду, копіювання або експорту артефактів."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Ajan çalıştırması tamamlandı. Ana plan, araç süreci ve yapıt referansları aşağıda korunmaktadır; yapıtları görüntülemek, kopyalamak veya dışa aktarmak için sağ paneli kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần chạy tác nhân này đã hoàn tất. Kế hoạch chính, quy trình công cụ và tham chiếu tạo phẩm được giữ lại bên dưới; sử dụng ngăn bên phải để xem, sao chép hoặc xuất tạo phẩm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksekusi Agen ini selesai. Rencana utama, proses alat, dan referensi artefak disimpan di bawah; gunakan panel kanan untuk melihat, menyalin, atau mengekspor artefak."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتمل تشغيل الوكيل هذا. الخطة الرئيسية، وعملية الأدوات، ومراجع المخرجات محفوظة أدناه؛ استخدم الجزء الأيمن للعرض أو النسخ أو التصدير."
          }
        }
      }
    },
