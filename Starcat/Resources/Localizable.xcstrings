    "explore.help.newReleases.rule.release" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drafts, prereleases, releases without downloadable assets, archived repositories, and forks are excluded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "草稿版、预发布版、没有可下载内容的 Release、归档项目和 Fork 项目不会进入本分类。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
