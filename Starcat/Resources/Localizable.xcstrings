    "settings.storage.readmePrefetch.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat slowly fills missing README HTML and raw Markdown caches while signed in. It runs in small batches and backs off on network errors."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后 Starcat 会慢速补齐缺失的 README HTML 与原始 Markdown 缓存；任务小批量执行，遇到网络错误会自动退避。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后 Starcat 会慢速补齐缺失的 README HTML 与原始 Markdown 缓存；任务小批量执行，遇到网络错误会自动退避。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatはサインイン中に、不足しているREADMEのHTMLと生のMarkdownキャッシュをゆっくりと補充します。少量ずつ実行し、ネットワークエラー時にはバックオフします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat이 로그인 상태에서 누락된 README HTML 및 원시 Markdown 캐시를 천천히 채웁니다. 작은 배치로 실행되며 네트워크 오류 시 백오프합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat füllt während der Anmeldung nach und nach fehlende README-HTML- und Roh-Markdown-Caches. Es läuft in kleinen Batches und reduziert die Geschwindigkeit bei Netzwerkfehlern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat remplit lentement les caches HTML et Markdown brut des README manquants lorsque vous êtes connecté. Il fonctionne par petits lots et se retire en cas d'erreurs réseau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat completa lentamente los README HTML y las cachés de Markdown sin procesar mientras has iniciado sesión. Se ejecuta en lotes pequeños y retrocede en caso de errores de red."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starcat preenche lentamente os caches de HTML e Markdown bruto dos READMEs ausentes enquanto você está logado. Ele opera em pequenos lotes e recua em caso de erros de rede."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat riempie lentamente la cache HTML e Markdown grezzo dei README mancanti mentre sei connesso. Viene eseguito in piccoli lotti e si ferma in caso di errori di rete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat постепенно заполняет кеш HTML и Markdown для отсутствующих README, пока вы в системе. Загрузка выполняется небольшими порциями и приостанавливается при сетевых ошибках."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat vult ontbrekende README-HTML en ruwe Markdown-caches langzaam aan terwijl je bent aangemeld. Het werkt in kleine batches en stopt bij netwerkfouten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat powoli uzupełnia brakujące pamięci podręczne HTML i surowego Markdown README, gdy jesteś zalogowany. Działa w małych partiach i wycofuje się przy błędach sieci."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat повільно заповнює відсутні кеші HTML та сирого Markdown README, коли ви ввійшли. Він працює невеликими партіями та зменшує частоту при помилках мережі."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat, oturum açıkken eksik README HTML ve ham Markdown önbelleklerini yavaşça doldurur. Küçük gruplar halinde çalışır ve ağ hatalarında geri çekilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat từ từ điền vào bộ nhớ đệm HTML và Markdown thô còn thiếu khi bạn đã đăng nhập. Nó chạy theo từng đợt nhỏ và tạm dừng khi có lỗi mạng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat perlahan mengisi cache HTML README dan Markdown mentah yang hilang saat Anda masuk. Proses berjalan dalam batch kecil dan mundur jika terjadi kesalahan jaringan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يملأ Starcat ببطء ذاكرة HTML و Markdown الخام المؤقتة لملفات README المفقودة أثناء تسجيل الدخول. يعمل على دفعات صغيرة ويتراجع عند أخطاء الشبكة."
          }
        }
      }
    },
