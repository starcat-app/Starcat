    "settings.autoTidy.actions.generateTags.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقتراح الوسوم وتطبيقها تلقائيًا؛ مع تمكين العتبة، يتم تطبيق الوسوم التي تستوفي متطلبات الثقة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags vorschlagen und automatisch anwenden; bei aktiviertem Schwellenwert werden nur Tags mit ausreichender Konfidenz angewendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommend tags and apply them automatically; with the threshold enabled, only tags that meet the confidence requirement are applied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomienda etiquetas y las aplica automáticamente; con el umbral activado, solo se aplican las etiquetas que cumplen el requisito de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommander des étiquettes et les appliquer automatiquement ; avec le seuil activé, seules les étiquettes atteignant le niveau de confiance requis sont appliquées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekomendasikan tag dan terapkan secara otomatis; dengan ambang diaktifkan, hanya tag yang memenuhi persyaratan kepercayaan yang diterapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccomanda tag e li applica automaticamente; con la soglia abilitata, vengono applicati solo i tag che soddisfano il requisito di confidenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグを推奨して自動適用します。しきい値が有効な場合、信頼度要件を満たすタグのみが適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그를 추천하고 자동으로 적용합니다. 임계값이 활성화된 경우 신뢰도 요구 사항을 충족하는 태그만 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags aanbevelen en automatisch toepassen; met de drempel ingeschakeld worden alleen tags toegepast die aan de vertrouwenseis voldoen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalecaj tagi i stosuj je automatycznie; przy włączonym progu stosowane są tylko tagi spełniające wymagania dotyczące pewności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomenda tags e as aplica automaticamente; com o limiar ativado, apenas tags que atendem ao requisito de confiança são aplicadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендовать теги и применять их автоматически; при включённом пороге применяются только теги, соответствующие требованию уверенности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiketleri önerir ve otomatik olarak uygular; eşik etkinleştirildiğinde, yalnızca güven gereksinimini karşılayan etiketler uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендувати теги та застосовувати їх автоматично; з увімкненим порогом застосовуються лише теги, що відповідають вимогам впевненості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đề xuất thẻ và tự động áp dụng; với ngưỡng được bật, chỉ áp dụng các thẻ đáp ứng yêu cầu độ tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 推荐并直接应用标签；启用阈值后，仅应用达到置信度要求的标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 推荐并直接应用标签；启用阈值后，仅应用达到置信度要求的标签。"
          }
        }
      }
    },
