    "settings.mcp.batchWrites.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح لأدوات الكتابة المجمعة المستقبلية بتحديث مستودعات متعددة في طلب واحد. لا تزال أدوات الكتابة P0 تستخدم حدودًا لكل طلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie zukünftigen Batch-Schreib-Tools, mehrere Repositorys in einer Anfrage zu aktualisieren. P0-Schreib-Tools verwenden weiterhin Limits pro Anfrage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow future batch write tools to update multiple repositories in one request. P0 write tools still use per-request limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que futuras herramientas de escritura por lotes actualicen múltiples repositorios en una sola solicitud. Las herramientas de escritura P0 aún usan límites por solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les futurs outils d'écriture par lots à mettre à jour plusieurs dépôts en une seule demande. Les outils d'écriture P0 utilisent toujours des limites par demande."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan alat tulis batch di masa mendatang untuk memperbarui beberapa repositori dalam satu permintaan. Alat tulis P0 masih menggunakan batas per permintaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti ai futuri strumenti di scrittura batch di aggiornare più repository in una singola richiesta. Gli strumenti di scrittura P0 utilizzano ancora limiti per richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将来のバッチ書き込みツールが1回のリクエストで複数のリポジトリを更新できるようにします。P0書き込みツールは引き続きリクエストごとの制限を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "향후 배치 쓰기 도구가 하나의 요청으로 여러 저장소를 업데이트할 수 있도록 허용합니다. P0 쓰기 도구는 여전히 요청당 제한을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toekomstige batch-schrijftools toestaan om meerdere repositories in één verzoek bij te werken. P0-schrijftools gebruiken nog steeds limieten per verzoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól przyszłym narzędziom do zapisu wsadowego na aktualizowanie wielu repozytoriów w jednym żądaniu. Narzędzia zapisu P0 nadal używają limitów na żądanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que futuras ferramentas de gravação em lote atualizem vários repositórios em uma única solicitação. As ferramentas de gravação P0 ainda usam limites por solicitação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить будущим инструментам пакетной записи обновлять несколько репозиториев за один запрос. Инструменты записи P0 по-прежнему используют ограничения на запрос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelecekteki toplu yazma araçlarının tek bir istekte birden çok depoyu güncellemesine izin ver. P0 yazma araçları hâlâ istek başına sınırlar kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити майбутні інструменти пакетного запису для оновлення кількох репозиторіїв в одному запиті. Інструменти запису P0 все ще використовують обмеження на запит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép các công cụ ghi hàng loạt trong tương lai cập nhật nhiều kho lưu trữ trong một yêu cầu. Các công cụ ghi P0 vẫn sử dụng giới hạn theo yêu cầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许后续批量写入工具在一次请求中更新多个仓库。P0 写入工具仍按单次请求限制执行。"
          }
        },
        "zh-Hant" : {
