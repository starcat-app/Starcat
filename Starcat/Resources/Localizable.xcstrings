    "rag.workspace.inspector.plan.help.questionUnderstanding.definition.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Planner model's interpretation of your question before retrieval runs. It shows what Starcat believes you are asking and how it will search semantically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检索执行前，Planner 模型对你问题的理解结果：展示 Starcat 认为你在问什么，以及将如何改写为语义检索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢索執行前，Planner 模型對你問題的理解結果：展示 Starcat 認為你在問什麼，以及將如何改寫為語義檢索。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索実行前のプランナーモデルによる質問の解釈。Starcatが何を尋ねられていると認識し、どのようにセマンティック検索するかを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 실행 전 Planner 모델의 질문 해석입니다. Starcat이 사용자가 무엇을 묻고 있는지, 어떻게 의미론적으로 검색할지 보여줍니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Interpretation Ihrer Frage durch das Planner-Modell vor dem Abruf. Es zeigt, was Starcat Ihrer Meinung nach fragt und wie es semantisch suchen wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'interprétation de votre question par le modèle planificateur avant l'exécution de la récupération. Il montre ce que Starcat pense que vous demandez et comment il effectuera la recherche sémantique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La interpretación del modelo planificador de su pregunta antes de ejecutar la recuperación. Muestra lo que Starcat cree que está preguntando y cómo buscará semánticamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A interpretação do modelo Planejador sobre sua pergunta antes da execução da recuperação. Mostra o que o Starcat acredita que você está perguntando e como fará a busca semântica."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'interpretazione del modello Planner della tua domanda prima dell'esecuzione del recupero. Mostra cosa Starcat pensa tu stia chiedendo e come effettuerà la ricerca semantica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интерпретация вашего вопроса моделью планировщика до выполнения поиска. Показывает, что, по мнению Starcat, вы спрашиваете и как будет выполнять семантический поиск."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De interpretatie van je vraag door het Plannermodel voordat het ophalen wordt uitgevoerd. Het toont wat Starcat denkt dat je vraagt en hoe het semantisch zal zoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpretacja pytania przez model Planisty przed uruchomieniem wyszukiwania. Pokazuje, co według Starcat pytasz i jak będzie szukać semantycznie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інтерпретація вашого питання моделлю планувальника до виконання пошуку. Показує, що, на думку Starcat, ви запитуєте, і як він шукатиме семантично."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlayıcı modelinin, getirme işlemi çalışmadan önce sorunuzu yorumlaması. Starcat'ın ne sorduğunuzu düşündüğünü ve anlamsal olarak nasıl arama yapacağını gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diễn giải câu hỏi của bạn bởi mô hình Planner trước khi truy xuất. Nó cho thấy Starcat nghĩ bạn đang hỏi gì và cách nó sẽ tìm kiếm ngữ nghĩa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpretasi model Planner terhadap pertanyaan Anda sebelum pengambilan dijalankan. Ini menunjukkan apa yang Starcat yakini Anda tanyakan dan bagaimana ia akan mencari secara semantik."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفسير نموذج المخطط لسؤالك قبل تشغيل الاسترجاع. يظهر ما تعتقد Starcat أنك تسأل عنه وكيف ستبحث دلاليًا."
          }
        }
      }
    },
