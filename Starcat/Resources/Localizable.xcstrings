          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте @ для выбора одного или нескольких репозиториев базы знаний или задайте вопрос по всей базе знаний."
          }
        },
        "nl" : {
          "stringUnit" : {
