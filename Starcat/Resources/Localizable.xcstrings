    "rag.workspace.inspector.metadata.help.artifacts.definition.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coverage is calculated from repositories currently in the knowledge base. Only aggregate counts are shown; note and summary content is never exposed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖率以当前已入库项目为范围。这里只展示聚合数量，不展示笔记或摘要正文。"
          }
        }
      }
    },
