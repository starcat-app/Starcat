    "error.user.localData.recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart Starcat. If the problem remains, export debug logs before deleting any local files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重启 Starcat；如果问题仍然存在，请先导出调试日志，不要直接删除本地文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重启 Starcat；如果问题仍然存在，请先导出调试日志，不要直接删除本地文件。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcatを再起動してください。問題が解決しない場合は、ローカルファイルを削除する前にデバッグログを書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat을 다시 시작하세요. 문제가 지속되면 로컬 파일을 삭제하기 전에 디버그 로그를 내보내세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starten Sie Starcat neu. Wenn das Problem bestehen bleibt, exportieren Sie Debug-Protokolle, bevor Sie lokale Dateien löschen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarrez Starcat. Si le problème persiste, exportez les journaux de débogage avant de supprimer des fichiers locaux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia Starcat. Si el problema persiste, exporta los registros de depuración antes de eliminar cualquier archivo local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicie o Starcat. Se o problema persistir, exporte os registros de depuração antes de excluir qualquer arquivo local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavvia Starcat. Se il problema persiste, esporta i log di debug prima di eliminare file locali."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустите Starcat. Если проблема останется, экспортируйте отладочные логи перед удалением локальных файлов."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start Starcat opnieuw. Als het probleem aanhoudt, exporteer dan debuglogs voordat je lokale bestanden verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom ponownie Starcat. Jeśli problem nadal występuje, wyeksportuj logi debugowania przed usunięciem plików lokalnych."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустіть Starcat. Якщо проблема залишиться, експортуйте журнали налагодження перед видаленням локальних файлів."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat'ı yeniden başlatın. Sorun devam ederse, herhangi bir yerel dosyayı silmeden önce hata ayıklama günlüklerini dışa aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khởi động lại Starcat. Nếu vấn đề vẫn còn, hãy xuất nhật ký gỡ lỗi trước khi xóa bất kỳ tệp cục bộ nào."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai ulang Starcat. Jika masalah berlanjut, ekspor log debug sebelum menghapus file lokal."
          }
        },
        "ar" : {
