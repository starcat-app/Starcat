    "rag.workspace.inspector.plan.help.retrievalFunnel.definition.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actual retrieval statistics for this turn: how many repositories and chunks passed each stage from candidates to final evidence. This replays execution, not the Planner's intent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本轮检索的实际统计：从候选仓库到最终证据，各阶段通过了多少仓库与分片。这是执行回放，不是 Planner 的意图描述。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本輪檢索的實際統計：從候選倉庫到最終證據，各階段通過了多少倉庫與分片。這是執行回放，不是 Planner 的意圖描述。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回の実際の検索統計: 候補から最終証拠まで、各段階を通過したリポジトリとチャンクの数。プランナーの意図ではなく、実行を再現します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 턴의 실제 검색 통계: 각 단계를 통과한 저장소 및 청크 수 (후보에서 최종 증거까지). 이는 실행을 재생하며, Planner의 의도가 아닙니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatsächliche Retrieval-Statistiken für diesen Durchlauf: wie viele Repositorys und Chunks jede Stufe von Kandidaten bis zu endgültigen Beweisen durchlaufen haben. Dies gibt die Ausführung wieder, nicht die Absicht des Planners."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistiques de récupération réelles pour ce tour : combien de dépôts et de fragments ont passé chaque étape, des candidats aux preuves finales. Cela rejoue l'exécution, pas l'intention du planificateur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estadísticas de recuperación reales para esta ronda: cuántos repositorios y fragmentos pasaron cada etapa, desde candidatos hasta evidencia final. Esto reproduce la ejecución, no la intención del Planificador."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estatísticas reais de recuperação para este turno: quantos repositórios e fragmentos passaram em cada estágio, de candidatos a evidência final. Isso reproduz a execução, não a intenção do Planejador."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistiche di recupero effettive per questo turno: quanti repository e chunk sono passati attraverso ogni fase, dai candidati alle evidenze finali. Questo riproduce l'esecuzione, non l'intento del Planner."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фактическая статистика поиска для этого раунда: сколько репозиториев и фрагментов прошло каждый этап от кандидатов до финальных свидетельств. Это воспроизводит выполнение, а не намерение Планировщика."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkelijke ophaalstatistieken voor deze beurt: hoeveel repositories en chunks elke fase hebben doorlopen van kandidaten tot definitief bewijs. Dit speelt de uitvoering af, niet de intentie van de Planner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rzeczywiste statystyki wyszukiwania dla tej tury: ile repozytoriów i fragmentów przeszło przez każdy etap od kandydatów do końcowych dowodów. To odtwarza wykonanie, a nie zamiar Planisty."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фактична статистика пошуку для цього кроку: скільки репозиторіїв і фрагментів пройшли кожен етап від кандидатів до остаточних доказів. Це відтворює виконання, а не намір планувальника."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tur için gerçek alma istatistikleri: adaylardan nihai kanıta kadar her aşamadan kaç depo ve parça geçti. Bu, Planlayıcı'nın niyetini değil, yürütmeyi yeniden oynatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thống kê truy xuất thực tế cho lượt này: có bao nhiêu kho lưu trữ và đoạn đã vượt qua mỗi giai đoạn từ ứng viên đến bằng chứng cuối cùng. Đây là phát lại quá trình thực thi, không phải ý định của Planner."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistik pengambilan aktual untuk giliran ini: berapa banyak repositori dan potongan yang melewati setiap tahap dari kandidat hingga bukti akhir. Ini memutar ulang eksekusi, bukan niat Planner."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إحصائيات الاسترجاع الفعلية لهذا الدور: كم عدد المستودعات والأجزاء التي اجتازت كل مرحلة من المرشحين إلى الأدلة النهائية. هذا يعيد تشغيل التنفيذ، وليس نية المخطط."
          }
        }
      }
    },
