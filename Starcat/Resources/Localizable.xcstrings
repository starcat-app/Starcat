    "settings.pro.direct.error.activationLimitReached" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل هذا الترخيص إلى الحد الأقصى للأجهزة. قم بإلغاء تنشيط جهاز Mac آخر، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Lizenz hat ihr Gerätelimit erreicht. Deaktiviere einen anderen Mac und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This license has reached its device limit. Deactivate another Mac, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta licencia ha alcanzado su límite de dispositivos. Desactiva otro Mac y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette licence a atteint sa limite d’appareils. Désactivez un autre Mac, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisensi ini telah mencapai batas perangkat. Nonaktifkan Mac lain, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa licenza ha raggiunto il limite di dispositivi. Disattiva un altro Mac, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このライセンスはデバイス数の上限に達しました。別のMacを無効化してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 라이선스의 기기 한도에 도달했습니다. 다른 Mac을 비활성화한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze licentie heeft het maximale aantal apparaten bereikt. Deactiveer een andere Mac en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta licencja osiągnęła limit urządzeń. Dezaktywuj innego Maca, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta licença atingiu o limite de dispositivos. Desative outro Mac e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта лицензия достигла лимита устройств. Деактивируйте другой Mac и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu lisans cihaz sınırına ulaştı. Başka bir Mac'i devre dışı bırakın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця ліцензія досягла ліміту пристроїв. Деактивуйте інший Mac, а потім спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấy phép này đã đạt giới hạn thiết bị. Hãy hủy kích hoạt một máy Mac khác, sau đó thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此授权已达设备数量上限。请先解绑其它 Mac，然后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此授權已達裝置數量上限。請先停用另一台 Mac，然後再試一次。"
          }
        }
      }
    },
