      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-select: cannot edit single field; can Delete or Merge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多选状态下不可编辑单个字段；可执行「删除」或「合并」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多選狀態下無法編輯單一欄位；可執行「刪除」或「合併」。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数選択：単一フィールドの編集は不可。削除またはマージのみ可能です。"
