    "repo.share.error.missingAIConfig" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم المشاركة ملخصًا بالذكاء الاصطناعي لصفحة المشاركة. لم يتم تكوين مزود ذكاء اصطناعي بعد — افتح الإعدادات ← الذكاء الاصطناعي، أضف مفتاح API لمهمة التلخيص، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Teilen wird eine KI-Zusammenfassung für die Freigabeseite verwendet. Es ist noch kein KI-Anbieter konfiguriert – öffnen Sie Einstellungen → KI, fügen Sie einen API-Schlüssel für die Zusammenfassungsaufgabe hinzu und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing uses an AI summary for the share page. No AI provider is configured yet — open Settings → AI, add an API key for the Summary task, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir usa un resumen de IA para la página. Aún no hay un proveedor de IA configurado: abre Ajustes → IA, añade una clave API para la tarea de resumen y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage utilise un résumé IA pour la page. Aucun fournisseur IA n’est configuré — ouvrez Réglages → IA, ajoutez une clé API pour la tâche Résumé, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbagi menggunakan ringkasan AI untuk halaman bagikan. Belum ada penyedia AI yang dikonfigurasi — buka Pengaturan → AI, tambahkan kunci API untuk tugas Ringkasan, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione utilizza un riepilogo AI per la pagina. Nessun provider AI configurato: apri Impostazioni → AI, aggiungi una chiave API per l'attività Riepilogo, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有にはAI要約が必要です。AIプロバイダが設定されていません。「設定」→「AI」で「要約」タスクのAPIキーを追加してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유는 공유 페이지에 AI 요약을 사용합니다. 아직 AI 제공자가 구성되지 않았습니다. 설정 → AI를 열고 요약 작업에 API 키를 추가한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delen gebruikt een AI-samenvatting voor de deelpagina. Er is nog geen AI-provider geconfigureerd — open Instellingen → AI, voeg een API-sleutel toe voor de Samenvatting-taak en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnianie wymaga podsumowania AI dla strony. Nie skonfigurowano jeszcze dostawcy AI — otwórz Ustawienia → AI, dodaj klucz API dla zadania Podsumowanie, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento usa um resumo IA para a página. Nenhum provedor de IA foi configurado ainda — abra Ajustes → IA, adicione uma chave de API para a tarefa de Resumo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для публикации используется ИИ-сводка. Провайдер ИИ ещё не настроен — откройте Настройки → ИИ, добавьте API-ключ для задачи «Сводка» и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşım, paylaşım sayfası için bir AI özeti kullanır. Henüz bir AI sağlayıcısı yapılandırılmamış — Ayarlar → AI bölümünü açın, Özet görevi için bir API anahtarı ekleyin ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для поширення використовується AI підсумок. Ще не налаштовано жодного AI провайдера — відкрийте Налаштування → AI, додайте ключ API для завдання «Підсумок», а потім спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ sử dụng tóm tắt AI cho trang chia sẻ. Chưa có nhà cung cấp AI nào được cấu hình — hãy mở Cài đặt → AI, thêm khóa API cho tác vụ Tóm tắt, sau đó thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享会附带 AI 摘要生成分享页。当前尚未配置 AI 服务，请前往「设置 → AI」为摘要任务配置 Provider 的 API Key 后重试。"
