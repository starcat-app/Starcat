    "settings.storage.clearTranslation.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All cached translations will be removed. Repos can be re-translated on demand; AI quota will be spent again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已缓存的所有译文将被清空。仓库仍可按需重新翻译，需要重新消耗 AI 配额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已缓存的所有译文将被清空。仓库仍可按需重新翻译，需要重新消耗 AI 配额。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュされたすべての翻訳が削除されます。リポジトリは必要に応じて再翻訳できます。その際、AIクォータが再度消費されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시된 모든 번역이 제거됩니다. 저장소는 필요 시 다시 번역할 수 있으며, AI 할당량이 다시 소모됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle zwischengespeicherten Übersetzungen werden entfernt. Repos können bei Bedarf neu übersetzt werden; dabei wird erneut KI-Kontingent verbraucht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les traductions mises en cache seront supprimées. Les dépôts peuvent être retraduits à la demande ; le quota IA sera à nouveau utilisé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las traducciones cacheadas. Los repositorios se pueden volver a traducir bajo demanda; se consumirá cuota de IA nuevamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as traduções em cache serão removidas. Os repositórios podem ser retraduzidos sob demanda; a cota de IA será consumida novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le traduzioni memorizzate nella cache verranno rimosse. I repository possono essere ritradotti su richiesta; la quota AI verrà consumata di nuovo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все кешированные переводы будут удалены. Репозитории можно перевести повторно по запросу; квота ИИ будет израсходована снова."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gecachte vertalingen worden verwijderd. Repo's kunnen op verzoek opnieuw worden vertaald; AI-quotum wordt opnieuw verbruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie zapisane tłumaczenia zostaną usunięte. Repozytoria można ponownie przetłumaczyć na żądanie; limit AI zostanie ponownie wykorzystany."
