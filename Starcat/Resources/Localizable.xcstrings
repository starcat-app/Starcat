    "rag.browser.chunk.permanentDelete.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This chunk will no longer appear in the list or be retrieved, even after the index is refreshed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分片将不再出现在列表中或参与召回，即使刷新索引也不会重新生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此區塊將不再顯示於清單中或參與檢索，即使重新整理索引也不會重新產生。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャンクはリストに表示されなくなり、インデックスを更新しても取得されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 청크는 목록에 더 이상 표시되지 않으며 인덱스를 새로 고쳐도 검색되지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chunk wird nicht mehr in der Liste angezeigt oder abgerufen, auch nicht nach einer Aktualisierung des Index."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fragment n'apparaîtra plus dans la liste et ne sera plus récupéré, même après actualisation de l'index."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este fragmento ya no aparecerá en la lista ni se recuperará, incluso después de actualizar el índice."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este fragmento não aparecerá mais na lista nem será recuperado, mesmo após a atualização do índice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo chunk non apparirà più nell'elenco né verrà recuperato, anche dopo l'aggiornamento dell'indice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чанк больше не будет отображаться в списке или извлекаться, даже после обновления индекса."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze chunk wordt niet meer weergegeven in de lijst of opgehaald, zelfs niet na het vernieuwen van de index."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten fragment nie będzie już widoczny na liście ani pobierany, nawet po odświeżeniu indeksu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей фрагмент більше не з'являтиметься у списку і не буде отриманий, навіть після оновлення індексу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu parça, dizin yenilendikten sonra bile listede görünmeyecek ve alınmayacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đoạn này sẽ không còn xuất hiện trong danh sách hoặc được truy xuất, ngay cả sau khi làm mới chỉ mục."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potongan ini tidak akan muncul lagi dalam daftar atau diambil, bahkan setelah indeks disegarkan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تظهر هذه القطعة في القائمة بعد الآن ولن يتم استرجاعها، حتى بعد تحديث الفهرس."
          }
        }
