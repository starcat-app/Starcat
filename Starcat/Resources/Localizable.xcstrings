    "settings.mcp.localAPIKey.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP uses the shared Local API Key from Settings > Integrations > Local API Key. Rotating that key invalidates existing MCP client configs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 使用「设置 → 集成 → 本地 API Key」中的共享 key。刷新该 key 后，已有 MCP 客户端配置会失效。"
          }
        }
      }
    },
    "settings.mcp.localAPIKey.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get API Key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取 API Key"
          }
        }
      }
    },
    "settings.mcp.localWrites.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow local MCP tools to write notes, statuses, and tags. This never performs GitHub remote star/unstar actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地 MCP 工具写入笔记、状态和标签。此开关不会执行 GitHub 远端 star/unstar 操作。"
          }
        }
      }
    },
    "settings.mcp.localWrites.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow local writes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地写入"
          }
        }
      }
    },
    "settings.mcp.port": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port (1024–65535)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口(1024-65535)"
          }
        }
      }
    },
    "settings.mcp.port.error.checkFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify this port. Try another port or restart Starcat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认这个端口是否可用，请换一个端口或重启 Starcat 后再试。"
          }
        }
      }
    },
    "settings.mcp.port.error.digitsOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port must contain digits only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口只能包含数字。"
          }
        }
      }
    },
    "settings.mcp.port.error.inUseFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %d is already in use. Choose another port and restart MCP Service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %d 已被占用，请换一个端口后重启 MCP Service。"
          }
        }
      }
    },
    "settings.mcp.port.error.invalidFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %d is invalid. Use a number from 1024 to 65535."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %d 无效，请输入 1024 到 65535 之间的数字。"
          }
        }
      }
    },
    "settings.mcp.port.error.tooHigh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port cannot exceed 65535."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口号不能超过 65535。"
          }
        }
      }
    },
    "settings.mcp.port.error.tooLow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port must be at least 1024."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口号不能小于 1024。"
          }
        }
      }
    },
    "settings.mcp.port.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digits only. Leave empty and tap Restart to use default port 5555."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能输入数字。留空后点「重启」将使用默认端口 5555。"
          }
        }
      }
    },
    "settings.mcp.privateNotes.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MCP tools to read repository private notes and reading status. Keep this off unless the connected agent should see that data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 MCP 工具读取仓库私有笔记和阅读状态。只有当连接的 Agent 应该看到这些数据时才开启。"
          }
        }
      }
    },
