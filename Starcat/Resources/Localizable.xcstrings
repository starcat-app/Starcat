        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin kartu ke papan klip dan buka X.com — tempel gambar ke dalam tweet Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la card negli appunti e apri X.com — incolla l'immagine nel tuo tweet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードをクリップボードにコピーしてX.comを開きます — 画像をツイートに貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드를 클립보드에 복사하고 X.com을 열어 트윗에 이미지를 붙여넣으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
