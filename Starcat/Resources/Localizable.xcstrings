    "rag.workspace.context.budget.help.definition.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you send a question, Starcat allocates the model context window across prompt segments: system rules, conversation history, your question, retrieved evidence, remote content, and attachments. Reserved output space is listed separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题发送后，系统会按当前模型的 Context Window，为本轮 Prompt 分配分片：系统提示、会话历史、问题、检索证据、远程内容与附件；为模型回答预留的输出空间会单独列出。"
          }
        }
      }
    },
    "rag.workspace.context.budget.help.definition.title": {
