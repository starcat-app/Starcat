    "agent.workspace.composer.placeholder" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the Agent more instructions, use @ to select starred repos, or / to call skills and tools"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续给 Agent 指令，或 @ 选择已 star repo，/ 调用技能与工具"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續給 Agent 更多指令，使用 @ 選擇已加星號的儲存庫，或使用 / 呼叫技能與工具"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントにさらに指示を与えるには、@でスター付きリポジトリを選択するか、/でスキルやツールを呼び出します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트에 추가 지침을 제공하거나, @를 사용하여 별표 표시한 저장소를 선택하거나, /를 사용하여 기술 및 도구를 호출하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib dem Agenten weitere Anweisungen, verwende @, um markierte Repos auszuwählen, oder /, um Fähigkeiten und Tools aufzurufen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez plus d'instructions à l'agent, utilisez @ pour sélectionner des dépôts favoris, ou / pour appeler des compétences et outils"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale más instrucciones al agente, usa @ para seleccionar repositorios destacados, o / para llamar habilidades y herramientas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê mais instruções ao Agente, use @ para selecionar repositórios favoritados, ou / para chamar habilidades e ferramentas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornisci ulteriori istruzioni all'agente, usa @ per selezionare repository con stella, o / per chiamare competenze e strumenti"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте агенту дополнительные инструкции, используйте @ для выбора отмеченных звёздами репозиториев или / для вызова навыков и инструментов"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef de Agent meer instructies, gebruik @ om gemarkeerde repos te selecteren, of / om vaardigheden en tools aan te roepen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj agentowi więcej instrukcji, użyj @, aby wybrać oznaczone gwiazdką repozytoria, lub /, aby wywołać umiejętności i narzędzia"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте агенту додаткові інструкції, використовуйте @ для вибору репозиторіїв з зірочками або / для виклику навичок та інструментів"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajana daha fazla talimat verin, yıldızlı depoları seçmek için @ kullanın veya becerileri ve araçları çağırmak için / kullanın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cung cấp thêm hướng dẫn cho tác nhân, sử dụng @ để chọn kho lưu trữ đã gắn sao hoặc / để gọi kỹ năng và công cụ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan instruksi lebih lanjut kepada Agen, gunakan @ untuk memilih repositori berbintang, atau / untuk memanggil keterampilan dan alat"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعط الوكيل تعليمات إضافية، استخدم @ لتحديد المستودعات المميزة بنجمة، أو / لاستدعاء المهارات والأدوات"
          }
        }
      }
    },
