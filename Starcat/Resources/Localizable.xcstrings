    "settings.pro.benefit.release.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راقب المزيد من المستودعات للإصدارات الجديدة، مع إشارات داخل التطبيق وإشعارات اختيارية لتفويت تحديثات الإصدارات المهمة بصعوبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Repositorys auf neue Versionen überwachen, mit In-App-Signalen und optionalen Benachrichtigungen, damit wichtige Versionssprünge schwerer zu übersehen sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch more repositories for new Releases, with in-app signals and optional notifications so important version bumps are harder to miss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigila más repositorios en busca de nuevas versiones, con señales en la aplicación y notificaciones opcionales para que los aumentos de versión importantes sean más difíciles de pasar por alto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillez plus de dépôts pour les nouvelles versions, avec des signaux dans l'application et des notifications optionnelles pour ne pas manquer les mises à jour importantes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantau lebih banyak repositori untuk Rilis baru, dengan sinyal dalam aplikasi dan notifikasi opsional sehingga pembaruan versi penting lebih sulit terlewatkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitora più repository per nuove versioni, con segnali in-app e notifiche opzionali in modo che gli aggiornamenti importanti siano più difficili da perdere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より多くのリポジトリのリリースを監視し、アプリ内通知とオプションの通知で重要なバージョンアップを見逃しにくくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 많은 저장소의 새 릴리스를 앱 내 신호와 선택적 알림으로 모니터링하여 중요한 버전 업데이트를 놓치지 않도록 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaak meer repositories voor nieuwe releases, met in-app signalen en optionele meldingen zodat belangrijke versie-updates moeilijker te missen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obserwuj więcej repozytoriów pod kątem nowych wydań, z sygnałami w aplikacji i opcjonalnymi powiadomieniami, aby ważne wersje były trudniejsze do przeoczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitore mais repositórios para novos Lançamentos, com sinais no app e notificações opcionais para que atualizações importantes de versão sejam mais difíceis de perder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживайте больше репозиториев на предмет новых релизов с внутриприложенными сигналами и опциональными уведомлениями, чтобы не пропустить важные обновления версий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni Sürümler için daha fazla depo izleyin, uygulama içi sinyaller ve isteğe bağlı bildirimlerle önemli sürüm atlamalarını kaçırmayı zorlaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спостерігайте за більшою кількістю репозиторіїв на предмет нових релізів із сигналами в додатку та додатковими сповіщеннями, щоб не пропустити важливі оновлення версій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi nhiều kho lưu trữ hơn cho các Bản phát hành mới, với tín hiệu trong ứng dụng và thông báo tùy chọn để không bỏ lỡ các bản nâng cấp quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可追踪更多仓库的 Release 更新，应用内信号与可选通知一起用，重要版本发布更不容易漏掉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可追蹤更多儲存庫的 Release 更新，透過應用程式內訊號與可選通知，讓重要版本更新更不容易錯過。"
          }
        }
      }
    },
