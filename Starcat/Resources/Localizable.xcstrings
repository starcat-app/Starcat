    "rag.workspace.inspector.retrievalScore.formula.hybrid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "score = (keyword RRF + keyword score × 0.12 + vector RRF + cosine similarity × 0.20) × source weight + preferred-repo boost"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合检索分 =（关键词 RRF + 字面命中分 × 0.12 + 向量 RRF + 余弦相似度 × 0.20）× 来源权重 + @repo 偏好加成"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "綜合檢索分 =（關鍵詞 RRF + 字面命中分 × 0.12 + 向量 RRF + 餘弦相似度 × 0.20）× 來源權重 + @repo 偏好加成"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スコア = (キーワードRRF + キーワードスコア × 0.12 + ベクトルRRF + コサイン類似度 × 0.20) × ソース重み + 優先リポジトリブースト"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점수 = (키워드 RRF + 키워드 점수 × 0.12 + 벡터 RRF + 코사인 유사도 × 0.20) × 소스 가중치 + 선호 저장소 부스트"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wertung = (Keyword-RRF + Keyword-Wertung × 0,12 + Vektor-RRF + Kosinus-Ähnlichkeit × 0,20) × Quellgewicht + Bevorzugtes-Repo-Boost"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "score = (RRF mots-clés + score mots-clés × 0,12 + RRF vectoriel + similarité cosinus × 0,20) × poids source + bonus dépôt préféré"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "puntuación = (RRF de palabras clave + puntuación de palabras clave × 0.12 + RRF vectorial + similitud coseno × 0.20) × peso de fuente + incremento de repositorio preferido"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pontuação = (RRF de palavra-chave + pontuação de palavra-chave × 0,12 + RRF vetorial + similaridade de cosseno × 0,20) × peso da fonte + impulso de repositório preferido"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "punteggio = (RRF parole chiave + punteggio parole chiave × 0,12 + RRF vettore + similarità coseno × 0,20) × peso fonte + boost repository preferito"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "оценка = (RRF ключевых слов + оценка ключевых слов × 0,12 + RRF векторов + косинусное сходство × 0,20) × вес источника + бонус предпочтительного репозитория"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "score = (trefwoord RRF + trefwoordscore × 0,12 + vector RRF + cosinusovereenkomst × 0,20) × brongewicht + voorkeursrepo-boost"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "wynik = (RRF słów kluczowych + wynik słów kluczowych × 0,12 + RRF wektorów + podobieństwo cosinusowe × 0,20) × waga źródła + premia za preferowane repozytorium"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "оцінка = (RRF ключових слів + оцінка ключових слів × 0.12 + RRF вектора + косинусна подібність × 0.20) × вага джерела + бонус улюбленого сховища"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "puan = (anahtar kelime RRF + anahtar kelime puanı × 0.12 + vektör RRF + kosinüs benzerliği × 0.20) × kaynak ağırlığı + tercih edilen depo desteği"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "điểm = (RRF từ khóa + điểm từ khóa × 0.12 + RRF vector + tương đồng cosine × 0.20) × trọng số nguồn + thưởng kho ưa thích"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "skor = (RRF kata kunci + skor kata kunci × 0,12 + RRF vektor + kemiripan kosinus × 0,20) × bobot sumber + dorongan repositori pilihan"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدرجة = (RRF الكلمات المفتاحية + درجة الكلمات المفتاحية × 0.12 + RRF المتجهات + تشابه جيب التمام × 0.20) × وزن المصدر + تعزيز المستودع المفضل"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.formula.keyword" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
