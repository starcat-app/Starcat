    "explore.help.popular.rule.threshold" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A project must have at least 1,000 Stars or meet the composite popularity threshold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目需要达到 1,000 Stars，或达到综合热度门槛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案需要達到 1,000 Stars，或達到綜合熱度門檻。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトは少なくとも1,000スターを持つか、複合人気スコアのしきい値を満たす必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트는 최소 1,000개의 Stars를 보유하거나 복합 인기 임계값을 충족해야 합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Projekt muss mindestens 1.000 Sterne haben oder den zusammengesetzten Beliebtheitsschwellenwert erreichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un projet doit avoir au moins 1 000 étoiles ou atteindre le seuil de popularité composite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proyecto debe tener al menos 1,000 estrellas o cumplir con el umbral de popularidad compuesto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um projeto deve ter pelo menos 1.000 Estrelas ou atender ao limite composto de popularidade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un progetto deve avere almeno 1.000 stelle o raggiungere la soglia di popolarità composita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проект должен иметь не менее 1000 звёзд или соответствовать порогу составной популярности."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een project moet ten minste 1.000 Stars hebben of voldoen aan de samengestelde populariteitsdrempel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt musi mieć co najmniej 1000 gwiazdek lub spełniać złożony próg popularności."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проект повинен мати щонайменше 1000 зірок або відповідати складеному порогу популярності."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir projenin en az 1.000 Yıldızı olmalı veya bileşik popülerlik eşiğini karşılamalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
