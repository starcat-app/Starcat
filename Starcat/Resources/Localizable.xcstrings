    "settings.pro.benefit.search.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادمج البحث بالتضمين المحلي مع نتائج الويب للعثور على المستودعات المميزة بنجمة بالمعنى، وليس فقط بالكلمات المفتاحية—مفيد عندما تتذكر الفكرة ولكن ليس الاسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Embedding-Suche mit Webergebnissen kombinieren, um markierte Repos nach Bedeutung zu finden, nicht nur nach Schlüsselwörtern – nützlich, wenn man die Idee, aber nicht den Namen kennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine local embedding search with web results to find starred repos by meaning, not just keywords—useful when you remember the idea but not the name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina la búsqueda de incrustaciones local con resultados web para encontrar repositorios destacados por significado, no solo por palabras clave, útil cuando recuerdas la idea pero no el nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinez la recherche par embedding local avec les résultats web pour trouver des dépôts starisés par leur sens, pas seulement par mots-clés—utile quand vous vous souvenez de l'idée mais pas du nom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gabungkan pencarian embedding lokal dengan hasil web untuk menemukan repositori yang dibintangi berdasarkan makna, bukan hanya kata kunci—berguna saat Anda ingat idenya tetapi tidak namanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina la ricerca di embedding locale con i risultati web per trovare repository stellati per significato, non solo per parole chiave, utile quando ricordi l'idea ma non il nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル埋め込み検索とWeb検索を組み合わせ、キーワードだけでなく意味でスター付きリポジトリを検索します。名前を忘れてもアイデアを覚えている場合に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 임베딩 검색과 웹 결과를 결합하여 키워드뿐만 아니라 의미로 별표 표시된 저장소를 찾습니다. 이름은 기억나지 않지만 아이디어는 기억날 때 유용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combineer lokale embedding-zoekopdracht met webresultaten om gesterde repositories te vinden op betekenis, niet alleen op trefwoorden—handig wanneer u het idee maar niet de naam herinnert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz lokalne wyszukiwanie osadzeń z wynikami internetowymi, aby znaleźć oznaczone gwiazdką repozytoria według znaczenia, a nie tylko słów kluczowych – przydatne, gdy pamiętasz pomysł, ale nie nazwę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine busca por incorporação local com resultados da web para encontrar repositórios favoritos por significado, não apenas por palavras-chave — útil quando você lembra da ideia, mas não do nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объедините локальный поиск по эмбеддингам с веб-результатами, чтобы находить звёздные репозитории по смыслу, а не только по ключевым словам — полезно, когда вы помните идею, но не название."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel gömme aramasını web sonuçlarıyla birleştirerek yıldızlı depoları yalnızca anahtar kelimelerle değil, anlamla bulun; adı değil fikri hatırladığınızda kullanışlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поєднуйте локальний пошук за вбудовуваннями з веб-результатами, щоб знаходити збережені репозиторії за змістом, а не лише за ключовими словами — корисно, коли ви пам'ятаєте ідею, але не назву."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết hợp tìm kiếm nhúng cục bộ với kết quả web để tìm kho đã gắn sao theo ý nghĩa, không chỉ từ khóa—hữu ích khi bạn nhớ ý tưởng nhưng không nhớ tên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地向量检索叠加网页结果，按含义而不是关键词找回 Star；适合只记得用途、记不清仓库名的场景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結合本地嵌入搜尋與網頁結果，依意義而非關鍵字找回已加星號的儲存庫——當你記得用途但忘了名稱時特別有用。"
          }
        }
      }
    },
