    },
    "settings.pro.benefit.search.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine local embedding search with web results to find starred repos by meaning, not just keywords—useful when you remember the idea but not the name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地向量检索叠加网页结果，按含义而不是关键词找回 Star；适合只记得用途、记不清仓库名的场景。"
          }
        }
      }
    },
