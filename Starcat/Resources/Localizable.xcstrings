            "value" : "The same tag cannot be both included and excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una misma etiqueta no puede estar incluida y excluida a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La même étiquette ne peut pas être à la fois incluse et exclue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag yang sama tidak dapat disertakan dan dikecualikan sekaligus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stesso tag non può essere sia incluso che escluso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じタグを含めると除外することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동일한 태그를 포함과 제외에 동시에 설정할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezelfde tag kan niet zowel worden opgenomen als uitgesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten sam tag nie może być jednocześnie uwzględniony i wykluczony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesma tag não pode ser incluída e excluída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один и тот же тег не может быть одновременно включён и исключён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı etiket hem dahil hem hariç tutulamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один і той самий тег не може бути одночасно включеним і виключеним."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể vừa bao gồm vừa loại trừ cùng một thẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一标签不能同时出现在包含与排除列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一標籤不能同時出現在包含與排除列表。"
          }
        }
      }
    },
    "smartCollections.editor.validation.updatedConflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تعيين كل من \"تم التحديث خلال\" و\"تم التحديث منذ أكثر من\" معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiert innerhalb und aktualisiert älter als können nicht beide gesetzt sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updated within and updated older than cannot both be set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden establecer a la vez «Actualizado en los últimos» y «Actualizado hace más de»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis à jour depuis et mis à jour depuis plus de ne peuvent pas être définis ensemble."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperbarui dalam dan diperbarui lebih lama dari tidak dapat diatur bersamaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è possibile impostare sia 'Aggiornato entro' che 'Aggiornato da più di'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新日時「以内」と「より前」は同時に設定できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 기간과 업데이트 이전 기간을 동시에 설정할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijgewerkt binnen en bijgewerkt ouder dan kunnen niet beide worden ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizowano w ciągu i zaktualizowano dawniej niż nie mogą być ustawione jednocześnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizado nos últimos e atualizado há mais de não podem ser definidos ao mesmo tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нельзя одновременно задать «обновлено в течение» и «обновлено старше»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellenen ve güncellenenden eski aynı anda ayarlanamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можна одночасно встановити «Оновлено протягом» і «Оновлено більше ніж»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đặt đồng thời 'đã cập nhật trong' và 'đã cập nhật lâu hơn'."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近更新」与「长期未更新」不能同时设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近更新」與「長期未更新」不能同時設定。"
          }
        }
      }
    },
