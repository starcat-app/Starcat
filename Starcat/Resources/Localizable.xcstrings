      }
    },
    "rag.workspace.inspector.plan.help.contextBudget.field.reservedOutput" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإخراج المحجوز: رموز مخصصة لرد النموذج؛ لا تُحتسب في نسبة الاستخدام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservierte Ausgabe: Tokens, die für die Modellantwort zurückgehalten werden; nicht im Nutzungsprozentsatz enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserved output: tokens set aside for the model reply; not counted in the usage percentage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salida reservada: tokens reservados para la respuesta del modelo; no se cuentan en el porcentaje de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortie réservée : jetons réservés pour la réponse du modèle ; non comptés dans le pourcentage d'utilisation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluaran yang dicadangkan: token yang disisihkan untuk balasan model; tidak dihitung dalam persentase penggunaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Output riservato: token riservati per la risposta del modello; non conteggiati nella percentuale di utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予約出力: モデルの応答用に確保されたトークン。使用率にはカウントされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예약된 출력: 모델 응답을 위해 할당된 토큰으로, 사용 비율에 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gereserveerde uitvoer: tokens die zijn gereserveerd voor het modelantwoord; niet meegeteld in het gebruikspercentage."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarezerwowane wyjście: tokeny przeznaczone na odpowiedź modelu; nie wliczane do procentu użycia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saída reservada: tokens reservados para a resposta do modelo; não contam na porcentagem de uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарезервированный вывод: токены, отведённые для ответа модели; не учитываются в процентах использования."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrılmış çıktı: model yanıtı için ayrılan token'lar; kullanım yüzdesine dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарезервоване виведення: токени, відведені для відповіді моделі; не враховуються у відсотку використання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu ra dự trữ: token dành riêng cho phản hồi của mô hình; không được tính vào tỷ lệ sử dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预留输出：为模型回答保留的分片；不计入顶部占用百分比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預留輸出：為模型回答保留的分片；不計入頂部佔用百分比。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.contextBudget.field.segments" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجزاء الإدخال: النظام، السجل، السؤال، الأدلة، المحتوى البعيد، والمرفقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingabeabschnitte: System, Verlauf, Frage, Belege, Remote-Inhalte und Anhänge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input segments: system, history, question, evidence, remote content, and attachments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segmentos de entrada: sistema, historial, pregunta, evidencia, contenido remoto y archivos adjuntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
