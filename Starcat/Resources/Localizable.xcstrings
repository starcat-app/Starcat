      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Run starcat pair --stdin, paste the copied five-minute URI, then press Control-D. Approve the device in Starcat." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "运行 starcat pair --stdin，粘贴复制的五分钟 URI，再按 Control-D，最后在 Starcat 中确认设备。" } }
      }
    },
