    "settings.general.shortcuts.configuration.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a shortcut to record it. Disabled shortcuts keep their saved key and still participate in conflict checks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击快捷键即可录制；关闭后仍会保留键位并参与冲突检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊快捷鍵即可錄製。停用的快捷鍵仍會保留按鍵設定，並參與衝突檢查。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットをクリックして記録します。無効にしたショートカットは保存されたキーを保持し、競合チェックの対象となります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 클릭하여 기록하세요. 비활성화된 단축키는 저장된 키를 유지하며 충돌 검사에 계속 참여합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf eine Tastenkombination, um sie aufzuzeichnen. Deaktivierte Tastenkombinationen behalten ihre gespeicherte Taste und nehmen weiterhin an Konfliktprüfungen teil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un raccourci pour l'enregistrer. Les raccourcis désactivés conservent leur touche enregistrée et participent toujours aux vérifications de conflits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en un atajo para grabarlo. Los atajos desactivados conservan su tecla guardada y siguen participando en las comprobaciones de conflictos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em um atalho para gravá‑lo. Atalhos desativados mantêm a tecla salva e ainda participam da verificação de conflitos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una scorciatoia per registrarla. Le scorciatoie disabilitate mantengono il tasto salvato e partecipano comunque ai controlli di conflitto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите сочетание клавиш, чтобы записать его. Отключённые сочетания сохраняют назначенную клавишу и по-прежнему участвуют в проверке конфликтов."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op een sneltoets om deze op te nemen. Uitgeschakelde sneltoetsen behouden hun opgeslagen toets en doen nog steeds mee aan conflictencontroles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij skrót, aby go nagrać. Wyłączone skróty zachowują zapisany klawisz i nadal uczestniczą w sprawdzaniu konfliktów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть комбінацію, щоб записати її. Вимкнені комбінації зберігають призначену клавішу та беруть участь у перевірці конфліктів."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kısayola tıklayarak kaydedin. Devre dışı bırakılan kısayollar kaydedilmiş tuşlarını korur ve çakışma kontrollerine katılmaya devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp vào một phím tắt để ghi lại. Các phím tắt bị vô hiệu hóa vẫn giữ phím đã lưu và vẫn tham gia kiểm tra xung đột."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik pintasan untuk merekamnya. Pintasan yang dinonaktifkan tetap menyimpan tombol yang disimpan dan tetap berpartisipasi dalam pemeriksaan konflik."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على اختصار لتسجيله. الاختصارات المعطلة تحتفظ بمفتاحها المحفوظ وتظل مشاركة في فحوصات التعارض."
          }
        }
      }
    },
    "settings.general.shortcuts.enabled.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disables keyboard triggers only. Menus, buttons, and AI message sending remain available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅停用键盘触发；菜单、按钮和 AI 消息发送不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅停用鍵盤觸發。選單、按鈕和 AI 訊息發送仍可使用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードトリガーのみを無効にします。メニュー、ボタン、AIメッセージ送信は引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 트리거만 비활성화합니다. 메뉴, 버튼 및 AI 메시지 전송은 계속 사용할 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviert nur Tastaturauslöser. Menüs, Schaltflächen und das Senden von KI-Nachrichten bleiben verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactive uniquement les déclencheurs clavier. Les menus, boutons et l'envoi de messages IA restent disponibles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva solo los disparadores de teclado. Los menús, botones y el envío de mensajes de IA siguen disponibles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativa apenas os acionadores de teclado. Menus, botões e envio de mensagens por IA permanecem disponíveis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabilita solo i trigger da tastiera. Menu, pulsanti e invio messaggi AI rimangono disponibili."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключает только клавиатурные триггеры. Меню, кнопки и отправка сообщений ИИ остаются доступными."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt alleen toetsenbordtriggers uit. Menu's, knoppen en het verzenden van AI-berichten blijven beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącza tylko wyzwalacze klawiaturowe. Menu, przyciski i wysyłanie wiadomości AI pozostają dostępne."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимикає лише клавіатурні тригери. Меню, кнопки та надсилання повідомлень ШІ залишаються доступними."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca klavye tetikleyicilerini devre dışı bırakır. Menüler, düğmeler ve AI mesaj gönderme işlemleri kullanılabilir durumda kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ vô hiệu hóa kích hoạt bàn phím. Menu, nút và gửi tin nhắn AI vẫn khả dụng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya menonaktifkan pemicu keyboard. Menu, tombol, dan pengiriman pesan AI tetap tersedia."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعطل مشغلات لوحة المفاتيح فقط. تظل القوائم والأزرار وإرسال رسائل الذكاء الاصطناعي متاحة."
          }
