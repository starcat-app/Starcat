    "githubStarLists.error.orgOAuthRestricted.adminOption" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only organization members or outside collaborators may be able to request app approval."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有组织成员或外部协作者才可能申请 App 授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有組織成員或外部協作者才能申請應用程式授權。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組織メンバーまたは外部コラボレーターのみがアプリの承認をリクエストできる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조직 구성원이나 외부 협력자만 앱 승인을 요청할 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Organisationsmitglieder oder externe Mitarbeiter können möglicherweise die App-Zulassung beantragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les membres de l'organisation ou les collaborateurs externes peuvent demander l'approbation de l'application."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que solo los miembros de la organización o colaboradores externos puedan solicitar la aprobación de la aplicación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente membros da organização ou colaboradores externos podem solicitar aprovação do aplicativo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo i membri dell'organizzazione o i collaboratori esterni potrebbero poter richiedere l'approvazione dell'app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только участники организации или внешние соавторы могут запросить одобрение приложения."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen organisatieleden of externe medewerkers kunnen mogelijk app-goedkeuring aanvragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko członkowie organizacji lub zewnętrzni współpracownicy mogą być w stanie poprosić o zatwierdzenie aplikacji."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише учасники організації або зовнішні співробітники можуть подати запит на схвалення застосунку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca kuruluş üyeleri veya dış işbirlikçiler uygulama onayı talep edebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ thành viên tổ chức hoặc cộng tác viên bên ngoài mới có thể yêu cầu phê duyệt ứng dụng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya anggota organisasi atau kolaborator luar yang mungkin dapat meminta persetujuan aplikasi."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يتمكن أعضاء المؤسسة أو المتعاونون الخارجيون فقط من طلب الموافقة على التطبيق."
          }
        }
      }
    },
