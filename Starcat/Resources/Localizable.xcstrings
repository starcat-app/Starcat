          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove tutti gli eventi seguiti da questo dispositivo. Possono essere recuperati di nuovo con un aggiornamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все события подписок с этого устройства. Их можно будет загрузить снова при обновлении."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert alle volgende gebeurtenissen van dit apparaat. Ze kunnen opnieuw worden opgehaald bij vernieuwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie wszystkich zdarzeń obserwowanych z tego urządzenia. Można je ponownie pobrać po odświeżeniu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить усі події відстеження з цього пристрою. Їх можна буде завантажити знову після оновлення."
