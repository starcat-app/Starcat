    "rag.workspace.inspector.plan.help.questionUnderstanding.definition.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Planner model's interpretation of your question before retrieval runs. It shows what Starcat believes you are asking and how it will search semantically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检索执行前，Planner 模型对你问题的理解结果：展示 Starcat 认为你在问什么，以及将如何改写为语义检索。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.questionUnderstanding.definition.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is question understanding?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题理解是什么？"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.questionUnderstanding.field.originalQuestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original question: the text you sent from Composer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始问题：你在 Composer 发送的原文。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.questionUnderstanding.field.planningNotes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan notes: short AI-generated explanations (up to 3) of what Starcat will do next."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规划说明：Planner 生成的简短说明（最多 3 条），描述接下来打算做什么。"
          }
        }
      }
    },
    "rag.workspace.inspector.plan.help.questionUnderstanding.field.semanticQuery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantic query: Planner-rewritten keywords used for vector and keyword retrieval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语义查询：Planner 改写后的检索词，用于向量与关键词召回。"
          }
        }
      }
    },
