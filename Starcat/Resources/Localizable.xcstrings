          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrar 3-5 alternativas mais ativas semelhantes ao repositório atual e gerar uma tabela de comparação."
          }
        },
        "it" : {
          "stringUnit" : {
