    "rag.workspace.error.timeout.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service took too long to respond. Try again in a moment; your question is still preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务响应超时，请稍后重试；你的问题已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務回應逾時，請稍後重試；你的問題已保留。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスの応答がタイムアウトしました。しばらくしてからもう一度お試しください。質問は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스 응답 시간이 너무 오래 걸렸습니다. 잠시 후 다시 시도하세요. 질문은 그대로 유지됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat zu lange für eine Antwort gebraucht. Versuchen Sie es in einem Moment erneut; Ihre Frage bleibt erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service a mis trop de temps à répondre. Réessayez dans un instant ; votre question est toujours conservée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio tardó demasiado en responder. Intente de nuevo en un momento; su pregunta aún se conserva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço demorou muito para responder. Tente novamente em instantes; sua pergunta ainda está preservada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio ha impiegato troppo tempo per rispondere. Riprova tra un momento; la tua domanda è ancora conservata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба слишком долго отвечала. Повторите попытку через некоторое время; ваш вопрос сохранён."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De service reageerde te langzaam. Probeer het later opnieuw; je vraag blijft behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa nie odpowiedziała na czas. Spróbuj ponownie za chwilę; twoje pytanie jest nadal zachowane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба надто довго відповідала. Спробуйте ще раз за хвилину; ваше запитання збережено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servis yanıt vermek için çok uzun sürdü. Bir süre sonra tekrar deneyin; sorunuz hâlâ korunuyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ mất quá nhiều thời gian để phản hồi. Thử lại sau; câu hỏi của bạn vẫn được giữ nguyên."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan terlalu lama merespons. Coba lagi sebentar; pertanyaan Anda tetap tersimpan."
