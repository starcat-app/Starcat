    "explore.help.trending.cache.update" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: after expiry, Starcat shows the existing ranking first and refreshes it in the background. Manual refresh requests the latest data immediately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新方式：过期后先显示已有榜单，同时在后台更新；手动刷新会立即请求最新数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新方式：過期後先顯示現有排名，同時在背景更新；手動重新整理會立即請求最新資料。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新：期限切れ後、Starcatは既存のランキングを最初に表示し、バックグラウンドで更新します。手動更新は即座に最新データを要求します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트: 만료 후 Starcat는 기존 순위를 먼저 표시하고 백그라운드에서 새로고침합니다. 수동 새로고침은 즉시 최신 데이터를 요청합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: Nach Ablauf zeigt Starcat zuerst die vorhandene Rangliste an und aktualisiert sie im Hintergrund. Manuelles Aktualisieren fordert sofort die neuesten Daten an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise à jour : après expiration, Starcat affiche d'abord le classement existant et l'actualise en arrière-plan. Une actualisation manuelle demande les dernières données immédiatement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualización: después de la expiración, Starcat muestra la clasificación existente primero y la actualiza en segundo plano. La actualización manual solicita los datos más recientes de inmediato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualização: após expirar, o Starcat mostra o ranking existente primeiro e o atualiza em segundo plano. A atualização manual solicita os dados mais recentes imediatamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornamento: dopo la scadenza, Starcat mostra prima la classifica esistente e la aggiorna in background. L'aggiornamento manuale richiede immediatamente i dati più recenti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновление: после истечения срока Starcat сначала показывает существующий рейтинг и обновляет его в фоне. Ручное обновление запрашивает последние данные немедленно."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update: na vervaldatum toont Starcat eerst de bestaande ranglijst en ververst deze op de achtergrond. Handmatig vernieuwen vraagt direct de nieuwste gegevens op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja: po wygaśnięciu Starcat najpierw pokazuje istniejący ranking i odświeża go w tle. Ręczne odświeżenie natychmiast pobiera najnowsze dane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення: після закінчення терміну дії Starcat спочатку показує існуючий рейтинг і оновлює його у фоновому режимі. Ручне оновлення негайно запитує останні дані."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme: süre dolduktan sonra Starcat önce mevcut sıralamayı gösterir ve arka planda yeniler. Manuel yenileme en son verileri hemen ister."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cập nhật: sau khi hết hạn, Starcat hiển thị bảng xếp hạng hiện có trước và làm mới nó trong nền. Làm mới thủ công sẽ yêu cầu dữ liệu mới nhất ngay lập tức."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan: setelah kedaluwarsa, Starcat menampilkan peringkat yang ada terlebih dahulu dan menyegarkannya di latar belakang. Penyegaran manual langsung meminta data terbaru."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحديث: بعد انتهاء الصلاحية، يعرض Starcat الترتيب الحالي أولاً ويقوم بتحديثه في الخلفية. التحديث اليدوي يطلب أحدث البيانات فورًا."
          }
        }
      }
    },
