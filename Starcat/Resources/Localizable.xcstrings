    "repo.notesPlaceholder" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب بعض الملاحظات، مثلاً: لماذا أضفتها للمفضلة، متى تعيد استخدامها، عيوب…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreiben Sie Notizen, z. B.: warum Sie es mit einem Stern markiert haben, wann Sie es wiederverwenden, Fallstricke…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write some notes, e.g.: why you starred it, when to reuse it, pitfalls…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe algunas notas, p. ej.: por qué le diste estrella, cuándo reutilizarlo, problemas…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez quelques notes, par exemple : pourquoi vous l'avez ajouté aux favoris, quand le réutiliser, les pièges…"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis beberapa catatan, misalnya: mengapa Anda membintanginya, kapan menggunakannya kembali, kendala…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi alcune note, ad esempio: perché l'hai aggiunto alle stelle, quando riutilizzarlo, insidie…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモを書いてください（例：スターを付けた理由、再利用するタイミング、注意点など）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노트를 작성하세요 (예: 별표한 이유, 재사용 시기, 주의사항 등)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf wat notities, bijv.: waarom je een ster gaf, wanneer het opnieuw te gebruiken, valkuilen…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz notatki, np.: dlaczego dodałeś gwiazdkę, kiedy ponownie użyć, pułapki…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva algumas notas, ex.: por que você favoritou, quando reutilizar, armadilhas…"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите заметки, например: зачем вы добавили в звёзды, когда использовать повторно, подводные камни…"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı notlar yazın, örn: neden yıldızladığınız, ne zaman tekrar kullanacağınız, tuzaklar…"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишіть нотатки, наприклад: чому ви додали в зірки, коли використовувати, підводні камені…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viết vài ghi chú, ví dụ: tại sao bạn gắn sao, khi nào dùng lại, các cạm bẫy…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写点笔记，例如：为什么 star 它、何时复用、踩过哪些坑…"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫點筆記，例如：為什麼 star 它、何時復用、踩過哪些坑…"
          }
        }
      }
    },
