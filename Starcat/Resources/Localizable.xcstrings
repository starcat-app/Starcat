    "about.privacy.whatWeStore.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub OAuth tokens, repo cache, tags, private notes, and reading status. In MVP stage, these data are stored locally."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub OAuth token、仓库缓存、标签、私有笔记和阅读状态。MVP 阶段这些数据保存在本机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub OAuth token、倉庫快取、標籤、私人筆記和閱讀狀態。MVP 階段這些資料儲存在本機。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub OAuthトークン、リポジトリキャッシュ、タグ、プライベートノート、および読書ステータス。MVP段階では、これらのデータはローカルに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub OAuth 토큰, 저장소 캐시, 태그, 개인 노트 및 읽기 상태. MVP 단계에서는 이러한 데이터가 로컬에 저장됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub-OAuth-Tokens, Repository-Cache, Tags, private Notizen und Lesestatus. In der MVP-Phase werden diese Daten lokal gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetons OAuth GitHub, cache des dépôts, tags, notes privées et statut de lecture. Au stade MVP, ces données sont stockées localement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens de OAuth de GitHub, caché de repositorios, etiquetas, notas privadas y estado de lectura. En la etapa MVP, estos datos se almacenan localmente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens OAuth do GitHub, cache de repositórios, tags, notas privadas e status de leitura. Na fase MVP, esses dados são armazenados localmente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token OAuth di GitHub, cache dei repository, tag, note private e stato di lettura. Nella fase MVP, questi dati sono memorizzati localmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токены OAuth GitHub, кэш репозиториев, теги, личные заметки и статус чтения. На этапе MVP эти данные хранятся локально."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub OAuth-tokens, repo-cache, tags, privénotities en leesstatus. In de MVP-fase worden deze gegevens lokaal opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeny OAuth GitHub, pamięć podręczna repozytoriów, tagi, prywatne notatki i status czytania. Na etapie MVP dane te są przechowywane lokalnie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токени OAuth GitHub, кеш репозиторіїв, теги, приватні нотатки та статус читання. На етапі MVP ці дані зберігаються локально."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub OAuth token'ları, depo önbelleği, etiketler, özel notlar ve okuma durumu. MVP aşamasında bu veriler yerel olarak depolanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token OAuth GitHub, bộ nhớ đệm kho lưu trữ, thẻ, ghi chú riêng tư và trạng thái đọc. Trong giai đoạn MVP, dữ liệu này được lưu trữ cục bộ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token OAuth GitHub, cache repositori, tag, catatan pribadi, dan status bacaan. Pada tahap MVP, data ini disimpan secara lokal."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز OAuth لـ GitHub، وذاكرة التخزين المؤقت للمستودع، والوسوم، والملاحظات الخاصة، وحالة القراءة. في مرحلة MVP، تُخزن هذه البيانات محلياً."
          }
        }
      }
    },
