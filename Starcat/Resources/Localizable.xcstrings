          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存有效期：3 小时，与热门、新发布共享同一份项目目录缓存。"
          }
        }
      }
    },
    "explore.help.discover.cache.update": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update: Starcat uses the local cache while it is valid and fetches the latest project catalog after it expires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新方式：有效期内优先读取本地缓存；过期后重新获取最新项目目录。"
          }
        }
      }
    },
