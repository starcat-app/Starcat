    "settings.mcp.agentSetup.pair.agent.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give an AI agent a five-minute, single-use pairing command and wait for approval in Starcat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 AI Agent 提供五分钟、单次有效的配对命令，并等待在 Starcat 中确认设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 AI Agent 提供五分鐘、單次有效的配對命令，並等待在 Starcat 中確認裝置。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIエージェントに5分間有効な使い捨てのペアリングコマンドを渡し、Starcatでの承認を待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 에이전트에게 5분 동안 유효한 일회용 페어링 명령을 제공하고 Starcat에서 승인을 기다리세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie einem KI-Agenten einen fünfminütigen, einmaligen Pairing-Befehl und warten Sie auf die Genehmigung in Starcat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à un agent IA une commande d'appairage à usage unique de cinq minutes et attendez l'approbation dans Starcat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a un agente de IA un comando de emparejamiento de un solo uso de cinco minutos y espera la aprobación en Starcat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forneça a um agente de IA um comando de emparelhamento de uso único de cinco minutos e aguarde a aprovação no Starcat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornisci a un agente AI un comando di abbinamento monouso di cinque minuti e attendi l'approvazione in Starcat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте ИИ-агенту одноразовую команду сопряжения на пять минут и дождитесь подтверждения в Starcat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef een AI-agent een eenmalige koppelingsopdracht van vijf minuten en wacht op goedkeuring in Starcat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekaż agentowi AI jednorazowe polecenie parowania ważne pięć minut i poczekaj na zatwierdzenie w Starcat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте AI-агенту одноразову команду сполучення на п'ять хвилин і зачекайте підтвердження в Starcat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yapay zeka aracısına beş dakikalık, tek kullanımlık bir eşleme komutu verin ve Starcat'ta onay bekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cung cấp cho tác nhân AI lệnh ghép nối dùng một lần trong năm phút và chờ phê duyệt trong Starcat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan agen AI perintah pemasangan sekali pakai selama lima menit dan tunggu persetujuan di Starcat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح وكيل الذكاء الاصطناعي أمر اقتران للاستخدام مرة واحدة لمدة خمس دقائق وانتظر الموافقة في Starcat."
          }
        }
      }
    },
