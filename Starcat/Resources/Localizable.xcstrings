          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプロバイダーが認証情報を拒否しました。AI設定でAPIキーを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 제공자가 자격 증명을 거부했습니다. AI 설정에서 API 키를 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
