    "rag.workspace.debug.retrieval.funnel.semanticFormat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantic matches: %1$lld found, %2$lld excluded by source settings, %3$lld below the similarity threshold, %4$lld kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语义匹配：找到 %1$lld 条，因来源设置排除 %2$lld 条，低于相似度阈值排除 %3$lld 条，保留 %4$lld 条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語意匹配：找到 %1$lld 條，因來源設定排除 %2$lld 條，低於相似度閾值排除 %3$lld 條，保留 %4$lld 條。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セマンティック一致: %1$lld 件見つかり、%2$lld 件がソース設定で除外、%3$lld 件が類似度しきい値未満、%4$lld 件が保持されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의미 일치: %1$lld개 발견, %2$lld개 출처 설정에서 제외, %3$lld개 유사도 임계값 미만, %4$lld개 유지."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantische Treffer: %1$lld gefunden, %2$lld durch Quelleinstellungen ausgeschlossen, %3$lld unter dem Ähnlichkeitsschwellenwert, %4$lld behalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspondances sémantiques : %1$lld trouvées, %2$lld exclues par les paramètres de source, %3$lld en dessous du seuil de similarité, %4$lld conservées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincidencias semánticas: %1$lld encontradas, %2$lld excluidas por configuración de fuente, %3$lld por debajo del umbral de similitud, %4$lld conservadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspondências semânticas: %1$lld encontradas, %2$lld excluídas pelas configurações de fonte, %3$lld abaixo do limite de similaridade, %4$lld mantidas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrispondenze semantiche: %1$lld trovate, %2$lld escluse dalle impostazioni della fonte, %3$lld sotto la soglia di similarità, %4$lld mantenute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семантические совпадения: найдено %1$lld, исключено настройками источника %2$lld, ниже порога схожести %3$lld, оставлено %4$lld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantische overeenkomsten: %1$lld gevonden, %2$lld uitgesloten door broninstellingen, %3$lld onder de overeenkomstdrempel, %4$lld behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowania semantyczne: %1$lld znaleziono, %2$lld wykluczono przez ustawienia źródła, %3$lld poniżej progu podobieństwa, %4$lld zachowano."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семантичні збіги: знайдено %1$lld, виключено %2$lld налаштуваннями джерела, %3$lld нижче порогу подібності, залишено %4$lld."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamsal eşleşmeler: %1$lld bulundu, %2$lld kaynak ayarlarıyla hariç tutuldu, %3$lld benzerlik eşiğinin altında, %4$lld korundu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khớp ngữ nghĩa: %1$lld tìm thấy, %2$lld bị loại bởi cài đặt nguồn, %3$lld dưới ngưỡng tương đồng, %4$lld được giữ lại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecocokan semantik: %1$lld ditemukan, %2$lld dikecualikan oleh pengaturan sumber, %3$lld di bawah ambang kemiripan, %4$lld disimpan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطابقات الدلالية: %1$lld تم العثور عليها، %2$lld مستبعدة بواسطة إعدادات المصدر، %3$lld أقل من حد التشابه، %4$lld محفوظة."
          }
        }
      }
    },
