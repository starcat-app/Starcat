    "error.user.aiProvider.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على %@ الإكمال لأن %@ أعاد استجابة غير متوقعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht abgeschlossen werden, da %@ eine unerwartete Antwort zurückgegeben hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not complete because %@ returned an unexpected response."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
