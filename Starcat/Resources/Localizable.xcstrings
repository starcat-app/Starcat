    "settings.pro.benefit.repoContext.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح RepoContextPacker وCodeFlow وسير عمل سياق قاعدة الشيفرة لتبقى إجابات AI مبنية على شجرة المصدر الفعلية للمستودع الذي تشاهده."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepoContextPacker, CodeFlow und Codebase-Kontext-Workflows freischalten, damit KI-Antworten im tatsächlichen Quellbaum des angezeigten Repositorys verankert bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock RepoContextPacker, CodeFlow, and codebase-context workflows so AI answers stay grounded in the actual source tree of the repo you are viewing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea RepoContextPacker, CodeFlow y flujos de trabajo de contexto de código base para que las respuestas de IA se mantengan fundamentadas en el árbol fuente real del repositorio que estás viendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquez RepoContextPacker, CodeFlow et les flux de travail de contexte de code source pour que les réponses IA restent ancrées dans l'arborescence réelle du dépôt que vous consultez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka kunci RepoContextPacker, CodeFlow, dan alur kerja konteks basis kode sehingga jawaban AI tetap berdasarkan pohon sumber repositori yang Anda lihat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca RepoContextPacker, CodeFlow e flussi di lavoro basati sul contesto del codice in modo che le risposte AI rimangano ancorate all'albero sorgente effettivo del repository che stai visualizzando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepoContextPacker、CodeFlow、コードベースコンテキストワークフローを有効にし、AI回答を表示中のリポジトリの実際のソースツリーに基づかせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepoContextPacker, CodeFlow 및 코드베이스 컨텍스트 워크플로를 잠금 해제하여 AI 답변이 현재 보고 있는 저장소의 실제 소스 트리에 기반하도록 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel RepoContextPacker, CodeFlow en codebase-context-workflows zodat AI-antwoorden gebaseerd blijven op de daadwerkelijke bronboom van de repository die u bekijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuj RepoContextPacker, CodeFlow i przepływy pracy związane z kontekstem bazy kodu, aby odpowiedzi AI pozostały osadzone w rzeczywistym drzewie źródłowym przeglądanego repozytorium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie RepoContextPacker, CodeFlow e fluxos de contexto de base de código para que as respostas da IA permaneçam fundamentadas na árvore de código real do repositório que você está visualizando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разблокируйте RepoContextPacker, CodeFlow и процессы контекста кодовой базы, чтобы ответы AI оставались привязанными к реальному дереву исходного кода просматриваемого репозитория."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RepoContextPacker, CodeFlow ve kod tabanı bağlam iş akışlarının kilidini açın, böylece AI yanıtları görüntülediğiniz deponun gerçek kaynak ağacına dayanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розблокуйте RepoContextPacker, CodeFlow та робочі процеси контексту кодової бази, щоб відповіді AI базувалися на актуальному дереві вихідного коду репозиторію, який ви переглядаєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở khóa RepoContextPacker, CodeFlow và quy trình làm việc ngữ cảnh mã nguồn để câu trả lời AI luôn dựa trên cây mã nguồn thực tế của kho bạn đang xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁 RepoContextPacker、CodeFlow 与仓库上下文工作流，让 AI 回答贴着当前仓库的真实源码结构展开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解鎖 RepoContextPacker、CodeFlow 與程式碼庫上下文工作流程，讓 AI 回答緊貼當前檢視的儲存庫實際原始碼結構。"
          }
        }
      }
    },
