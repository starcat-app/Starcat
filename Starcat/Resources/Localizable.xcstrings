        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APIキーはこのMac上で安全に保存されます。テストによりプロバイダの検索リクエストが1回消費される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
