    "settings.mcp.localAPIKey.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP uses the shared Local API Key from Settings > Integrations > Local API Key. Rotating that key invalidates existing MCP client configs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 使用「设置 → 集成 → 本地 API Key」中的共享 key。刷新该 key 后，已有 MCP 客户端配置会失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 使用「設定 > 整合 > 本地 API Key」中的共用 Local API Key。輪換該金鑰會使現有 MCP 用戶端設定失效。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCPは設定 > 統合 > ローカルAPIキーの共有ローカルAPIキーを使用します。そのキーをローテーションすると、既存のMCPクライアント設定が無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP는 설정 > 통합 > 로컬 API 키의 공유 로컬 API 키를 사용합니다. 해당 키를 교체하면 기존 MCP 클라이언트 구성이 무효화됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP verwendet den gemeinsamen lokalen API-Schlüssel aus Einstellungen > Integrationen > Lokaler API-Schlüssel. Das Rotieren dieses Schlüssels macht bestehende MCP-Client-Konfigurationen ungültig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP utilise la clé API locale partagée depuis Réglages > Intégrations > Clé API locale. La rotation de cette clé invalide les configurations MCP client existantes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP usa la clave API local compartida de Ajustes > Integraciones > Clave API local. Rotar esa clave invalida las configuraciones existentes del cliente MCP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MCP usa a Chave de API Local compartilhada de Ajustes > Integrações > Chave de API Local. Rotacionar essa chave invalida as configurações existentes do cliente MCP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP utilizza la chiave API locale condivisa da Impostazioni > Integrazioni > Chiave API locale. La rotazione di quella chiave invalida le configurazioni esistenti del client MCP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP использует общий локальный API-ключ из Настроек > Интеграции > Локальный API-ключ. Смена ключа делает недействительными существующие конфигурации MCP-клиентов."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP gebruikt de gedeelde lokale API-sleutel uit Instellingen > Integraties > Lokale API-sleutel. Het roteren van die sleutel maakt bestaande MCP-clientconfiguraties ongeldig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP używa współdzielonego lokalnego klucza API z Ustawienia > Integracje > Lokalny klucz API. Obrót tego klucza unieważnia istniejące konfiguracje klienta MCP."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP використовує спільний локальний API-ключ з Налаштування > Інтеграції > Локальний API-ключ. Зміна цього ключа анулює існуючі конфігурації MCP-клієнтів."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP, Ayarlar > Entegrasyonlar > Yerel API Anahtarı'ndaki paylaşılan Yerel API Anahtarını kullanır. Bu anahtarı döndürmek, mevcut MCP istemci yapılandırmalarını geçersiz kılar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP sử dụng Khóa API cục bộ được chia sẻ từ Cài đặt > Tích hợp > Khóa API cục bộ. Xoay khóa đó sẽ vô hiệu hóa cấu hình ứng dụng khách MCP hiện có."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP menggunakan Kunci API Lokal bersama dari Pengaturan > Integrasi > Kunci API Lokal. Memutar kunci itu membatalkan konfigurasi klien MCP yang ada."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم MCP مفتاح API المحلي المشترك من الإعدادات > التكاملات > مفتاح API المحلي. يؤدي تدوير هذا المفتاح إلى إبطال تكوينات عميل MCP الحالية."
          }
        }
      }
    },
