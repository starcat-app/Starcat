    "about.brand.slogan" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your GitHub Stars into a searchable, organized, and maintainable developer knowledge base."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 GitHub Stars 变成可搜索、可整理、可长期维护的开发者知识库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 GitHub Stars 轉換為可搜尋、可整理、可長期維護的開發者知識庫。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubのスターを検索可能で整理されたメンテナブルな開発者ナレッジベースに変えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub Star를 검색 가능하고 정리된 유지 관리 가능한 개발자 지식 베이스로 전환하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwandle deine GitHub-Sterne in eine durchsuchbare, organisierte und wartbare Wissensdatenbank für Entwickler."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez vos GitHub Stars en une base de connaissances de développeur consultable, organisée et maintenable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte tus estrellas de GitHub en una base de conocimiento de desarrollador buscable, organizada y mantenible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme suas Estrelas do GitHub em uma base de conhecimento de desenvolvedor pesquisável, organizada e sustentável."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma le tue Stelle GitHub in una base di conoscenza ricercabile, organizzata e manutenibile per sviluppatori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превратите ваши звёзды GitHub в удобную, организованную и поддерживаемую базу знаний разработчика."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je GitHub-sterren om in een doorzoekbare, georganiseerde en onderhoudbare kennisbank voor ontwikkelaars."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamień swoje gwiazdki GitHub w przeszukiwalną, uporządkowaną i łatwą w utrzymaniu bazę wiedzy dla programistów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетворіть ваші зірки GitHub на пошукову, організовану та підтримувану базу знань розробника."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub Yıldızlarınızı aranabilir, düzenli ve sürdürülebilir bir geliştirici bilgi tabanına dönüştürün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biến các GitHub Stars của bạn thành một cơ sở kiến thức lập trình viên có thể tìm kiếm, sắp xếp và duy trì."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah GitHub Stars Anda menjadi basis pengetahuan pengembang yang dapat dicari, terorganisir, dan terpelihara."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حوّل نجوم GitHub إلى قاعدة معرفة للمطورين قابلة للبحث والتنظيم والصيانة."
          }
        }
      }
    },
