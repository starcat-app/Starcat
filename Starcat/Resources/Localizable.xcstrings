          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательный Bearer-токен. Хранится в связке ключей и никогда не включается в отладочные записи."
          }
        },
        "nl" : {
          "stringUnit" : {
