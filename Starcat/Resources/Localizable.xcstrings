    "settings.diagnostics.privacy.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تصميم الأرشيف لاستبعاد رموز GitHub المميزة، ومفاتيح API، ومطالبات الذكاء الاصطناعي، ونصوص README، والملاحظات الخاصة. قد يتضمن أسماء الخدمات، ورموز الحالة، وأسماء المستودعات الكاملة، ومسارات الملفات المحلية، وملخصات الأخطاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv wurde so konzipiert, dass es GitHub-Tokens, API-Schlüssel, KI-Eingabeaufforderungen, README-Inhalte und private Notizen ausschließt. Es kann Dienstnamen, Statuscodes, vollständige Repository-Namen, lokale Dateipfade und Fehlerzusammenfassungen enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive is designed to exclude GitHub tokens, API keys, AI prompts, README bodies, and private notes. It may include service names, status codes, repository full names, local file paths, and error summaries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo está diseñado para excluir tokens de GitHub, claves API, indicaciones de IA, cuerpos de README y notas privadas. Puede incluir nombres de servicio, códigos de estado, nombres completos de repositorio, rutas de archivos locales y resúmenes de errores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archive est conçue pour exclure les jetons GitHub, les clés API, les invites IA, les contenus README et les notes privées. Elle peut inclure les noms de services, les codes d'état, les noms complets de dépôts, les chemins de fichiers locaux et les résumés d'erreurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arsip dirancang untuk mengecualikan token GitHub, kunci API, prompt AI, isi README, dan catatan pribadi. Arsip mungkin menyertakan nama layanan, kode status, nama lengkap repositori, jalur file lokal, dan ringkasan kesalahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archivio è progettato per escludere token GitHub, chiavi API, prompt AI, corpi README e note private. Può includere nomi di servizi, codici di stato, nomi completi dei repository, percorsi di file locali e riepiloghi di errori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブはGitHubトークン、APIキー、AIプロンプト、README本文、プライベートノートを除外するように設計されています。サービス名、ステータスコード、リポジトリのフルネーム、ローカルファイルパス、エラー概要が含まれる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아카이브는 GitHub 토큰, API 키, AI 프롬프트, README 본문, 개인 메모를 제외하도록 설계되었습니다. 서비스 이름, 상태 코드, 저장소 전체 이름, 로컬 파일 경로, 오류 요약이 포함될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het archief is ontworpen om GitHub-tokens, API-sleutels, AI-prompts, README-teksten en privénotities uit te sluiten. Het kan servicenamen, statuscodes, volledige repositorynamen, lokale bestandspaden en foutsamenvattingen bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiwum zostało zaprojektowane tak, aby wykluczać tokeny GitHub, klucze API, podpowiedzi AI, treści README i prywatne notatki. Może zawierać nazwy usług, kody statusu, pełne nazwy repozytoriów, lokalne ścieżki plików i podsumowania błędów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo foi projetado para excluir tokens do GitHub, chaves de API, prompts de IA, corpos de README e notas privadas. Pode incluir nomes de serviços, códigos de status, nomes completos de repositórios, caminhos de arquivos locais e resumos de erros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архив разработан так, чтобы исключить токены GitHub, ключи API, подсказки ИИ, содержимое README и личные заметки. Он может включать имена служб, коды состояния, полные имена репозиториев, локальные пути к файлам и сводки ошибок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşiv, GitHub token'ları, API anahtarları, AI istemleri, README içerikleri ve özel notları hariç tutacak şekilde tasarlanmıştır. Hizmet adları, durum kodları, depo tam adları, yerel dosya yolları ve hata özetlerini içerebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архів розроблено так, щоб виключити токени GitHub, ключі API, підказки ШІ, тіла README та приватні нотатки. Він може містити назви служб, коди стану, повні назви репозиторіїв, локальні шляхи до файлів та підсумки помилок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kho lưu trữ được thiết kế để loại trừ token GitHub, khóa API, lời nhắc AI, nội dung README và ghi chú riêng tư. Nó có thể bao gồm tên dịch vụ, mã trạng thái, tên đầy đủ của kho lưu trữ, đường dẫn tệp cục bộ và tóm tắt lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断包设计上不包含 GitHub token、API Key、AI prompt、README 正文和私有笔记。它可能包含服务名、状态码、仓库 full name、本地文件路径和错误摘要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断包设计上不包含 GitHub token、API Key、AI prompt、README 正文和私有笔记。它可能包含服务名、状态码、仓库 full name、本地文件路径和错误摘要。"
          }
        }
      }
    },
