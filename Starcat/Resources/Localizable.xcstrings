    "settings.storage.wiki.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki / ZRead / CodeWiki indexing status cached on disk (fully indexed: 30 days / contains uncached: 3 days). Reused across the entire chat session and toolbar wiki popover."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki / ZRead / CodeWiki 探测结果落地磁盘缓存（全部已收录 30 天 / 含未收录 3 天）。AI 对话会话期与详情页 toolbar wiki 弹层共用同一份缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki / ZRead / CodeWiki 索引狀態快取於磁碟（完全索引：30 天 / 包含未快取：3 天）。在整個聊天會話和工具列 wiki 彈出視窗中重複使用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki / ZRead / CodeWikiのインデックス状態がディスクにキャッシュされます（完全インデックス：30日 / 未キャッシュを含む：3日）。チャットセッション全体とツールバーのWikiポップオーバーで再利用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki / ZRead / CodeWiki 인덱싱 상태가 디스크에 캐시됩니다(완전 인덱싱: 30일 / 캐시되지 않은 항목 포함: 3일). 전체 채팅 세션 및 툴바 wiki 팝오버에서 재사용됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki-/ZRead-/CodeWiki-Indexierungsstatus, der auf der Festplatte zwischengespeichert wird (vollständig indiziert: 30 Tage / enthält nicht zwischengespeicherte: 3 Tage). Wird in der gesamten Chat-Sitzung und im Wiki-Popover der Symbolleiste wiederverwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statut d'indexation DeepWiki / ZRead / CodeWiki mis en cache sur le disque (entièrement indexé : 30 jours / contient du non mis en cache : 3 jours). Réutilisé dans toute la session de chat et la popover wiki de la barre d'outils."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estado de indexación de DeepWiki / ZRead / CodeWiki almacenado en caché en disco (completamente indexado: 30 días / contiene no cacheado: 3 días). Reutilizado en toda la sesión de chat y en el popover de wiki de la barra de herramientas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status de indexação DeepWiki / ZRead / CodeWiki armazenado em cache no disco (totalmente indexado: 30 dias / contém não cacheado: 3 dias). Reutilizado em toda a sessão de chat e popover wiki da barra de ferramentas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stato di indicizzazione DeepWiki / ZRead / CodeWiki memorizzato nella cache su disco (completamente indicizzato: 30 giorni / contiene non in cache: 3 giorni). Riutilizzato in tutta la sessione chat e nel popover wiki della barra degli strumenti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статус индексации DeepWiki / ZRead / CodeWiki, кешированный на диске (полностью проиндексировано: 30 дней / содержит некешированное: 3 дня). Повторно используется во всём сеансе чата и всплывающем окне Wiki на панели инструментов."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki/ZRead/CodeWiki-indexeringsstatus op schijf gecachet (volledig geïndexeerd: 30 dagen / bevat niet-gecachte: 3 dagen). Hergebruikt in de hele chatsessie en de wiki-popover van de werkbalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan indeksowania DeepWiki / ZRead / CodeWiki zapisany na dysku (w pełni zaindeksowane: 30 dni / zawiera niebuforowane: 3 dni). Ponownie używany w całej sesji czatu i wyskakującym okienku wiki na pasku narzędzi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стан індексування DeepWiki / ZRead / CodeWiki, кешований на диску (повністю проіндексовано: 30 днів / містить некешоване: 3 дні). Використовується протягом усього сеансу чату та спливаючої панелі Wiki на панелі інструментів."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepWiki / ZRead / CodeWiki dizinleme durumu diske önbelleğe alınır (tam dizinlenmiş: 30 gün / önbelleğe alınmamış içerik: 3 gün). Tüm sohbet oturumu ve araç çubuğu wiki açılır penceresi boyunca yeniden kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trạng thái lập chỉ mục DeepWiki / ZRead / CodeWiki được lưu trong bộ nhớ đệm trên đĩa (đã lập chỉ mục đầy đủ: 30 ngày / chứa chưa được lưu vào bộ nhớ đệm: 3 ngày). Được sử dụng lại trong toàn bộ phiên chat và popup wiki trên thanh công cụ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status pengindeksan DeepWiki / ZRead / CodeWiki di-cache di disk (terindeks penuh: 30 hari / berisi yang tidak di-cache: 3 hari). Digunakan kembali di seluruh sesi chat dan popover wiki toolbar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالة فهرسة DeepWiki / ZRead / CodeWiki مخزنة مؤقتًا على القرص (مفهرسة بالكامل: 30 يومًا / تحتوي على غير مخزن مؤقتًا: 3 أيام). يعاد استخدامها عبر جلسة المحادثة بأكملها ونافذة الويكي المنبثقة في شريط الأدوات."
          }
        }
      }
