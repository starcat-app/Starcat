            "value": "Exclusive identity badge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专属身份标识"
          }
        }
      }
    },
    "settings.pro.benefit.cloud.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud sync is reserved for a later Pro milestone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudKit 同步预留给后续 Pro 里程碑。"
