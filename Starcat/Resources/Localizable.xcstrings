    "onboarding.step1.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start from Trending, Weekly picks, and AI-assisted recommendations to find projects worth starring before they disappear in the feed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Trending、周刊精选和 AI 辅助推荐开始，先发现真正值得收藏的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 Trending、週刊精選和 AI 輔助推薦開始，先發現真正值得收藏的專案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレンド、週間ピック、AIアシストのおすすめから始めて、フィードで埋もれる前にスターを付ける価値のあるプロジェクトを見つけましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트렌딩, 주간 추천, AI 기반 추천을 통해 피드에서 사라지기 전에 별표할 가치가 있는 프로젝트를 찾아보세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnen Sie mit Trends, wöchentlichen Empfehlungen und KI-gestützten Vorschlägen, um Projekte zu finden, die es wert sind, markiert zu werden, bevor sie im Feed untergehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par les tendances, les sélections hebdomadaires et les recommandations assistées par IA pour trouver des projets qui méritent d'être suivis avant qu'ils ne disparaissent du fil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza desde Tendencias, Selecciones semanales y recomendaciones asistidas por IA para encontrar proyectos que merezcan una estrella antes de que desaparezcan del feed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece pelas Tendências, Seleções da Semana e recomendações com IA para encontrar projetos que valem uma estrela antes que desapareçam no feed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia da Trending, Scelte settimanali e raccomandazioni assistite dall'IA per trovare progetti degni di una stella prima che scompaiano dal feed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с трендов, еженедельных подборок и рекомендаций на основе ИИ, чтобы найти проекты, достойные звезды, прежде чем они исчезнут из ленты."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin bij Trending, Wekelijkse picks en AI-ondersteunde aanbevelingen om projecten te vinden die het waard zijn om te markeren voordat ze in de feed verdwijnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od popularnych, cotygodniowych wyborów i rekomendacji AI, aby znaleźć projekty warte oznaczenia, zanim znikną w strumieniu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почніть із популярного, щотижневих добірок та рекомендацій на основі ШІ, щоб знаходити проєкти, варті уваги, перш ніж вони зникнуть у стрічці."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trendler, Haftalık Seçkiler ve yapay zeka destekli önerilerle, akışta kaybolmadan yıldızlamaya değer projeleri keşfedin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu từ Trending, Lựa chọn hàng tuần và đề xuất hỗ trợ AI để tìm các dự án đáng gắn sao trước khi chúng biến mất khỏi nguồn cấp dữ liệu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dari Trending, Pilihan Mingguan, dan rekomendasi berbasis AI untuk menemukan proyek yang layak dibintangi sebelum menghilang dari umpan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ من الشائع، والاختيارات الأسبوعية، والتوصيات المدعومة بالذكاء الاصطناعي للعثور على مشاريع تستحق التنجيم قبل أن تختفي في الخلاصة."
          }
        }
      }
    },
