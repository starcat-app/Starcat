    "onboarding.step3.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم البحث الشامل والبحث الدلالي للعثور على المستودع الذي تتذكره بشكل غامض، حتى عندما يغيب الاسم الدقيق أو اللغة عن الذاكرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie die globale Suche und die semantische Suche, um das Repository zu finden, an das Sie sich vage erinnern, selbst wenn der genaue Name oder die Sprache nicht mehr präsent sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use global search and semantic search to find the repo you vaguely remember, even when the exact name or language is gone from memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la búsqueda global y la búsqueda semántica para encontrar el repositorio que recuerdas vagamente, incluso si el nombre exacto o el lenguaje se han ido de la memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la recherche globale et la recherche sémantique pour trouver le dépôt dont vous vous souvenez vaguement, même si le nom exact ou le langage vous échappe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan pencarian global dan pencarian semantik untuk menemukan repositori yang samar-samar Anda ingat, bahkan ketika nama atau bahasa yang tepat sudah hilang dari ingatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la ricerca globale e la ricerca semantica per trovare il repository che ricordi vagamente, anche quando il nome esatto o il linguaggio sono svaniti dalla memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グローバル検索とセマンティック検索を使用して、うろ覚えのリポジトリを正確な名前や言語を忘れても見つけられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 검색과 의미 검색을 사용하여 정확한 이름이나 언어가 기억나지 않더라도 어렴풋이 기억하는 저장소를 찾으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik globale zoekopdracht en semantisch zoeken om de repo te vinden die je vaag herinnert, zelfs als de exacte naam of taal uit je geheugen is verdwenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj wyszukiwania globalnego i semantycznego, aby znaleźć repozytorium, które pamiętasz niewyraźnie, nawet gdy dokładna nazwa lub język umknęły z pamięci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a busca global e a busca semântica para encontrar aquele repositório que você lembra vagamente, mesmo quando o nome exato ou a linguagem já não estão na memória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте глобальный и семантический поиск, чтобы найти репозиторий, который вы смутно помните, даже если точное название или язык стёрлись из памяти."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam adı veya dili hatırlamasanız bile, belli belirsiz hatırladığınız depoyu bulmak için genel arama ve anlamsal aramayı kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте глобальний пошук та семантичний пошук, щоб знайти репозиторій, який ви смутно пам'ятаєте, навіть якщо точна назва чи мова стерлися з пам'яті."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng tìm kiếm toàn cầu và tìm kiếm ngữ nghĩa để tìm kho lưu trữ bạn nhớ mơ hồ, ngay cả khi tên chính xác hoặc ngôn ngữ đã biến mất khỏi trí nhớ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用全局搜索和语义搜索找回那些只记得大概用途、却忘了名字和语言的仓库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用全域搜尋和語意搜尋找回那些只記得大概用途、卻忘了名字和語言的倉庫。"
          }
        }
      }
    },
