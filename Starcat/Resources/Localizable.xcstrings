    "ai.context.settings.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حزم كود المصدر للمستودع بصيغة XML لتغذية الذكاء الاصطناعي، بحيث يمكن للملخصات والدردشة \"رؤية الكود\". التوليد الأول يقوم بتنزيل وفك ضغط المستودع، قد يستغرق 1-3 ثوانٍ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verpackt den Quellcode des Repos als XML für KI, damit Zusammenfassungen und Chat den Code sehen können. Die erste Generation lädt das Repo herunter und entpackt es, kann 1-3 s dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pack repo source code as XML to feed AI, so summaries and chat can \"see the code\". First generation downloads and unzips the repo, may take 1-3s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empaqueta el código fuente del repositorio como XML para alimentar a la IA, de modo que los resúmenes y el chat puedan \"ver el código\". La primera generación descarga y descomprime el repositorio, puede tardar 1-3 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empaqueter le code source du dépôt en XML pour l'IA, afin que les résumés et le chat puissent « voir le code ». La première génération télécharge et décompresse le dépôt, cela peut prendre 1 à 3 secondes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemas kode sumber repositori sebagai XML untuk diumpankan ke AI, sehingga ringkasan dan obrolan dapat \"melihat kode\". Generasi pertama mengunduh dan mengekstrak repositori, mungkin memakan waktu 1-3 detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impacchetta il codice sorgente del repository come XML da fornire all'IA, in modo che riepiloghi e chat possano \"vedere il codice\". La prima generazione scarica e decomprime il repository, potrebbe richiedere 1-3 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリのソースコードをXMLにパッケージ化してAIに提供し、サマリーやチャットが「コードを参照」できるようにします。初回生成時はリポジトリをダウンロードして解凍するため、1〜3秒かかる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리포지토리 소스 코드를 XML로 패키징하여 AI에 제공하면 요약과 채팅에서 \"코드를 볼 수 있습니다\". 첫 번째 생성 시 리포지토리를 다운로드하고 압축을 풀며 1~3초가 소요될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verpak de broncode van de repo als XML om AI te voeden, zodat samenvattingen en chat de code kunnen 'zien'. Eerste generatie downloadt en pakt de repo uit, duurt 1-3 seconden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakuje kod źródłowy repozytorium jako XML do zasilania AI, aby podsumowania i czat mogły „widzieć kod”. Pierwsze generowanie pobiera i rozpakowuje repozytorium, może zająć 1–3 s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empacota o código-fonte do repositório como XML para alimentar a IA, permitindo que resumos e chat \"vejam o código\". A primeira geração baixa e descompacta o repositório, podendo levar de 1 a 3 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Упаковать исходный код репозитория в XML для передачи ИИ, чтобы сводки и чат могли «видеть код». При первом создании загружается и распаковывается репозиторий, это может занять 1–3 с."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depo kaynak kodunu AI'ya beslemek için XML olarak paketler, böylece özetler ve sohbet \"kodu görebilir\". İlk nesil depoyu indirir ve açar, 1-3 saniye sürebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакує вихідний код репозиторію як XML для подачі ШІ, щоб підсумки та чат могли «бачити код». Перше покоління завантажує та розпаковує репозиторій, може тривати 1–3 с."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng gói mã nguồn repo dưới dạng XML để cung cấp cho AI, giúp tóm tắt và chat có thể \"xem mã\". Thế hệ đầu tiên tải xuống và giải nén repo, có thể mất 1-3 giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把仓库源码打包成 XML 喂给 AI，让摘要 / 对话能「看到代码」。首次生成会下载并解压 ZIP，可能 1-3 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將倉庫原始碼打包成 XML 餵給 AI，讓摘要／對話能「看到程式碼」。首次產生會下載並解壓縮 ZIP，可能需要 1-3 秒。"
          }
        }
      }
    },
