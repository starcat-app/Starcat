    "error.user.service.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على %@ الإكمال لأن %@ غير متاح أو أعاد خطأ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht abgeschlossen werden, da %@ nicht verfügbar ist oder einen Fehler zurückgegeben hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not complete because %@ is unavailable or returned an error."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no pudo completarse porque %@ no está disponible o devolvió un error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas pu être terminé car %@ est indisponible ou a renvoyé une erreur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak dapat diselesaikan karena %@ tidak tersedia atau mengembalikan kesalahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha potuto completare perché %@ non è disponibile o ha restituito un errore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は%@が利用できないかエラーを返したため、完了できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) %@을(를) 사용할 수 없거나 오류를 반환하여 완료할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kon niet worden voltooid omdat %@ niet beschikbaar is of een fout retourneerde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie mogło zostać ukończone, ponieważ %@ jest niedostępne lub zwróciło błąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não pôde ser concluído porque %@ está indisponível ou retornou um erro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не удалось завершить, так как %@ недоступен или вернул ошибку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tamamlanamadı çünkü %@ kullanılamıyor veya bir hata döndürdü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не вдалося завершити, оскільки %@ недоступна або повернула помилку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thể hoàn thành vì %@ không khả dụng hoặc trả về lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未能完成，因为 %@ 不可用或返回了错误。"
          }
