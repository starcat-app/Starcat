    "settings.general.interfaceScale.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust Starcat-specific text size. Currently applies to the Agent workspace first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整 Starcat 内的文字大小；当前优先应用到 Agent 工作台。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整 Starcat 專用的文字大小。目前優先套用於 Agent 工作區。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat固有のテキストサイズを調整します。現在は主にエージェントワークスペースに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat 특정 텍스트 크기를 조정합니다. 현재는 에이전트 작업 공간에 먼저 적용됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Starcat-spezifische Textgröße an. Gilt derzeit zuerst für den Agent-Arbeitsbereich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster la taille du texte propre à Starcat. S'applique d'abord à l'espace de travail Agent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el tamaño del texto específico de Starcat. Actualmente se aplica primero al espacio de trabajo del Agente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta o tamanho do texto específico do Starcat. Atualmente se aplica primeiro ao espaço de trabalho do Agente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la dimensione del testo specifica di Starcat. Attualmente si applica principalmente all'area di lavoro Agent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте размер текста для Starcat. Сначала применяется к рабочей области Агента."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de Starcat-specifieke tekstgrootte aan. Dit is momenteel van toepassing op de Agent-werkruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj rozmiar tekstu specyficzny dla Starcat. Obecnie dotyczy przede wszystkim obszaru roboczego Agenta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте розмір тексту Starcat. Наразі застосовується спочатку до робочої області Агента."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starcat'a özel metin boyutunu ayarlayın. Şu anda öncelikle Ajan çalışma alanına uygulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh cỡ chữ riêng của Starcat. Hiện áp dụng cho không gian làm việc Agent trước."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan ukuran teks khusus Starcat. Saat ini berlaku untuk ruang kerja Agen terlebih dahulu."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
