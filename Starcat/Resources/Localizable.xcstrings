    "settings.filters.interestedLanguages.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only these languages appear in the global language filter. This does not filter lists by itself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有这些语言会出现在全局语言筛选中；这里本身不会直接过滤列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
