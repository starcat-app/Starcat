        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限ウィンドウがリセットされるまで待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한 창이 초기화될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht tot het limietvenster opnieuw wordt ingesteld en probeer het opnieuw."
