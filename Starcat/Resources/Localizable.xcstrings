    "rag.workspace.guidance.socialReply" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا! أجيب على الأسئلة من قاعدة معرفة Starcat الخاصة بك. اختر سؤالاً أدناه، أو اسأل عن مستودع في قاعدة معرفتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Ich beantworte Fragen aus Ihrer Starcat-Wissensdatenbank. Wählen Sie eine Frage unten oder fragen Sie nach einem Repository in Ihrer Wissensdatenbank."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello! I answer questions from your Starcat knowledge base. Choose a question below, or ask about a repository in your knowledge base."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Respondo preguntas de tu base de conocimiento de Starcat. Elige una pregunta a continuación o pregunta sobre un repositorio en tu base de conocimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour ! Je réponds aux questions de votre base de connaissances Starcat. Choisissez une question ci-dessous, ou posez une question sur un dépôt de votre base de connaissances."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo! Saya menjawab pertanyaan dari basis pengetahuan Starcat Anda. Pilih pertanyaan di bawah, atau tanyakan tentang repositori di basis pengetahuan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Rispondo a domande dalla tua knowledge base di Starcat. Scegli una domanda qui sotto o chiedi informazioni su un repository nella tua knowledge base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！Starcatナレッジベースからの質問にお答えします。以下の質問を選ぶか、ナレッジベース内のリポジトリについて質問してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! Starcat 지식 베이스의 질문에 답변합니다. 아래에서 질문을 선택하거나 지식 베이스의 저장소에 대해 물어보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Ik beantwoord vragen uit uw Starcat-kennisbank. Kies een vraag hieronder of stel een vraag over een repository in uw kennisbank."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witaj! Odpowiadam na pytania z Twojej bazy wiedzy Starcat. Wybierz pytanie poniżej lub zapytaj o repozytorium w swojej bazie wiedzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá! Respondo perguntas da sua base de conhecimento do Starcat. Escolha uma pergunta abaixo ou pergunte sobre um repositório na sua base de conhecimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравствуйте! Я отвечаю на вопросы из вашей базы знаний Starcat. Выберите вопрос ниже или спросите о репозитории в вашей базе знаний."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba! Starcat bilgi tabanınızdan soruları yanıtlıyorum. Aşağıdan bir soru seçin veya bilgi tabanınızdaki bir depo hakkında soru sorun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привіт! Я відповідаю на запитання з вашої бази знань Starcat. Виберіть запитання нижче або запитайте про репозиторій у вашій базі знань."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xin chào! Tôi trả lời các câu hỏi từ cơ sở tri thức Starcat của bạn. Chọn một câu hỏi bên dưới hoặc hỏi về một kho lưu trữ trong cơ sở tri thức của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！我主要根据你的 Starcat 知识库回答仓库相关问题。你可以点击下面的问题，或直接询问知识库中的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！我主要根據你的 Starcat 知識庫回答倉庫相關問題。你可以點選下面的問題，或直接詢問知識庫中的專案。"
          }
        }
      }
    },
