    "settings.diagnostics.telemetry.enabled.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال أحداث منتج مجهولة المصدر ومدرجة في القائمة المسموح بها، ومجموعات تقريبية للأداء. لا يرسل Starcat أبدًا أسماء المستودعات، أو نصوص البحث، أو الملاحظات، أو نصوص README، أو المطالبات، أو الردود، أو مفاتيح API، أو الرموز المميزة، أو المسارات المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden Sie zugelassene, anonyme Produktereignisse und grobe Leistungsdaten. Starcat sendet niemals Repository-Namen, Suchtext, Notizen, README-Inhalte, Eingabeaufforderungen, Antworten, API-Schlüssel, Tokens oder lokale Pfade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send allowlisted, anonymous product events and coarse performance buckets. Starcat never sends repository names, search text, notes, README bodies, prompts, responses, API keys, tokens, or local paths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar eventos de producto anónimos permitidos y métricas de rendimiento generales. Starcat nunca envía nombres de repositorio, texto de búsqueda, notas, cuerpos de README, indicaciones, respuestas, claves API, tokens ni rutas locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer des événements produits anonymes autorisés et des catégories de performances générales. Starcat n'envoie jamais de noms de dépôts, de texte de recherche, de notes, de contenus README, d'invites, de réponses, de clés API, de jetons ou de chemins locaux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim peristiwa produk anonim yang diizinkan dan bucket kinerja kasar. Starcat tidak pernah mengirim nama repositori, teks pencarian, catatan, isi README, prompt, respons, kunci API, token, atau jalur lokal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia eventi di prodotto anonimi consentiti e fasce di prestazioni approssimative. Starcat non invia mai nomi di repository, testo di ricerca, note, corpi README, prompt, risposte, chiavi API, token o percorsi locali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可リストに登録された匿名の製品イベントと大まかなパフォーマンスバケットを送信します。Starcatはリポジトリ名、検索テキスト、メモ、README本文、プロンプト、応答、APIキー、トークン、ローカルパスを送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용 목록에 포함된 익명 제품 이벤트와 대략적인 성능 버킷을 전송합니다. Starcat는 저장소 이름, 검색 텍스트, 메모, README 본문, 프롬프트, 응답, API 키, 토큰, 로컬 경로를 절대 전송하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur goedgekeurde, anonieme productgebeurtenissen en grove prestatiecategorieën. Starcat verzendt nooit repositorynamen, zoektekst, notities, README-teksten, prompts, antwoorden, API-sleutels, tokens of lokale paden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj dozwolone, anonimowe zdarzenia produktowe i ogólne dane o wydajności. Starcat nigdy nie wysyła nazw repozytoriów, tekstu wyszukiwania, notatek, treści README, podpowiedzi, odpowiedzi, kluczy API, tokenów ani lokalnych ścieżek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia eventos de produto anônimos e permitidos, além de faixas de desempenho gerais. O Starcat nunca envia nomes de repositórios, texto de pesquisa, notas, corpos de README, prompts, respostas, chaves de API, tokens ou caminhos locais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлять разрешённые анонимные события продукта и общие показатели производительности. Starcat никогда не отправляет имена репозиториев, текст поиска, заметки, содержимое README, подсказки, ответы, ключи API, токены или локальные пути."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verilen, anonim ürün olaylarını ve kaba performans kovalarını gönderin. Starcat asla depo adları, arama metni, notlar, README içerikleri, istemler, yanıtlar, API anahtarları, token'lar veya yerel yollar göndermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилайте дозволені анонімні події продукту та загальні показники продуктивності. Starcat ніколи не надсилає назви репозиторіїв, текст пошуку, нотатки, тіла README, підказки, відповіді, ключі API, токени або локальні шляхи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi các sự kiện sản phẩm ẩn danh được cho phép và các nhóm hiệu suất thô. Starcat không bao giờ gửi tên kho lưu trữ, văn bản tìm kiếm, ghi chú, nội dung README, lời nhắc, phản hồi, khóa API, token hoặc đường dẫn cục bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送白名单内的匿名产品事件与粗粒度性能分桶。Starcat 不会发送仓库名、搜索词、笔记、README 正文、prompt、回复、API Key、token 或本地路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送白名单内的匿名产品事件与粗粒度性能分桶。Starcat 不会发送仓库名、搜索词、笔记、README 正文、prompt、回复、API Key、token 或本地路径。"
          }
        }
      }
    },
