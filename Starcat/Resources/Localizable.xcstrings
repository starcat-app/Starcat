        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把仓库源码打包成 XML 喂给 AI，让摘要 / 对话能「看到代码」。首次生成会下载并解压 ZIP，可能 1-3 秒。"
          }
