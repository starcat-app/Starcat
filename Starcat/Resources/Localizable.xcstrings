      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes context.xml and its metadata. You can generate them again later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会删除 context.xml 及其元数据，之后仍可重新生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作會刪除 context.xml 及其元數據，之後仍可重新生成。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより context.xml とそのメタデータが削除されます。後で再生成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 context.xml과 해당 메타데이터를 제거합니다. 나중에 다시 생성할 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden context.xml und seine Metadaten entfernt. Sie können sie später erneut generieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime context.xml et ses métadonnées. Vous pourrez les regénérer plus tard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina context.xml y sus metadatos. Puedes generarlos de nuevo más tarde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove o context.xml e seus metadados. Você pode gerá-los novamente depois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove context.xml e i suoi metadati. Puoi rigenerarli in seguito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит context.xml и его метаданные. Вы сможете сгенерировать их позже."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee verwijdert u context.xml en de bijbehorende metadata. U kunt ze later opnieuw genereren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie pliku context.xml i jego metadanych. Możesz je później wygenerować ponownie."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить context.xml та його метадані. Ви зможете створити їх знову пізніше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, context.xml ve meta verilerini kaldırır. Daha sonra tekrar oluşturabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa context.xml và siêu dữ liệu của nó. Bạn có thể tạo lại chúng sau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus context.xml dan metadatanya. Anda dapat membuatnya lagi nanti."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يزيل context.xml والبيانات الوصفية الخاصة به. يمكنك إنشاؤها مرة أخرى لاحقًا."
          }
        }
      }
    },
