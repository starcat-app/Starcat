    "repoHealth.unavailable.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد لا يكون لهذا المستودع سجل مخزن مؤقت محلي بعد، أو فشل تحديث اللقطة. حاول التحديث بعد اكتمال المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Repo hat möglicherweise noch keinen lokalen Cache-Eintrag, oder die Snapshot-Aktualisierung ist fehlgeschlagen. Versuchen Sie nach Abschluss der Synchronisation zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This repo may not have a local cached record yet, or the snapshot refresh failed. Try refreshing after sync finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que este repositorio aún no tenga un registro en caché local, o que la actualización de la instantánea haya fallado. Intenta refrescar después de que termine la sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dépôt n'a peut-être pas encore d'enregistrement en cache local, ou l'actualisation de l'instantané a échoué. Essayez d'actualiser après la fin de la synchronisation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repo ini mungkin belum memiliki catatan cache lokal, atau penyegaran snapshot gagal. Coba segarkan setelah sinkronisasi selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo repository potrebbe non avere ancora un record in cache locale o l'aggiornamento dello snapshot è fallito. Prova ad aggiornare dopo la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリポジトリにはまだローカルキャッシュレコードがないか、スナップショットの更新に失敗した可能性があります。同期が完了したら更新してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장소에 아직 로컬 캐시 기록이 없거나 스냅샷 새로고침에 실패했을 수 있습니다. 동기화 완료 후 새로고침해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze repo heeft mogelijk nog geen lokale cache-record of de snapshotvernieuwing is mislukt. Probeer te vernieuwen nadat synchronisatie is voltooid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To repozytorium może nie mieć jeszcze lokalnego rekordu w pamięci podręcznej lub odświeżenie migawki nie powiodło się. Spróbuj odświeżyć po zakończeniu synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este repositório pode não ter um registro em cache local ainda, ou a atualização do snapshot falhou. Tente atualizar após a sincronização terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, для этого репозитория ещё нет локальной кешированной записи, или обновление снимка не удалось. Попробуйте обновить после завершения синхронизации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu deponun henüz yerel önbellek kaydı olmayabilir veya anlık görüntü yenilemesi başarısız oldu. Senkronizasyon tamamlandıktan sonra yenilemeyi deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, цей репозиторій ще не має локального кешу або оновлення знімка не вдалося. Спробуйте оновити після завершення синхронізації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kho này có thể chưa có bản ghi bộ nhớ đệm cục bộ hoặc làm mới ảnh chụp nhanh thất bại. Hãy thử làm mới sau khi đồng bộ hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个仓库可能还没有本地缓存记录，或快照刷新失败。同步完成后可以再刷新。"
