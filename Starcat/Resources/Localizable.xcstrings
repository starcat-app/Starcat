    "agent.definition.githubWeeklyReport.defaultPrompt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create this week's GitHub trending open-source weekly report for me, in a style similar to Ruan Yifeng Weekly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帮我生成本周 GitHub 热门开源项目周刊，风格参考阮一峰 Weekly。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為我生成這週的 GitHub 熱門開源專案週報，風格參考阮一峰 Weekly。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週の GitHub トレンドオープンソース週報を、阮一峰週刊スタイルで作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 GitHub 트렌딩 오픈소스 주간 보고서를 작성해 주세요. 스타일은 Ruan Yifeng 주간과 유사하게."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle für mich den dieswöchigen GitHub-Trending-Open-Source-Wochenbericht, ähnlich wie Ruan Yifeng Weekly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez pour moi le rapport hebdomadaire open-source tendance de GitHub de cette semaine, dans un style similaire à Ruan Yifeng Weekly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea para mí el informe semanal de código abierto en tendencia de GitHub de esta semana, en un estilo similar al de Ruan Yifeng Weekly."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie para mim o relatório semanal de código aberto em tendência do GitHub desta semana, em um estilo semelhante ao Ruan Yifeng Weekly."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea per me il report settimanale open-source di tendenza di GitHub di questa settimana, in uno stile simile a Ruan Yifeng Weekly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создай для меня еженедельный отчёт о трендовых open-source проектах GitHub за эту неделю в стиле, похожем на «Еженедельник Жуань Ифэна»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak voor mij het wekelijkse GitHub-trending open-source rapport van deze week, in een stijl vergelijkbaar met Ruan Yifeng Weekly."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz dla mnie cotygodniowy raport o trendach open-source na GitHubie w tym tygodniu, w stylu podobnym do Ruan Yifeng Weekly."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть для мене щотижневий звіт про трендові відкриті проекти на GitHub цього тижня у стилі, подібному до Ruan Yifeng Weekly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu haftanın GitHub trend açık kaynak haftalık raporunu benim için oluştur, Ruan Yifeng Haftalık stiline benzer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo báo cáo tuần về mã nguồn mở thịnh hành trên GitHub cho tôi, theo phong cách tương tự Ruan Yifeng Weekly."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat laporan mingguan open-source tren GitHub minggu ini untuk saya, dengan gaya yang mirip dengan Ruan Yifeng Weekly."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ لي التقرير الأسبوعي لمشاريع GitHub الرائجة مفتوحة المصدر لهذا الأسبوع، بأسلوب مشابه لأسبوعية روان ييفنغ."
          }
        }
      }
    },
