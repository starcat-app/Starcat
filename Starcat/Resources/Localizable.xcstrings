    "rag.workspace.error.embeddingRequest.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The configured embedding model could not complete the request. Check the model and provider settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前向量化模型无法完成请求，请检查模型和服务商配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前向量化模型無法完成請求，請檢查模型和服務商設定。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定された埋め込みモデルがリクエストを完了できませんでした。モデルとプロバイダーの設定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정된 임베딩 모델이 요청을 완료할 수 없습니다. 모델 및 제공자 설정을 확인하세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das konfigurierte Embedding-Modell konnte die Anfrage nicht abschließen. Überprüfen Sie die Modell- und Anbietereinstellungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle d'embedding configuré n'a pas pu traiter la demande. Vérifiez les paramètres du modèle et du fournisseur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de incrustaciones configurado no pudo completar la solicitud. Verifique la configuración del modelo y del proveedor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo de incorporação configurado não pôde concluir a solicitação. Verifique as configurações do modelo e do provedor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello di embedding configurato non ha potuto completare la richiesta. Controlla le impostazioni del modello e del provider."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроенная модель эмбеддингов не смогла выполнить запрос. Проверьте настройки модели и провайдера."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het geconfigureerde embeddingmodel kon het verzoek niet voltooien. Controleer de model- en providerinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skonfigurowany model osadzania nie mógł zrealizować żądania. Sprawdź ustawienia modelu i dostawcy."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштована модель вбудовування не змогла виконати запит. Перевірте налаштування моделі та постачальника."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapılandırılan gömme modeli isteği tamamlayamadı. Model ve sağlayıcı ayarlarını kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình nhúng đã cấu hình không thể hoàn thành yêu cầu. Kiểm tra cài đặt mô hình và nhà cung cấp."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model embedding yang dikonfigurasi tidak dapat menyelesaikan permintaan. Periksa pengaturan model dan penyedia."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على نموذج التضمين المُعد إكمال الطلب. تحقق من إعدادات النموذج والموفر."
          }
        }
      }
    },
