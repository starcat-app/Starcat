    "settings.storage.clearAiContext.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل ملفات context.xml و metadata.json المنشأة. تُحفظ ملفات ZIP المصدر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle generierten context.xml und metadata.json. Quell-ZIPs bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes all generated context.xml and metadata.json. Source ZIPs are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los context.xml y metadata.json generados. Los ZIP de origen se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les context.xml et metadata.json générés. Les ZIP sources sont conservés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua context.xml dan metadata.json yang dibuat. ZIP sumber tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutti i file context.xml e metadata.json generati. I ZIP sorgente vengono conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成されたcontext.xmlとmetadata.jsonをすべて削除します。ソースZIPは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생성된 모든 context.xml과 metadata.json을 삭제합니다. 소스 ZIP은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alle gegenereerde context.xml en metadata.json. Bron-ZIP's blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa wszystkie wygenerowane pliki context.xml i metadata.json. Źródłowe pliki ZIP pozostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui todos os context.xml e metadata.json gerados. Os ZIPs de origem são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все сгенерированные context.xml и metadata.json. Исходные ZIP-архивы сохраняются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturulan tüm context.xml ve metadata.json dosyalarını siler. Kaynak ZIP'ler korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє всі згенеровані context.xml та metadata.json. Вихідні ZIP-файли зберігаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tất cả context.xml và metadata.json đã tạo. Các tệp ZIP nguồn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除所有已生成的 context.xml 与 metadata.json。共享源码 ZIP 不会被删除。"
