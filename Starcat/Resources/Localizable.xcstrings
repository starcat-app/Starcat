        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتائج البحث الخارجي المخزنة مؤقتًا على القرص (بحث عام 6 ساعات / سياق خارجي للذكاء الاصطناعي 24 ساعة)."
