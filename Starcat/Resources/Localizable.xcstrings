    "settings.autoTidy.actions.generateSummary.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate and save AI summaries for processed stars. Uses additional model quota."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为处理的 Star 生成并保存 AI 摘要，会额外消耗模型额度。"
