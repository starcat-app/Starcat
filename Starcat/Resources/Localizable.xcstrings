    "settings.general.shortcuts.configuration.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على اختصار لتسجيله. الاختصارات المعطلة تحتفظ بمفتاحها المحفوظ وتظل مشاركة في فحوصات التعارض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf eine Tastenkombination, um sie aufzuzeichnen. Deaktivierte Tastenkombinationen behalten ihre gespeicherte Taste und nehmen weiterhin an Konfliktprüfungen teil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a shortcut to record it. Disabled shortcuts keep their saved key and still participate in conflict checks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en un atajo para grabarlo. Los atajos desactivados conservan su tecla guardada y siguen participando en las comprobaciones de conflictos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un raccourci pour l'enregistrer. Les raccourcis désactivés conservent leur touche enregistrée et participent toujours aux vérifications de conflits."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik pintasan untuk merekamnya. Pintasan yang dinonaktifkan tetap menyimpan tombol yang disimpan dan tetap berpartisipasi dalam pemeriksaan konflik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una scorciatoia per registrarla. Le scorciatoie disabilitate mantengono il tasto salvato e partecipano comunque ai controlli di conflitto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットをクリックして記録します。無効にしたショートカットは保存されたキーを保持し、競合チェックの対象となります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 클릭하여 기록하세요. 비활성화된 단축키는 저장된 키를 유지하며 충돌 검사에 계속 참여합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op een sneltoets om deze op te nemen. Uitgeschakelde sneltoetsen behouden hun opgeslagen toets en doen nog steeds mee aan conflictencontroles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij skrót, aby go nagrać. Wyłączone skróty zachowują zapisany klawisz i nadal uczestniczą w sprawdzaniu konfliktów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em um atalho para gravá‑lo. Atalhos desativados mantêm a tecla salva e ainda participam da verificação de conflitos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите сочетание клавиш, чтобы записать его. Отключённые сочетания сохраняют назначенную клавишу и по-прежнему участвуют в проверке конфликтов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kısayola tıklayarak kaydedin. Devre dışı bırakılan kısayollar kaydedilmiş tuşlarını korur ve çakışma kontrollerine katılmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть комбінацію, щоб записати її. Вимкнені комбінації зберігають призначену клавішу та беруть участь у перевірці конфліктів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp vào một phím tắt để ghi lại. Các phím tắt bị vô hiệu hóa vẫn giữ phím đã lưu và vẫn tham gia kiểm tra xung đột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击快捷键即可录制；关闭后仍会保留键位并参与冲突检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊快捷鍵即可錄製。停用的快捷鍵仍會保留按鍵設定，並參與衝突檢查。"
          }
        }
      }
    },
    "settings.general.shortcuts.enabled.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعطل مشغلات لوحة المفاتيح فقط. تظل القوائم والأزرار وإرسال رسائل الذكاء الاصطناعي متاحة."
