          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat messages are sent directly and do not use a user prompt template."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes de chat se envían directamente y no usan una plantilla de prompt de usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages de chat sont envoyés directement et n'utilisent pas de modèle de prompt utilisateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
