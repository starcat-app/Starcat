    "ai.usage.empty.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Chat and Embedding calls will appear here. Historical usage is not backfilled."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的 Chat 与 Embedding 调用会显示在这里，不会回填历史用量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的 Chat 與 Embedding 呼叫會顯示在這裡，不會回填歷史用量。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいチャットと埋め込みの呼び出しがここに表示されます。過去の使用状況はバックフィルされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 채팅 및 임베딩 호출이 여기에 표시됩니다. 과거 사용 기록은 백필되지 않습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Chat- und Embedding-Aufrufe werden hier angezeigt. Der bisherige Verlauf wird nicht nachgetragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux appels de Chat et d’Embedding apparaîtront ici. L’historique n’est pas rétroactif."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas llamadas de Chat y Embedding aparecerán aquí. El uso histórico no se rellena."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas chamadas de Chat e Embedding aparecerão aqui. O uso histórico não é preenchido retroativamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuove chiamate Chat e Embedding appariranno qui. La cronologia precedente non viene recuperata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые вызовы Chat и Embedding будут отображаться здесь. История использования не заполняется задним числом."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe Chat- en Embedding-oproepen verschijnen hier. Historisch gebruik wordt niet teruggevuld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe wywołania czatu i osadzania pojawią się tutaj. Historyczne użycie nie jest uzupełniane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові виклики Chat та Embedding з'являтимуться тут. Історичне використання не заповнюється."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni Sohbet ve Gömme çağrıları burada görünecek. Geçmiş kullanım doldurulmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cuộc gọi Chat và Embedding mới sẽ xuất hiện ở đây. Lịch sử sử dụng không được sao lưu."
