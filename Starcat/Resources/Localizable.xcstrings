    "onboarding.step4.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in when you are ready. Starcat syncs your Stars locally, keeps private notes and status, and tracks releases for the projects that matter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好后登录 GitHub，Starcat 会本地同步你的 Stars，保存私有笔记和状态，并追踪重要项目的 Release。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備好後登入 GitHub，Starcat 會本地同步你的 Stars，儲存私有筆記和狀態，並追蹤重要專案的 Release。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたらサインインしてください。Starcatはスターをローカルに同期し、プライベートノートとステータスを保持し、重要なプロジェクトのリリースを追跡します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비가 되면 로그인하세요. Starcat이 별을 로컬에 동기화하고, 개인 노트와 상태를 유지하며, 중요한 프로젝트의 릴리스를 추적합니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich an, wenn Sie bereit sind. Starcat synchronisiert Ihre Sterne lokal, behält private Notizen und Status und verfolgt Veröffentlichungen für die wichtigen Projekte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous quand vous êtes prêt. Starcat synchronise vos étoiles localement, conserve des notes privées et un statut, et suit les versions des projets importants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión cuando estés listo. Starcat sincroniza tus estrellas localmente, guarda notas privadas y estado, y rastrea los lanzamientos de los proyectos que importan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça login quando estiver pronto. O Starcat sincroniza suas Estrelas localmente, mantém notas e status privados e acompanha lançamentos dos projetos que importam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi quando sei pronto. Starcat sincronizza le tue stelle localmente, mantiene note private e stato, e tiene traccia delle versioni per i progetti che contano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, когда будете готовы. Starcat синхронизирует ваши звёзды локально, сохраняет личные заметки и статусы, а также отслеживает релизы важных проектов."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld je aan wanneer je er klaar voor bent. Starcat synchroniseert je Stars lokaal, bewaart privénotities en status en houdt releases bij voor de projecten die ertoe doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, gdy będziesz gotowy. Starcat synchronizuje Twoje gwiazdki lokalnie, przechowuje prywatne notatki i status oraz śledzi wydania ważnych projektów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увійдіть, коли будете готові. Starcat синхронізує ваші зірки локально, зберігає приватні нотатки та статуси, а також відстежує релізи важливих проєктів."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır olduğunuzda oturum açın. Starcat, yıldızlarınızı yerel olarak senkronize eder, özel notlar ve durum tutar ve önemli projeler için sürümleri takip eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập khi bạn sẵn sàng. Starcat đồng bộ Sao của bạn cục bộ, giữ ghi chú riêng tư và trạng thái, đồng thời theo dõi bản phát hành cho các dự án quan trọng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk saat Anda siap. Starcat menyinkronkan Bintang Anda secara lokal, menyimpan catatan pribadi dan status, serta melacak rilis untuk proyek yang penting."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل الدخول عندما تكون مستعدًا. يقوم Starcat بمزامنة نجومك محليًا، ويحتفظ بالملاحظات والحالة الخاصة، ويتتبع الإصدارات للمشاريع التي تهمك."
          }
        }
      }
    },
