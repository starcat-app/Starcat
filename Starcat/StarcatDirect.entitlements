<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Direct / 非 App Store 版按非沙箱应用运行。
      这里保留独立 entitlements 文件，是为了让 App Store 与 Direct target 的签名边界清晰；
      需要新增 Direct 专属能力时只改本文件，不影响 Starcat.entitlements。
    -->
    <!-- Universal Links：Direct 渠道与 App Store 渠道共用公开仓库链接。 -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:starcat.ink</string>
    </array>

    <!--
      Direct Widget 使用独立共享容器，避免与 App Store 版同时安装时串数据。
      使用无需 provisioning profile 授权的 Team ID 前缀，并与 Widget / 发布重签
      配置保持一致，避免 macOS 15+ 将访问视为外部容器访问而反复询问用户。
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>8WCUMGCWMB.com.starcat.app.direct.widgets</string>
        <!-- 两个主 App 共用；Widget / 屏保 / 辅助二进制均不授予。 -->
        <string>8WCUMGCWMB.com.starcat.app.localai</string>
    </array>
</dict>
</plist>
