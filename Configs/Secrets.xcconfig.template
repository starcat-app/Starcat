// Secrets.xcconfig.template —— 私密构建配置模板（进 git，但仅作为模板）
//
// ────────────────────────────────────────────────────────────────────────────
// 使用步骤（推荐自动化）
// ────────────────────────────────────────────────────────────────────────────
// 1. 在 supports/starcat-api/.env 填 STARCAT_SHARED_API_KEY=sk-starcat-...
//    （并让六个业务 *_API_KEYS 与之同值；见该文件注释）
// 2. make setup-production-api-keys   ← 写入本机 Secrets.xcconfig（六槽同值）
// 3. **不要 commit Secrets.xcconfig**（已加 .gitignore）
// 4. xcodegen generate && 重新 build App
//
// 手动：cp Configs/Secrets.xcconfig.template Configs/Secrets.xcconfig 后改下面几行。
// ────────────────────────────────────────────────────────────────────────────
//
// STARCAT_PRODUCTION_API_KEY_<SERVICE>
//   编译期注入 Info.plist 的自建后端 Bearer Token（每服务一个槽位）。
//   **聚合部署（默认）**：六个槽填**相同**值，且与 starcat-api 的
//   STARCAT_SHARED_API_KEY / 各 *_API_KEYS 白名单一致。
//   留空 = 该服务 BYOK-only（用户须在「设置 → 服务」填 Key，否则 401）。
//
//   自动化：make setup-production-api-keys（读 supports/starcat-api/.env）
//   Fly 对齐：聚合 App 用前缀 secrets（TRENDING_API_KEYS 等）；独立仓仍各自维护
//   文档：supports/docs/fly-io-环境变量.md §7（待同步聚合口径）
//
// --- 旧说明（独立 *.fly.dev / 每仓不同 Key；保留注释勿删）---
// // 1. 在 supports/starcat-*-api/.env 里分别填 API_KEYS=sk-starcat-...
// // 2. make setup-production-api-keys   ← 从各服务 .env 自动写入（每服务可不同）
// // 字段说明（五个服务可各不相同）
// // STARCAT_PRODUCTION_API_KEY_<SERVICE> 各自建后端 fly.io 的 baked-in Bearer Token

STARCAT_PRODUCTION_API_KEY_TRENDING =
STARCAT_PRODUCTION_API_KEY_WEEKLY =
STARCAT_PRODUCTION_API_KEY_SHARING =
STARCAT_PRODUCTION_API_KEY_WIKI =
STARCAT_PRODUCTION_API_KEY_RECOMMEND =
STARCAT_PRODUCTION_API_KEY_DISCOVERY =

// Starcat License API — Direct 分发授权 / Creem checkout 后端
// 这些配置项让测试环境和生产环境长期共存；构建时用 STARCAT_LICENSE_API_ENVIRONMENT 选择当前套。
// *_KEY 对应各自 supports/starcat-license-api 的 API_KEYS。Creem API Key 仍只保存在服务端。
STARCAT_LICENSE_API_ENVIRONMENT = test
STARCAT_LICENSE_API_TEST_BASE_URL = https:/$()/starcat-license-api-staging.fly.dev
STARCAT_LICENSE_API_TEST_KEY =
STARCAT_LICENSE_API_LIVE_BASE_URL = https:/$()/starcat-license-api.fly.dev
STARCAT_LICENSE_API_LIVE_KEY =

// Aptabase App Key — 匿名产品事件后端
// https://aptabase.com/ → Project Settings → App Key
// 留空时 Starcat 遥测保持 no-op；用户未开启设置页开关时也不会发送。
// 格式错误或上报失败只会静默降级，不应暴露给用户。
STARCAT_APTABASE_APP_KEY =

// GitHub OAuth App Client Secret — 从 GitHub OAuth App Settings 获取
// https://github.com/settings/developers → Starcat → Client Secret
// Web Application Flow (PKCE) token 交换时必须提供
STARCAT_OAUTH_CLIENT_SECRET =

// “我的项目”GitHub App Client Secret — 从 GitHub App Settings 获取
// 安装期间 OAuth 回调的 code 交换和 refresh token 轮换时必须提供
// 原生客户端无法把该值当作真正机密；绝不能在这里放 GitHub App Private Key
STARCAT_GITHUB_APP_CLIENT_SECRET =

// 本机签名（可选）
// 正式 Apple Developer Team 下来后建议填 DEVELOPMENT_TEAM，保证 Xcode Run、
// scripts/run-debug-appstore.sh / scripts/run-debug-direct.sh 和 archive 使用同一 Team。
// Debug 使用 Apple Development；App Store archive 使用 Apple Distribution；
// Direct 公开发布默认使用 `Developer ID Application: liwen gong (8WCUMGCWMB)`。
// 未来换 Team / CI keychain 时，再用 STARCAT_DIRECT_SIGN_IDENTITY 覆盖。
// 示例：
//   DEVELOPMENT_TEAM = 8WCUMGCWMB
//   CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY =
