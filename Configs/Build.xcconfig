// Build.xcconfig —— Starcat 工程公共构建配置入口（进 git）
//
// 设计意图：
// - 该文件是「公开」配置：所有人 clone 仓库后能立即编译 / 测试；
// - 私密变量（如 production API Key）走 `Secrets.xcconfig`，由开发者本地自行 cp
//   `Secrets.xcconfig.template` → `Secrets.xcconfig` 填值；该文件**不进 git**（已加 .gitignore）。
//
// 工作机制：
// - 下面的 `#include? "Secrets.xcconfig"` 是 Xcode xcconfig 的「可选包含」语法（带问号）：
//   - 文件存在 → 用其中变量覆盖本文件的同名变量
//   - 文件不存在 → 静默跳过，不报错（让 CI / 新 contributor 零配置即可编译）
// - Secrets.xcconfig 缺失时，本文件的默认值（多数为空字符串）生效，App 在运行期表现为
//   「production 默认 Key 未配置 → BYOK-only 模式」
//
// 添加新私密变量的步骤：
// 1. 本文件加 `MY_NEW_SECRET = `（空字符串默认值，保证编译能过）
// 2. `Secrets.xcconfig.template` 加同名变量 + 注释说明
// 3. project.yml `info.properties` 段加 `MY_NEW_SECRET: $(MY_NEW_SECRET)` 让值进 Info.plist
// 4. 代码里通过 `Bundle.main.infoDictionary["MY_NEW_SECRET"] as? String` 读取

// MARK: - R-01 自建后端 production 默认 API Key（每服务一个槽位；聚合后六槽同值）
//
// trending / weekly / sharing / wiki / recommend / discovery 各一条槽位（策略保留）。
// 默认空 = 该服务 BYOK-only。聚合 starcat-api 时六个槽填相同 sk-starcat-...，
// 与 supports/starcat-api/.env 的 STARCAT_SHARED_API_KEY 一致。
// 自动化：make setup-production-api-keys（读 starcat-api/.env，不再读各独立仓）
//
// 旧：每服务从 supports/starcat-*-api/.env 各自同步、可互不相同（已弃用，脚本内注释保留）
STARCAT_PRODUCTION_API_KEY_TRENDING =
STARCAT_PRODUCTION_API_KEY_WEEKLY =
STARCAT_PRODUCTION_API_KEY_SHARING =
STARCAT_PRODUCTION_API_KEY_WIKI =
STARCAT_PRODUCTION_API_KEY_RECOMMEND =
STARCAT_PRODUCTION_API_KEY_DISCOVERY =
// 独立 Collection 写入 key；不与聚合 Gateway 的内容服务 key 共用。
STARCAT_COLLECTION_API_KEY =

// MARK: - Direct 分发授权 / 支付后端

// 当前构建使用的 License API 环境。Direct Debug 默认 test，Direct Release 在 project.yml 覆盖为 live。
// 可选值：test / live。只影响 Starcat 自家 License API；Creem test/live 由对应后端环境变量决定。
STARCAT_LICENSE_API_ENVIRONMENT = test

// Test Mode / staging：连接使用 Creem Test Mode 的 starcat-license-api-staging。
STARCAT_LICENSE_API_TEST_BASE_URL = https:/$()/starcat-license-api-staging.fly.dev
STARCAT_LICENSE_API_TEST_KEY =

// Live / production：连接使用 Creem Live Mode 的 starcat-license-api。
STARCAT_LICENSE_API_LIVE_BASE_URL = https:/$()/starcat-license-api.fly.dev
STARCAT_LICENSE_API_LIVE_KEY =

// MARK: - 匿名遥测（Aptabase）

// Aptabase App Key。默认空 = 后端未配置，App 内遥测保持 no-op。
// 即使配置了 key，仍必须由用户在「设置 → 诊断」开启匿名遥测开关才会发送事件。
// 格式错误时 Starcat 会在调用 SDK 前降级 no-op，避免把配置问题暴露给用户。
STARCAT_APTABASE_APP_KEY = 

// MARK: - GitHub OAuth（Web Application Flow）

// GitHub OAuth App Client Secret。Web Flow token 交换时 /login/oauth/access_token
// 要求同时带 client_secret + code_verifier（PKCE 保护 code 不替代 client auth）。
// Device Flow 和 PAT 不需要这个值。默认空 = Web Flow 退化为错误提示。
STARCAT_OAUTH_CLIENT_SECRET =

// MARK: - “我的项目”GitHub App

// GitHub App Client ID 是公开标识，不是 secret。
STARCAT_GITHUB_APP_CLIENT_ID = Iv23liEKp4zzsEk5mJw8

// GitHub App 页面 URL 中的公开 slug（非 secret），用于构造用户安装入口。
// 实际安装页：https:/$()/github.com/apps/starcat-for-github/installations/new
STARCAT_GITHUB_APP_SLUG = starcat-for-github

// GitHub App Client Secret。安装期间 OAuth 回调使用 Authorization Code Flow，
// token 交换与后续 refresh 都必须携带。默认空 = 只保留 OAuth Public fallback。
// macOS 原生应用属于 public client，无法真正隐藏该值；授权请求必须使用随机 state，
// 且绝不能把权限更大的 GitHub App private key 注入客户端。
STARCAT_GITHUB_APP_CLIENT_SECRET =

// MARK: - 分发渠道

// 默认按 App Store 渠道构建。Direct target / 打包脚本会覆盖为 `direct`。
// 运行时代码只能读取该显式注入值，不允许按 receipt / bundle path 猜测渠道。
STARCAT_DISTRIBUTION = appstore

// MARK: - Sparkle（Direct 分发自动更新）

// Sparkle EdDSA 公钥。默认留空表示 Direct 版暂不启动自动更新；
// 正式发版前用 `sparkle generate_keys` 生成并写入 Secrets.xcconfig。
STARCAT_SPARKLE_PUBLIC_ED_KEY =

// MARK: - 引入私密配置（可选）
//
// `?` 让 include 在文件缺失时静默跳过；新 contributor / CI 不需要 Secrets.xcconfig 也能编译。
#include? "Secrets.xcconfig"
