# 复制到 ~/.config/starcat/history-daily.env，并执行 chmod 600。
HISTORY_BASE_URL=https://starcat-api.fly.dev
HISTORY_GATEWAY_SERVICE=history
HISTORY_PUBLISH_KEY=replace-with-production-publish-key

# 数据默认保存在 /Volumes/T0/Starcat；只有目录变化时才需要覆盖。
# STARCAT_WATCH_VOLUME_ROOT=/Volumes/T0
# HISTORY_RAW_ROOT=/Volumes/T0/Starcat/bigquery/watch-events-2016-2026/raw/gh_archive
# HISTORY_DATA_ROOT=/Volumes/T0/Starcat/history
# HISTORY_MEMORY_LIMIT=12GB
# HISTORY_THREADS=4
