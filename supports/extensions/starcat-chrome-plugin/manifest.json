{
  "manifest_version": 3,
  "name": "Starcat Browser Plugin",
  "description": "Show Starcat context on GitHub repository pages.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "http://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/shared/shared.js", "src/content/content-script.js"],
      "css": ["src/content/content-script.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Starcat Browser Plugin",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html"
}
