# CodeGraph 运行时数据
.codegraph/
# ---- 支撑项目目录 (supports/) ----
# 策略: 默认忽略所有,按目录/文件粒度逐个放行
# 放行的目录会递归跟踪其下所有内容; 放行的文件仅该文件本身
supports/*
# 整目录放行
!supports/.claude/
!supports/backups/
!supports/docs/
!supports/scripts/
!supports/extensions/
# 单文件放行
!supports/AGENTS.md
!supports/CLAUDE.md
!supports/SYNC.md
!supports/clone-all.sh
!supports/Makefile
!supports/README.md
!supports/start-all.sh
# extensions/ 下的独立 git 仓库忽略
supports/extensions/starcat-*

# CodebaseMemory 内置二进制由脚本下载并移动到资源目录，不进入 Git 历史。
Starcat/Resources/Codebase/codebase

!.claude/skills/macos-app-skills/build

sparkle-private-key

